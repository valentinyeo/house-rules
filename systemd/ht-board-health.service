[Unit]
Description=Hourly board health: safe fixes, scorecard, alarm (house-rules hypertask-triage step 0)

[Service]
Type=oneshot
TimeoutStartSec=55min
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=-/bin/sh -c '%h/.local/share/house-rules/skills/hypertask-triage/scripts/board-health --board 8525 > %h/.local/state/board-health/last-8525.log 2>&1'
ExecStart=-/bin/sh -c '%h/.local/share/house-rules/skills/hypertask-triage/scripts/board-health --board 15 --fix --apply > %h/.local/state/board-health/last-15.log 2>&1'
ExecStart=-/bin/sh -c '%h/.local/share/house-rules/skills/hypertask-triage/scripts/board-health --board 11514 --fix --apply > %h/.local/state/board-health/last-11514.log 2>&1'
ExecStart=-/bin/sh -c '%h/.local/share/house-rules/skills/hypertask-triage/scripts/board-health --scope 2060 > %h/.local/state/board-health/last-2060.log 2>&1'
ExecStart=-/bin/sh -c '%h/.local/share/house-rules/skills/hypertask-triage/scripts/board-health --scope 2060/multi-bot > %h/.local/state/board-health/last-2060-multi-bot.log 2>&1'
ExecStart=-/bin/sh -c '%h/.local/share/house-rules/skills/hypertask-triage/scripts/board-health --scope 2060/postbox > %h/.local/state/board-health/last-2060-postbox.log 2>&1'
ExecStart=-/bin/sh -c '%h/.local/share/house-rules/skills/hypertask-triage/scripts/board-health --scope 2060/multi-bot-android > %h/.local/state/board-health/last-2060-multi-bot-android.log 2>&1'
ExecStart=-/bin/sh -c '%h/.local/share/house-rules/skills/hypertask-triage/scripts/board-health --board 10450 --apply > %h/.local/state/board-health/last-10450.log 2>&1'
ExecStart=-/bin/sh -c '%h/.local/share/house-rules/skills/hypertask-triage/scripts/board-health --board 8783 --apply > %h/.local/state/board-health/last-8783.log 2>&1'
ExecStart=-/bin/sh -c '%h/.local/share/house-rules/skills/hypertask-triage/scripts/board-health --board 2108 --apply > %h/.local/state/board-health/last-2108.log 2>&1'
ExecStart=-/bin/sh -c '%h/.local/share/house-rules/skills/hypertask-triage/scripts/board-health --board 2128 --apply > %h/.local/state/board-health/last-2128.log 2>&1'
ExecStart=-%h/.local/share/house-rules/skills/hypertask-triage/scripts/board-health-wake
