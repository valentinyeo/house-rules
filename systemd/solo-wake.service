[Unit]
Description=Roster check, then wake idle solo devs whose board or view still has open tickets (HYCI-211, HYCI-214)

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStartPre=-%h/.local/share/house-rules/fleet/roster-check --record --log
ExecStart=%h/.local/share/house-rules/fleet/solo-wake
