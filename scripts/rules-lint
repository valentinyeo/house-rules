#!/usr/bin/env python3
"""rules-lint: structural checks for house rules and skills. Style is judged by the blind eval, not regex.

  rules-lint [FILE...]                  lint whole files (default: house-rules.md, skills/*/SKILL.md, reference/*.md)
  rules-lint --diff BASE [--head REV]   lint only what a change adds since BASE (CI and sync use this)
  rules-lint --self-test

Checks:
  date         a rule line with "(20xx-" or "why:". Dates and reasons go in the PR body.
  enforcer     an Enforcement row whose second cell is not "judgment", "not yet" or a backticked check (in --diff mode: also "not yet" rows growing past BASE)
  format       a house-rules.md bullet outside Enforcement that is not "- **Label:** sentence."
  frontmatter  SKILL.md without name, description, a trigger ("use when ...") in it, or a description over 1024 characters
  length       a rule bullet over 45 words (each code span counts as one word)
  pair         a rule label with no row in the Enforcement table, or an Enforcement row whose rule has no bullet
  size         SKILL.md over 500 lines: move detail to reference/<topic>.md
  table        a path in the "Read X when Y" table of house-rules.md that does not exist
  orphan       a reference/*.md file that house-rules.md and no skill points to
  words        house-rules.md over 1500 words (in --diff mode: growing past WORD_CEILING)

Exit 1 on any hit, with file:line. Reads only: never edits a file, starts no job.
"""
import argparse
import os
import re
import subprocess
import sys
import tempfile

MAX_FILE_WORDS = 1500
WORD_CEILING = MAX_FILE_WORDS  # in --diff mode the file may not grow past the cap
MAX_DESC = 1024
MAX_SKILL_LINES = 500
MAX_RULE_WORDS = 45

DATE_RE = re.compile(r"\(20\d\d-|\bwhy:", re.I)
CODE_SPAN_RE = re.compile(r"`[^`\n]*`")
URL_RE = re.compile(r"https?://\S+")
RULE_RE = re.compile(r"^- \*\*[^*]+:\*\* .+$")
LABEL_RE = re.compile(r"^- \*\*([^*]+):\*\*")


def sh(root, *args, check=True):
    r = subprocess.run(["git", "-C", root, *args], capture_output=True, text=True)
    if check and r.returncode:
        sys.exit("rules-lint: git %s failed: %s" % (" ".join(args), r.stderr.strip()))
    return r.stdout if r.returncode == 0 else None


def read(root, head, path):
    if head is None:
        full = os.path.join(root, path)
        if not os.path.isfile(full):
            return None
        with open(full, encoding="utf-8", errors="replace") as f:
            return f.read()
    return sh(root, "show", "%s:%s" % (head, path), check=False)


def tree(root, head):
    """Repo-relative file paths at head (the working tree when head is None)."""
    if head is None:
        out = []
        for dirpath, dirs, names in os.walk(root):
            dirs[:] = [d for d in dirs if d != ".git"]
            out += [os.path.relpath(os.path.join(dirpath, n), root) for n in names]
        return sorted(out)
    return [x for x in (sh(root, "ls-tree", "-r", "--name-only", head, check=False) or "").split("\n") if x]


def rule_lines(text):
    """(lineno, text) for prose lines: outside frontmatter and code fences, not headings or table rows."""
    lines = text.split("\n")
    i = 0
    if lines and lines[0].strip() == "---":
        i = 1
        while i < len(lines) and lines[i].strip() != "---":
            i += 1
        i += 1
    fence = False
    out = []
    for n in range(i, len(lines)):
        s = lines[n].strip()
        if s.startswith("```"):
            fence = not fence
        elif not fence and s and not s.startswith(("#", "|", "<!--")):
            out.append((n + 1, s))
    return out


def line_problems(s):
    c = URL_RE.sub("URL", CODE_SPAN_RE.sub("CODE", s))
    if DATE_RE.search(c):
        return [("date", "dates and why: go in the PR body, not the rule")]
    return []


def md_lines(text):
    """(lineno, stripped line, in_fence) for markdown lines, YAML frontmatter skipped."""
    lines = text.split("\n")
    start = 0
    if lines and lines[0].strip() == "---":
        start = 1
        while start < len(lines) and lines[start].strip() != "---":
            start += 1
        start += 1
    out, fence = [], False
    for n in range(start, len(lines)):
        s = lines[n].strip()
        if s.startswith("```"):
            fence = not fence
            out.append((n + 1, s, True))
        else:
            out.append((n + 1, s, fence))
    return out


def rule_bullets(text):
    """(lineno, stripped line, label or None) for "- " bullets of house-rules.md outside Enforcement."""
    out, section = [], ""
    for n, s, fence in md_lines(text):
        if fence:
            continue
        if s.startswith("#"):
            section = s.lstrip("#").strip().lower()
        elif not section.startswith("enforcement") and s.startswith("- "):
            m = LABEL_RE.match(s) if RULE_RE.match(s) else None
            out.append((n, s, m.group(1) if m else None))
    return out


def enforcement_rows(text, fallback=True):
    """(lineno, rule cell, enforced-by cell) for the table under the Enforcement heading.

    fallback reads a table whose header says "Enforced by" in a file with no Enforcement
    heading, so an old-format file reports its rows as unpaired.
    """
    lines = [(n, s) for n, s, fence in md_lines(text) if not fence]
    has_section = any(s.startswith("#") and s.lstrip("#").strip().lower().startswith("enforcement") for _, s in lines)
    rows, insec, header, want = [], False, True, False
    for n, s in lines:
        if s.startswith("#"):
            insec = s.lstrip("#").strip().lower().startswith("enforcement")
            header, want = True, insec
            continue
        if not s.startswith("|") or not (insec or (fallback and not has_section)):
            continue
        cells = [c.strip() for c in s.split("|")]
        if cells and not cells[0]:
            cells = cells[1:]
        if cells and not cells[-1]:
            cells = cells[:-1]
        if header:
            header = False
            want = len(cells) >= 2 and (insec or "enforced by" in cells[1].lower())
            continue
        if not want or len(cells) < 2:
            continue
        if all(re.fullmatch(r":?-{2,}:?", c) for c in cells[:2]):
            continue
        rows.append((n, cells[0], cells[1]))
    return rows


def enforcer_ok(cell):
    c = cell.strip().lower()
    return c in ("judgment", "not yet") or "`" in cell


def house_rules_problems(text, base_text=None):
    """(lineno, code, message) for the labelled-rule format of house-rules.md."""
    out, labelled = [], []
    bullets, rows = rule_bullets(text), enforcement_rows(text)
    for n, s, label in bullets:
        if label is None:
            out.append((n, "format", 'write "- **Label:** imperative sentence.", one rule per bullet'))
            continue
        labelled.append((n, label))
        words = len(CODE_SPAN_RE.sub(" CODE ", s).split())
        if words > MAX_RULE_WORDS:
            out.append((n, "length", "%d words, max %d: cut it or move detail to a reference file" % (words, MAX_RULE_WORDS)))
    table = set(r[1] for r in rows)
    for n, label in labelled:
        if label not in table:
            out.append((n, "pair", "no Enforcement row for %s" % label))
    names = set(l for _, l in labelled)
    for n, rule, enforced in rows:
        if rule not in names:
            out.append((n, "pair", "Enforcement row %s has no rule bullet" % rule))
        if not enforcer_ok(enforced):
            out.append((n, "enforcer", 'second cell must be "judgment", "not yet", or a backticked check'))
    if base_text is not None:
        # an old-format base has no Enforcement section, so the first table is grandfathered
        base = enforcement_rows(base_text, fallback=False)
        if base:  # the first table in a file is grandfathered
            before = sum(1 for r in base if r[2].strip().lower() == "not yet")
            after = [r for r in rows if r[2].strip().lower() == "not yet"]
            if len(after) > before:
                old = set(r[1] for r in base)
                n = next((r[0] for r in after if r[1] not in old), after[0][0])
                out.append((n, "enforcer", "new rule with no enforcer: add a check, or mark it judgment if it truly needs judgment"))
    return out


def parse_frontmatter(text):
    lines = text.split("\n")
    if not lines or lines[0].strip() != "---":
        return None
    fm, key = {}, None
    for ln in lines[1:]:
        if ln.strip() == "---":
            return fm
        m = re.match(r"^([A-Za-z_-]+):\s*(.*)$", ln)
        if m:
            key = m.group(1)
            fm[key] = m.group(2).strip()
        elif key and ln.startswith((" ", "\t")):
            fm[key] = (fm[key] + " " + ln.strip()).strip()
    return None


def frontmatter_problems(text):
    fm = parse_frontmatter(text)
    if fm is None:
        return ["no frontmatter: add name and description"]
    out = []
    for k in ("name", "description"):
        if not fm.get(k) or fm[k] in (">", "|", ">-", "|-"):
            out.append("frontmatter %s missing or empty" % k)
    d = fm.get("description", "")
    if d and not re.search(r"\b(use|when|trigger)", d, re.I):
        out.append("description has no trigger: say when to use it")
    if len(d) > MAX_DESC:
        out.append("description over %d characters" % MAX_DESC)
    return out


def lint_file(root, head, path, only_lines, report):
    text = read(root, head, path)
    if text is None:
        return
    if path.endswith("SKILL.md"):
        for msg in frontmatter_problems(text):
            report(path, 1, "frontmatter", msg)
        if len(text.split("\n")) > MAX_SKILL_LINES:
            report(path, 1, "size", "over %d lines: move detail to reference/<topic>.md" % MAX_SKILL_LINES)
    for n, s in rule_lines(text):
        if only_lines is None or n in only_lines:
            for code, msg in line_problems(s):
                report(path, n, code, msg)


def structure_problems(root, head, report):
    files = set(tree(root, head))
    hr = read(root, head, "house-rules.md") or ""
    intable = False
    for n, ln in enumerate(hr.split("\n"), 1):
        if ln.startswith("#"):
            intable = bool(re.search(r"read .* when", ln, re.I))
        elif intable and ln.startswith("|") and ln.count("|") >= 2:
            for p in re.findall(r"`([^`]+)`", ln.split("|")[1]):
                if not p.startswith(("~", "/")) and not re.search(r"[<*]", p) and p not in files:
                    report("house-rules.md", n, "table", "read-table target does not exist: %s" % p)
    pointers = hr + "".join(read(root, head, f) or "" for f in files if re.fullmatch(r"skills/[^/]+/SKILL\.md", f))
    for f in sorted(files):
        if re.fullmatch(r"reference/[^/]+\.md", f) and f not in pointers:
            report(f, 1, "orphan", "house-rules.md and no skill points to this file")


def added_lines(root, base, head):
    """{path: set(new line numbers)} for the linted files."""
    args = ["diff", "-U0", "--no-color", base] + ([head] if head else []) + ["--", "house-rules.md", "skills/*/SKILL.md", "reference/*.md"]
    res, path, cur = {}, None, None
    for ln in sh(root, *args).split("\n"):
        if ln.startswith("+++ "):
            path = None if ln.endswith("/dev/null") else ln[6:]
            if path:
                res.setdefault(path, set())
        elif ln.startswith("@@"):
            m = re.match(r"@@ -\S+ \+(\d+)(?:,(\d+))?", ln)
            cur = None if m.group(2) == "0" else int(m.group(1))
        elif ln.startswith("+") and path and cur is not None:
            res[path].add(cur)
            cur += 1
    return res


def run(root, files, base, head, out):
    hits = []

    def report(path, n, code, msg):
        hits.append((path, n, code, msg))
        print("%s:%d: %s: %s" % (path, n, code, msg), file=out)

    wc = lambda t: len(t.split()) if t else 0
    structure_problems(root, head, report)
    hr_text = read(root, head, "house-rules.md")
    if hr_text is not None:
        base_text = read(root, base, "house-rules.md") if base is not None else None
        for n, code, msg in house_rules_problems(hr_text, base_text):
            report("house-rules.md", n, code, msg)
    if base is None:
        paths = files or ["house-rules.md"] + [x for x in tree(root, head) if re.fullmatch(r"skills/[^/]+/SKILL\.md|reference/[^/]+\.md", x)]
        for p in paths:
            lint_file(root, head, p, None, report)
        if "house-rules.md" in paths and wc(read(root, head, "house-rules.md")) > MAX_FILE_WORDS:
            report("house-rules.md", 1, "words", "%d words, max %d" % (wc(read(root, head, "house-rules.md")), MAX_FILE_WORDS))
    else:
        for p, lines in sorted(added_lines(root, base, head).items()):
            lint_file(root, head, p, lines, report)
        new, old = wc(read(root, head, "house-rules.md")), wc(read(root, base, "house-rules.md"))
        if new > WORD_CEILING and new > old:
            report("house-rules.md", 1, "words", "%d words, ceiling %d: shrink it" % (new, WORD_CEILING))
    print("RULES-LINT bad=%d" % len(hits), file=out)
    return 1 if hits else 0


def self_test():
    ok = True

    def check(name, cond):
        nonlocal ok
        print(("PASS " if cond else "FAIL ") + name)
        ok = ok and cond

    check("clean line", not line_problems("Switch flags yourself; never ask Valentin."))
    check("dated line", bool(line_problems("Do X. (2026-11-14, Valentin).")))
    check("why line", bool(line_problems("Do X, why: because.")))
    check("code span ignored", not line_problems("Run `git log --since 2026-11-01`."))
    check("frontmatter missing", bool(frontmatter_problems("# no fm\n")))
    check("frontmatter ok", not frontmatter_problems("---\nname: a\ndescription: Use when b.\n---\nbody\n"))
    check("frontmatter no trigger", bool(frontmatter_problems("---\nname: a\ndescription: Does things.\n---\n")))
    check("frontmatter empty desc", bool(frontmatter_problems("---\nname: a\ndescription:\n---\n")))

    def hr_doc(bullets, rows):
        """A minimal house-rules.md in the labelled style."""
        text = "# House rules\n\n## Work\n\n" + "\n".join(bullets)
        text += "\n\n## Enforcement\n\n| Rule | Enforced by |\n| --- | --- |\n"
        return text + "".join("| %s | %s |\n" % r for r in rows)

    def codes(text, base=None):
        return [c for _, c, _ in house_rules_problems(text, base)]

    check("format: labelled rule with its row passes",
          not house_rules_problems(hr_doc(["- **Tickets:** Open a ticket on your board."], [("Tickets", "judgment")])))
    check("format: unlabelled bullet refused",
          "format" in codes(hr_doc(["- Open a ticket."], [("Tickets", "judgment")])))
    check("pair: rule label without a table row refused",
          codes(hr_doc(["- **Tickets:** Open a ticket."], [])).count("pair") == 1)
    check("pair: table row without a rule refused",
          codes(hr_doc(["- **Tickets:** Open a ticket."], [("Tickets", "judgment"), ("Models", "judgment")])).count("pair") == 1)
    check("length: rule over 45 words refused",
          "length" in codes(hr_doc(["- **Long:** " + "word " * 50 + "end."], [("Long", "judgment")])))
    check("length: a code span counts as one word",
          "length" not in codes(hr_doc(["- **Cmd:** Run `" + "x " * 80 + "` now."], [("Cmd", "judgment")])))
    check("enforcer: bare second cell refused",
          "enforcer" in codes(hr_doc(["- **Tickets:** Open a ticket."], [("Tickets", "nothing")])))
    check("enforcer: judgment, not yet and a backticked check pass",
          not house_rules_problems(hr_doc(["- **A:** Do a.", "- **B:** Do b.", "- **C:** Do c."],
                                          [("A", "judgment"), ("B", "not yet"), ("C", "`rules-lint` required")])))
    base = hr_doc(["- **A:** Do a."], [("A", "not yet")])
    check("enforcer: diff mode refuses a new unenforced rule",
          any(m.startswith("new rule with no enforcer") for _, c, m in house_rules_problems(
              hr_doc(["- **A:** Do a.", "- **B:** Do b."], [("A", "not yet"), ("B", "not yet")]), base)))
    check("enforcer: diff mode allows a new judgment rule",
          not house_rules_problems(hr_doc(["- **A:** Do a.", "- **B:** Do b."], [("A", "not yet"), ("B", "judgment")]), base))
    check("enforcer: the first table in a file is grandfathered",
          not house_rules_problems(hr_doc(["- **A:** Do a.", "- **B:** Do b."], [("A", "not yet"), ("B", "not yet")]),
                                   "# Old rules\n- Never do X.\n"))

    here = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
    check("format, pair, length: current house-rules.md passes",
          not house_rules_problems(read(here, None, "house-rules.md") or ""))

    class Buf:
        def __init__(self):
            self.t = ""

        def write(self, s):
            self.t += s

    with tempfile.TemporaryDirectory() as d:
        def g(*a):
            subprocess.run(["git", "-C", d, "-c", "user.name=t", "-c", "user.email=t@t", *a], check=True, capture_output=True)

        def put(path, text):
            os.makedirs(os.path.dirname(os.path.join(d, path)), exist_ok=True)
            with open(os.path.join(d, path), "w") as f:
                f.write(text)

        def commit(msg):
            g("add", "-A")
            g("commit", "-qm", msg)

        old_rule = "- **Old:** Never do X. (2026-11-01, why: old)."
        run_rule = "- **Run:** Run the lint before every pull request."
        g("init", "-q", "-b", "main")
        put("house-rules.md", hr_doc([old_rule], [("Old", "`old-check`")]))
        commit("base")
        b = Buf()
        check("full mode fails on old file", run(d, None, None, None, b) == 1 and "bad=1" in b.t)
        put("house-rules.md", hr_doc([old_rule, run_rule], [("Old", "`old-check`"), ("Run", "judgment")]))
        commit("good")
        check("diff mode grandfathers old bad line", run(d, None, "HEAD~1", "HEAD", Buf()) == 0)
        put("house-rules.md", hr_doc([old_rule, run_rule, '- **Bad:** Never skip it. (2026-11-14, why: Valentin said it).'],
                                     [("Old", "`old-check`"), ("Run", "judgment"), ("Bad", "judgment")]))
        commit("bad")
        b = Buf()
        check("diff mode refuses dated line", run(d, None, "HEAD~1", "HEAD", b) == 1 and ": date:" in b.t)
        put("skills/x/SKILL.md", "# no frontmatter\nDo the thing.\n")
        commit("skill")
        b = Buf()
        check("new skill without frontmatter refused", run(d, None, "HEAD~1", "HEAD", b) == 1 and "frontmatter" in b.t)
        put("reference/boards.md", "Board 15 is Hypertask.\n")
        put("house-rules.md", hr_doc([old_rule, run_rule], [("Old", "`old-check`"), ("Run", "judgment")])
            + "\n## Read X when Y\n| Read | When |\n|---|---|\n| `reference/missing.md` | boards |\n")
        commit("ref")
        b = Buf()
        run(d, None, "HEAD~1", "HEAD", b)
        check("read-table missing target refused", ": table:" in b.t)
        check("orphan reference refused", "reference/boards.md:1: orphan" in b.t)
        put("house-rules.md", hr_doc(["- **Pad:** " + "pad " * 9000], [("Pad", "judgment")]))
        commit("big")
        b = Buf()
        run(d, None, "HEAD~1", "HEAD", b)
        check("diff mode refuses file growing past cap", ": words:" in b.t)

    old = sh(here, "show", "origin/main:house-rules.md", check=False) or sh(here, "show", "main:house-rules.md", check=False)
    if not old or "format" not in codes(old):
        print("SKIP old house-rules.md: origin/main already uses the labelled style")
    else:
        with tempfile.TemporaryDirectory() as d:
            subprocess.run(["git", "-C", d, "init", "-q", "-b", "main"], check=True, capture_output=True)
            with open(os.path.join(d, "house-rules.md"), "w") as f:
                f.write(old)
            b = Buf()
            check("old house-rules.md fails format and pair", run(d, None, None, None, b) == 1
                  and ": format:" in b.t and ": pair:" in b.t)
    print("SELF-TEST " + ("ok" if ok else "FAILED"))
    return 0 if ok else 1


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("files", nargs="*")
    ap.add_argument("--diff", metavar="BASE")
    ap.add_argument("--head", help="git rev to read (default: working tree; use HEAD in CI)")
    ap.add_argument("--root", help="repo root (default: the repo this script lives in)")
    ap.add_argument("--self-test", action="store_true")
    a = ap.parse_args()
    if a.self_test:
        sys.exit(self_test())
    root = a.root or os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
    sys.exit(run(root, a.files, a.diff, a.head, sys.stdout))


if __name__ == "__main__":
    main()
