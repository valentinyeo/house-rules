      if [ -f "$STATE/PAUSED" ] || [ -f "$STATE/stop-$n" ]; then sleep 300; continue; fi
      provider_busy_wait "$(engine "$n")" || continue
      orphan_run_wait "$n"
      pick_bin=$(python3 "$PICK_GATE" pick 2>>"$rlog") || { echo "$(date -u +%FT%TZ) pick-gate: no runnable picker" >> "$rlog"; sleep 900; continue; }
      if ! pick=$("$pick_bin" "$n" --json 2>>"$rlog"); then
        echo "$(date -u +%FT%TZ) pick: nothing to start" >> "$rlog"
        note=$(grep -aE 'none:|fleet/pick:' "$rlog" | tail -1 | cut -c1-400 || true)
        case $note in
          *"not counted"*) wip=$note ;;
          *) wip=$("$pick_bin" --wip 2>/dev/null | tr '\n' ' ' | cut -c1-500 || true) ;;
        esac
        python3 "$HERE/runner-state.py" --pick-fail --runner "$n" --note "$note" --wip "$wip" --ledger "$STATE/run-ledger.jsonl" >>"$rlog" 2>&1 || true
        sleep 900; continue
      fi
      IFS=$'\t' read -r pick_ticket pick_engine pick_model pick_effort pick_source pick_repo < <(jq -r '[.ticket,(.engine // "cursor"),.model,.effort,.source,.repo] | @tsv' <<< "$pick")
      if ! ticket_key_ok "$pick_ticket"; then
        note="one-run: pick returned no ticket key, no model started"
        echo "$(date -u +%FT%TZ) $note" >> "$rlog"
        python3 "$HERE/runner-state.py" --pick-fail --runner "$n" --note "$note" --wip "" --ledger "$STATE/run-ledger.jsonl" >>"$rlog" 2>&1 || true
        sleep 900; continue
      fi
      [ -d "$pick_repo" ] || pick_repo=$HOME/projects/hypertask
      harness_base=$pick_engine
      pi_login_heal "$harness_base" "$rlog" && echo "$(date -u +%FT%TZ) harness: Pi Codex login renewed from the Codex CLI login, back on Pi" >> "$rlog"
      pick_engine=$(harness "$n" "$pick_engine"); pick=$(jq -c --arg e "$pick_engine" '.engine = $e' <<< "$pick")
      if [ "$(cat "$STATE/harness-$n" 2>/dev/null)" = pi ] && [ "$pick_engine" = "$harness_base" ] && [ -f "$(pi_down_mark "$harness_base")" ]; then
        echo "$(date -u +%FT%TZ) harness: pi-$harness_base login is down, this pick runs on hax $harness_base" >> "$rlog"
      fi
      echo "$(date -u +%FT%TZ) pick: $pick_ticket $pick_engine $pick_model $pick_effort ($pick_source)" >> "$rlog"
      if ! known_engine "$pick_engine" || { [ "$pick_engine" = opencode ] && ! opencode_key; }; then
        echo "$(date -u +%FT%TZ) gate: engine $pick_engine cannot start (unknown engine or no OpenCode Go key)" >> "$rlog"; sleep 900; continue
      fi
      brief=$(run_brief "$n" "$pick")
      echo "$(date -u +%FT%TZ) start" >> "$rlog"
      clear; tmux clear-history -t "$TMUX_PANE"
      : > "$runlog"
      : > "$STATE/runner-$n.result"
      # The pacer reads this line to count runner-hours per plan: "cursor|hax|claude: TICKET MODEL", nothing after.
      case $pick_engine in cursor|claude) run_tag=$pick_engine ;; *) run_tag=hax ;; esac
      echo "$(date -u +%FT%TZ) $run_tag: $pick_ticket $pick_model" >> "$rlog"
      tmux select-pane -t "$TMUX_PANE" -T "RUNNER $n $pick_engine $pick_model"
      cmodel=$pick_model
      refs_before=$(mktemp); python3 "$HERE/runner-state.py" --refs --repo "$pick_repo" --ticket "$pick_ticket" > "$refs_before" 2>/dev/null || true
      started_at=$(date +%s)
      launch "$pick_engine" "$pick_model" "$pick_effort" "$pick_repo" "$brief" 2>&1 | tee "$runlog"
      rc=${PIPESTATUS[0]}
      echo "$(date -u +%FT%TZ) end" >> "$rlog"
      # An unknown state is a fault. flag approval is not a state. A crash or a run under two minutes with no final line
      # is FAIL, so a bad launch does not park the ticket.
      elapsed=$(( $(date +%s) - started_at ))
      case $pick_engine in pi-codex|pi-opencode)
        if [ "$rc" -ne 0 ] && [ "$elapsed" -lt 120 ] && pi_mark_auth_failure "$pick_engine" "$runlog"; then
          echo "$(date -u +%FT%TZ) harness: pi-${pick_engine#pi-} login failed on ${pick_ticket}; its next picks run on hax ${pick_engine#pi-} until the login file changes" >> "$rlog"
        fi ;;
      esac
      stop=""; [ -f "$STATE/stop-$n" ] && stop=$(head -1 "$STATE/stop-$n" || true)
      waitf="$STATE/wait-check-$pick_ticket"
      waited=0; [ -f "$waitf" ] && waited=$(( $(date +%s) - $(stat -c %Y "$waitf") ))
      final=$(grep -a -E 'INFRA RUNNER DONE|CI RUNNER DONE|RUNNER DONE|RUNNER TOO HARD|^(RUNNER )?PARKED |RUNNER IDLE' "$runlog" | tail -1 | sed 's/\x1b\[[0-9;]*[A-Za-z]//g' | cut -c1-300 || true)
      # A run with no ending of its own that the provider refused is provider busy, never a crash. The mark rests every
      # runner on that plan, and it changes no engine: the same provider is tried again when the mark expires.
      overload=0
      if [ -z "$final" ] && mark_provider_busy "$pick_engine" "$runlog"; then overload=1; fi
      meta=$(python3 "$HERE/runner-state.py" --classify --final "$final" --rc "$rc" --elapsed "$elapsed" --stop "$stop" --waited "$waited" --ticket "$pick_ticket" --overload "$overload") \
        || meta='{"state":"FAULT","result":"FAIL","park":"","waits":"","detail":"classifier failed"}'
      state=$(jq -r '.state // "FAULT"' <<<"$meta"); res=$(jq -r '.result // "FAIL"' <<<"$meta")
      park_mode=$(jq -r '.park // ""' <<<"$meta"); waits=$(jq -r '.waits // ""' <<<"$meta"); detail=$(jq -r '.detail // ""' <<<"$meta")
      [ -n "$state" ] || state=FAULT; [ -n "$res" ] || res=FAIL
      if [ "$state" = "WAIT_CHECK" ]; then [ -f "$waitf" ] || touch "$waitf"; else rm -f "$waitf"; fi
      reason=$(printf '%s' "$final" | cut -c1-300)
      progress=$(ticket_progress "$pick_repo" "$pick_ticket" "$refs_before"); rm -f "$refs_before"
      # Built in another repo than the picker named (HYCI-361: a PR on yeoux-site)? A PR the run links, opened since it started, is progress.
      if [ "$progress" -eq 0 ] && [ "$state" != BUILDING ]; then
        pr_made=$(python3 "$HERE/runner-state.py" --pr-progress --log "$runlog" --since "$started_at" 2>/dev/null || echo 0)
        [[ "$pr_made" =~ ^[0-9]+$ ]] && progress=$pr_made
      fi
      # A PARKED ending names the ticket and nothing else. The ledger keeps the model's own reason beside it, so the next
      # look at a pile of parks reads one line each instead of opening every log (13 Nov, "3 shipped vs 17 runs").
      ledger_detail="$detail"
      if [ "$state" = PARKED ]; then
        park_why=$(python3 "$HERE/runner-state.py" --park-reason --log "$runlog" 2>/dev/null | head -1 | cut -c1-200 || true)
        [ -n "$park_why" ] && ledger_detail="${detail:+$detail | }why: $park_why"
      fi
      save_transcript "$pick_ticket" "$runlog" "$state" "$ledger_detail" "$progress" "$rc" "$elapsed"
      jq -nc --arg ts "$(date -u +%FT%TZ)" --arg ticket "$pick_ticket" --arg engine "$pick_engine" --arg model "$cmodel" --arg result "$res" --argjson runner "$n" --arg reason "$reason" --arg state "$state" --arg detail "$ledger_detail" --arg source "${pick_source:-}" --argjson progress "$progress" --arg transcript "$(basename "${TRANSCRIPT_FILE:-}")" \
        '{ts:$ts,runner:$runner,ticket:$ticket,engine:$engine,model:$model,result:$result,reason:$reason,state:$state,detail:$detail,source:$source,progress:$progress,transcript:$transcript}' >> "$STATE/run-ledger.jsonl" 2>/dev/null || true
      if [ "$state" != BUILDING ] && [ "$progress" -eq 0 ]; then note_empty_run "$pick_ticket" "$state" "$detail" "$progress" "${pick_source:-}"; fi
      echo "$res" > "$STATE/runner-$n.result"
      if [ "$park_mode" = "bump" ]; then
        # RUNNER TOO HARD: the one valid leave. The brain tag goes up one step and a stronger runner takes the ticket (2026-11-13).
        "$HERE/park" "$pick_ticket" --too-hard "$detail" >>"$rlog" 2>&1 || echo "$(date -u +%FT%TZ) park-too-hard failed" >>"$rlog"
      elif [ "$park_mode" = "lead" ]; then
        "$HERE/park" "$pick_ticket" --lead --why "$detail" >>"$rlog" 2>&1 || echo "$(date -u +%FT%TZ) park-lead failed" >>"$rlog"
      elif [ "$park_mode" = "pc" ]; then
        # fleet/pick skips it until the PC tunnel answers again
        printf '%s %s\n' "$(date -u +%FT%TZ)" "$pick_ticket" >> "$STATE/pc-waits"
        "$HERE/park" "$pick_ticket" --hand-back "needs Valentin's PC or the check phone online for the live check" >>"$rlog" 2>&1 || echo "$(date -u +%FT%TZ) park-pc failed" >>"$rlog"
      elif [ "$park_mode" = "waits" ] && [ -n "$waits" ] && [ "$waits" != "null" ]; then
        "$HERE/park" "$pick_ticket" --waits-on "$waits" >>"$rlog" 2>&1 || echo "$(date -u +%FT%TZ) park-waits failed" >>"$rlog"
      fi
      [ "$res" = FAIL ] && save_fail_tail "$pick_ticket" "$runlog"
      if [ "$res" = FAIL ] && grep -q 'no model reply for [0-9]*s twice' <<<"$final"; then
        silent_n=$(( $(cat "$STATE/silent-runs-$n" 2>/dev/null || echo 0) + 1 )); echo "$silent_n" > "$STATE/silent-runs-$n"
        echo "$(date -u +%FT%TZ) silent provider: $silent_n run(s) in a row ended by the reply cap, resting $(silent_rest "$silent_n")s" >> "$rlog"
        sleep "$(silent_rest "$silent_n")"
      else
        rm -f "$STATE/silent-runs-$n"
        sleep "$(fail_rest "$res" "$elapsed")"
      fi
    done ;;
esac
