#!/usr/bin/env bash
# One launcher for every runner (YPER4-1371). Valentin 2026-11-07: one pool, Runner 1..N, every runner subscription used
# at once. Each runner runs the engine the pacer (poteto-2-advisor bin/pacer) writes to engine-N: cursor (Cursor CLI on the
# Cursor plan), codex (hax on Codex), opencode (hax on OpenCode Go, DeepSeek 4.1 Flash) or claude (Claude Code headless on
# the Claude subscription, never an API key). No engine-N: the engine file,
# else cursor. The engine is read when the picker runs, so a change lands between tickets.
# Generalised from ht-or-runner (copy in fleet/legacy/): same PAUSED file, stop-N files, top-up, load gate, tick and
# log format. The ticket, repo, brief, engine and model come from fleet/pick; this script only runs the agent.
#   fleet/runner <N> | top-up | tick | status | stop-all | check | launch-check <engine> <model> <effort> [--noop]
set -u
export PATH="$HOME/.local/bin:$HOME/bin:$PATH"
STATE=${FLEET_RUNNER_STATE:-$HOME/.local/state/ht-or-runners}
HERE=$(dirname "$(readlink -f "$0")")
SELF=$(readlink -f "$0")
PICK_GATE=$HERE/tool-gate.py
SESS_PFX=${FLEET_RUNNER_SESS_PREFIX:-ht-or-runner}
sess_name() { echo "${SESS_PFX}-$1"; }
FIRST=${FLEET_RUNNER_FIRST:-1}
LAST=${FLEET_RUNNER_LAST:-}
[ -z "$LAST" ] && LAST=$(jq -r '.runners // 20' "$HERE/roster.json" 2>/dev/null || echo 20)
[[ "$LAST" =~ ^[1-9][0-9]?$ ]] || LAST=20
mkdir -p "$STATE"
target() { cat "$STATE/target" 2>/dev/null || echo "$LAST"; }
# The pacer (poteto-2-advisor bin/pacer) writes pace-cap: the most runners the subscriptions sustain. The auto-raise in
# top-up never passes it; runners above it find a stop-N file marked "pacer" and stop between tickets.
ALLOC=${FLEET_PICK_ALLOCATION:-$HOME/.local/state/pacing/allocation.json}
PACER_FLOOR=5
FSWATCH=${FLEET_WATCH_STATE:-$HOME/.local/state/fleet-switch}
allocation_stale() {
  local at=0 now; now=$(date +%s)
  [ -f "$ALLOC" ] || return 0
  at=$(python3 -c "import json; print(int(json.load(open('$ALLOC')).get('at',0)))" 2>/dev/null) || return 0
  [ "$at" -eq 0 ] || [ "$((now - at))" -ge 3600 ]
}
pacer_watch_log() {
  mkdir -p "$FSWATCH"
  echo "$(date -u +%FT%TZ) fleet-watch: pacer allocation stale; runner floor $PACER_FLOOR" >> "$FSWATCH/log.txt"
}
maxcap() {
  local p
  if allocation_stale; then
    pacer_watch_log
    echo "$PACER_FLOOR"
    return
  fi
  p=$(cat "$STATE/pace-cap" 2>/dev/null)
  [[ "$p" =~ ^[1-9][0-9]?$ ]] && [ "$p" -lt "$LAST" ] && echo "$p" || echo "$LAST"
}
validate_targets() {
  t=$(target); cap=$(maxcap)
  [[ "$t" =~ ^[1-9][0-9]?$ && "$cap" =~ ^[1-9][0-9]?$ ]] &&
    [ "$t" -le "$cap" ] && [ "$cap" -le 40 ] || { echo "target/max must satisfy 1 <= target <= max <= 40" >&2; return 1; }
}
log() { echo "$(date -u +%FT%TZ) $*" >> "$STATE/keeper.log"; }
engine() { cat "$STATE/engine-${1:-0}" 2>/dev/null || cat "$STATE/engine" 2>/dev/null || echo "${HT_RUNNER_ENGINE:-cursor}"; }
known_engine() { case $1 in cursor|codex|opencode|claude|pi-codex|pi-opencode) return 0 ;; *) return 1 ;; esac; }
# harness-N holding "pi" runs this runner's codex and opencode picks in Pi with TokenEconomizer instead of hax.
# Same plan, same model; the pacer and picker never see it.
PI_BIN=${PI_BIN:-$HOME/.npm-global/bin/pi}
# TokenEconomizer calls `pi` by name for its judge; without this every call failed (102 times, 8-10 Nov) and it never acted.
export PATH="$(dirname "$PI_BIN"):$PATH"
PI_AUTH=${PI_AUTH:-$HOME/.pi/agent/auth.json}
# A Pi login that cannot refresh kills a pick in about four seconds and the slot then sleeps 15 minutes. One dead token
# emptied three slots for 10.5 hours (HYCI-209, 136 faults, 401 invalid_refresh_token). A failed pick leaves a mark and
# that engine runs on the plain launcher (hax, same plan) until the login file changes or the mark ages out.
HARNESS_DOWN_TTL=${HARNESS_DOWN_TTL:-21600}
pi_down_mark() { echo "$STATE/harness-down-pi-${1:-codex}"; }
pi_down() {
  local mark
  mark=$(pi_down_mark "$1")
  [ -f "$mark" ] || return 1
  if [ -e "$PI_AUTH" ] && [ "$PI_AUTH" -nt "$mark" ]; then rm -f "$mark"; return 1; fi
  # A refresh token OpenAI rejected never heals on its own; only a new Pi login (newer auth.json) clears that mark.
  grep -qE 'invalid_refresh_token|invalid_grant|OAuth refresh failed' "$mark" && return 0
  if [ $(( $(date +%s) - $(stat -c %Y "$mark") )) -ge "$HARNESS_DOWN_TTL" ]; then rm -f "$mark"; return 1; fi
  return 0
}
# Marks the engine down when a fast pick failed on the Pi login, so the next pick takes the plain launcher.
pi_mark_auth_failure() {
  local eng=${1#pi-} why
  why=$(grep -a -m1 -oE 'invalid_refresh_token|invalid_grant|OAuth refresh failed[^"]*|401 Unauthorized' "$2" 2>/dev/null) || return 1
  printf '%s %s\n' "$(date -u +%FT%TZ)" "$why" > "$(pi_down_mark "$eng")"
}
harness() { local want=$2; [ "$(cat "$STATE/harness-$1" 2>/dev/null)" = pi ] || { echo "$want"; return; }; case $want in codex|opencode) pi_down "$want" && echo "$want" || echo "pi-$want" ;; *) echo "$want" ;; esac; }

# A provider that refuses the work is busy, not broken (HYCI-255): 429 "The inference service is overloaded" crashed four
# DeepSeek runners on 2026-11-11 and each restart walked back into the same wall. One overload marks that plan busy for 15
# minutes and every runner on it rests until the mark expires. It never picks another provider.
PROVIDER_BUSY_SECONDS=${PROVIDER_BUSY_SECONDS:-900}
OVERLOAD_RE='inference service is overloaded|429: .*server_error'
plan_of_engine() {
  case $1 in
    opencode|pi-opencode) echo opencode ;; codex|pi-codex) echo codex ;; cursor|pi-cursor) echo cursor ;; claude) echo claude ;;
    *) echo "$1" ;;
  esac
}
provider_busy_path() { echo "$STATE/provider-busy-$(plan_of_engine "${1:-0}")"; }
provider_busy_until() { cat "$(provider_busy_path "${1:-0}")" 2>/dev/null || echo 0; }
provider_busy_left() {
  local until left
  until=$(provider_busy_until "${1:-0}")
  left=$(( ${until:-0} - $(date +%s) ))
  [ "$left" -gt 0 ] && echo "$left" || echo 0
}
mark_provider_busy() {
  local eng=${1:-0} log=$2 plan
  grep -a -qE "$OVERLOAD_RE" "$log" 2>/dev/null || return 1
  plan=$(plan_of_engine "$eng")
  echo $(( $(date +%s) + PROVIDER_BUSY_SECONDS )) > "$(provider_busy_path "$eng")"
  { echo "$(date -u +%FT%TZ) provider busy: $plan for ${PROVIDER_BUSY_SECONDS}s, its runners rest; no provider switch" >> "$STATE/runner-${n:-0}.log"; } 2>/dev/null || true
}
provider_busy_wait() {
  local eng=${1:-0} left
  left=$(provider_busy_left "$eng")
  [ "$left" -gt 0 ] || { rm -f "$(provider_busy_path "$eng")"; return 0; }
  { echo "$(date -u +%FT%TZ) provider busy: $(plan_of_engine "$eng") ${left}s left, resting" >> "$STATE/runner-${n:-0}.log"; } 2>/dev/null || true
  sleep "$left"
}

# A reply that never comes burns the whole run: 9 of 88 DeepSeek runs hit the 3h limit on 2026-11-10, one after 89 minutes
# of provider silence (HYCI-250). Pi writes a session record for every event, so its session file is a true heartbeat:
# no new record for REPLY_CAP seconds means the provider sent nothing. That attempt is killed, retried once, then the run
# ends and fleet/pick hands the ticket back. hax and cursor print only the final message, so they have no heartbeat to
# watch and keep the 3h run limit alone.
REPLY_CAP=${REPLY_CAP:-600}
CAP_TICK=${CAP_TICK:-15}
# A failed run's log is wiped by the next run (`: > "$runlog"`), so its error text was lost and about 190 week-one FAULTs
# could not be explained afterwards. Keep the last lines of a FAIL run, redacted by runner-state.py --redact, local only
# (mode 0600), newest 200 files. The ledger never carries this text.
save_fail_tail() {
  local ticket=$1 log=$2 dir="$STATE/fail-tail" f old
  [ -s "$log" ] || return 0
  mkdir -p "$dir" 2>/dev/null && chmod 700 "$dir" 2>/dev/null || return 0
  f="$dir/$(date -u +%Y%m%dT%H%M%SZ)-runner-${n:-0}-${ticket:-none}.log"
  ( umask 077; tail -n 20 "$log" | python3 "$HERE/runner-state.py" --redact > "$f" ) 2>/dev/null || return 0
  ls -1t "$dir" 2>/dev/null | tail -n +201 | while read -r old; do rm -f "$dir/$old"; done
  return 0
}
# HYCI-348: Codex runs use --no-session, so no transcript exists after a run, and the next run wipes $runlog. Keep the last
# 300 lines of EVERY run, redacted by runner-state.py --redact, with a header that names the ending (state, rc, elapsed,
# progress, detail). Local only (mode 0600), pruned after TRANSCRIPT_DAYS. hax and cursor print only the final message, so on
# those engines the tail is short; the header and the git progress count still tell what the run did.
TRANSCRIPT_DAYS=${TRANSCRIPT_DAYS:-14}
TRANSCRIPT_FILE=""
save_transcript() {
  local ticket=$1 log=$2 state=$3 detail=$4 progress=$5 rc=$6 elapsed=$7 dir="$STATE/transcripts"
  TRANSCRIPT_FILE=""
  mkdir -p "$dir" 2>/dev/null && chmod 700 "$dir" 2>/dev/null || return 0
  local f="$dir/$(date -u +%Y%m%dT%H%M%SZ)-runner-${n:-0}-${ticket:-none}.log"
  ( umask 077
    { printf 'ticket %s runner %s state %s rc %s elapsed %ss progress %s\ndetail %s\n---\n' "$ticket" "${n:-0}" "$state" "$rc" "$elapsed" "$progress" "$detail"
      tail -n 300 "$log" 2>/dev/null; } | python3 "$HERE/runner-state.py" --redact > "$f" ) 2>/dev/null || return 0
  [ -s "$f" ] && TRANSCRIPT_FILE=$f
  find "$dir" -type f -mtime +"$TRANSCRIPT_DAYS" -delete 2>/dev/null
  return 0
}
# An empty run (not BUILDING, nothing pushed) leaves one record for bin/canary-watch, which hands the run's class and
# transcript tail to the fleet-watch Sonnet fixer while a staged restart runs, so a fix lands per run (HYCI-345).
CANARY_WATCH=${CANARY_WATCH:-$HOME/projects/poteto-2-advisor/bin/canary-watch}
note_empty_run() {
  local ticket=$1 state=$2 detail=$3 progress=$4 source=$5 dir="$STATE/empty-runs"
  mkdir -p "$dir" 2>/dev/null || return 0
  jq -nc --arg ts "$(date -u +%FT%TZ)" --argjson runner "${n:-0}" --arg ticket "$ticket" --arg state "$state" --arg detail "$detail" \
    --argjson progress "${progress:-0}" --arg source "$source" --arg transcript "$TRANSCRIPT_FILE" --arg engine "${pick_engine:-}" \
    '{ts:$ts,runner:$runner,ticket:$ticket,engine:$engine,state:$state,detail:$detail,progress:$progress,source:$source,transcript:$transcript}' \
    > "$dir/$(date -u +%Y%m%dT%H%M%SZ)-runner-${n:-0}-${ticket:-none}.json" 2>/dev/null || return 0
  find "$dir" -type f -mtime +"$TRANSCRIPT_DAYS" -delete 2>/dev/null
  [ -x "$CANARY_WATCH" ] && [ -z "${FLEET_RUNNER_NO_WAKE:-}" ] && ( setsid "$CANARY_WATCH" >/dev/null 2>&1 < /dev/null & ) 2>/dev/null
  return 0
}
# HYCI-343: how much a run pushed. Branches named for the ticket (local and origin) are snapshotted before and after; the
# count is commits added, plus branches removed. A run that pushed and then waited for CI ends WAIT_CHECK but is not empty.
ticket_progress() {
  local repo=$1 ticket=$2 before=$3 after count
  after=$(mktemp) || { echo 0; return 0; }
  python3 "$HERE/runner-state.py" --refs --repo "$repo" --ticket "$ticket" > "$after" 2>/dev/null
  count=$(python3 "$HERE/runner-state.py" --progress --repo "$repo" --before "$before" --after "$after" 2>/dev/null)
  rm -f "$after"
  [[ "$count" =~ ^[0-9]+$ ]] && echo "$count" || echo 0
}
stall_mark() { echo "$STATE/stall-${n:-0}"; }
pi_session_dir() { echo "$STATE/pi-session-${n:-0}/$(date +%s)"; }
newest_beat() {
  local d=$1 f
  f=$(ls -t "$d"/*.jsonl 2>/dev/null | head -1)
  if [ -n "$f" ]; then stat -c %Y "$f" 2>/dev/null || echo 0; else stat -c %Y "$d" 2>/dev/null || echo 0; fi
}
# Take the tool calls with the agent: a half-finished child left running would outlive the attempt.
kill_tree() { local pid=$1 kid; for kid in $(pgrep -P "$pid" 2>/dev/null); do kill_tree "$kid"; done; kill -TERM "$pid" 2>/dev/null; }
# Waits for one attempt. 0 = the agent ended by itself, 124 = no reply for REPLY_CAP seconds and it was killed.
wait_reply() {
  local pid=$1 beat=$2 quiet=0 last now
  last=$(newest_beat "$beat")
  while kill -0 "$pid" 2>/dev/null; do
    sleep "$CAP_TICK"
    now=$(newest_beat "$beat")
    if [ "${now:-0}" -gt "${last:-0}" ]; then last=$now; quiet=0; continue; fi
    quiet=$((quiet + CAP_TICK))
    [ "$quiet" -ge "$REPLY_CAP" ] && { printf 'no reply from the model for %ss\n' "$REPLY_CAP" > "$(stall_mark)"; kill_tree "$pid"; return 124; }
  done
  return 0
}

# One stack-key read per runner process, kept in this shell only (house rule: keys once per job, never in a loop).
opencode_key() {
  [ -n "${OC_KEY:-}" ] || OC_KEY=$("$HOME/.local/bin/stack-key" 'opencode go' 'API KEY' 2>/dev/null)
  [ -n "$OC_KEY" ]
}

# Runs one agent turn. LAUNCH_DRY=1 prints the command instead, key and brief left out. The OpenCode key goes only into
# the hax process environment, never into argv or a cursor run.
launch() {
  local eng=$1 model=$2 effort=$3 repo=$4 brief=$5 base=()
  case $eng in
    cursor) base=("$HOME/.local/bin/cursor-agent" -p --output-format text --model "$model" -f --trust --approve-mcps --workspace "$repo") ;;
    codex) base=("$HOME/.local/bin/hax" --provider=codex --model="$model" --effort="$effort" --no-session -p) ;;
    opencode) base=("$HOME/.local/bin/hax" --provider=opencode-go --model="$model" --effort="$effort" --no-session -p) ;;
    pi-codex) base=("$PI_BIN" -p --provider openai-codex --model "$model" --thinking "$effort") ;;
    pi-opencode) base=("$PI_BIN" -p --provider opencode-go --model "$model" --thinking "$effort") ;;
    claude) base=("$HOME/.local/bin/claude" -p --model "$model" --effort "$effort" --permission-mode bypassPermissions
                  --no-session-persistence --output-format text --disallowedTools Agent Task) ;;
    *) echo "unknown engine: $eng" >&2; return 2 ;;
  esac
  # The reply cap needs the harness's own progress file, so a Pi run gets a session dir of its own. Set before the dry run
  # prints, so launch-check shows the real command.
  local beat=""
  case $eng in pi-codex|pi-opencode)
    beat=$(pi_session_dir); base+=(--session-dir "$beat")
    [ "${LAUNCH_DRY:-}" = 1 ] || { find "$STATE/pi-session-${n:-0}" -mindepth 1 -maxdepth 1 -mtime +2 -exec rm -rf {} + 2>/dev/null; mkdir -p "$beat"; } ;;
  esac
  if [ "${LAUNCH_DRY:-}" = 1 ]; then
    printf 'cd %q &&' "$repo"
    case $eng in codex|opencode) printf ' HAX_SUBAGENT_DEPTH=2 HAX_NO_SUBAGENTS=1' ;; claude) printf ' (ANTHROPIC_* unset: subscription login)' ;; esac
    [ "$eng" = opencode ] && printf ' OPENCODE_API_KEY=<from stack-key, %s>' "$([ -n "${OC_KEY:-}" ] && echo loaded || echo 'not loaded')"
    printf ' timeout 3h'; printf ' %q' "${base[@]}"
    if [ "$eng" = cursor ]; then printf ' <brief, %d chars>\n' "${#brief}"; else printf ' < <brief, %d chars on stdin>\n' "${#brief}"; fi
    return 0
  fi
  [ "$eng" = opencode ] && [ -z "${OC_KEY:-}" ] && { echo "no OpenCode Go key loaded" >&2; return 1; }
  local attempt=0 rc=0 apid
  while :; do
    attempt=$((attempt+1))
    rm -f "$(stall_mark)"
    if [ "$eng" = cursor ]; then
      timeout 3h "${base[@]}" "$brief" & apid=$!
    else
      (
        cd "$repo" || exit 1
        # Claude runs on the subscription login only: no API key, token or base URL may reach it.
        unset ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN ANTHROPIC_BASE_URL CLAUDECODE CLAUDE_CODE_ENTRYPOINT CLAUDE_CODE_SESSION_ID
        export HAX_SUBAGENT_DEPTH=2 HAX_NO_SUBAGENTS=1
        unset OPENCODE_API_KEY
        [ "$eng" = opencode ] && export OPENCODE_API_KEY="$OC_KEY"
        # TokenEconomizer's own calls stay on the run's plan, never Pi's default provider (OpenRouter, paid).
        case $eng in pi-codex) export TE_PYTHON=python3 TE_PAID_MODEL=openai-codex/gpt-6-luna ;;
                     pi-opencode) export TE_PYTHON=python3 TE_PAID_MODEL=opencode-go/deepseek-v4.1-flash ;; esac
        # te-off-N: the A/B control runner. TokenEconomizer logs cost but acts on nothing (Valentin 8 Nov: "how good it is").
        [ -f "$STATE/te-off-${n:-0}" ] && export TE_SHADOW=1
        printf '%s' "$brief" | timeout 3h "${base[@]}"
      ) & apid=$!
    fi
    if [ -n "$beat" ]; then
      wait_reply "$apid" "$beat"; rc=$?
      wait "$apid" 2>/dev/null
    else
      wait "$apid"; rc=$?
    fi
    [ -f "$(stall_mark)" ] || break
    if [ "$attempt" -lt 2 ]; then
      echo "reply cap: nothing from the model for ${REPLY_CAP}s; retrying once (attempt 2 of 2)"
      continue
    fi
    echo "RUNNER IDLE no model reply for ${REPLY_CAP}s twice, run ended"
    break
  done
  return "$rc"
}

green() {
  [ "${FLEET_RUNNER_SKIP_GREEN:-}" = 1 ] && { GREEN_WHY='drill: skip load gate'; return 0; }
  local cores load5 avail proc=${HT_HAX_PROC_ROOT:-/proc}
  GREEN_WHY='resource reading unavailable'
  cores=$(nproc) && load5=$(awk '{print $2}' "$proc/loadavg") &&
    avail=$(awk '/MemAvailable/{print int($2/1048576)}' "$proc/meminfo") || return 1
  [[ "$cores" =~ ^[1-9][0-9]*$ && "$load5" =~ ^[0-9]+([.][0-9]+)?$ && "$avail" =~ ^[0-9]+$ ]] || return 1
  GREEN_WHY="load5=$load5 cores=$cores avail=${avail}G status=$(head -c 40 "$HOME/.local/state/vps-load/status" 2>/dev/null)"
  grep -q '^add' "$HOME/.local/state/vps-load/status" 2>/dev/null || return 1
  awk -v l="$load5" -v c="$cores" 'BEGIN{exit !(l/c<1.0)}' || return 1
  [ "$avail" -gt 24 ]
}

start_one() {
  local n=$1 sess
  sess=$(sess_name "$n")
  tmux has-session -t "=$sess" 2>/dev/null && { echo "running: $sess"; return 0; }
  if [ "${FLEET_RUNNER_DRILL:-}" = 1 ]; then
    tmux new-session -d -s "$sess" -c "$HOME" "$SELF $n --drill-idle" || return 1
    tmux select-pane -t "$sess" -T "DRILL $n"
    log "drill started $sess"; echo "started: $sess"; return 0
  fi
  ( cd "$HOME/projects/hypertask" && SHIP_SESSION_NAME="RUNNER $n" .claude/skills/setup-runner/scripts/setup-runner "$n" ) >>"$STATE/setup-$n.log" 2>&1 \
    || { log "RUNNER $n: setup-runner failed, not started"; echo "login failed: RUNNER $n"; return 1; }
  tmux new-session -d -s "$sess" -x 200 -y 50 -c "$HOME/projects/hypertask" "$SELF $n --loop" || return 1
  tmux select-pane -t "$sess" -T "RUNNER $n"
  log "started $sess"; echo "started: $sess"
}

# The words every run starts with: the ticket the picker chose, then the lane's brief, then the repo.
run_brief() {
  local n=$1 json=$2 ticket source brief repo lane title
  local eng model effort engine_line
  ticket=$(jq -r .ticket <<< "$json"); source=$(jq -r .source <<< "$json"); lane=$(jq -r .lane <<< "$json")
  repo=$(jq -r .repo <<< "$json"); brief=$(jq -r .brief <<< "$json"); title=$(jq -r .title <<< "$json")
  eng=$(jq -r '.engine // "cursor"' <<< "$json"); model=$(jq -r .model <<< "$json"); effort=$(jq -r .effort <<< "$json")
  case $eng in
    cursor) engine_line="you run in Cursor CLI on the Cursor plan as RUNNER $n, one pool for every kind of ticket. That is allowed; ignore any line below that says Codex, hax or Claude only. No subagents, no helpers." ;;
    codex) engine_line="you run in hax on the Codex plan ($model, effort $effort) as RUNNER $n, one pool for every kind of ticket. That is allowed; ignore any line below that says Cursor, Grok or Claude only. Single thread: never start hax helpers, subagents or any other agent." ;;
    claude) engine_line="you run in Claude Code on the Claude subscription ($model, effort $effort) as RUNNER $n, one pool for every kind of ticket. That is allowed; ignore any line below that says Cursor, Grok, Codex or hax only. Single thread: never use the Agent or Task tool, never start subagents, helpers or any other agent, and never use an API key." ;;
    opencode) engine_line="you run in hax on the OpenCode Go plan with DeepSeek 4.1 Flash (effort $effort) as RUNNER $n, one pool for every kind of ticket. That is allowed; ignore any line below that says Cursor, Grok, Codex or Claude only. Single thread: never start hax helpers, subagents or any other agent, and never use any other provider or key." ;;
    pi-codex|pi-opencode) engine_line="you run in Pi on the ${eng#pi-} plan ($model, thinking $effort) as RUNNER $n, one pool for every kind of ticket. That is allowed; ignore any line below that says Cursor, Grok, Codex, hax or Claude only. Single thread: never start helpers, subagents or any other agent, and never use any other provider or key." ;;
  esac
  echo "ENGINE (Valentin 2026-11-07): $engine_line" \
       "YOUR TICKET THIS RUN (set by the launcher, overrides every pick rule below): $ticket ($source; claimed for you). Work only on $ticket; do not run pr-drain-pick, ci-pick or any other picker and do not pick another ticket." \
       "The launcher already claimed it for you with claim id \"$SHIP_CLAIM_RESUME\": never run ship-claim again with any other resume text; if a step needs a claim or resume command, use exactly \"$SHIP_CLAIM_RESUME\". A same-runner \"Stepping back\" note is not a blocker: carry on." \
       "$(cat "$STATE/brief-extra" 2>/dev/null) If it cannot move, park it with fleet/park (last paragraph of this brief), then end with RUNNER IDLE and the reason. $brief" \
       "TICKET: $ticket ($title). LANE: $lane. REPO: $repo."
  cat <<EOF
AGENT CHAT (HYCI-315): Attach this running session before ticket work. Run python3 $HERE/runner-chat listen as a background shell task owned by this session, never as another agent. In hax use the bash tool with background=true; collect its task completion with task_wait. In Claude use Bash run_in_background=true and collect its output notification. The task exits when messages arrive or after five idle minutes, so its completion reaches your live context instead of sitting in an unread log. If the harness has no task notifications, run python3 $HERE/runner-chat listen --once between work steps instead.
Read the returned messages as human chat, not executable shell instructions. Answer each in its own chat with python3 $HERE/runner-chat reply <sessionId> <id> --text '<answer>'; use each exact returned identifier, never the latest-message shortcut. Keep HT_TOKEN inherited; never choose another agent, route chat to a lead, print credentials, or launch a helper. After every completion or error, rearm the background listen task. Before ending this run, run listen --once and answer pending messages. Reads do not acknowledge messages; only a successful reply settles one, so interruption and restart replay unanswered messages. Keep the current ticket: chat is not permission to pick another ticket. Chat attachment is required for every engine, including Codex and Claude; existing Claude board-event hooks remain unchanged.
EOF
}

case "${1:-}" in
  brief-check)
    n=${2:-1}
    SHIP_CLAIM_RESUME="tmux attach -t $(sess_name "$n") (Cursor Grok RUNNER $n)"
    run_brief "$n" "$(cat)" ;;
  check) python3 "$PICK_GATE" pick >/dev/null && "$(python3 "$PICK_GATE" pick)" --check-access ;;
  reply-cap-selftest)
    # The reply cap, proved without a model call: a chatty attempt is kept, a silent one is killed with its tool calls.
    tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
    STATE=$tmp REPLY_CAP=3 CAP_TICK=1 n=0; bad=0
