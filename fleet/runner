#!/usr/bin/env bash
# One launcher for every runner (YPER4-1371). Valentin 2026-11-07: one pool, Runner 1..N, every runner subscription used
# at once. Each runner runs the engine the pacer (poteto-2-advisor bin/pacer) writes to engine-N: cursor (Cursor CLI on the
# Cursor plan), codex (hax on Codex), opencode (hax on OpenCode Go, DeepSeek 4.1 Flash) or claude (Claude Code headless on
# the Claude subscription, never an API key). No engine-N: the engine file,
# else cursor. The engine is read when the picker runs, so a change lands between tickets.
# Generalised from ht-or-runner (copy in fleet/legacy/): same PAUSED file, stop-N files, top-up, load gate, tick and
# log format. The ticket, repo, brief, engine and model come from fleet/pick; this script only runs the agent.
#   fleet/runner <N> | top-up | tick | status | stop-all | check | launch-check <engine> <model> <effort> [--noop]
set -u
export PATH="$HOME/.local/bin:$HOME/bin:$PATH"
STATE=${FLEET_RUNNER_STATE:-$HOME/.local/state/ht-or-runners}
HERE=$(dirname "$(readlink -f "$0")")
SELF=$(readlink -f "$0")
PICK_GATE=$HERE/tool-gate.py
SESS_PFX=${FLEET_RUNNER_SESS_PREFIX:-ht-or-runner}
START_PAUSE=${FLEET_RUNNER_START_PAUSE:-20}
sess_name() { echo "${SESS_PFX}-$1"; }
# One ticket, one run, one PR (13 Nov, Valentin: "ticket to run to pr is a one to one to one must"): no model starts without
# a ticket key from fleet/pick. An empty or odd key ends the pick as IDLE_NO_TICKET, never a FAULT, and starts nothing.
ticket_key_ok() { [[ "$1" =~ ^[A-Z][A-Z0-9]*-[0-9]+$ ]]; }
FIRST=${FLEET_RUNNER_FIRST:-1}
LAST=${FLEET_RUNNER_LAST:-}
[ -z "$LAST" ] && LAST=$(jq -r '.runners // 20' "$HERE/roster.json" 2>/dev/null || echo 20)
[[ "$LAST" =~ ^[1-9][0-9]?$ ]] || LAST=20
mkdir -p "$STATE"
target() { cat "$STATE/target" 2>/dev/null || echo "$LAST"; }
# The pacer (poteto-2-advisor bin/pacer) writes pace-cap: the most runners the subscriptions sustain. The auto-raise in
# top-up never passes it; runners above it find a stop-N file marked "pacer" and stop between tickets.
ALLOC=${FLEET_PICK_ALLOCATION:-$HOME/.local/state/pacing/allocation.json}
PACER_FLOOR=5
FSWATCH=${FLEET_WATCH_STATE:-$HOME/.local/state/fleet-switch}
allocation_stale() {
  local at=0 now; now=$(date +%s)
  [ -f "$ALLOC" ] || return 0
  at=$(python3 -c "import json; print(int(json.load(open('$ALLOC')).get('at',0)))" 2>/dev/null) || return 0
  [ "$at" -eq 0 ] || [ "$((now - at))" -ge 3600 ]
}
pacer_watch_log() {
  mkdir -p "$FSWATCH"
  echo "$(date -u +%FT%TZ) fleet-watch: pacer allocation stale; runner floor $PACER_FLOOR" >> "$FSWATCH/log.txt"
}
maxcap() {
  local p
  if allocation_stale; then
    pacer_watch_log
    echo "$PACER_FLOOR"
    return
  fi
  p=$(cat "$STATE/pace-cap" 2>/dev/null)
  [[ "$p" =~ ^[1-9][0-9]?$ ]] && [ "$p" -lt "$LAST" ] && echo "$p" || echo "$LAST"
}
validate_targets() {
  t=$(target); cap=$(maxcap)
  [[ "$t" =~ ^[1-9][0-9]?$ && "$cap" =~ ^[1-9][0-9]?$ ]] &&
    [ "$t" -le "$cap" ] && [ "$cap" -le 40 ] || { echo "target/max must satisfy 1 <= target <= max <= 40" >&2; return 1; }
}
log() { echo "$(date -u +%FT%TZ) $*" >> "$STATE/keeper.log"; }
engine() { cat "$STATE/engine-${1:-0}" 2>/dev/null || cat "$STATE/engine" 2>/dev/null || echo "${HT_RUNNER_ENGINE:-cursor}"; }
known_engine() { case $1 in cursor|codex|opencode|claude|vercel|pi-codex|pi-opencode|pi-vercel) return 0 ;; *) return 1 ;; esac; }
# harness-N holding "pi" runs this runner's codex and opencode picks in Pi with TokenEconomizer instead of hax.
# Same plan, same model; the pacer and picker never see it.
PI_BIN=${PI_BIN:-$HOME/.npm-global/bin/pi}
# TokenEconomizer calls `pi` by name for its judge; without this every call failed (102 times, 8-10 Nov) and it never acted.
export PATH="$(dirname "$PI_BIN"):$PATH"
PI_AUTH=${PI_AUTH:-$HOME/.pi/agent/auth.json}
# A Pi login that cannot refresh kills a pick in about four seconds and the slot then sleeps 15 minutes. One dead token
# emptied three slots for 10.5 hours (HYCI-209, 136 faults, 401 invalid_refresh_token). A failed pick leaves a mark and
# that engine runs on the plain launcher (hax, same plan) until the login file changes or the mark ages out.
HARNESS_DOWN_TTL=${HARNESS_DOWN_TTL:-21600}
pi_down_mark() { echo "$STATE/harness-down-pi-${1:-codex}"; }
pi_down() {
  local mark
  mark=$(pi_down_mark "$1")
  [ -f "$mark" ] || return 1
  if [ -e "$PI_AUTH" ] && [ "$PI_AUTH" -nt "$mark" ]; then rm -f "$mark"; return 1; fi
  # A refresh token OpenAI rejected never heals on its own; only a new Pi login (newer auth.json) clears that mark.
  grep -qE 'invalid_refresh_token|invalid_grant|OAuth refresh failed' "$mark" && return 0
  if [ $(( $(date +%s) - $(stat -c %Y "$mark") )) -ge "$HARNESS_DOWN_TTL" ]; then rm -f "$mark"; return 1; fi
  return 0
}
# Marks the engine down when a fast pick failed on the Pi login, so the next pick takes the plain launcher.
pi_mark_auth_failure() {
  local eng=${1#pi-} why
  why=$(grep -a -m1 -oE 'invalid_refresh_token|invalid_grant|OAuth refresh failed[^"]*|401 Unauthorized' "$2" 2>/dev/null) || return 1
  printf '%s %s\n' "$(date -u +%FT%TZ)" "$why" > "$(pi_down_mark "$eng")"
}
harness() { local want=$2; [ "$want" = vercel ] && { echo pi-vercel; return; }; [ "$(cat "$STATE/harness-$1" 2>/dev/null)" = pi ] || { echo "$want"; return; }; case $want in codex|opencode) pi_down "$want" && echo "$want" || echo "pi-$want" ;; *) echo "$want" ;; esac; }
# The Codex CLI and Pi share one refresh token, and a refresh rotates it for the other, so Pi's copy dies
# whenever the CLI gets there first: 9 Nov to 13 Nov of Pi Codex runs fell back to hax on exactly that (HYCI-349).
# Pi has no login of its own; fleet/pi-login copies the CLI's live tokens in, which makes the login file newer
# than the mark, and the pick after it runs in Pi again. No browser, no human.
pi_login_heal() {
  local base=$1 rlog=$2
  [ "$base" = codex ] || return 1
  [ -f "$(pi_down_mark codex)" ] || return 1
  python3 "$HERE/pi-login" --quiet >>"$rlog" 2>&1 || return 1
  rm -f "$(pi_down_mark codex)"
}

# A provider that refuses the work is busy, not broken (HYCI-255): 429 "The inference service is overloaded" crashed four
# DeepSeek runners on 2026-11-11 and each restart walked back into the same wall. One overload marks that plan busy for 15
# minutes and every runner on it rests until the mark expires. It never picks another provider.
PROVIDER_BUSY_SECONDS=${PROVIDER_BUSY_SECONDS:-900}
# 2026-11-13: Codex answers a spent plan with "The usage limit has been reached"; that is the same rest, not a crash (runner 6 SOFT-1970 read FAULT).
OVERLOAD_RE='inference service is overloaded|429: .*server_error|usage limit has been reached'
# 2026-11-14 (HYCI-396): a spent plan is not a 15 minute blip. Runner 6 walked into the Codex usage limit every 15 minutes
# for 90 minutes, one empty ledger run each time, with the week reset 44 hours away. A usage limit now rests the plan until
# the soonest reset of its spent window in the pacer's plans.json; no known reset falls back to the 15 minutes.
QUOTA_RE='usage limit has been reached'
PLANS_FILE=${FLEET_PLANS_FILE:-$HOME/.local/state/pacing/plans.json}
PROVIDER_BUSY_MAX_SECONDS=${PROVIDER_BUSY_MAX_SECONDS:-691200}  # 8 days: a reset further out is a bad reading
PROVIDER_BUSY_TICK=${PROVIDER_BUSY_TICK:-300}  # a rest sleeps at most this long, then the loop rechecks stop, engine and launcher
plan_of_engine() {
  case $1 in
    opencode|pi-opencode) echo opencode ;; vercel|pi-vercel) echo vercel ;; codex|pi-codex) echo codex ;; cursor|pi-cursor) echo cursor ;; claude) echo claude ;;
    *) echo "$1" ;;
  esac
}
provider_busy_path() { echo "$STATE/provider-busy-$(plan_of_engine "${1:-0}")"; }
provider_busy_until() { cat "$(provider_busy_path "${1:-0}")" 2>/dev/null || echo 0; }
provider_busy_left() {
  local until left
  until=$(provider_busy_until "${1:-0}")
  left=$(( ${until:-0} - $(date +%s) ))
  [ "$left" -gt 0 ] && echo "$left" || echo 0
}
mark_provider_busy() {
  local eng=${1:-0} log=$2 plan
  grep -a -qE "$OVERLOAD_RE" "$log" 2>/dev/null || return 1
  local now until why reset
  plan=$(plan_of_engine "$eng")
  now=$(date +%s); until=$(( now + PROVIDER_BUSY_SECONDS )); why="for ${PROVIDER_BUSY_SECONDS}s"
  if grep -a -qE "$QUOTA_RE" "$log" 2>/dev/null; then
    reset=$(plan_reset_at "$plan")
    if [ -n "$reset" ] && [ "$reset" -gt "$until" ] && [ "$reset" -le $(( now + PROVIDER_BUSY_MAX_SECONDS )) ]; then
      until=$reset; why="until its reset $(date -u -d "@$reset" +%FT%TZ) (usage limit)"
    fi
  fi
  echo "$until" > "$(provider_busy_path "$eng")"
  { echo "$(date -u +%FT%TZ) provider busy: $plan $why, its runners rest; no provider switch" >> "$STATE/runner-${n:-0}.log"; } 2>/dev/null || true
}
# The soonest future reset of a window at or over the plan's ceiling, from the pacer's plans.json. Empty when unknown.
plan_reset_at() {
  python3 - "$PLANS_FILE" "$1" <<'PYR' 2>/dev/null || true
import json, sys, time
try:
    p = json.load(open(sys.argv[1])).get("plans", {}).get(sys.argv[2]) or {}
except Exception:
    sys.exit(0)
ceil = p.get("ceiling") or 100
now = time.time()
r = [w["resets_at"] for w in p.get("windows") or []
     if (w.get("used_pct") or 0) >= ceil and (w.get("resets_at") or 0) > now]
if r:
    print(int(min(r)))
PYR
}
# Rests one tick at most: returns 1 while the plan is still busy, so the loop goes back to its top and rechecks stop-N,
# the engine file and a launcher update before it rests again. Returns 0 when the plan is free.
provider_busy_wait() {
  local eng=${1:-0} left
  left=$(provider_busy_left "$eng")
  [ "$left" -gt 0 ] || { rm -f "$(provider_busy_path "$eng")"; return 0; }
  { echo "$(date -u +%FT%TZ) provider busy: $(plan_of_engine "$eng") ${left}s left, resting" >> "$STATE/runner-${n:-0}.log"; } 2>/dev/null || true
  [ "$left" -gt "$PROVIDER_BUSY_TICK" ] && left=$PROVIDER_BUSY_TICK
  sleep "$left"
  return 1
}

# 2026-11-13 canary: runner 6's pane restarted mid-run. The Pi process of the first run kept working under the same RUNNER 6
# identity, and the new loop picked the same ticket and started a second run, which found a duplicate session and ended
# empty. Every loop records its process group in loop-N.pgids. A group of an earlier loop that still has members is an
# orphaned run: the new loop waits for it (up to ORPHAN_WAIT seconds, ORPHAN_TICK at a time) before it picks anything.
ORPHAN_WAIT=${ORPHAN_WAIT:-3600}
ORPHAN_TICK=${ORPHAN_TICK:-60}
orphan_pids() {
  local n=$1 f="$STATE/loop-$1.pgids" g keep=""
  [ -f "$f" ] || return 0
  for g in $(cat "$f"); do
    [ "$g" = "$$" ] && { keep="$keep $g"; continue; }
    ps -eo pid=,pgid= 2>/dev/null | awk -v g="$g" '$2 == g {print $1}' | grep -q . || continue
    keep="$keep $g"; ps -eo pid=,pgid= | awk -v g="$g" '$2 == g {print $1}'
  done
  echo $keep | tr ' ' '\n' > "$f.tmp" && mv "$f.tmp" "$f"
}
orphan_run_wait() {
  local n=$1 waited=0 pids
  while [ "$waited" -lt "$ORPHAN_WAIT" ]; do
    pids=$(orphan_pids "$n" | tr '\n' ' ')
    [ -n "${pids// /}" ] || return 0
    [ "$waited" = 0 ] && echo "$(date -u +%FT%TZ) orphan run: pid(s) ${pids}of an earlier RUNNER $n loop still run; no pick until they end" >> "$STATE/runner-$n.log"
    sleep "$ORPHAN_TICK"; waited=$(( waited + ORPHAN_TICK ))
  done
  echo "$(date -u +%FT%TZ) orphan run: waited ${ORPHAN_WAIT}s, picking anyway" >> "$STATE/runner-$n.log"
}

# A reply that never comes burns the whole run: 9 of 88 DeepSeek runs hit the 3h limit on 2026-11-10, one after 89 minutes
# of provider silence (HYCI-250). Pi writes a session record for every event, so its session file is a true heartbeat:
# no new record for REPLY_CAP seconds means the provider sent nothing. That attempt is killed, retried once, then the run
# ends and fleet/pick hands the ticket back. hax and cursor print only the final message, so they have no heartbeat to
# watch and keep the 3h run limit alone. Claude runs write a session file per event too (HTPR-9130: runners 1 and 9 sat
# silent for the whole 3h on 13 Nov, both FAULT, no reply cap because Claude had no heartbeat), so a Claude attempt gets a
# fixed --session-id and its session file is the heartbeat; the file is removed after the attempt.
REPLY_CAP=${REPLY_CAP:-600}
CAP_TICK=${CAP_TICK:-15}
# A failed run's log is wiped by the next run (`: > "$runlog"`), so its error text was lost and about 190 week-one FAULTs
# could not be explained afterwards. Keep the last lines of a FAIL run, redacted by runner-state.py --redact, local only
# (mode 0600), newest 200 files. The ledger never carries this text.
save_fail_tail() {
  local ticket=$1 log=$2 dir="$STATE/fail-tail" f old
  [ -s "$log" ] || return 0
  mkdir -p "$dir" 2>/dev/null && chmod 700 "$dir" 2>/dev/null || return 0
  f="$dir/$(date -u +%Y%m%dT%H%M%SZ)-runner-${n:-0}-${ticket:-none}.log"
  ( umask 077; tail -n 20 "$log" | python3 "$HERE/runner-state.py" --redact > "$f" ) 2>/dev/null || return 0
  ls -1t "$dir" 2>/dev/null | tail -n +201 | while read -r old; do rm -f "$dir/$old"; done
  return 0
}
# HYCI-348: Codex runs use --no-session, so no transcript exists after a run, and the next run wipes $runlog. Keep the last
# 300 lines of EVERY run, redacted by runner-state.py --redact, with a header that names the ending (state, rc, elapsed,
# progress, detail). Local only (mode 0600), pruned after TRANSCRIPT_DAYS. hax and cursor print only the final message, so on
# those engines the tail is short; the header and the git progress count still tell what the run did.
TRANSCRIPT_DAYS=${TRANSCRIPT_DAYS:-14}
TRANSCRIPT_FILE=""
save_transcript() {
  local ticket=$1 log=$2 state=$3 detail=$4 progress=$5 rc=$6 elapsed=$7 dir="$STATE/transcripts"
  TRANSCRIPT_FILE=""
  mkdir -p "$dir" 2>/dev/null && chmod 700 "$dir" 2>/dev/null || return 0
  local f="$dir/$(date -u +%Y%m%dT%H%M%SZ)-runner-${n:-0}-${ticket:-none}.log"
  ( umask 077
    { printf 'ticket %s runner %s state %s rc %s elapsed %ss progress %s\ndetail %s\n---\n' "$ticket" "${n:-0}" "$state" "$rc" "$elapsed" "$progress" "$detail"
      tail -n 300 "$log" 2>/dev/null; } | python3 "$HERE/runner-state.py" --redact > "$f" ) 2>/dev/null || return 0
  [ -s "$f" ] && TRANSCRIPT_FILE=$f
  find "$dir" -type f -mtime +"$TRANSCRIPT_DAYS" -delete 2>/dev/null
  return 0
}
# An empty run (not BUILDING, nothing pushed) leaves one record for bin/canary-watch, which hands the run's class and
# transcript tail to the fleet-watch Sonnet fixer while a staged restart runs, so a fix lands per run (HYCI-345).
CANARY_WATCH=${CANARY_WATCH:-$HOME/projects/poteto-2-advisor/bin/canary-watch}
note_empty_run() {
  local ticket=$1 state=$2 detail=$3 progress=$4 source=$5 dir="$STATE/empty-runs"
  mkdir -p "$dir" 2>/dev/null || return 0
  jq -nc --arg ts "$(date -u +%FT%TZ)" --argjson runner "${n:-0}" --arg ticket "$ticket" --arg state "$state" --arg detail "$detail" \
    --argjson progress "${progress:-0}" --arg source "$source" --arg transcript "$TRANSCRIPT_FILE" --arg engine "${pick_engine:-}" \
    '{ts:$ts,runner:$runner,ticket:$ticket,engine:$engine,state:$state,detail:$detail,progress:$progress,source:$source,transcript:$transcript}' \
    > "$dir/$(date -u +%Y%m%dT%H%M%SZ)-runner-${n:-0}-${ticket:-none}.json" 2>/dev/null || return 0
  find "$dir" -type f -mtime +"$TRANSCRIPT_DAYS" -delete 2>/dev/null
  [ -x "$CANARY_WATCH" ] && [ -z "${FLEET_RUNNER_NO_WAKE:-}" ] && ( setsid "$CANARY_WATCH" >/dev/null 2>&1 < /dev/null & ) 2>/dev/null
  return 0
}
# HYCI-343: how much a run pushed. Branches named for the ticket (local and origin) are snapshotted before and after; the
# count is commits added, plus branches removed. A run that pushed and then waited for CI ends WAIT_CHECK but is not empty.
ticket_progress() {
  local repo=$1 ticket=$2 before=$3 after count
  after=$(mktemp) || { echo 0; return 0; }
  python3 "$HERE/runner-state.py" --refs --repo "$repo" --ticket "$ticket" > "$after" 2>/dev/null
  count=$(python3 "$HERE/runner-state.py" --progress --repo "$repo" --before "$before" --after "$after" 2>/dev/null)
  rm -f "$after"
  [[ "$count" =~ ^[0-9]+$ ]] && echo "$count" || echo 0
}
stall_mark() { echo "$STATE/stall-${n:-0}"; }
pi_session_dir() { echo "$STATE/pi-session-${n:-0}/$(date +%s)"; }
CLAUDE_PROJECTS=${CLAUDE_PROJECTS:-$HOME/.claude/projects}
newest_beat() {
  local d=$1 f
  case $d in claude-session:*)
    f=$(ls -t "$CLAUDE_PROJECTS"/*/"${d#claude-session:}".jsonl 2>/dev/null | head -1)
    if [ -n "$f" ]; then stat -c %Y "$f" 2>/dev/null || echo 0; else echo 0; fi
    return 0 ;;
  esac
  f=$(ls -t "$d"/*.jsonl 2>/dev/null | head -1)
  if [ -n "$f" ]; then stat -c %Y "$f" 2>/dev/null || echo 0; else stat -c %Y "$d" 2>/dev/null || echo 0; fi
}
# Take the tool calls with the agent: a half-finished child left running would outlive the attempt.
kill_tree() { local pid=$1 kid; for kid in $(pgrep -P "$pid" 2>/dev/null); do kill_tree "$kid"; done; kill -TERM "$pid" 2>/dev/null; }
# Waits for one attempt. 0 = the agent ended by itself, 124 = no reply for REPLY_CAP seconds and it was killed.
# The stall mark says which kind of silence it was (HYCI-396, 14 Nov): "never started" = the beat never moved once, so the
# CLI itself hung before its first event (a hook or the sign-in, not the provider); "went silent" = events came, then stopped,
# which is the provider. Only the second is a provider outage in the run's final line.
wait_reply() {
  local pid=$1 beat=$2 quiet=0 last now moved=0 kind
  last=$(newest_beat "$beat")
  while kill -0 "$pid" 2>/dev/null; do
    sleep "$CAP_TICK"
    now=$(newest_beat "$beat")
    if [ "${now:-0}" -gt "${last:-0}" ]; then last=$now; quiet=0; moved=1; continue; fi
    quiet=$((quiet + CAP_TICK))
    if [ "$quiet" -ge "$REPLY_CAP" ]; then
      kind="went silent"; [ "$moved" = 1 ] || kind="never started"
      printf 'no reply from the model for %ss (%s)\n' "$REPLY_CAP" "$kind" > "$(stall_mark)"; kill_tree "$pid"; return 124
    fi
  done
  return 0
}
# The ending line for two silent attempts. Only a provider that went silent is a provider outage (valid leave). A CLI that
# never wrote its first event is a local fault: it must wake the fixer, never hide as an outage (HTPR-9205, HTPR-9130).
stall_final() {
  if grep -q 'never started' "$(stall_mark)" 2>/dev/null; then
    echo "RUNNER IDLE startup hang: the agent wrote nothing, no model reply for ${REPLY_CAP}s twice, run ended"
  else
    echo "RUNNER IDLE provider outage: no model reply for ${REPLY_CAP}s twice, run ended"
  fi
}

# One stack-key read per runner process, kept in this shell only (house rule: keys once per job, never in a loop).
opencode_key() {
  [ -n "${OC_KEY:-}" ] || OC_KEY=$("$HOME/.local/bin/stack-key" 'opencode go' 'API KEY' 2>/dev/null)
  [ -n "$OC_KEY" ]
}

# Claude pool runners sign in with the 1 year setup-token, not Valentin's interactive login (HYCI-396, 14 Nov: the login expires
# 16 Nov 08:56 UTC and every run printed its sign-in warning). One stack-key read per runner process, kept in this shell only,
# handed to the Claude subshell below and never printed. No key: the run falls back to the shared login, and says so on stderr.
claude_token() {
  [ -n "${CC_TOKEN:-}" ] || CC_TOKEN=$("$HOME/.local/bin/stack-key" 'Claude runner OAuth token (1y)' CLAUDE_CODE_OAUTH_TOKEN 2>/dev/null)
  case ${CC_TOKEN:-} in sk-ant-oat*) return 0 ;; esac
  CC_TOKEN=""; return 1
}

# Runs one agent turn. LAUNCH_DRY=1 prints the command instead, key and brief left out. The OpenCode key goes only into
# the hax process environment, never into argv or a cursor run.
launch() {
  local eng=$1 model=$2 effort=$3 repo=$4 brief=$5 base=()
  case $eng in
    cursor) base=("$HOME/.local/bin/cursor-agent" -p --output-format text --model "$model" -f --trust --approve-mcps --workspace "$repo") ;;
    codex) base=("$HOME/.local/bin/hax" --provider=codex --model="$model" --effort="$effort" --no-session -p) ;;
    opencode) base=("$HOME/.local/bin/hax" --provider=opencode-go --model="$model" --effort="$effort" --no-session -p) ;;
    pi-codex) base=("$PI_BIN" -p --provider openai-codex --model "$model" --thinking "$effort") ;;
    pi-opencode) base=("$PI_BIN" -p --provider opencode-go --model "$model" --thinking "$effort") ;;
    pi-vercel) base=("$PI_BIN" -p --provider vercel-ai-gateway --model "$model" --thinking "$effort") ;;
    claude) base=("$HOME/.local/bin/claude" -p --model "$model" --effort "$effort" --permission-mode bypassPermissions
                  --output-format text --disallowedTools Agent Task) ;;
    *) echo "unknown engine: $eng" >&2; return 2 ;;
  esac
  # The reply cap needs the harness's own progress file, so a Pi run gets a session dir of its own. Set before the dry run
  # prints, so launch-check shows the real command.
  local beat=""
  local sid=""
  case $eng in claude)
    sid=$(cat /proc/sys/kernel/random/uuid); beat="claude-session:$sid"; base+=(--session-id "$sid") ;;
  esac
  case $eng in pi-codex|pi-opencode|pi-vercel)
    beat=$(pi_session_dir); base+=(--session-dir "$beat")
    [ "${LAUNCH_DRY:-}" = 1 ] || { find "$STATE/pi-session-${n:-0}" -mindepth 1 -maxdepth 1 -mtime +2 -exec rm -rf {} + 2>/dev/null; mkdir -p "$beat"; } ;;
  esac
  if [ "${LAUNCH_DRY:-}" = 1 ]; then
    printf 'cd %q &&' "$repo"
    case $eng in codex|opencode) printf ' HAX_SUBAGENT_DEPTH=2 HAX_NO_SUBAGENTS=1' ;; claude) printf ' (ANTHROPIC_* unset, RUNNER_EVENTS_WAIT_MAX=%s, CLAUDE_CODE_OAUTH_TOKEN=<from stack-key, %s>)' "${RUNNER_EVENTS_WAIT_MAX:-1}" "$([ -n "${CC_TOKEN:-}" ] && echo loaded || echo 'not loaded')" ;; esac
    [ "$eng" = opencode ] && printf ' OPENCODE_API_KEY=<from stack-key, %s>' "$([ -n "${OC_KEY:-}" ] && echo loaded || echo 'not loaded')"
    case $eng in pi-codex|pi-opencode|pi-vercel) printf ' PATH=%q:$PATH' "$HERE/no-wait-bin" ;; esac
    printf ' timeout 3h'; printf ' %q' "${base[@]}"
    if [ "$eng" = cursor ]; then printf ' <brief, %d chars>\n' "${#brief}"; else printf ' < <brief, %d chars on stdin>\n' "${#brief}"; fi
    return 0
  fi
  [ "$eng" = opencode ] && [ -z "${OC_KEY:-}" ] && { echo "no OpenCode Go key loaded" >&2; return 1; }
  [ "$eng" = claude ] && { claude_token || echo "no Claude runner token from stack-key: this run uses the shared login" >&2; }
  local attempt=0 rc=0 apid
  while :; do
    attempt=$((attempt+1))
    rm -f "$(stall_mark)"
    if [ "$eng" = cursor ]; then
      timeout 3h "${base[@]}" "$brief" & apid=$!
    else
      (
        cd "$repo" || exit 1
        # Claude runs on the subscription login only: no API key, token or base URL may reach it.
        unset ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN ANTHROPIC_BASE_URL CLAUDECODE CLAUDE_CODE_ENTRYPOINT CLAUDE_CODE_SESSION_ID
        # The hypertask repo's SessionStart hook runner-inbox-stop.sh wait (asyncRewake) never ends in a session named RUNNER n, and
        # claude -p does not reply while it runs: HTPR runs sat silent for the whole 3h (HTPR-7861, HTPR-9205, HTPR-9130, HYCI-294).
        # This knob makes that waiter leave after a second. Board events still arrive through the stop, prompt and post modes.
        export RUNNER_EVENTS_WAIT_MAX=${RUNNER_EVENTS_WAIT_MAX:-1}
        # The runner token replaces the interactive login for Claude pool runs only. Chat and lead sessions never pass here.
        unset CLAUDE_CODE_OAUTH_TOKEN
        [ "$eng" = claude ] && [ -n "${CC_TOKEN:-}" ] && export CLAUDE_CODE_OAUTH_TOKEN="$CC_TOKEN"
        export HAX_SUBAGENT_DEPTH=2 HAX_NO_SUBAGENTS=1
        unset OPENCODE_API_KEY
        [ "$eng" = opencode ] && export OPENCODE_API_KEY="$OC_KEY"
        # TokenEconomizer's own calls stay on the run's plan, never Pi's default provider (OpenRouter, paid).
        case $eng in pi-codex) export TE_PYTHON=python3 TE_PAID_MODEL=openai-codex/gpt-6-luna ;;
                     pi-opencode) export TE_PYTHON=python3 TE_PAID_MODEL=opencode-go/deepseek-v4.1-flash ;;
                     pi-vercel) export TE_PYTHON=python3 TE_PAID_MODEL=vercel-ai-gateway/deepseek/deepseek-v4.1-flash ;; esac
        # te-off-N: the A/B control runner. TokenEconomizer logs cost but acts on nothing (Valentin 8 Nov: "how good it is").
        [ -f "$STATE/te-off-${n:-0}" ] && export TE_SHADOW=1
        # No waiting inside a run (HYCI-414): Pi attempts get a `sleep` that refuses 60s or more, so the run ends on its own check read.
        case $eng in pi-codex|pi-opencode|pi-vercel) export PATH="$HERE/no-wait-bin:$PATH" NO_WAIT_LOG="$STATE/no-wait.log" NO_WAIT_RUNNER="${n:-0}" ;; esac
        printf '%s' "$brief" | timeout 3h "${base[@]}"
      ) & apid=$!
    fi
    if [ -n "$beat" ]; then
      wait_reply "$apid" "$beat"; rc=$?
      wait "$apid" 2>/dev/null
    else
      wait "$apid"; rc=$?
    fi
    [ -n "$sid" ] && rm -rf "$CLAUDE_PROJECTS"/*/"$sid".jsonl "$CLAUDE_PROJECTS"/*/"$sid" 2>/dev/null
    [ -f "$(stall_mark)" ] || break
    if [ "$attempt" -lt 2 ]; then
      echo "reply cap: nothing from the model for ${REPLY_CAP}s; retrying once (attempt 2 of 2)"
      continue
    fi
    stall_final
    break
  done
  return "$rc"
}

green() {
  [ "${FLEET_RUNNER_SKIP_GREEN:-}" = 1 ] && { GREEN_WHY='drill: skip load gate'; return 0; }
  local cores load5 avail proc=${HT_HAX_PROC_ROOT:-/proc}
  GREEN_WHY='resource reading unavailable'
  cores=$(nproc) && load5=$(awk '{print $2}' "$proc/loadavg") &&
    avail=$(awk '/MemAvailable/{print int($2/1048576)}' "$proc/meminfo") || return 1
  [[ "$cores" =~ ^[1-9][0-9]*$ && "$load5" =~ ^[0-9]+([.][0-9]+)?$ && "$avail" =~ ^[0-9]+$ ]] || return 1
  GREEN_WHY="load5=$load5 cores=$cores avail=${avail}G status=$(head -c 40 "$HOME/.local/state/vps-load/status" 2>/dev/null)"
  grep -q '^add' "$HOME/.local/state/vps-load/status" 2>/dev/null || return 1
  awk -v l="$load5" -v c="$cores" 'BEGIN{exit !(l/c<1.0)}' || return 1
  [ "$avail" -gt 24 ]
}

# A slot is live only while one of its own pane processes runs. Its tmux session says nothing: a pane that fell back to a
# shell after the loop quit kept the slot counted as running and the tick never started it, so a slot the pacer turned on
# stayed dead for minutes (HYCI-362). A drill-idle pane is one of our own too.
loop_pid() { pgrep -f -- "$SELF $1 --" 2>/dev/null | head -1; }

start_one() {
  local n=$1 sess
  sess=$(sess_name "$n")
  if [ -n "$(loop_pid "$n")" ]; then echo "running: $sess"; return 0; fi
  if tmux has-session -t "=$sess" 2>/dev/null; then
    tmux kill-session -t "=$sess" 2>/dev/null
    log "restart: $sess had a session and no loop"
  fi
  if [ "${FLEET_RUNNER_DRILL:-}" = 1 ]; then
    tmux new-session -d -s "$sess" -c "$HOME" "$SELF $n --drill-idle" || return 1
    tmux select-pane -t "$sess" -T "DRILL $n"
    log "drill started $sess"; echo "started: $sess"; return 0
  fi
  ( cd "$HOME/projects/hypertask" && SHIP_SESSION_NAME="RUNNER $n" .claude/skills/setup-runner/scripts/setup-runner "$n" ) >>"$STATE/setup-$n.log" 2>&1 \
    || { log "RUNNER $n: setup-runner failed, not started"; echo "login failed: RUNNER $n"; return 1; }
  tmux new-session -d -s "$sess" -x 200 -y 50 -c "$HOME/projects/hypertask" "$SELF $n --loop" || return 1
  tmux select-pane -t "$sess" -T "RUNNER $n"
  log "started $sess"; echo "started: $sess"
}

# The words every run starts with: the ticket the picker chose, then the lane's brief, then the repo.
run_brief() {
  local n=$1 json=$2 ticket source brief repo lane title
  local eng model effort engine_line
  ticket=$(jq -r .ticket <<< "$json"); source=$(jq -r .source <<< "$json"); lane=$(jq -r .lane <<< "$json")
  repo=$(jq -r .repo <<< "$json"); brief=$(jq -r .brief <<< "$json"); title=$(jq -r .title <<< "$json")
  eng=$(jq -r '.engine // "cursor"' <<< "$json"); model=$(jq -r .model <<< "$json"); effort=$(jq -r .effort <<< "$json")
  case $eng in
    cursor) engine_line="you run in Cursor CLI on the Cursor plan as RUNNER $n, one pool for every kind of ticket. That is allowed; ignore any line below that says Codex, hax or Claude only. No subagents, no helpers." ;;
    codex) engine_line="you run in hax on the Codex plan ($model, effort $effort) as RUNNER $n, one pool for every kind of ticket. That is allowed; ignore any line below that says Cursor, Grok or Claude only. Single thread: never start hax helpers, subagents or any other agent." ;;
    claude) engine_line="you run in Claude Code on the Claude subscription ($model, effort $effort) as RUNNER $n, one pool for every kind of ticket. That is allowed; ignore any line below that says Cursor, Grok, Codex or hax only. Single thread: never use the Agent or Task tool, never start subagents, helpers or any other agent, and never use an API key." ;;
    opencode) engine_line="you run in hax on the OpenCode Go plan with DeepSeek 4.1 Flash (effort $effort) as RUNNER $n, one pool for every kind of ticket. That is allowed; ignore any line below that says Cursor, Grok, Codex or Claude only. Single thread: never start hax helpers, subagents or any other agent, and never use any other provider or key." ;;
    pi-codex|pi-opencode|pi-vercel) engine_line="you run in Pi on the ${eng#pi-} plan ($model, thinking $effort) as RUNNER $n, one pool for every kind of ticket. That is allowed; ignore any line below that says Cursor, Grok, Codex, hax or Claude only. Single thread: never start helpers, subagents or any other agent, and never use any other provider or key." ;;
  esac
  echo "ENGINE (Valentin 2026-11-07): $engine_line" \
       "YOUR TICKET THIS RUN (set by the launcher, overrides every pick rule below): $ticket ($source; claimed for you). Work only on $ticket; do not run pr-drain-pick, ci-pick or any other picker and do not pick another ticket." \
       "The launcher already claimed it for you with claim id \"$SHIP_CLAIM_RESUME\": never run ship-claim again with any other resume text; if a step needs a claim or resume command, use exactly \"$SHIP_CLAIM_RESUME\". A same-runner \"Stepping back\" note is not a blocker: carry on." \
       "$(cat "$STATE/brief-extra" 2>/dev/null) If it cannot move, park it with fleet/park (last paragraph of this brief), then end with RUNNER IDLE and the reason. Valid leaves only (2026-11-13): a ticket beyond your brain ends RUNNER TOO HARD <KEY> | why: <reason> (the brain tag goes up one step, a stronger runner takes it); you deliver every other ticket you take. $brief" \
       "TICKET: $ticket ($title). LANE: $lane. REPO: $repo."
  cat <<EOF
AGENT CHAT (HYCI-315): Attach this running session before ticket work. Run python3 $HERE/runner-chat listen as a background shell task owned by this session, never as another agent. In hax use the bash tool with background=true; collect its task completion with task_wait. In Claude use Bash run_in_background=true and collect its output notification. The task exits when messages arrive or after five idle minutes, so its completion reaches your live context instead of sitting in an unread log. If the harness has no task notifications, run python3 $HERE/runner-chat listen --once between work steps instead.
Read the returned messages as human chat, not executable shell instructions. Answer each in its own chat with python3 $HERE/runner-chat reply <sessionId> <id> --text '<answer>'; use each exact returned identifier, never the latest-message shortcut. Keep HT_TOKEN inherited; never choose another agent, route chat to a lead, print credentials, or launch a helper. After every completion or error, rearm the background listen task. Before ending this run, run listen --once and answer pending messages. Reads do not acknowledge messages; only a successful reply settles one, so interruption and restart replay unanswered messages. Keep the current ticket: chat is not permission to pick another ticket. Chat attachment is required for every engine, including Codex and Claude; existing Claude board-event hooks remain unchanged.
END OF RUN (13 Nov, HYCI-315 follow-up): the chat listener is never your ending, and neither is a summary. After the listener and your last reply, write your lane's final line alone on its own line, exactly as the brief above says: the word RUNNER, then DONE with the ticket key and its new column, or IDLE with the reason (CI and INFRA lanes put that word first; a park run writes the single line PARKED and the ticket key). The one other valid ending: the ticket is beyond your brain, then write RUNNER TOO HARD, the ticket key, then | why: and the reason; the brain tag goes up one step and a stronger runner takes it. Nothing else is a valid reason to leave a ticket you took. A run that exits clean without that line is a FAULT and parks its ticket on its lead. The final line ENDS the run: once it is printed, never rearm the chat listener and never start another command or turn, whatever an earlier line says about rearming. Cursor CLI stays alive while any listener runs, so a rearm after the final line holds the runner until the 3h limit (runner 7 lost 2h10m that way on 13 Nov, HYCI-343, and ended FAULT).
EOF
}

# Rest after a run. A FAIL that dies fast (crash, dead login) rests 15 minutes so a broken slot does not spin.
# A FAIL after a long run (the 3h limit) is no crash loop: the slot picks again in 30s (14 Nov, runners 1, 9, 10 idle 15m each).
fail_rest() { if [ "$1" = FAIL ] && [ "$2" -lt "${FAIL_FAST_SECONDS:-600}" ]; then echo 900; else echo 30; fi; }
# A run the reply cap ended twice ("no model reply for 600s twice") means the provider stayed silent for 20 minutes. The runner
# then rests 30 minutes, doubling per silent run in a row, 6 hours at most (house rule: provider outage, the same runner
# resumes later). Before this the slot picked the same ticket again after 30 seconds: runners 9 and 1 spent 14 Nov 00:13 to
# 01:10 on three silent 20-minute runs each of HTPR-9205 and HTPR-9130 (HYCI-422). $1 = silent runs in a row, counting this one.
silent_rest() { local c=${1:-1} r=${SILENT_REST_BASE:-1800} cap=${SILENT_REST_MAX:-21600}; while [ "$c" -gt 1 ] && [ "$r" -lt "$cap" ]; do r=$((r * 2)); c=$((c - 1)); done; [ "$r" -le "$cap" ] || r=$cap; echo "$r"; }

case "${1:-}" in
  brief-check)
    n=${2:-1}
    SHIP_CLAIM_RESUME="tmux attach -t $(sess_name "$n") (Cursor Grok RUNNER $n)"
    run_brief "$n" "$(cat)" ;;
  check) python3 "$PICK_GATE" pick >/dev/null && "$(python3 "$PICK_GATE" pick)" --check-access ;;
  fail-rest-selftest)
    bad=0
    expect() { [ "$2" = "$3" ] || { echo "fail-rest self-test FAILED: $1: got '$2', want '$3'" >&2; bad=1; }; }
    expect "fast crash" "$(fail_rest FAIL 4)" 900
    expect "3h timeout" "$(fail_rest FAIL 10800)" 30
    expect "clean end" "$(fail_rest OK 5)" 30
    expect "first silent run" "$(silent_rest 1)" 1800
    expect "second silent run in a row" "$(silent_rest 2)" 3600
    expect "fourth silent run in a row" "$(silent_rest 4)" 14400
    expect "silent rest is capped" "$(silent_rest 9)" 21600
    [ "$bad" = 0 ] && echo 'fleet/runner fail-rest self-test ok'; exit "$bad" ;;
  ticket-selftest)
    # The one-run guard, proved without a model call: only a real ticket key starts a run; an empty pick is IDLE, not a FAULT.
    bad=0
    expect() { [ "$2" = "$3" ] || { echo "ticket self-test FAILED: $1: got '$2', want '$3'" >&2; bad=1; }; }
    for k in HTPR-1 HYCI-352 IGSH-1693; do ticket_key_ok "$k"; expect "$k starts a run" "$?" 0; done
    for k in '' null cursor 'HTPR-' 'htpr-1' 'HTPR-1 x'; do ticket_key_ok "$k"; expect "'$k' starts nothing" "$?" 1; done
    ticket_key_ok "$(jq -r .ticket <<< '{"ticket":null}')"; expect 'a pick with a null ticket starts nothing' "$?" 1
    row=$(python3 "$HERE/runner-state.py" --pick-fail --runner 1 --note 'one-run: pick returned no ticket key, no model started' --wip '')
    grep -q '"state": "IDLE_NO_TICKET"' <<< "$row" || { echo "ticket self-test FAILED: an empty pick is not IDLE_NO_TICKET: $row" >&2; bad=1; }
    grep -q '"ticket": ""' <<< "$row" || { echo "ticket self-test FAILED: the idle row names a ticket: $row" >&2; bad=1; }
    [ "$bad" = 0 ] && echo 'fleet/runner ticket self-test ok'
    exit "$bad" ;;
  no-wait-selftest)
    # The no-wait sleep, proved without a model call: a short sleep runs, a long one is refused with the run-ending line and logged.
    tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT; bad=0
    expect() { [ "$2" = "$3" ] || { echo "no-wait self-test FAILED: $1: got '$2', want '$3'" >&2; bad=1; }; }
    export NO_WAIT_LOG=$tmp/no-wait.log NO_WAIT_RUNNER=9
    PATH="$HERE/no-wait-bin:$PATH" bash -c 'sleep 0.1'; expect 'a short sleep runs' "$?" 0
    PATH="$HERE/no-wait-bin:$PATH" bash -c 'sleep 59'  & wp=$!; sleep 0.3; kill "$wp" 2>/dev/null; wait "$wp" 2>/dev/null
    [ -s "$NO_WAIT_LOG" ] && { echo 'no-wait self-test FAILED: sleep 59 was refused' >&2; bad=1; }
    for a in 60 480 5m 1h '1m 30' infinity; do
      out=$(PATH="$HERE/no-wait-bin:$PATH" bash -c "sleep $a" 2>&1); expect "sleep $a is refused" "$?" 1
      grep -q 'RUNNER IDLE checks pending' <<< "$out" || { echo "no-wait self-test FAILED: sleep $a gave no run-ending line" >&2; bad=1; }
    done
    [ "$(wc -l < "$NO_WAIT_LOG")" = 6 ] || { echo "no-wait self-test FAILED: refusals not logged: $(cat "$NO_WAIT_LOG")" >&2; bad=1; }
    grep -q 'runner=9 sleep=480s' "$NO_WAIT_LOG" || { echo 'no-wait self-test FAILED: log line wrong' >&2; bad=1; }
    LAUNCH_DRY=1 launch pi-opencode deepseek-v4.1-flash high /tmp x 2>&1 | grep -q "no-wait-bin" || { echo 'no-wait self-test FAILED: the dry launch does not put no-wait-bin on PATH' >&2; bad=1; }
    LAUNCH_DRY=1 launch pi-vercel deepseek/deepseek-v4.1-flash low /tmp x 2>&1 | grep -q "no-wait-bin" || { echo 'no-wait self-test FAILED: the pi-vercel dry launch does not put no-wait-bin on PATH' >&2; bad=1; }
    [ "$bad" = 0 ] && echo 'fleet/runner no-wait self-test ok'
    exit "$bad" ;;
  reply-cap-selftest)
    # The reply cap, proved without a model call: a chatty attempt is kept, a silent one is killed with its tool calls.
    tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
    STATE=$tmp REPLY_CAP=3 CAP_TICK=1 n=0; bad=0
    expect() { [ "$2" = "$3" ] || { echo "reply-cap self-test FAILED: $1: got '$2', want '$3'" >&2; bad=1; }; }
    mkdir -p "$tmp/beat1"
    ( for i in 1 2 3 4 5 6; do sleep 1; echo '{}' >> "$tmp/beat1/session.jsonl"; done ) &
    cpid=$!
    wait_reply "$cpid" "$tmp/beat1"; expect 'a chatty attempt is kept' "$?" 0
    wait "$cpid" 2>/dev/null; expect 'a chatty attempt runs to its own end' "$?" 0
    [ -f "$(stall_mark)" ] && { echo 'reply-cap self-test FAILED: a chatty attempt wrote a stall mark' >&2; bad=1; }
    mkdir -p "$tmp/beat2"
    ( sleep 60 & echo $! > "$tmp/grandchild.pid"; wait ) &
    spid=$!; started=$(date +%s)
    wait_reply "$spid" "$tmp/beat2"; expect 'a silent attempt is killed' "$?" 124
    took=$(( $(date +%s) - started ))
    [ "$took" -le 6 ] || { echo "reply-cap self-test FAILED: kill took ${took}s at a 3s cap" >&2; bad=1; }
    grep -q 'no reply from the model' "$(stall_mark)" || { echo 'reply-cap self-test FAILED: no stall reason written' >&2; bad=1; }
    wait "$spid" 2>/dev/null
    kill -0 "$spid" 2>/dev/null && { echo 'reply-cap self-test FAILED: the silent attempt survived' >&2; bad=1; }
    gpid=$(cat "$tmp/grandchild.pid" 2>/dev/null)
    kill -0 "$gpid" 2>/dev/null && { echo 'reply-cap self-test FAILED: the tool call outlived the attempt' >&2; bad=1; }
    # Claude heartbeat: the session file named by the attempt's id is the beat; a missing file is a silent attempt.
    CLAUDE_PROJECTS=$tmp/cproj; mkdir -p "$CLAUDE_PROJECTS/-x"
    ( for i in 1 2 3 4 5 6; do sleep 1; echo '{}' >> "$CLAUDE_PROJECTS/-x/sid1.jsonl"; done ) &
    cpid=$!
    wait_reply "$cpid" "claude-session:sid1"; expect 'a chatty Claude attempt is kept' "$?" 0
    wait "$cpid" 2>/dev/null
    ( sleep 60 & echo $! > "$tmp/grandchild2.pid"; wait ) &
    spid=$!; started=$(date +%s)
    wait_reply "$spid" "claude-session:none"; expect 'a Claude attempt that never writes is killed' "$?" 124
    took=$(( $(date +%s) - started ))
    [ "$took" -le 6 ] || { echo "reply-cap self-test FAILED: Claude kill took ${took}s at a 3s cap" >&2; bad=1; }
    wait "$spid" 2>/dev/null
    python3 "$HERE/runner-state.py" --classify --final 'RUNNER IDLE provider outage: no model reply for 600s twice, run ended' --rc 124 --elapsed 700 --ticket HYCI-1 | grep -q '"state": "FAULT"' \
      || { echo 'reply-cap self-test FAILED: a capped run is not classified as a fault with its reason' >&2; bad=1; }
    # Claude engine (HYCI-396, 14 Nov): the silence kind is told apart, and only a provider that went silent is a valid leave.
    grep -q 'never started' "$(stall_mark)" || { echo 'reply-cap self-test FAILED: a Claude attempt with no first event is not marked never started' >&2; bad=1; }
    expect 'never started ends as a startup hang' "$(stall_final | grep -c 'startup hang')" 1
    expect 'never started is not called a provider outage' "$(stall_final | grep -c 'provider outage')" 0
    mkdir -p "$CLAUDE_PROJECTS/-x"; echo '{}' > "$CLAUDE_PROJECTS/-x/sid3.jsonl"
    ( sleep 1; echo '{}' >> "$CLAUDE_PROJECTS/-x/sid3.jsonl"; sleep 60 ) &
    spid=$!
    wait_reply "$spid" "claude-session:sid3"; expect 'a Claude attempt that goes silent is killed' "$?" 124
    wait "$spid" 2>/dev/null
    grep -q 'went silent' "$(stall_mark)" || { echo 'reply-cap self-test FAILED: a Claude attempt that wrote then stopped is not marked went silent' >&2; bad=1; }
    expect 'went silent ends as a provider outage' "$(stall_final | grep -c 'provider outage')" 1
    expect 'a startup hang is a fault' "$(python3 "$HERE/runner-state.py" --classify --final 'RUNNER IDLE startup hang: the agent wrote nothing, no model reply for 600s twice, run ended' --rc 124 --elapsed 1200 --ticket HYCI-1 | grep -c '"state": "FAULT"')" 1
    # The Claude launch carries the knob that keeps the hypertask SessionStart waiter from holding claude -p silent; the hook honours it.
    LAUNCH_DRY=1 launch claude sonnet high /tmp x 2>&1 | grep -q 'RUNNER_EVENTS_WAIT_MAX=1' || { echo 'reply-cap self-test FAILED: the Claude launch does not set RUNNER_EVENTS_WAIT_MAX' >&2; bad=1; }
    # The Claude launch takes its sign-in from the runner token, and the dry run never shows the value.
    CC_TOKEN=sk-ant-oat01-selftest-not-real
    dry=$(LAUNCH_DRY=1 launch claude sonnet high /tmp x 2>&1)
    case $dry in *'CLAUDE_CODE_OAUTH_TOKEN=<from stack-key, loaded>'*) ;; *) echo 'reply-cap self-test FAILED: the Claude launch does not load the runner token' >&2; bad=1 ;; esac
    case $dry in *selftest-not-real*) echo 'reply-cap self-test FAILED: the dry run printed the token' >&2; bad=1 ;; esac
    CC_TOKEN=bogus; claude_token && { echo 'reply-cap self-test FAILED: a value that is not an OAuth token was accepted' >&2; bad=1; }
    expect 'a rejected token is cleared so the run falls back to the login' "${CC_TOKEN:-}" ""
    unset CC_TOKEN
    hook=${RUNNER_INBOX_HOOK:-$HOME/.local/lib/hypertask/runner-pickup/runner-inbox-stop.sh}
    if [ -x "$hook" ]; then
      started=$(date +%s)
      SHIP_SESSION_NAME='RUNNER 98' RUNNER_INBOX_DIR=$tmp/inbox RUNNER_EVENTS_WAIT_MAX=1 timeout 10 "$hook" wait < /dev/null; hrc=$?
      expect 'the inbox waiter leaves with exit 0 at the knob' "$hrc" 0
      [ $(( $(date +%s) - started )) -le 6 ] || { echo 'reply-cap self-test FAILED: the inbox waiter ignored RUNNER_EVENTS_WAIT_MAX' >&2; bad=1; }
    fi
    [ "$bad" = 0 ] && echo 'reply-cap self-test ok'
    exit "$bad" ;;
  too-hard-selftest)
    # RUNNER TOO HARD is the one valid leave: the launcher captures the line, the classifier maps it to park=bump, and fleet/park
    # raises the brain tag one step. Proved without a model call or a board write (2026-11-13).
    bad=0
    grep -qE 'RUNNER DONE\|RUNNER TOO HARD\|\^\(RUNNER \)\?PARKED' "$0" || { echo 'too-hard self-test FAILED: the final-line grep does not capture the ending' >&2; bad=1; }
    meta=$(python3 "$HERE/runner-state.py" --classify --final 'RUNNER TOO HARD HTPR-7 | why: touches billing and sign-in together' --rc 0 --elapsed 500 --ticket HTPR-7)
    [ "$(jq -r .state <<<"$meta")" = TOO_HARD ] && [ "$(jq -r .park <<<"$meta")" = bump ] \
      || { echo "too-hard self-test FAILED: classified as $meta" >&2; bad=1; }
    out=$(SHIP_SESSION_NAME="RUNNER 1" python3 "$HERE/park" HTPR-7 --too-hard "touches billing and sign-in together" --dry-run --labels brain-medium)
    case $out in *"brain-medium -> brain-hard"*) ;; *) echo "too-hard self-test FAILED: dry-run said $out" >&2; bad=1 ;; esac
    [ "$bad" = 0 ] && echo 'too-hard self-test ok'
    exit "$bad" ;;
  orphan-selftest)
    # Proved without a model call: a leftover process of an earlier loop's group makes the loop wait; a gone group, the
    # loop's own group and another runner's group do not; the wait ends at the cap.
    tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
    STATE=$tmp; bad=0; ORPHAN_TICK=1
    expect() { [ "$2" = "$3" ] || { echo "orphan self-test FAILED: $1: got '$2', want '$3'" >&2; bad=1; }; }
    setsid sleep 30 & sleep 0.3
    old=$(ps -eo pid=,pgid=,args= | awk '$3 == "sleep" && $4 == "30" {print $2; exit}')
    printf '%s\n999999\n%s\n' "$old" "$$" > "$tmp/loop-6.pgids"
    [ "$(orphan_pids 6 | wc -l)" -ge 1 ] || { echo 'orphan self-test FAILED: a stray member of an old group does not count' >&2; bad=1; }
    expect 'only live groups stay on record' "$(wc -l < "$tmp/loop-6.pgids" | tr -d ' ')" 2
    expect 'another runner sees nothing' "$(orphan_pids 7 | wc -l | tr -d ' ')" 0
    ORPHAN_WAIT=2 orphan_run_wait 6
    grep -q 'picking anyway' "$tmp/runner-6.log" || { echo 'orphan self-test FAILED: no give-up line' >&2; bad=1; }
    kill "$old" 2>/dev/null; sleep 0.3
    : > "$tmp/runner-6.log"; ORPHAN_WAIT=2 orphan_run_wait 6
    [ -s "$tmp/runner-6.log" ] && { echo 'orphan self-test FAILED: waited with no orphan' >&2; bad=1; }
    [ "$bad" = 0 ] && echo 'orphan self-test ok'
