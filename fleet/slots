#!/usr/bin/env python3
import argparse
from dataclasses import dataclass
import fcntl
import json
from math import floor
import os
from pathlib import Path
import re
import sys
import time

CAP = 10
DEFAULT_CAP = 2  # Projects without a cap in roster.json (Valentin 2026-11-17: others 3 or lower).
BUSY_TARGET = 0.75
BUSY_MAX = 0.85
CORES_PER_WORKER = 0.5  # CPU allowance while a worker builds.
MEM_MIN_GB = 8
PER_WORKER_GB = 1.0  # Worker and its tools.
RESERVATION_SECONDS = 120
CLAUDE_MATCHER = re.compile(r"(?:^|/)(?:claude|@anthropic-ai/claude-code/cli\.js)$")
WORKER_MATCHERS = (
    (re.compile(r"(?:^|/)codex(?:\.js)?$"), ("exec",)),
    (CLAUDE_MATCHER, ("-p", "--print")),
    (re.compile(r"(?:^|/)hax$"), ("-p",)),
    (re.compile(r"(?:^|/)cursor-agent$"), ()),
    (re.compile(r"(?:^|/)(?:pi|pi-coding-agent/(?:dist/)?cli\.js)$"), ()),
)


@dataclass(frozen=True)
class Box:
    busy: float
    cores: int
    mem_avail_gb: float
    fleet_workers: int


def is_worker(argv, pid=None, chat_pids=()):
    if not argv:
        return False
    executable = argv[0]
    args = argv[1:]
    if Path(executable).name in ("node", "nodejs") and args:
        executable, *args = args
    if CLAUDE_MATCHER.search(executable):
        stream_input = any(
            arg == "--input-format=stream-json"
            or (arg == "--input-format" and args[i + 1:i + 2] == ["stream-json"])
            for i, arg in enumerate(args)
        )
        if stream_input or pid in chat_pids:
            return False
    flags = {arg.split("=", 1)[0] for arg in args}
    return any(pattern.search(executable)
               and (not required or any(arg in flags for arg in required))
               for pattern, required in WORKER_MATCHERS)


def fleet_workers():
    chat_pids = set()
    for session in (Path.home() / ".claude/sessions").glob("*.json"):
        try:
            data = json.loads(session.read_text())
        except (OSError, ValueError):
            continue
        if isinstance(data, dict) and isinstance(data.get("pid"), int):
            chat_pids.add(data["pid"])
    workers = 0
    for process in Path("/proc").iterdir():
        if not process.name.isdigit():
            continue
        try:
            argv = process.joinpath("cmdline").read_bytes().decode(errors="replace").rstrip("\0").split("\0")
        except OSError:
            continue
        workers += is_worker(argv, int(process.name), chat_pids)
    return workers


def box():
    with open("/proc/stat") as f:
        before = list(map(int, f.readline().split()[1:9]))
    time.sleep(1)
    with open("/proc/stat") as f:
        after = list(map(int, f.readline().split()[1:9]))
    delta = [end - start for start, end in zip(before, after)]
    total = sum(delta)
    busy = 1 - (delta[3] + delta[4]) / total if total else 0.0
    with open("/proc/meminfo") as f:
        mem = {k: int(v.split()[0]) for k, v in (line.split(":", 1) for line in f)}
    return Box(busy, os.cpu_count() or 1, mem["MemAvailable"] / 1_048_576, fleet_workers())


def decide(running, ready, box, cap=CAP, reservations=0):
    cap = min(cap, CAP)
    room = cap - running
    if room <= 0:
        return 0, f"at the cap of {cap}"
    if ready <= 0:
        return 0, "no ready ticket: board empty, blocked, or waiting on a person"
    if box.busy >= BUSY_MAX:
        return 0, f"CPU full (busy {box.busy:.0%})"
    cpu_slots = max(0, floor((BUSY_TARGET - box.busy) * box.cores / CORES_PER_WORKER) - reservations)
    mem_slots = max(0, floor((box.mem_avail_gb - MEM_MIN_GB) / PER_WORKER_GB) - reservations)
    fleet_max = box.cores * 2
    workers = box.fleet_workers + reservations
    fleet_slots = max(0, fleet_max - workers)
    memory_reason = (f"memory low ({box.mem_avail_gb:.0f} GB free, min {MEM_MIN_GB})"
                     if box.mem_avail_gb < MEM_MIN_GB else f"memory allows {mem_slots}")
    limits = (
        (room, ""),
        (ready, f"only {ready} ready ticket(s)"),
        (cpu_slots, f"CPU allows {cpu_slots} (busy {box.busy:.0%})"),
        (mem_slots, memory_reason),
        (fleet_slots, f"server holds {workers} workers (max {fleet_max})"),
    )
    return min(limits, key=lambda limit: limit[0])


def reserve(running, ready, cap=CAP, state_dir=None, project=None):
    state_dir = Path(state_dir) if state_dir is not None else Path.home() / ".cache/slots"
    state_dir.mkdir(parents=True, exist_ok=True)
    with (state_dir / "lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        snapshot = box()
        now = time.time()
        reservations_file = state_dir / "reservations"
        try:
            reservations = [float(epoch) for epoch in reservations_file.read_text().splitlines()]
        except FileNotFoundError:
            reservations = []
        reservations = [epoch for epoch in reservations if now - epoch < RESERVATION_SECONDS]
        projects_file = state_dir / "projects.json"
        try:
            projects = json.loads(projects_file.read_text())
        except FileNotFoundError:
            projects = {}
        projects = {name: state for name, state in projects.items()
                    if now - state["seen"] < RESERVATION_SECONDS}
        own_pending = []
        if project is not None:
            own_pending = [epoch for epoch in projects.get(project, {}).get("pending", [])
                           if now - epoch < RESERVATION_SECONDS]
            projects[project] = {"running": running, "cap": min(cap, CAP), "ready": ready,
                                 "seen": now, "pending": own_pending}
        k, why = decide(running + len(own_pending), ready, snapshot, cap, len(reservations))
        if project is not None and ready > 0 and running + len(own_pending) < min(cap, CAP):
            rows = json.loads(Path(__file__).with_name("roster.json").read_text())["rows"]
            priorities = {row["name"]: row.get("priority", 3) for row in rows}
            higher = sorted((name for name in priorities
                             if priorities[name] < priorities.get(project, 3)),
                            key=lambda name: priorities[name])
            cpu_slots = max(0, floor((BUSY_TARGET - snapshot.busy) * snapshot.cores
                                     / CORES_PER_WORKER) - len(reservations))
            for name in higher:
                if name not in projects:
                    continue
                state = projects[name]
                pending = sum(now - epoch < RESERVATION_SECONDS
                              for epoch in state.get("pending", []))
                deficit = max(0, min(state.get("cap", CAP) - state.get("running", 0), state.get("ready", CAP)) - pending)
                if deficit and cpu_slots < deficit + k:
                    k, why = 0, f"held for {name}"
                    break
                cpu_slots -= deficit
            own_pending.extend([now] * k)
        reservations.extend([now] * k)
        projects_file.write_text(json.dumps(projects))
        reservations_file.write_text("".join(f"{epoch}\n" for epoch in reservations))
        return snapshot, k, why


def self_test():
    from contextlib import redirect_stdout
    from io import StringIO
    from tempfile import TemporaryDirectory
    from unittest.mock import Mock, patch

    idle = Box(0.0, 18, 70, 0)
    assert decide(0, 20, idle) == (10, "")
    assert decide(4, 20, idle) == (6, "")
    assert decide(10, 5, idle) == (0, "at the cap of 10")
    assert decide(2, 3, idle) == (3, "only 3 ready ticket(s)")
    assert decide(2, 0, idle) == (0, "no ready ticket: board empty, blocked, or waiting on a person")
    assert decide(0, 20, Box(0.60, 18, 70, 0)) == (5, "CPU allows 5 (busy 60%)")
    assert decide(0, 20, Box(0.80, 18, 70, 0)) == (0, "CPU allows 0 (busy 80%)")
    assert decide(0, 20, Box(0.85, 18, 70, 0)) == (0, "CPU full (busy 85%)")
    assert decide(0, 20, Box(0.91, 18, 70, 0)) == (0, "CPU full (busy 91%)")
    assert decide(0, 20, Box(0.0, 18, 70, 36)) == (0, "server holds 36 workers (max 36)")
    assert decide(0, 20, Box(0.0, 18, 70, 40)) == (0, "server holds 40 workers (max 36)")
    assert decide(0, 20, Box(0.0, 18, 70, 33)) == (3, "server holds 33 workers (max 36)")
    assert decide(0, 20, Box(0.0, 18, 5, 0)) == (0, "memory low (5 GB free, min 8)")
    assert decide(0, 20, Box(0.0, 18, 8, 0)) == (0, "memory allows 0")
    assert decide(0, 20, Box(0.0, 18, 8.5, 0)) == (0, "memory allows 0")
    assert decide(0, 20, Box(0.0, 18, 12, 0)) == (4, "memory allows 4")
    assert decide(1, 20, idle, cap=3) == (2, "")
    assert decide(0, 20, idle, cap=50) == (10, "")
    for argv in (
        ["/usr/bin/codex", "exec", "task"],
        ["node", "/opt/codex/bin/codex.js", "exec", "task"],
        ["claude", "--print", "task"],
        ["/home/valentin/.local/bin/claude", "-p", "--model", "opus", "--effort", "high",
         "--permission-mode", "bypassPermissions", "--output-format", "text",
         "--disallowedTools", "Agent", "Task", "--session-id", "worker-id"],
        ["claude", "--print", "--session-id", "worker-id"],
        ["claude", "--print", "--session-id=worker-id"],
        ["claude", "--print", "--resume", "worker-id"],
        ["claude", "--print", "--resume=worker-id"],
        ["node", "/opt/@anthropic-ai/claude-code/cli.js", "--print", "task"],
        ["node", "/opt/@anthropic-ai/claude-code/cli.js", "-p", "--session-id", "worker-id"],
        ["/home/valentin/.local/bin/hax", "--provider=codex", "--model=gpt-6.1-sol",
         "--effort=high", "--no-session", "-p"],
        ["/home/valentin/.local/bin/hax", "--provider=opencode-go", "--model=glm-5",
         "--effort=high", "--no-session", "-p"],
        ["cursor-agent", "-p", "task"],
        ["pi", "--print", "task"],
    ):
        assert is_worker(argv), argv
    for argv in (
        [], ["codex"], ["claude"],
        ["claude", "--session-id", "chat"],
        ["claude", "--resume", "chat"],
        ["claude", "--print", "--input-format", "stream-json"],
        ["claude", "-p", "--input-format=stream-json"],
        ["node", "/opt/@anthropic-ai/claude-code/cli.js", "--print",
         "--input-format", "stream-json"],
        ["node", "/opt/@anthropic-ai/claude-code/cli.js", "-p",
         "--input-format=stream-json"],
        ["hax", "--provider=codex"],
        ["python3", "fleet/slots", "--running", "0", "--ready", "10"],
        ["fleet/slots", "--running", "0", "--ready", "10"],
        ["bash", "-c", "codex exec task"],
        ["python3", "task.py", "cursor-agent"],
        ["pi-server", "--print"],
    ):
        assert not is_worker(argv), argv
    with TemporaryDirectory() as fixture_dir:
        fixture = Path(fixture_dir)
        sessions = fixture / ".claude/sessions"
        sessions.mkdir(parents=True)
        (sessions / "chat.json").write_text(json.dumps({"pid": 101}))
        (sessions / "broken.json").write_text("{")
        (sessions / "empty.json").write_text("[]")
        processes = []
        for pid, argv in (
            (101, ["claude", "--print", "task"]),
            (102, ["claude", "-p", "task"]),
            (103, ["claude", "--print", "--input-format", "stream-json"]),
            (104, ["claude", "--print", "--input-format=stream-json"]),
            (105, ["node", "/opt/@anthropic-ai/claude-code/cli.js", "-p", "task"]),
            (106, ["codex", "exec", "task"]),
        ):
            process = fixture / str(pid)
            process.mkdir()
            (process / "cmdline").write_bytes("\0".join(argv).encode() + b"\0")
            processes.append(process)
        with patch.object(Path, "home", return_value=fixture):
            with patch.object(Path, "iterdir", return_value=iter(processes)):
                assert fleet_workers() == 3
            (sessions / "node-chat.json").write_text(json.dumps({"pid": 105}))
            (sessions / "non-claude.json").write_text(json.dumps({"pid": 106}))
            with patch.object(Path, "iterdir", return_value=iter(processes)):
                assert fleet_workers() == 2
    with TemporaryDirectory() as state_dir:
        with patch.dict(globals(), box=Mock(return_value=Box(0.0, 18, 70, 35))):
            with patch("time.time", return_value=1000):
                grants = [reserve(0, 10, state_dir=state_dir)[1] for _ in range(4)]
            assert grants == [1, 0, 0, 0], grants
            reservations_file = Path(state_dir) / "reservations"
            assert reservations_file.read_text().splitlines() == ["1000.0"]
            with patch("time.time", return_value=1119):
                assert reserve(0, 10, state_dir=state_dir)[1] == 0
            with patch("time.time", return_value=1120):
                assert reserve(0, 10, state_dir=state_dir)[1] == 1
            assert reservations_file.read_text().splitlines() == ["1120"]
    assert decide(0, 20, Box(0.60, 18, 70, 0), reservations=4) == (
        1, "CPU allows 1 (busy 60%)")
    assert decide(0, 20, Box(0.0, 18, 12, 0), reservations=3) == (
        1, "memory allows 1")
    with TemporaryDirectory() as state_dir:
        with patch.dict(globals(), box=Mock(return_value=Box(0.60, 18, 70, 0))):
            grants = [reserve(0, 10, state_dir=state_dir)[1] for _ in range(12)]
            assert grants == [5] + [0] * 11, grants
    ht, multibot, other = "HT Product Lead", "Multi Bot Opus Runner", "postbox"

    def seen(state_dir, name, running=0, ready=10):
        path = Path(state_dir) / "projects.json"
        projects = json.loads(path.read_text()) if path.exists() else {}
        projects[name] = {"running": running, "cap": CAP, "ready": ready, "seen": time.time(), "pending": []}
        path.write_text(json.dumps(projects))

    with TemporaryDirectory() as state_dir:
        with patch.dict(globals(), box=Mock(return_value=Box(0.60, 18, 70, 0))):
            assert reserve(0, 10, state_dir=state_dir, project=other)[1] == 5, "a silent higher project holds nobody"
    with TemporaryDirectory() as state_dir:
        with patch.dict(globals(), box=Mock(return_value=Box(0.80, 18, 70, 0))):
            seen(state_dir, ht)
            assert reserve(0, 10, state_dir=state_dir, project=other)[1:] == (
                0, f"held for {ht}")
            assert reserve(0, 10, state_dir=state_dir, project=ht)[1:] == (
                0, "CPU allows 0 (busy 80%)")
    with TemporaryDirectory() as state_dir:
        with patch.dict(globals(), box=Mock(return_value=Box(0.60, 18, 70, 0))):
            seen(state_dir, ht)
            for name in (other, multibot):
                assert reserve(0, 10, state_dir=state_dir, project=name)[1:] == (
                    0, f"held for {ht}")
            assert reserve(0, 10, state_dir=state_dir, project=ht)[1] == 5
            assert reserve(0, 10, state_dir=state_dir, project=other)[1] == 0
    for ht_cap in (0, 3, CAP):
        with TemporaryDirectory() as state_dir:
            with patch.dict(globals(), box=Mock(return_value=Box(0.60, 18, 70, 0))):
                reserve(ht_cap, 0, cap=ht_cap, state_dir=state_dir, project=ht)
                seen(state_dir, multibot)
                assert reserve(0, 10, state_dir=state_dir, project=other)[1:] == (
                    0, f"held for {multibot}")
                assert reserve(0, 10, state_dir=state_dir, project=multibot)[1] == 5
    with TemporaryDirectory() as state_dir:
        with patch.dict(globals(), box=Mock(return_value=Box(0.60, 18, 70, 0))):
            reserve(CAP, 0, state_dir=state_dir, project=ht)
            reserve(CAP, 0, state_dir=state_dir, project=multibot)
            assert reserve(0, 10, state_dir=state_dir, project=other)[1] == 5
    with TemporaryDirectory() as state_dir:
        with patch.dict(globals(), box=Mock(return_value=Box(0.0, 36, 100, 0))):
            assert reserve(0, 10, state_dir=state_dir, project=other)[1] == 10
            assert reserve(0, 10, state_dir=state_dir, project=ht)[1] == 10
            assert reserve(0, 10, state_dir=state_dir, project=ht)[1] == 0
    with TemporaryDirectory() as state_dir:
        with patch.dict(globals(), box=Mock(return_value=Box(0.0, 18, 70, 0))):
            assert reserve(0, 10, state_dir=state_dir, project=ht)[1] == 10
            with patch.dict(globals(), box=Mock(return_value=Box(0.60, 18, 70, 0))):
                assert reserve(0, 10, state_dir=state_dir, project=multibot)[1] == 0
            with patch.dict(globals(), box=Mock(return_value=Box(0.0, 18, 70, 0))):
                assert reserve(0, 10, state_dir=state_dir, project=multibot)[1] == 10
    with TemporaryDirectory() as state_dir:
        with patch.dict(globals(), box=Mock(return_value=Box(0.60, 18, 70, 0))):
            with patch("time.time", return_value=1000):
                reserve(CAP, 0, state_dir=state_dir, project=ht)
                assert reserve(0, 10, state_dir=state_dir, project=multibot)[1] == 5
            with patch("time.time", return_value=1120):
                assert reserve(0, 10, state_dir=state_dir, project=multibot)[1] == 5, "a stale higher project holds nobody"
    with TemporaryDirectory() as state_dir:
        with patch.dict(globals(), box=Mock(return_value=Box(0.60, 18, 70, 0))):
            assert reserve(0, 2, state_dir=state_dir, project=ht)[1] == 2
            assert reserve(0, 10, state_dir=state_dir, project=multibot)[1] == 3, "held only for the tickets Hypertask can start"
    output = StringIO()
    with patch.dict(globals(), reserve=Mock(return_value=(idle, 0, f"held for {ht}"))):
        with redirect_stdout(output):
            main(["--running", "0", "--ready", "10", "--project", other])
        reserve.assert_called_once_with(0, 10, roster_cap(other), project=other)
    assert output.getvalue() == f"start 0: held for {ht}\n"
    print("slots self-test ok")


def roster_cap(project):
    """The project's worker cap from roster.json; unlisted projects get DEFAULT_CAP."""
    rows = json.loads(Path(__file__).with_name("roster.json").read_text())["rows"]
    return next((row.get("workers", DEFAULT_CAP) for row in rows if row["name"] == project), DEFAULT_CAP)


def main(argv):
    parser = argparse.ArgumentParser()
    parser.add_argument("--running", type=int)
    parser.add_argument("--ready", type=int)
    parser.add_argument("--cap", type=int, default=CAP)
    parser.add_argument("--project")
    parser.add_argument("--why", action="store_true")
    parser.add_argument("--self-test", action="store_true")
    args = parser.parse_args(argv)
    if args.self_test:
        return self_test()
    if args.running is None or args.ready is None:
        parser.error("--running and --ready are required")
    if min(args.running, args.ready, args.cap) < 0:
        parser.error("--running, --ready and --cap must be nonnegative")
    cap = min(args.cap, roster_cap(args.project)) if args.project else args.cap
    snapshot, k, why = reserve(args.running, args.ready, cap, project=args.project)
    if args.why:
        print(snapshot, file=sys.stderr)
    print(f"start {k}" + (f": {why}" if why else ""))


if __name__ == "__main__":
    main(sys.argv[1:])
