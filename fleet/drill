    start = time.time()
    found = read_list(LISTS / "rule-drift")
    detected = time.time()
    if found is None:
        return row("rule-drift", start, detected, None, False, "rule-drift list is missing")
    if found:
        return row("rule-drift", start, detected, None, False, "rule-drift list is not empty")
    r = subprocess.run([sys.executable, str(REPO / "bin" / "rules-drift"), "--self-check"], capture_output=True, text=True)
    if r.returncode != 0 or "self-check PASS" not in (r.stdout or ""):
        return row("rule-drift", start, detected, None, False, "rules-drift self-check failed")
    r = subprocess.run([sys.executable, str(REPO / "bin" / "rules-drift"), "--house-rules"], capture_output=True, text=True)
    if r.returncode != 0:
        err = (r.stdout or r.stderr or "rules-drift --house-rules failed").strip().splitlines()[-1]
        return row("rule-drift", start, detected, None, False, err)
    return row("rule-drift", start, detected, detected, True, "")


def drill_dead_supervisor(ctx):
    start = time.time()
    hb = ctx.watch_state / "heartbeat"
    hb.write_text("1\n")
    old = time.time() - 1500
    os.utime(hb, (old, old))
    detected = time.time()
    alarm = REPO / "bin" / "fleet-supervisor-alarm"
    if not alarm.exists():
        return row("dead-supervisor", start, detected, None, False, "no outside alarm for a stopped supervisor heartbeat")
    env = {**os.environ, "FLEET_SUPERVISOR_DRILL": "1"}
    r = subprocess.run([sys.executable, str(alarm), "--self-check"], capture_output=True, text=True, cwd=str(REPO), env=env)
    if r.returncode != 0:
        detail = (r.stderr or r.stdout or "self-check failed").strip().splitlines()[-1]
        return row("dead-supervisor", start, detected, None, False, detail)
    return row("dead-supervisor", start, detected, detected, True, "")


