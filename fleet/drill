def drill_dead_runner(ctx):
    start = time.time()
    kill_drill_sessions()
    unit = subprocess.run(["systemctl", "--user", "cat", "fleet-runner-tick.service"], capture_output=True, text=True)
    text = unit.stdout or ""
    if "fleet/runner tick" not in text:
        unit = subprocess.run(["systemctl", "--user", "cat", "ht-or-runner-tick.service"], capture_output=True, text=True)
        text = unit.stdout or ""
    if "fleet/runner tick" not in text:
        return row("dead-runner", start, time.time(), None, False, "timer service does not start fleet/runner tick")
    env = ctx.env()
    env["FLEET_RUNNER_SKIP_GREEN"] = "1"
    env["FLEET_RUNNER_FIRST"] = "1"
    env["FLEET_RUNNER_LAST"] = "1"
    (ctx.runner_state / "target").write_text("1\n")
    sess = "drill-runner-1"
    subprocess.run([str(RUNNER), "1"], env=env, capture_output=True, text=True)
    if not has_session(sess):
        return row("dead-runner", start, time.time(), None, False, "drill session not started")
    cmd = pane_cmd(sess)
    if "fleet/runner" not in cmd:
        kill_drill_sessions()
        return row("dead-runner", start, time.time(), None, False, f"pane started {cmd}")
    subprocess.run(["tmux", "kill-session", "-t", sess], capture_output=True)
    time.sleep(1)
    if has_session(sess):
        kill_drill_sessions()
        return row("dead-runner", start, time.time(), None, False, "session still alive after kill")
    detected = time.time()
    subprocess.run([str(RUNNER), "tick"], env=env, capture_output=True, text=True)
    fix = time.time()
    for _ in range(30):
        if has_session(sess):
            break
        time.sleep(1)
    if not has_session(sess):
        return row("dead-runner", start, detected, None, False, "tick did not restart drill session within 30s")
    cmd = pane_cmd(sess)
    kill_drill_sessions()
    if "fleet/runner" not in cmd:
        return row("dead-runner", start, detected, None, False, f"restarted pane was {cmd}")
    if "/.local/bin/ht-or-runner" in cmd:
        return row("dead-runner", start, detected, None, False, "legacy launcher still in the pane")
    return row("dead-runner", start, detected, fix, True, "")


def drill_dead_parts(ctx):
    start = time.time()
    scan = HERE / "dead-parts-scan.py"
    r = subprocess.run([sys.executable, str(scan)], capture_output=True, text=True)
    detected = time.time()
    if r.returncode != 0:
        err = (r.stderr or r.stdout or "dead-parts-scan failed").strip().splitlines()[0]
        return row("dead-parts", start, detected, None, False, err)
    found = [ln.strip() for ln in (r.stdout or "").splitlines() if ln.strip()]
    if found:
        msg = "; ".join(found[:8])
        if len(found) > 8:
            msg += f"; +{len(found) - 8} more"
        return row("dead-parts", start, detected, None, False, msg)
    return row("dead-parts", start, detected, detected, True, "")


