    )


def file_alarm(items, dry, sample):
    if sample and not dry:
        sample = False
    names = armed_names()
    failed = [i for i in items if not i["pass"] and (i["failure"] in names or (sample and dry))]
    if not failed:
        print("drill-file-none")
        return 0
    body = incident_body()
    path = Path(tempfile.mkdtemp(prefix="fleet-drill-file-")) / "body.html"
    path.write_text(body)
    checked = subprocess.run([sys.executable, str(LINT), "--shape", str(path)], capture_output=True, text=True)
    if checked.returncode != 0:
        sys.stderr.write(checked.stderr or "")
        return 1
    if dry:
        print("would file Factory drill failed")
        print("drill-file-lint-ok")
        return 0
    listed = subprocess.run(
        ["hypertask", "--json", "task", "list", "--project", "2060", "--search", "Factory drill failed", "--limit", "50"],
        capture_output=True, text=True,
    )
    if listed.returncode != 0:
        sys.stderr.write(listed.stderr or listed.stdout)
        return 1
    try:
        data = json.loads(listed.stdout[listed.stdout.index("{"):])
    except ValueError:
        sys.stderr.write("drill file: ticket list was not readable\n")
        return 1
    if not isinstance(data.get("tasks"), list):
        sys.stderr.write("drill file: ticket list was not readable\n")
        return 1
    existing = ""
    done = {"done", "archive", "archived"}
    for task in data.get("tasks") or []:
        if (task.get("title") or "") != "Factory drill failed":
            continue
        if task.get("sectionIsDone") or (task.get("section") or "").lower() in done:
            continue
        existing = task.get("ticketNumber") or ""
        break
    note = "drill fail: " + ", ".join(i["failure"] for i in failed)
    if existing:
        added = subprocess.run(["vcc", "activity", "add", existing, note], capture_output=True, text=True)
        if added.returncode != 0:
            sys.stderr.write(added.stderr or added.stdout)
            return 1
        print(f"drill-file-noted {existing}")
        return 0
    created = subprocess.run(
        ["vcc", "task", "create", "--project", "2060", "--title", "Factory drill failed",
         "--description-file", str(path), "--priority", "urgent",
         "--labels", "CI,Hypertask CI,brain-medium", "--section", "Todo"],
        capture_output=True, text=True,
    )
    if created.returncode != 0:
        sys.stderr.write(created.stderr or created.stdout)
        return 1
    print("drill-file-created")
    return 0


def run_one(name, ctx):
    try:
        return DRILLS[name](ctx)
    except (Exception, SystemExit) as e:
        return row(name, time.time(), time.time(), None, False, f"{type(e).__name__}: {e}")


def usage():
    print("fleet/drill <failure>|--all [--json] [--file] [--file-dry]")
    print("failures: " + " ".join(FAILURES))
    print("drill-harness-ok")


def main():
    args = sys.argv[1:]
    if not args or "--help" in args or "-h" in args:
        usage()
        return 0
    as_json = "--json" in args
    do_file = "--file" in args
    dry_file = "--file-dry" in args
    sample = os.environ.get("FLEET_DRILL_FILE_SAMPLE") == "1"
    pos = [a for a in args if not a.startswith("--")]
    if "--all" in args:
        if pos:
            usage()
            return 2
        names = list(FAILURES)
    elif len(pos) == 1 and pos[0] in DRILLS:
        names = [pos[0]]
    else:
        usage()
        return 2
    ctx = Sandbox()
    items = []
    code = 0
    try:
        for name in names:
            item = run_one(name, ctx)
            items.append(item)
            show(item, as_json)
            append_result(item)
        if do_file or dry_file:
            code = file_alarm(items, dry_file, sample)
    finally:
        held = ctx.close()
    if "--all" in args and {i["failure"] for i in items} == set(FAILURES) and held and code == 0:
        print("drill-sandbox-ok")
    elif "--all" in args and not held:
        print("drill-sandbox-leak")
        return 1
    return code


if __name__ == "__main__":
    sys.exit(main())
