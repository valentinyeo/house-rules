#!/usr/bin/env python3
"""One drill command for the factory (YPER4-1383).

    fleet/drill <failure> [--json] [--file] [--file-dry]
    fleet/drill --all [--json] [--file] [--file-dry]
    fleet/drill --help

Each drill injects one failure in a temp sandbox, records pass or fail with minutes,
and tears the sandbox down. It never writes live pick state, live runner state, the
live tmux pool, live tickets, or live pull requests.

Names in fleet/drill-lists/armed open one checks-board ticket when they fail.
Practice drills stay off that list until a later ticket turns them green.
The ticket does not use the Incident label: on the checks board that label means
the release line is down.

Output: one JSON line per drill appended to ~/.local/state/fleet-drill/results.jsonl
with failure, injected_at, detected_at, fix_started_at, minutes, pass.
"""
import hashlib
import importlib.machinery
import importlib.util
import json
import os
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path

HERE = Path(__file__).resolve().parent
REPO = HERE.parent
RUNNER = HERE / "runner"
PICK = HERE / "pick"
LISTS = HERE / "drill-lists"
LINT = Path.home() / ".local/share/vstack/skills/hypertask/scripts/ticket-lint"
RESULTS = Path(os.environ.get("FLEET_DRILL_RESULTS", Path.home() / ".local/state/fleet-drill/results.jsonl"))
HOME = Path.home()
LIVE = [
    HOME / ".local/state/fleet-pick",
    HOME / ".local/state/ht-or-runners",
    HOME / ".local/state/fleet-switch",
    HOME / ".local/state/pacing/allocation.json",
]
FAILURES = [
    "missing-check",
    "broken-picker",
    "cap-deadlock",
    "pacer-stop",
    "board-access",
    "idle-on-human",
    "dead-runner",
    "dead-parts",
    "rule-drift",
    "dead-supervisor",
]
FIELDS = ("failure", "injected_at", "detected_at", "fix_started_at", "minutes", "pass")
_PICK = None


def iso(ts):
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(ts))


def read_list(path):
    try:
        text = path.read_text()
    except OSError:
        return None
    return [ln.strip() for ln in text.splitlines() if ln.strip()]


def armed_names():
    found = read_list(LISTS / "armed")
    return set(found or [])


def under_root(path, root):
    rp = Path(path).resolve()
    root = root.resolve()
    return rp == root or root in rp.parents


def live_hit(path):
    rp = Path(path).resolve()
    for live in LIVE:
        try:
            lr = live.resolve()
        except OSError:
            continue
        if rp == lr or lr in rp.parents or rp in lr.parents:
            return rp
    return None


def tmux_names():
    r = subprocess.run(["tmux", "list-sessions", "-F", "#{session_name}"], capture_output=True, text=True)
    if r.returncode != 0:
        return set()
    return {ln.strip() for ln in r.stdout.splitlines() if ln.strip()}


def has_session(name):
    r = subprocess.run(["tmux", "has-session", "-t", f"={name}"], capture_output=True)
    return r.returncode == 0


def pane_cmd(name):
    r = subprocess.run(["tmux", "list-panes", "-t", name, "-F", "#{pane_start_command}"], capture_output=True, text=True)
    return (r.stdout.splitlines() or [""])[0]


def kill_drill_sessions():
    for name in tmux_names():
        if name.startswith("drill-runner-"):
            subprocess.run(["tmux", "kill-session", "-t", name], capture_output=True)


class Sandbox:
    def __init__(self):
        self.root = Path(tempfile.mkdtemp(prefix="fleet-drill-"))
        self.pick_state = self.root / "pick"
        self.runner_state = self.root / "runner"
        self.watch_state = self.root / "watch"
        self.allocation = self.root / "allocation.json"
        self.virtual = self.root / "virtual"
        for p in (self.pick_state / "claims", self.runner_state, self.watch_state):
            p.mkdir(parents=True)
        self.virtual.write_text("")
        self.allocation.write_text('{"at":0}\n')
        for p in (self.pick_state, self.runner_state, self.watch_state, self.allocation, self.virtual):
            hit = live_hit(p)
            if hit or not under_root(p, self.root):
                shutil.rmtree(self.root, ignore_errors=True)
                raise SystemExit(f"drill refused: sandbox escaped ({hit or p})")
        self.before = tmux_names()

    def env(self):
        env = os.environ.copy()
        env["FLEET_PICK_STATE"] = str(self.pick_state)
        env["FLEET_PICK_LKG"] = str(self.root / "lkg")
        env["FLEET_HOME"] = str(HERE)
        env["FLEET_RUNNER_STATE"] = str(self.runner_state)
        env["FLEET_WATCH_STATE"] = str(self.watch_state)
        env["FLEET_PICK_ALLOCATION"] = str(self.allocation)
        env["FLEET_PICK_VIRTUAL"] = str(self.virtual)
        env["FLEET_RUNNER_SESS_PREFIX"] = "drill-runner"
        env["FLEET_RUNNER_DRILL"] = "1"
        env["PYTHONDONTWRITEBYTECODE"] = "1"
        return env

    def close(self):
        kill_drill_sessions()
        after = tmux_names()
        before_live = {n for n in self.before if n.startswith("ht-or-runner-")}
        after_live = {n for n in after if n.startswith("ht-or-runner-")}
        drills_left = {n for n in after if n.startswith("drill-runner-")}
        ok = before_live == after_live and not drills_left
        shutil.rmtree(self.root, ignore_errors=True)
        return ok


def row(failure, start, detected, fix_started, ok, detail=""):
    return {
        "failure": failure,
        "injected_at": iso(start),
        "detected_at": iso(detected) if detected else None,
        "fix_started_at": iso(fix_started) if fix_started else None,
        "minutes": round((time.time() - start) / 60, 3),
        "pass": bool(ok),
        "detail": detail,
    }


def show(item, as_json):
    word = "pass" if item["pass"] else "fail"
    line = f"{item['failure']} {word} {item['minutes']}m"
    if item.get("detail") and not item["pass"]:
        line += " " + item["detail"]
    print(line)
    if item["failure"] == "dead-runner" and item["pass"]:
        print("dead-runner drill ok")
    if as_json:
        print(json.dumps({k: item[k] for k in FIELDS}))


def append_result(item):
    RESULTS.parent.mkdir(parents=True, exist_ok=True)
    with RESULTS.open("a") as f:
        f.write(json.dumps({k: item[k] for k in FIELDS}) + "\n")


def load_pick(ctx):
    global _PICK
    if _PICK is not None:
        return _PICK
    os.environ["FLEET_PICK_STATE"] = str(ctx.pick_state)
    os.environ["FLEET_RUNNER_STATE"] = str(ctx.runner_state)
    os.environ["FLEET_WATCH_STATE"] = str(ctx.watch_state)
    os.environ["FLEET_PICK_ALLOCATION"] = str(ctx.allocation)
    os.environ["FLEET_PICK_VIRTUAL"] = str(ctx.virtual)
    os.environ["FLEET_RUNNERS"] = "5"
    loader = importlib.machinery.SourceFileLoader("fleet_pick_drill", str(PICK))
    spec = importlib.util.spec_from_loader("fleet_pick_drill", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    _PICK = mod
    return mod


def sandbox_pick(pick, ctx):
    for label, path in (("pick", pick.STATE), ("runner", pick.RUNNER_STATE), ("watch", pick.WATCH),
                        ("allocation", pick.ALLOCATION)):
        if not under_root(path, ctx.root):
            raise RuntimeError(f"{label} state is not in the sandbox: {path}")


def compiles(path, dest):
    r = subprocess.run(
        [sys.executable, "-c", "import py_compile,sys; py_compile.compile(sys.argv[1], cfile=sys.argv[2], doraise=True)", str(path), str(dest)],
        capture_output=True, text=True,
    )
    return r.returncode == 0


def file_sha(path):
    h = hashlib.sha256()
    with Path(path).open("rb") as f:
        for chunk in iter(lambda: f.read(65536), b""):
            h.update(chunk)
    return h.hexdigest()


def drill_missing_check(ctx):
    start = time.time()
    (ctx.watch_state / "missing-check.json").write_text(json.dumps({"status": "drill-review", "age_min": 31, "reported": False}))
    detected = time.time()
    hits = []
    for folder in (REPO / "fleet", REPO / "bin"):
        for p in folder.iterdir():
            if not p.is_file() or p.name == "drill":
                continue
            if "drill-review" in p.read_text(errors="replace"):
                hits.append(p.name)
    if hits:
        return row("missing-check", start, detected, detected, True, "watcher present")
    return row("missing-check", start, detected, None, False, "no watcher files an incident when a required status stays silent")


def drill_broken_picker(ctx):
    start = time.time()
    env = ctx.env()
    gate = HERE / "tool-gate.py"
    seed = subprocess.run([sys.executable, str(gate), "pick"], env=env, capture_output=True, text=True)
    if seed.returncode != 0:
        det = time.time()
        err = (seed.stderr or seed.stdout or "tool-gate seed failed").strip().splitlines()[-1]
        return row("broken-picker", start, det, None, False, err)
    bad = ctx.root / "pick-bad.py"
    bad.write_text(PICK.read_text() + "\n(\n")
    owner = ctx.root / "ticket_owner.py"
    shutil.copy2(HERE / "ticket_owner.py", owner)
    good = compiles(PICK, ctx.root / "pick-good.pyc")
    broken = compiles(bad, ctx.root / "pick-bad.pyc")
    if not good:
        return row("broken-picker", start, time.time(), None, False, "current picker does not compile")
    if broken:
        return row("broken-picker", start, time.time(), None, False, "injected syntax error still compiled")
    env_bad = dict(env)
    env_bad["FLEET_PICK_SOURCE"] = str(bad)
    # The injected fault exercises rollback, without filing a live incident.
    bad_sha = hashlib.sha256((file_sha(bad) + file_sha(owner)).encode()).hexdigest()
    (ctx.watch_state / "broken-picker-incident.json").write_text(json.dumps({"sha": bad_sha}))
    roll = subprocess.run([sys.executable, str(gate), "pick"], env=env_bad, capture_output=True, text=True)
    detected = time.time()
    if roll.returncode != 0:
        return row("broken-picker", start, detected, None, False, "tool-gate did not serve lkg on bad pick")
    lkg = Path(roll.stdout.strip())
    if not lkg.is_file() or file_sha(lkg) == file_sha(bad):
        return row("broken-picker", start, detected, None, False, "rollback path was not the last good copy")
    lkg_sha = ctx.runner_state / "pick-lkg.sha"
    if not lkg_sha.exists():
        return row("broken-picker", start, detected, None, False, "no last-known-good picker sha")
    return row("broken-picker", start, detected, detected, True, "")


def drill_cap_deadlock(ctx):
    start = time.time()
    try:
        pick = load_pick(ctx)
        sandbox_pick(pick, ctx)
        pick.ht = lambda *a, **k: (_ for _ in ()).throw(RuntimeError("live board read"))
        pick.set_engine("cursor")
        pick.RUNNERS = 5
        pick.RUNNING.clear()
        pick.MEMBERS.clear()
        pick.LOGGED.clear()
        pick.CHECKED[0] = 0
        names = [f"runner {i}" for i in range(1, 6)]
        now = time.time()
        cache = {b: {"at": now, "names": names} for b in pick.BOARDS}
        (ctx.pick_state / "members.json").write_text(json.dumps(cache))

        def tk(key, section, prio="Medium", holders=()):
            return {
                "key": key, "idx": 1, "board": pick.PREFIX_BOARD[key.split("-")[0]], "section": section,
                "title": "x", "labels": [], "prio": prio, "holders": [[h, True] for h in holders],
                "waiting": False, "subs": False, "paid": False,
                "created": "2026-01-01T00:00:00Z", "updated": "2026-01-01T00:00:00Z",
            }

        wip = [tk(f"HTPR-{9101 + i}", "In Progress", holders=("runner 2",)) for i in range(12)]
        bait = tk("HTPR-9400", "Features", "Urgent")
        tools = tk("HYCI-9301", "Todo", "Urgent")
        checks = tk("HYCI-9300", "Todo", "Medium")
        blocked = tk("HTPR-9201", "Done")
        tickets = wip + [bait, tools, checks, blocked]
        rel = {t["key"]: [[], []] for t in tickets}
        rel["HYCI-9300"] = [[], ["HTPR-9201"]]
        pick.SNAP = {"tickets": tickets, "rel": rel, "prs": [], "incidents": [], "open": {}}
        offers = []

        def fake(n, t, source, dry):
            pick.record_claim(n, t["key"], True)
            return True

        pick.try_claim = fake
        for n in range(1, 6):
            try:
                got = pick.choose(n, True)
            except SystemExit:
                continue
            if got:
                offers.append((n, got[0]["key"], got[1]))
        detected = time.time()
        kept = [o for o in offers if o[2] == "kept-slot"]
        # The pool counts one unit per live runner, so 12 app tickets under one runner no longer close new work and the
        # app bait is open to a free runner (HYCI-433). HYCI-386: only the ticket an open app ticket waits on takes the
        # kept slot, and it still beats urgent app work. Plain urgent infra does not.
        app_at = next((i for i, o in enumerate(offers) if o[1] == "HTPR-9400"), None)
        blocker_at = next((i for i, o in enumerate(offers) if o[1] == "HYCI-9300"), None)
        plain_at = next((i for i, o in enumerate(offers) if o[1] == "HYCI-9301"), None)
        ok = (blocker_at is not None and any(o[1] == "HYCI-9300" and o[2] == "kept-slot" for o in kept)
              and app_at is not None and blocker_at < app_at
              and (plain_at is None or app_at < plain_at)
              and not any(o[1] == "HYCI-9301" and o[2] == "kept-slot" for o in offers))
        detail = "" if ok else f"offers={offers[:8]}"
        return row("cap-deadlock", start, detected, detected if ok else None, ok, detail)
    except (Exception, SystemExit) as e:
        return row("cap-deadlock", start, time.time(), None, False, f"{type(e).__name__}: {e}")


def drill_pacer_stop(ctx):
    start = time.time()
    ctx.allocation.write_text(json.dumps({"at": time.time() - 7200, "engine": "cursor", "models": {}}))
    (ctx.runner_state / "pace-cap").write_text("0\n")
    r = subprocess.run([str(RUNNER), "status"], env=ctx.env(), capture_output=True, text=True)
    detected = time.time()
    text = (r.stdout or "") + (r.stderr or "")
    log = ""
    log_path = ctx.watch_state / "log.txt"
    if log_path.exists():
        log = log_path.read_text()
    if "max=5" in text and "pacer" in log:
        return row("pacer-stop", start, detected, detected, True, "")
    return row("pacer-stop", start, detected, None, False, "pace did not fall back to floor 5")


def drill_board_access(ctx):
    start = time.time()
    try:
        pick = load_pick(ctx)
        sandbox_pick(pick, ctx)
        pick.ht = lambda *a, **k: (_ for _ in ()).throw(RuntimeError("live board read"))
        aged = time.time() - 400
        names = [f"runner {i}" for i in range(1, 6) if i != 3]
        cache = {b: {"at": aged, "names": names} for b in pick.BOARDS}
        (ctx.pick_state / "members.json").write_text(json.dumps(cache))
        pick.MEMBERS.clear()
        pick.LOGGED.clear()
        refreshed = {b: {f"runner {i}" for i in range(1, 6)} for b in pick.BOARDS}

        def fetch(board):
            return set(refreshed.get(board) or [])

        pick.fetch_members = fetch
        joined = pick.can_join(3, "2060")
        detected = time.time()
        incident_path = ctx.watch_state / "incidents.jsonl"
        incident = incident_path.read_text() if incident_path.exists() else ""
        named = "runner 3" in incident and "2060" in incident
        if joined and named:
            return row("board-access", start, detected, detected, True, "")
        parts = []
        if not joined:
            parts.append("refused claim did not refresh membership")
        if not named:
            parts.append("no incident names the runner and the board")
        return row("board-access", start, detected, None, False, "; ".join(parts))
    except (Exception, SystemExit) as e:
        return row("board-access", start, time.time(), None, False, f"{type(e).__name__}: {e}")


def drill_idle_on_human(ctx):
