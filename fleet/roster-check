#!/usr/bin/env python3
"""Roster check: every live agent session on this VPS must be accounted for (HYCI-214).

    roster-check [--record] [--log] | --self-test

Live sessions: tmux panes that run an agent (claude, hax, codex, cursor-agent) and Multibot hosted chats
(fleet/roster.py). Each is matched to a fleet/roster.json row (pinned tmux, name pattern, or Multibot name), else to
its own announcement (fleet/roster-announce). Prints one line per session that is not accounted for:
  NOT-IN-ROSTER <tmux> ...  no row and never announced
  UNKNOWN <tmux> ...        announced, but never said its kind and board
--record writes an unknown announcement for each NOT-IN-ROSTER session, so the hook-less harnesses (Codex, hax) are
recorded too, never silently dropped. --record also moves announcements of dead sessions that are over a day old to
announce/stale/ (SOFT-2716; roster.rows() already ignores them). --log appends to ~/.local/state/fleet-switch/log.txt for Fleet Tools when the
flagged set changes, and posts the same note once on the Hypertask ticket FLEET_ALARM_TICKET (agent login HT_TOKEN,
agent-log note, nobody notified); with either variable missing it only logs. Exit 1 when any session is flagged. Read only on boards.
"""
import json
import os
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import roster  # noqa: E402

WATCH = Path(os.environ.get("FLEET_WATCH_STATE", Path.home() / ".local/state/fleet-switch"))
LAST = WATCH / "roster-check.json"


def verdicts(sessions, static, announced):
    """[(tag, session, note)] for sessions not accounted for. Pure."""
    by_key = {roster.key_of(a): a for a in announced}
    out = []
    for s in sessions:
        if roster.row_for(static, s["tmux"], s.get("name")):
            continue
        a = by_key.get(roster.key_of(s))
        if a and a.get("kind") not in (None, "unknown"):
            continue
        note = " ".join(f"{k}={v}" for k, v in (("name", s.get("name")), ("harness", s.get("harness")),
                                                  ("cwd", (a or {}).get("cwd"))) if v)
        out.append(("UNKNOWN" if a else "NOT-IN-ROSTER", s, note))
    return out


def announced_sessions(announced, live_tmux):
    """Announced unknowns whose tmux is alive but not seen as an agent session (e.g. idle shells), as sessions."""
    return [dict(tmux=a["tmux"], name=a.get("multibot"), harness=a.get("harness"))
            for a in announced if a.get("tmux") in live_tmux and a.get("kind") in (None, "unknown")]


def worker_errors(rows):
    return [f"roster.json row {row.get('name', index)}: workers requires workers_by starting Valentin"
            for index, row in enumerate(rows)
            if "workers" in row and not str(row.get("workers_by", "")).startswith("Valentin")]


def read_names(path):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return []


def note_for(names):
    if not names:
        return "roster-check: every live session is in the roster"
    return (f"roster-check: {len(names)} live sessions not in the roster, {roster.OWNER}: add a row or have them run "
            f"fleet/roster-announce: " + ", ".join(names))


def log_flagged(names, watch=None, run=subprocess.run, env=os.environ):
    """Log the flagged set when it changed since the last run, and post it once as an agent-log note on
    FLEET_ALARM_TICKET. The post has its own marker (roster-check-posted.json): it moves only after a successful
    post, so a failed post is retried next run and a post never repeats for an unchanged set. A set that was never
    flagged is not posted. Returns the post status: "posted", "failed", "off" (a variable is missing) or "same"."""
    watch = watch or WATCH
    last, posted = watch / "roster-check.json", watch / "roster-check-posted.json"
    note = note_for(names)
    if names != read_names(last):
        watch.mkdir(parents=True, exist_ok=True)
        with open(watch / "log.txt", "a") as f:
            f.write(time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()) + " " + note + "\n")
        last.write_text(json.dumps(names))
    if names == read_names(posted):
        return "same"
    status = roster.post_alarm(note, run=run, env=env)
    if status == "posted":
        posted.write_text(json.dumps(names))
    elif status == "failed":
        print("roster-check: alarm post failed, will retry next run", file=sys.stderr)
    return status


def main():
    static, announced = roster.static_rows(), roster.announced()
    errors = worker_errors(static)
    if errors:
        print("\n".join(errors))
        sys.exit(1)
    sessions = roster.live_sessions()
    seen = {s["tmux"] for s in sessions}
    alive = roster._mp_send().tmux_names() or set()
    sessions += [s for s in announced_sessions(announced, alive) if s["tmux"] not in seen]
    flagged = verdicts(sessions, static, announced)
    if "--record" in sys.argv:
        for path in roster.archive_stale():
            print(f"STALE-ARCHIVED {path.name} -> announce/stale/")
        for tag, s, _ in flagged:
            if tag == "NOT-IN-ROSTER":
                roster.write_announce(dict(tmux=s["tmux"], multibot=s.get("name"), sid=s.get("sid"),
                                           harness=s.get("harness"), kind="unknown", seen=roster.now_iso(),
                                           source="roster-check"))
    for tag, s, note in flagged:
        print(f"{tag} {s['tmux']} {note}".rstrip())
    print(f"ROSTER-CHECK: {len(flagged)} of {len(sessions)} live agent sessions not accounted for.")
    if "--log" in sys.argv:
        log_flagged(sorted(s["tmux"] + (f" ({s['name']})" if s.get("name") else "") for _, s, _ in flagged))
    sys.exit(1 if flagged else 0)


def self_test():
    assert worker_errors([{"name": "A", "workers": 5}]) == [
        "roster.json row A: workers requires workers_by starting Valentin"]
    assert worker_errors([{"name": "A", "workers": 5, "workers_by": "agent"}])
    assert not worker_errors([{"name": "A", "workers": 5, "workers_by": "Valentin 2026-11-16"},
                              {"name": "B"}])
    actual = roster.static_rows()
    assert not worker_errors(actual)
    assert {(r["name"], r["workers"], r["workers_by"]) for r in actual if "workers" in r} == {
        ("HT Product Lead", 7, "Valentin 2026-11-17"), ("Multi Bot Opus Runner", 7, "Valentin 2026-11-17"),
        ("multiprompt-android", 3, "Valentin 2026-11-17"), ("Pecunia", 3, "Valentin 2026-11-17"),
        ("postbox", 3, "Valentin 2026-11-17"), ("poteto-2-advisor", 3, "Valentin 2026-11-17"),
        ("HT Features", 10, "Valentin 2026-11-25")}
    static = [{"name": "postbox"}, {"name": "ht-or-runner-{n}"},
              {"name": "Matt Live Stream", "multibot": "Matt Live Stream", "tmux": "live-1d21840"}]
    s = lambda t, name=None: {"tmux": t, "name": name, "harness": "claude"}
    live = [s("postbox"), s("ht-or-runner-3"), s("live-1d21840"), s("live-9", "Design Pass Runner"), s("live-a"),
            s("live-b"), s("codex-x")]
    ann = [{"tmux": "live-a", "kind": "unknown", "cwd": "/p"}, {"tmux": "live-b", "kind": "solo-dev", "board": "9"}]
    got = {(tag, x["tmux"]) for tag, x, _ in verdicts(live, static, ann)}
    assert got == {("NOT-IN-ROSTER", "live-9"), ("UNKNOWN", "live-a"), ("NOT-IN-ROSTER", "codex-x")}, got
    assert verdicts([s("live-x", "matt live stream")], static, []) == [], "a Multibot name must match its row"
    wild = [{"name": "live-chromescribe-{*}"}]
    assert roster.row_for(wild, "live-chromescribe-mwmmhm4f"), "{*} matches a hosted chat's own id"
    assert roster.row_for(wild, "live-chromescribex-mwmmhm4f") is None, "{*} sits where the id is, no wider"
    assert roster.row_for(roster.static_rows(), "live-chromescribe-abc123"), "the roster covers the next Chromescribe chat"
    alive = {"live-a", "live-z"}
    extra = announced_sessions(ann + [{"tmux": "live-gone", "kind": "unknown"}], alive)
    assert [x["tmux"] for x in extra] == ["live-a"], "only announced unknowns with a live tmux are flagged"
    import tempfile
    from unittest.mock import Mock

    assert roster.OWNER == "Fleet Tools" and "Fleet Tools" in note_for(["a"]) and "Chief Of" not in note_for(["a"])
    ok, bad = Mock(return_value=subprocess.CompletedProcess([], 0, "{}", "")), Mock(return_value=subprocess.CompletedProcess([], 1, "", "x"))
    on = {"FLEET_ALARM_TICKET": "SOFT-1", "HT_TOKEN": "tok"}
    with tempfile.TemporaryDirectory() as d:
        w = Path(d)
        assert log_flagged([], w, ok, on) == "same" and not ok.called, "a set never flagged posts nothing"
        assert log_flagged(["live-a"], w, ok, on) == "posted" and ok.call_count == 1, "a change posts once"
        argv = ok.call_args[0][0]
        assert argv[:6] == ["hypertask", "--json", "--token", "tok", "activity", "add"] and argv[6] == "SOFT-1", argv
        assert "--kind" not in argv and "Fleet Tools" in argv[-1], "agent-log note naming the new owner"
        assert "Fleet Tools" in (w / "log.txt").read_text() and "Chief Of" not in (w / "log.txt").read_text()
        for _ in range(3):
            assert log_flagged(["live-a"], w, ok, on) == "same"
        assert ok.call_count == 1 and (w / "log.txt").read_text().count("\n") == 1, "unchanged set: no new post, no new log"
        assert log_flagged(["live-a", "live-b"], w, ok, on) == "posted" and ok.call_count == 2, "a changed set posts again"
        assert log_flagged([], w, ok, on) == "posted" and "every live session" in ok.call_args[0][0][-1], "recovery posts"
    for env in ({}, {"FLEET_ALARM_TICKET": "SOFT-1"}, {"HT_TOKEN": "tok"}):
        with tempfile.TemporaryDirectory() as d:
            off = Mock()
            assert log_flagged(["live-a"], Path(d), off, env) == "off" and not off.called, "env missing: log only"
            assert "live-a" in (Path(d) / "log.txt").read_text(), "env missing: today's log line stays"
            assert log_flagged(["live-a"], Path(d), ok, on) == "posted", "set later: the pending change posts once"
    with tempfile.TemporaryDirectory() as d:
        assert log_flagged(["live-a"], Path(d), bad, on) == "failed" and not (Path(d) / "roster-check-posted.json").exists()
        assert log_flagged(["live-a"], Path(d), ok, on) == "posted", "a failed post is retried"
        boom = Mock(side_effect=subprocess.TimeoutExpired("hypertask", 60))
        assert log_flagged(["live-b"], Path(d), boom, on) == "failed", "a hung CLI must not raise"
    print("roster-check self-test ok")


if __name__ == "__main__":
    self_test() if "--self-test" in sys.argv else main()
