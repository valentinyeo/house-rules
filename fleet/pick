    return seen


def parkable(t, ledger=None):
    """Is t, the unfinished ticket that blocks a runner, due a park job? It must sit in a building column and be nobody else's claim.
    A ticket gets one job per REST_MAX, so a park run that did not park cannot be retried within the rest window.
    A ticket whose latest run ended WAIT_CHECK under JUST_WAITED_S ago gets no park job, whatever its PR shows: the run set its own
    recheck, and a red check is fix work for its own run after the rest, not a hand-back (13 Nov 20:22: SOFT-1968 park job 49s after
    WAIT_CHECK, PR 963 red at 20:19:40, the model handed it back, an empty run)."""
    if t["section"] not in BOARDS[t["board"]][1] or t["key"] in SKIP[0].hard or just_waited(t["key"]):
        return False
    if t["key"] in one_run_hold(True):  # its next step is a script's (checks, merge, release): a park job has nothing to park
        return False
    when = stamp_time((park_ledger() if ledger is None else ledger).get(t["key"], ""))
    return when is None or (dt.datetime.now(dt.timezone.utc) - when).total_seconds() > REST_MAX


ADMISSION_HOLD_TTL = 600


def admission_file():
    return STATE / "admission-holds"


def admission_remembered(n, key):
    """Did ship-claim's domain admission refuse this runner on this ticket in the last ten minutes? Then the next pick does not
    spend a claim on it again."""
    now = time.time()
    try:
        for line in admission_file().read_text().splitlines():
            who, k, at = line.split()
            if who == str(n) and k == key and now - float(at) < ADMISSION_HOLD_TTL:
                return True
    except (OSError, ValueError):
        pass
    return False


def remember_admission(n, key):
    now = time.time()
    keep = []
    try:
        keep = [l for l in admission_file().read_text().splitlines() if now - float(l.split()[2]) < ADMISSION_HOLD_TTL]
    except (OSError, ValueError, IndexError):
        pass
    STATE.mkdir(parents=True, exist_ok=True)
    tmp = admission_file().with_name(f"admission-holds.{os.getpid()}")
    tmp.write_text("\n".join(keep + [f"{n} {key} {now:.0f}"]) + "\n")
    os.replace(tmp, admission_file())


def record_park(n, key):
    STATE.mkdir(parents=True, exist_ok=True)
    with open(STATE / "parks", "a") as f:
        f.write(f"{dt.datetime.now(dt.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')} {key} {n}\n")


def try_claim(n, t, source, dry):
    """Claim t for Runner N. Returns True when it is ours, raises Pick for an own ticket found by a refusal."""
    if t.get("_owner") and t["_owner"]["runner"] != int(n):
        return False
    adopting = t["board"] == "2060" or source in ("orphan", "incident-takeover")
    if dry and adopting:
        record_claim(n, t["key"], True)
        return True
    if adopting:
        ok = adopt(n, t, "Adopted from a runner that no longer works it; staying on it until it is live" if source != "board" else "Picked by fleet/pick")
        if ok and t["board"] == "2060" and t["section"] == "Todo":
            ceo(n, "task", "move", t["key"], "--section", "Doing")
        if ok:
            record_claim(n, t["key"], False)
        else:
            note(t["key"], "adopt refused")
        return ok
    if not dry and source != "incident" and admission_remembered(n, t["key"]):
        note(t["key"], "domain admission refused this runner under ten minutes ago")
        return False
    rc, out = ship_claim(n, t["key"], source == "incident", dry)
    if rc == 0:
        record_claim(n, t["key"], dry)
        return True
    last = out.strip().splitlines()[-1] if out.strip() else "no output"
    note(t["key"], f"ship-claim refused (rc {rc}): {last}")
    if rc == 4 and "Domain admission failed" in out and not dry:
        remember_admission(n, t["key"])
    if rc == 4 and source != "incident":
        own = held_ticket(out)
        mine = fetch_ticket(own) if own else None
        if mine and timed_out_here(mine):
            log(f"hold {t['key']}: own {own} timed out on OpenCode; it waits for its hand-back")
            return False
        if mine and mine["key"] in one_run_hold(dry):
            # Before the hand-back: a ticket whose next step is a script's is not offered as "own" either (SOFT-2273, 13 Nov
            # 20:52 and 21:35: handed back twice with the hold on, each run only waited).
            log(f"hold {t['key']}: own {own} waits on its PR's checks, merge or release (one-run); a script owns it, no run")
            return False
        if mine and own not in SKIP[0] and not held_back(mine, own=True):
            raise Pick(mine, "own")
        if mine and pr_checks_pending(mine["key"], mine):
            log(f"hold {t['key']}: own {own} has an open PR whose checks are running; a park job has nothing to park (HYCI-352, HYCI-358 parks)")
            return False
        if mine and parkable(mine):  # parking clears both holds: ship-claim lets a parked ticket's open PR go too
            raise Pick(mine, "park")
        if mine:
            log(f"hold {t['key']}: unfinished {own} rests or waits (IDLE and unchanged, or BlockedBy open); its park job already ran "
                f"within the rest window or {own} is not in a building column. Park it with fleet/park")
            return False
        log(f"hold {t['key']}: {out.strip().splitlines()[-1] if out.strip() else 'no reason'}")
    return False


PRS_CACHE = STATE / "open-prs.json"
PRS_FRESH_S, PRS_STALE_S = 600, 900
PRS_JUST_S = 30  # a PR list this young already shows a PR that a run opened before it ended
JUST_WAITED_S = 30 * 60  # a run that ended WAIT_CHECK this recently opened or pushed its PR in that run


def open_prs_rest(tok, why):
    """GraphQL refused (its limit is separate from REST's): list PRs over REST. No check states there, so none read red."""
    r = subprocess.run(["gh", "api", "--paginate", f"repos/{PR_REPO}/pulls?base=production&state=open&per_page=100"],
                       capture_output=True, text=True, env=dict(os.environ, GH_TOKEN=tok), timeout=300)
    if r.returncode != 0:
        raise RuntimeError(f"GitHub PR list failed: {why}; REST too: {(r.stderr or '').strip()[:80]}")
    prs = json.loads(r.stdout.replace("][", ","))
    log(f"open PRs: GraphQL failed ({why[:60]}); read {len(prs)} over REST, check states unknown")
    return [{"number": p["number"], "title": p["title"], "draft": p["draft"], "branch": p["head"]["ref"],
             "updated": p["updated_at"], "red": False, "head": p["head"]["sha"], "review": None, "mergeable": None,
             "checks": None} for p in prs]


def check_states(rollup):
    """Sorted, de-duplicated 'name=state' strings of a PR's check runs and commit statuses. A check that is still running
    reads IN_PROGRESS or PENDING, so a finishing check changes the list."""
    return sorted({f"{c.get('name') or c.get('context') or '?'}={c.get('conclusion') or c.get('state') or c.get('status') or '?'}"
                   for c in rollup or []})


RUNNING_CHECK = re.compile(r"=(?:IN_PROGRESS|PENDING|QUEUED|EXPECTED|WAITING|REQUESTED)$")
FAILED_CHECK = re.compile(r"=(?:FAILURE|TIMED_OUT|CANCELLED|ACTION_REQUIRED|ERROR|STARTUP_FAILURE)$")
CANCELLED_CHECK = re.compile(r"=CANCELLED$")


def failed_checks(checks):
    """The failing 'name=state' entries of a check list, minus every CANCELLED attempt that a newer attempt of the same check
    supersedes (the list holds the same name twice, e.g. `bugfix-regression=CANCELLED` and `bugfix-regression=IN_PROGRESS`).
    A superseded cancel is not red; a lone cancel stays listed so the caller can hand it to the script that reruns it."""
    names = {}
    for c in checks or []:
        names.setdefault(c.rpartition("=")[0], set()).add(c.rpartition("=")[2])
    return [c for c in checks or [] if FAILED_CHECK.search(c) and not (CANCELLED_CHECK.search(c) and len(names[c.rpartition("=")[0]]) > 1)]


def gate_checks(checks):
    """What a run can act on, not the raw list (HYCI-343). A check that finishes while seven still run changes the raw list
    and woke the pool on a ticket with nothing to do: held reads "work still running" whatever finishes underneath. The part
    moves only when a run has a reason to act: the last check finishes, or one fails."""
    if checks is None:
        return None
    failed = sorted(failed_checks(checks))
    if any(RUNNING_CHECK.search(c) for c in checks):
        return ["running"] + failed
    return ["finished"] + failed


def open_prs(fresh=False):
    """`fresh`: a ticket's run just ended on a PR it opened (pr_checks_pending), so the shared ten-minute copy may predate that PR;
    a copy older than PRS_JUST_S is read again. Every open PR to production on hypertask-ai/hypertask, read once per pick. One GitHub read serves every
    runner's pick for PRS_FRESH_S, the same ten minutes fleet/pr-snapshot writes its copy; on a failed read (the
    App's GraphQL limit ran out on 2026-11-10 and every pick stopped) a copy up to PRS_STALE_S old stands in.
    SNAP["prs_at"] is when the list was read. Besides the title, branch and red flag, each PR carries its head commit, review
    decision, mergeable state and check states: the wait gate (wait_gate) fingerprints them at no extra GitHub call."""
    if fresh and SNAP["prs"] is not None and time.time() - (SNAP.get("prs_at") or 0) >= PRS_JUST_S:
        SNAP["prs"] = None
    if SNAP["prs"] is None:
        try:
            cached = json.loads(PRS_CACHE.read_text())
            age = time.time() - cached["at"]
        except (OSError, ValueError, KeyError, TypeError):
            cached, age = None, None
        if cached and age < (PRS_JUST_S if fresh else PRS_FRESH_S):
            SNAP["prs"], SNAP["prs_at"] = cached["prs"], cached["at"]
            return SNAP["prs"]
        tok = subprocess.run(["gh-app-token"], capture_output=True, text=True).stdout.strip()
        if not tok:
            raise RuntimeError("empty GitHub App token")
        r = subprocess.run(["gh", "pr", "list", "--repo", PR_REPO, "--base", "production", "--state", "open", "--limit", "1000",
                            "--json", "number,title,isDraft,headRefName,updatedAt,statusCheckRollup,headRefOid,reviewDecision,mergeable,mergeStateStatus"],
                           capture_output=True, text=True, env=dict(os.environ, GH_TOKEN=tok), timeout=300)
        if r.returncode != 0 and cached and age < PRS_STALE_S:
            log(f"open PRs: GitHub read failed ({(r.stderr or '').strip()[:80]}); using a copy {int(age)}s old")
            SNAP["prs"], SNAP["prs_at"] = cached["prs"], cached["at"]
            return SNAP["prs"]
        if r.returncode != 0:
            SNAP["prs"], SNAP["prs_at"] = open_prs_rest(tok, (r.stderr or "").strip()[:120]), time.time()
            return SNAP["prs"]
        prs = json.loads(r.stdout)
        if not isinstance(prs, list) or len(prs) >= 1000:
            raise RuntimeError("incomplete PR list")
        SNAP["prs"] = [{"number": p["number"], "title": p["title"], "draft": p["isDraft"], "branch": p["headRefName"],
                        "updated": p["updatedAt"],
                        "red": any(c.get("conclusion") in ("FAILURE", "TIMED_OUT") or c.get("state") in ("FAILURE", "ERROR")
                                   for c in p.get("statusCheckRollup") or []),
                        "head": p.get("headRefOid"), "review": p.get("reviewDecision") or "",
                        "mergeable": p.get("mergeable") or "", "merge_state": p.get("mergeStateStatus") or "", "checks": check_states(p.get("statusCheckRollup"))}
                       for p in prs]
        SNAP["prs_at"] = time.time()
        tmp = PRS_CACHE.with_suffix(".tmp")
        tmp.write_text(json.dumps({"at": SNAP["prs_at"], "prs": SNAP["prs"]}))
        tmp.replace(PRS_CACHE)
        save_cache(SNAP)
    return SNAP["prs"]


def pr_ticket(p):
    if p["branch"].startswith(("dependabot/", "renovate/")):
        return None
    m = TICKET.search(p["title"]) or TICKET.search(p["branch"].upper())
    return m[0] if m else None


def pr_orphan_rank(p):
    """A green open PR whose ticket is an orphan in a building column: drain it when the WIP cap blocks new starts."""
    tk = pr_ticket(p)
    if not tk or p["draft"] or p["red"]:
        return None
    t = by_key(tk)
    if not t or t["section"] not in BOARDS[t["board"]][1] or not orphan(t):
        return None
    if skipped(t) or "design-pass" in t["labels"] or not orphan_ok(t) or held_back(t):
        return None
    return (3, p["updated"], p["number"])


def pr_candidates(n, taken):
    """pr-drain-pick rules: draft PRs, red PRs idle for 6 hours, and green PRs on orphan building tickets."""
    open_prs()
    now = dt.datetime.now(dt.timezone.utc)
    frozen = FREEZE.exists()
    out = []
    for p in SNAP["prs"]:
        tk = pr_ticket(p)
        entry = {"pr": p["number"], "ticket": tk, "result": "candidate"}
        TRACE["prs"][p["number"]] = entry
        if not tk:
            entry["result"] = "no linked pool ticket"
            continue
        idle = now - dt.datetime.fromisoformat(p["updated"].replace("Z", "+00:00"))
        if frozen:
            if "HYCI-" not in p["title"] or idle < dt.timedelta(minutes=30):
                entry["result"] = "app freeze: only checks PRs idle 30 minutes"
                continue
            key = (0, p["updated"], p["number"])
        elif p["draft"]:
            key = (1 if p["branch"].startswith("dependabot/") else 0, p["updated"], p["number"])
        elif p["red"] and idle > dt.timedelta(hours=6):
            key = (2, p["updated"], p["number"])
        else:
            key = pr_orphan_rank(p)
            if key is None:
                entry["result"] = ("red PR idle under six hours" if p["red"] else
                                   TRACE["why"].get(tk, "not an eligible orphan in a building column"))
                continue
        if idle < dt.timedelta(hours=2) and not frozen:
            entry["result"] = "PR idle under two hours"
            continue
        m = TICKET.search(p["title"])
        if not m:
            entry["result"] = "no ticket in PR title"
            continue
        owner = PR_CLAIMS / str(p["number"]) / "owner"
        try:
            who, at = owner.read_text().split("\t")
            if who != f"RUNNER {n}" and now - dt.datetime.fromisoformat(at) < dt.timedelta(hours=3):
                entry["result"] = f"PR claimed by {who}"
                continue
        except (OSError, ValueError):
            pass
        out.append((key, p, m[0]))
    return [(p, k) for _, p, k in sorted(out, key=lambda x: x[0])]


