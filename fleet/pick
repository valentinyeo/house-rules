def claim_files():
    out = {}
    now = time.time()
    try:
        for p in STATE.joinpath("claims").iterdir():
            if not p.name.startswith(".") and now - p.stat().st_mtime < CLAIM_TTL:
                n, key = p.read_text().split("\t")[:2]
                out[key] = n
    except OSError:
        pass
    return out


def virtual_claims():
    out = {}
    path = os.environ.get("FLEET_PICK_VIRTUAL")
    if path and os.path.exists(path):
        for line in open(path):
            n, key = line.rstrip("\n").split("\t")[:2]
            out[key] = n
    return out


def record_claim(n, key, dry):
    if dry:
        path = os.environ.get("FLEET_PICK_VIRTUAL")
        if path:
            with open(path, "a") as f:
                f.write(f"{n}\t{key}\n")
        return
    d = STATE / "claims"
    d.mkdir(parents=True, exist_ok=True)
    (d / key).write_text(f"{n}\t{key}\t{dt.datetime.now(dt.timezone.utc).isoformat()}")


def ceo(n, *args):
    env = dict(os.environ, CEO_AGENT=f"RUNNER {n}", SHIP_SESSION_NAME=f"RUNNER {n}")
    r = subprocess.run([str(CEO_HT), *args], capture_output=True, text=True, env=env, timeout=300)
    return r.returncode, r.stdout + r.stderr


def adopt(n, t, why):
    """Assign the ticket to Runner N and say so in the agent lane. Used where ship-claim does not apply."""
    resume = os.environ.get("SHIP_CLAIM_RESUME", f"tmux attach -t fleet-runner-{n}")
    rc, _ = ceo(n, "task", "assign", t["key"], "--self")
    if rc != 0:
        return False
    rc, _ = ceo(n, "activity", "add", t["key"], f"Claimed. Session working it now. Claim id: [{resume}]\n{why}. Resume: {resume}")
    return rc == 0


def ship_claim(n, key, incident=False, dry=False):
    """Claim key for Runner N. A dry run asks `ship-claim hold` instead: the same holds, read only, no claim."""
    env = dict(os.environ, SHIP_SESSION_NAME=f"RUNNER {n}", SHIP_CLAIM_PICKED="1")
    if incident:
        env["SHIP_CLAIM_INCIDENT"] = "1"  # ship-claim re-reads the ticket and honours it only for a real open incident
    args = ["hold", key] if dry else [key, env.get("SHIP_CLAIM_RESUME", "")]
    r = subprocess.run([str(SHIP_CLAIM), *args], capture_output=True, text=True, env=env, timeout=900)
    return r.returncode, r.stdout + r.stderr


def held_ticket(out):
    m = re.search(r"(?:still has open PRs|unfinished merged work):?\s*(.*)", out)
    if not m:
        return None
    found = TICKET.search(m.group(1))
    if found:
        return found[0]
    for pr in re.findall(r"/pull/([0-9]+)", m.group(1)):
        r = subprocess.run(["gh", "pr", "view", pr, "-R", PR_REPO, "--json", "title", "--jq", ".title"], capture_output=True, text=True)
        found = TICKET.search(r.stdout) if r.returncode == 0 else None
        if found:
            return found[0]
    return None


# ---------------------------------------------------------------- the pick

class Pick(Exception):
    def __init__(self, t, source):
        self.t, self.source = t, source


SKIP = [()]  # the Skip of the pick in progress (a list so try_claim sees the current one)


def by_key(key):
    return next((t for t in SNAP["tickets"] if t["key"] == key), None)


def fetch_ticket(key):
    """A ticket the board lists in none of the pick columns (for example the ticket of a PR)."""
    t = by_key(key)
    if t:
        return t
    d = ht("task", "get", key)
    try:
        raw = d["tasks"][0]
        t = slim(raw, str(raw.get("projectId") or raw.get("boardId")))  # a moved ticket answers with its new key
    except (TypeError, KeyError, IndexError):
        return None
    if t["board"] not in BOARDS:
        return None
    SNAP["tickets"].append(t)
    return t


def last_run(n):
    """(ticket, end time, result) of the run this runner finished last, from its launcher log and result file.
    The logs hold whole agent transcripts (100 MB and more), so only the tail that holds the last 'pick: <ticket>' line is read."""
    key = end = None
    try:
        with open(RUNNER_STATE / f"runner-{n}.log", "rb") as f:
            size = f.seek(0, 2)
            span = 1 << 21
            while True:
                start = max(0, size - span)
                f.seek(start)
                data = f.read(size - start)
                at = len(data)
                while True:
                    at = data.rfind(b" pick: ", 0, at)
                    if at < 0 or TICKET.match(data[at + 7:at + 40].decode("utf-8", "replace")):
                        break
                if at >= 0 and (start == 0 or data.rfind(b"\n", 0, at) >= 0):
                    break
                if start == 0:
                    break
                span *= 4
        if at >= 0:
            lines = data[data.rfind(b"\n", 0, at) + 1:].decode("utf-8", "replace").splitlines()
            key, end = TICKET.match(lines[0].partition(" pick: ")[2])[0], lines[0].split()[0]
            for line in lines[1:]:
                if line.rstrip().endswith(" end"):
                    end = line.split()[0]
        result = (RUNNER_STATE / f"runner-{n}.result").read_text().strip()
    except OSError:
        return None
    return (key, end, result) if key else None


def stamp_time(stamp):
    try:
        return dt.datetime.fromisoformat(stamp.replace("Z", "+00:00"))
    except ValueError:
        return None


def resting(n, dry):
    """Tickets some runner ended IDLE on that have not changed since: they wait on someone else, so every runner takes other work.
    IDLE ends are kept in runner-N.idle, so later runs and 'nothing to start' lines do not make a runner forget.
    A runner that just finished still shows in its runner-N.result and log, so its IDLE counts before its file is written."""
    path = RUNNER_STATE / f"runner-{n}.idle"
    seen = {}
    try:
        for line in open(path):
            stamp, key = line.split()
            seen[key] = max(seen.get(key, ""), stamp)
    except (OSError, ValueError):
        pass
    last = last_run(n)
    if last and last[2] == "IDLE" and last[1] and seen.get(last[0]) != last[1]:
        seen[last[0]] = last[1]
        if not dry:
            with open(path, "a") as f:
                f.write(f"{last[1]} {last[0]}\n")
    everyone = dict(seen)
    for m in range(1, RUNNERS + 1):
        if m == n:
            continue
        try:
            for line in open(RUNNER_STATE / f"runner-{m}.idle"):
                stamp, key = line.split()
                everyone[key] = max(everyone.get(key, ""), stamp)
        except (OSError, ValueError):
            pass
        other = last_run(m)
        if other and other[2] == "IDLE" and other[1]:
            everyone[other[0]] = max(everyone.get(other[0], ""), other[1])
    now = dt.datetime.now(dt.timezone.utc)
    rest = set()
    for key, stamp in everyone.items():
        when = stamp_time(stamp)
        if when is None or (now - when).total_seconds() > REST_MAX:
            continue
        t = by_key(key)
        if t is None:
            if (now - when).total_seconds() < 7200:
                rest.add(key)
            continue
        changed = stamp_time(t["updated"])
        if changed and (changed - when).total_seconds() > REST_GRACE:
            continue
        rest.add(key)
    return rest


class Skip:
    """Tickets this pick hands out to nobody: other runners' claims (hard) and tickets resting after an IDLE end.
    A resting ticket with a BlockedBy link is governed by that link instead (held_back lets it go when the blocker is done).
    The link is read only when a resting ticket is actually considered, so a busy ledger costs no extra reads."""

    def __init__(self, hard, rest):
        self.hard, self.rest = hard, rest

    def __contains__(self, key):
        if key in self.hard:
            return True
        return key in self.rest and not relations(key)[0]


def lane_count(taken):
    """Runners that hold CI or infra work: by board assignment, plus claims the board does not show yet."""
    held = [t for t in SNAP["tickets"] if t["section"] in BOARDS[t["board"]][1] and in_lane(t)]
    runners = {n for t in held for n in names(t) if live_runner(n)}
    shown = {t["key"] for t in held if any(live_runner(n) for n in names(t))}
    return len(runners) + len({k for k in taken if k not in shown and by_key(k) and in_lane(by_key(k))})


def sf_eligible(t):
    labels = set(t["labels"])
    if labels & (SKIP_SF | CI_LABELS | SKIP_ALL) or t["subs"] or t["waiting"] or t["paid"] or t["key"] in SF_SKIP_TICKETS:
        return False
    if SF_LEAD in names(t):
        return False
    if "multiprompt" in labels and t["prio"] == "Urgent":
        return False
    try:
        hold = {l.split()[0] for l in open(SF_HOLD) if l.strip() and not l.startswith("#")}
    except OSError:
        hold = set()
    return t["key"] not in hold


def eligible_new(t):
    """May a runner start this ticket from its new-work column? Rules of the five old pickers."""
    labels = set(t["labels"])
    if labels & SKIP_ALL or t["waiting"] or not t["section"] in BOARDS[t["board"]][0]:
        return False
    if t["board"] == "2060":
        return sf_eligible(t)
    if t["board"] == "15" and not is_ci(t):
        return not labels & SKIP_APP and not any(h[1] for h in t["holders"])
    if t["board"] == "4060":
        return not labels & SKIP_INFRA
    return True


def orphan_ok(t):
    if t["board"] == "2060":
        return sf_eligible(t)
    return is_ci(t) or t["board"] != "15" or not set(t["labels"]) & SKIP_APP


def is_open(key):
    """Is this blocker still open? Tickets in a pick column are; any other is read once (done column or archived = closed)."""
    if by_key(key):
        return True
    known = SNAP.setdefault("open", {})
    if key not in known:
        d = ht("task", "get", key)
        try:
            raw = d["tasks"][0]
            known[key] = raw.get("status") != "Archive" and not raw.get("sectionIsDone")
        except (TypeError, KeyError, IndexError):
            known[key] = True  # unreadable: assume it still blocks
        save_cache(SNAP)
    return known[key]


def blocked(t):
    return any(is_open(w) for w in relations(t["key"])[0])


CHECKED = [0]


def held_back(t, own=False):
    """Waits on someone, so no runner takes it: Valentin Review, a marked Question to Valentin (not for the runner's own
    ticket), or an open BlockedBy link. The relation reads are capped per pick; out of reads, nothing unchecked is taken."""
    if not own and (t["section"] == "Valentin Review" or t["waiting"]):
        return True
    if t["key"] not in SNAP["rel"]:
        if CHECKED[0] >= BLOCK_LOOKUPS * 2:
            return True
        CHECKED[0] += 1
    return blocked(t)


def blocks_app(t):
    return any(PREFIX_BOARD.get(k.split("-")[0]) in ("15", "2060") for k in relations(t["key"])[1])


def park_ledger():
    """{ticket: stamp of its newest park job}, any runner. One line per job: ISO stamp, ticket, runner."""
    seen = {}
    try:
        for line in open(STATE / "parks"):
            stamp, key = line.split()[:2]
            seen[key] = max(seen.get(key, ""), stamp)
    except (OSError, ValueError):
        pass
    return seen


def parkable(t, ledger=None):
    """Is t, the unfinished ticket that blocks a runner, due a park job? It must sit in a building column and be nobody else's claim.
    A ticket gets one job per REST_MAX, so a park run that did not park cannot be retried within the rest window."""
    if t["section"] not in BOARDS[t["board"]][1] or t["key"] in SKIP[0].hard:
        return False
    when = stamp_time((park_ledger() if ledger is None else ledger).get(t["key"], ""))
    return when is None or (dt.datetime.now(dt.timezone.utc) - when).total_seconds() > REST_MAX


def record_park(n, key):
    STATE.mkdir(parents=True, exist_ok=True)
    with open(STATE / "parks", "a") as f:
        f.write(f"{dt.datetime.now(dt.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')} {key} {n}\n")


def try_claim(n, t, source, dry):
    """Claim t for Runner N. Returns True when it is ours, raises Pick for an own ticket found by a refusal."""
    adopting = t["board"] == "2060" or source in ("orphan", "incident-takeover")
    if dry and adopting:
        record_claim(n, t["key"], True)
        return True
    if adopting:
        ok = adopt(n, t, "Adopted from a runner that no longer works it; staying on it until it is live" if source != "board" else "Picked by fleet/pick")
        if ok and t["board"] == "2060" and t["section"] == "Todo":
            ceo(n, "task", "move", t["key"], "--section", "Doing")
        if ok:
            record_claim(n, t["key"], False)
        return ok
    rc, out = ship_claim(n, t["key"], source == "incident", dry)
    if rc == 0:
        record_claim(n, t["key"], dry)
        return True
    if rc == 4 and source != "incident":
        own = held_ticket(out)
        mine = fetch_ticket(own) if own else None
        if mine and own not in SKIP[0] and not held_back(mine, own=True):
            raise Pick(mine, "own")
        if mine and parkable(mine):  # parking clears both holds: ship-claim lets a parked ticket's open PR go too
            raise Pick(mine, "park")
        if mine:
            log(f"hold {t['key']}: unfinished {own} rests or waits (IDLE and unchanged, or BlockedBy open); its park job already ran "
                f"within the rest window or {own} is not in a building column. Park it with fleet/park")
            return False
        log(f"hold {t['key']}: {out.strip().splitlines()[-1] if out.strip() else 'no reason'}")
    return False


def pr_candidates(n, taken):
    """pr-drain-pick rules: draft PRs and red PRs idle for 6 hours, unowned or with a stale claim."""
    if SNAP["prs"] is None:
        tok = subprocess.run(["gh-app-token"], capture_output=True, text=True).stdout.strip()
        if not tok:
            raise RuntimeError("empty GitHub App token")
        r = subprocess.run(["gh", "pr", "list", "--repo", PR_REPO, "--base", "production", "--state", "open", "--limit", "1000",
                            "--json", "number,title,isDraft,headRefName,updatedAt,statusCheckRollup"],
                           capture_output=True, text=True, env=dict(os.environ, GH_TOKEN=tok), timeout=300)
        prs = json.loads(r.stdout)
        if not isinstance(prs, list) or len(prs) >= 1000:
            raise RuntimeError("incomplete PR list")
        SNAP["prs"] = [{"number": p["number"], "title": p["title"], "draft": p["isDraft"], "branch": p["headRefName"],
                        "updated": p["updatedAt"],
                        "red": any(c.get("conclusion") in ("FAILURE", "TIMED_OUT") or c.get("state") in ("FAILURE", "ERROR")
                                   for c in p.get("statusCheckRollup") or [])} for p in prs]
        save_cache(SNAP)
    now = dt.datetime.now(dt.timezone.utc)
    frozen = FREEZE.exists()
    out = []
    for p in SNAP["prs"]:
        idle = now - dt.datetime.fromisoformat(p["updated"].replace("Z", "+00:00"))
        if frozen:
            if "HYCI-" not in p["title"] or idle < dt.timedelta(minutes=30):
                continue
            key = (0, p["updated"], p["number"])
        elif p["draft"]:
            key = (1 if p["branch"].startswith("dependabot/") else 0, p["updated"], p["number"])
        elif p["red"] and idle > dt.timedelta(hours=6):
            key = (2, p["updated"], p["number"])
        else:
            continue
        if idle < dt.timedelta(hours=2) and not frozen:
            continue
        m = TICKET.search(p["title"])
        if not m:
            continue
        owner = PR_CLAIMS / str(p["number"]) / "owner"
        try:
            who, at = owner.read_text().split("\t")
            if who != f"RUNNER {n}" and now - dt.datetime.fromisoformat(at) < dt.timedelta(hours=3):
                continue
        except (OSError, ValueError):
            pass
        out.append((key, p, m[0]))
    return [(p, k) for _, p, k in sorted(out, key=lambda x: x[0])]


# ---------------------------------------------------------------- live incidents (YPER4-1375)

def fresh_claims():
    """Claims younger than FRESH_CLAIM: the run has not started yet, so no launcher log line shows it."""
    out, now = {}, time.time()
    try:
        for p in STATE.joinpath("claims").iterdir():
            if not p.name.startswith(".") and now - p.stat().st_mtime < FRESH_CLAIM:
                n, key = p.read_text().split("\t")[:2]
                out[key] = n
    except OSError:
        pass
    return out


def active_run(m):
    """The ticket Runner m is running right now, from its launcher log: the last 'cursor: KEY' line with no 'end'
    after it, started under CLAIM_TTL ago. None when idle, sleeping, or the log is missing."""
    key = stamp = None
    try:
        with open(RUNNER_STATE / f"runner-{m}.log", "rb") as f:
            f.seek(0, os.SEEK_END)
            f.seek(max(0, f.tell() - 65536))
            lines = f.read().decode(errors="replace").splitlines()
    except OSError:
        return None
    for line in lines:
        if line.endswith(" end"):
            key = None
        elif " cursor: " in line:
            found = TICKET.match(line.split(" cursor: ", 1)[1])
            if found:
                key, stamp = found[0], line.split(" ", 1)[0]
    if not key:
        return None
    try:
        age = (dt.datetime.now(dt.timezone.utc) - dt.datetime.fromisoformat(stamp.replace("Z", "+00:00"))).total_seconds()
    except ValueError:
        return None
    return key if age < CLAIM_TTL else None


def incident_runner(key, n):
    """The runner other than N that works incident KEY right now (running it, or just claimed it), else None."""
    virtual = virtual_claims().get(key)
    if virtual and virtual != str(n):
        return virtual
    fresh = fresh_claims().get(key)
    if fresh and fresh != str(n):
        return fresh
    for m in range(1, RUNNERS + 1):
        if m != n and active_run(m) == key:
            return str(m)
    return None


def just_ended(n, key):
    """Did Runner N end a run on KEY less than 30 minutes ago? Then it does not spin on it again at once."""
    last = last_run(n)
    if not last or last[0] != key or not last[1]:
        return False
    try:
        end = dt.datetime.fromisoformat(last[1].replace("Z", "+00:00"))
    except ValueError:
        return False
    return (dt.datetime.now(dt.timezone.utc) - end).total_seconds() < 1800


def incident_step(n, dry):
    """Step 0. The open incident that no other runner works, oldest and most urgent first. Lane cap, app freeze,
    rests and the skip sets of the other steps do not apply; only brain-extra-hard and design-pass tickets (which
    ship-claim refuses) and tickets that wait on a person are left out."""
    me = f"runner {n}"
    cands = [t for t in SNAP.get("incidents") or []
             if t["board"] in INCIDENT_BOARDS and not t["waiting"] and t["section"] != "Valentin Review" and not set(t["labels"]) & (SKIP_ALL | {"design-pass"})]
    for t in sorted(cands, key=lambda t: (rank(t), t["created"])):
        if incident_runner(t["key"], n):
            continue
        if me in names(t):
            if just_ended(n, t["key"]):
                continue
            record_claim(n, t["key"], dry)
            return t, "incident"
        stale = any(live_runner(h) for h in names(t))  # assigned to a runner that is not running it: take it over
        if try_claim(n, t, "incident-takeover" if stale else "incident", dry):
            return t, "incident"
    return None


def choose(n, dry):
    hit = incident_step(n, dry)
    if hit:
        return hit
    me = f"runner {n}"
    taken = {**claim_files(), **virtual_claims()}
    others = {k for k, who in taken.items() if who != str(n)}
    mine_claim = [k for k, who in taken.items() if who == str(n)]
    skip = Skip(others, resting(n, dry))
    SKIP[0] = skip
    building = [t for t in SNAP["tickets"] if t["section"] in BOARDS[t["board"]][1]]

    # a. own ticket
    for t in sorted((t for t in building if me in names(t) and t["section"] != "QA" and not set(t["labels"]) & SKIP_ALL),
                    key=lambda t: (BOARD_ORDER[t["board"]], rank(t))):
        if t["key"] not in skip and not held_back(t, own=True):
            return t, "own"
    qa_mine = [t for t in building if me in names(t) and t["section"] == "QA"]
    if qa_mine:
        theirs = sorted((t for t in building if t["section"] == "QA" and t["key"] not in skip and not set(t["labels"]) & SKIP_ALL
                         and any(live_runner(h) and h != me for h in names(t)) and "design-pass" not in t["labels"]),
                        key=lambda t: t["key"])
        if theirs:
            return theirs[n % len(theirs)], "cross-qa"
    full = lambda: lane_count(others) >= LANE_CAP
    frozen = FREEZE.exists()

    # b. orphans
    for t in sorted((t for t in building if orphan(t) and t["key"] not in skip and not t["waiting"]
                     and not set(t["labels"]) & (SKIP_ALL | {"design-pass"}) and orphan_ok(t)),
                    key=lambda t: (rank(t), t["updated"])):
        if (in_lane(t) and full()) or (frozen and not in_lane(t)) or held_back(t):
            continue
        if try_claim(n, t, "orphan", dry):
            return t, "orphan"

    # new work, ordered by priority across every board (Valentin 2026-11-07: use the priority field)
    new = [t for t in SNAP["tickets"] if t["key"] not in skip and t["key"] not in mine_claim and eligible_new(t)
           and free_for(t, me)]
    new.sort(key=lambda t: (rank(t), t["created"]))
    lane_new = [t for t in new if in_lane(t)]
    app_new = [t for t in new if not in_lane(t)]
    tries = 0

    def attempt(cands):
        nonlocal tries
        for t in cands:
            if tries >= 8:
                return None
            if held_back(t):
                continue
            tries += 1
            if try_claim(n, t, "board", dry):
                return t
        return None

    # c0. Urgent app work on any board goes before the PR queue
    if not frozen:
        t = attempt(sorted((x for x in app_new if x["prio"] == "Urgent"), key=lambda t: (t["created"], BOARD_ORDER[t["board"]])))
        if t:
            return t, "board"

    # c. PR queue
    for p, key in pr_candidates(n, others):
        t = fetch_ticket(key)
        if (not t or t["key"] in skip or set(t["labels"]) & (SKIP_ALL | {"design-pass"})
                or any(live_runner(h) and h != me for h in names(t))):
            continue
        if (in_lane(t) and full()) or (frozen and not in_lane(t)) or held_back(t):
            continue
        if try_claim(n, t, "pr", dry):
            return t, "pr"

    if not full():
        # one relations read per ticket is slow, so only the top BLOCK_LOOKUPS non-Urgent tickets are checked
        pref = [t for t in lane_new if t["prio"] == "Urgent"]
        pref += [t for t in [x for x in lane_new if x["prio"] != "Urgent"][:BLOCK_LOOKUPS] if blocks_app(t)]
        t = attempt(sorted(pref, key=lambda t: (t["prio"] != "Urgent", rank(t), t["created"])))
        if t:
            return t, "ci-lane"
    if not frozen:
        t = attempt(sorted(app_new, key=lambda t: (rank(t), BOARD_ORDER[t["board"]], t["created"])))
        if t:
            return t, "board"
    if not full():
        t = attempt(lane_new)
        if t:
            return t, "ci-lane"
    raise SystemExit("none: no free ticket the pool may take" + (" (app freeze: CI and infra only)" if frozen else ""))


def render(n, t, source):
    label, model, effort = brain(t)
    ln = lane(t)
    brief_file = HERE / "briefs" / {"app": "app.txt", "ci": "ci.txt", "infra": "infra.txt", "sf": "sf.txt"}[ln]
    brief = (brief_file.read_text() + (HERE / "briefs" / "park.txt").read_text().rstrip()).replace("$n", str(n))
    if source == "park":
        brief_file = HERE / "briefs" / "park-job.txt"
        brief = brief_file.read_text().replace("$n", str(n)) + "\n" + (HERE / "briefs" / "park.txt").read_text().rstrip()
        label, model, effort = ("brain-light", *paced_models().get("park", PARK_BRAIN[1:]))
    if source == "incident":
        brief_file = HERE / "briefs" / ("release-stop.txt" if t["board"] == "11514" else "incident.txt")
        brief = brief_file.read_text().replace("$n", str(n)) + "\n" + brief
        label, model, effort = ("brain-hard", *paced_models().get("incident", ("grok-4.7-high", "high")))
    return {"runner": n, "ticket": t["key"], "board": t["board"], "section": t["section"], "lane": ln, "source": source,
            "title": t["title"], "url": url(t), "repo": repo_for(t), "brief_file": str(brief_file), "brief": brief,
            "brain": label, "model": model, "effort": effort, "labels": t["labels"]}


def self_test():
    """The park hand-back: due once per rest window, never for a foreign claim or a ticket outside a building column, and the
    job's brief and model. Needs no board, no network."""
    global STATE, ALLOCATION, RUNNER_STATE
    import tempfile
    STATE = Path(tempfile.mkdtemp())
    ALLOCATION = STATE / "allocation.json"
    RUNNER_STATE = STATE
    t = {"key": "HTPR-1", "idx": 1, "board": "15", "section": "In Progress", "title": "x", "labels": [], "prio": "Medium"}
    SKIP[0] = Skip(set(), set())
    assert parkable(t), "a resting building ticket with no job yet is due one"
    record_park(3, "HTPR-1")
    assert not parkable(t), "a job handed out within REST_MAX is not repeated, whatever its outcome"
    old = (dt.datetime.now(dt.timezone.utc) - dt.timedelta(seconds=REST_MAX + 60)).strftime("%Y-%m-%dT%H:%M:%SZ")
    assert parkable(t, {"HTPR-1": old}), "the window ends after REST_MAX"
    assert not parkable({**t, "section": "Bugs"}, {}), "only building columns"
    assert parkable({**t, "key": "HTPR-9"}), "a job for one ticket does not block another"
    SKIP[0] = Skip({"HTPR-1"}, set())
    assert not parkable(t, {}), "another runner's claim is never parked"
    SKIP[0] = Skip(set(), set())
    job = render(5, t, "park")
    assert job["source"] == "park" and job["model"] == "grok-4.7-medium" and job["brain"] == "brain-light"
    assert "PARK RUN" in job["brief"] and "fleet/park <TICKET> --waits-on" in job["brief"] and "$n" not in job["brief"]
    assert "ENGINE" not in job["brief"] and job["brief_file"].endswith("briefs/park-job.txt")
    assert "PARK RUN" not in render(5, t, "board")["brief"]
    hard = {**t, "labels": ["brain-hard"]}
    assert brain(hard)[1:] == ("grok-4.7-high", "high"), "no allocation: the built-in map"
    m = {"light": {"id": "composer-2.5", "effort": "medium"}, "medium": {"id": "composer-2.5", "effort": "medium"},
         "hard": {"id": "grok-4.7-medium", "effort": "medium"}, "park": {"id": "composer-2.5", "effort": "low"}}
    ALLOCATION.write_text(json.dumps({"at": time.time(), "engine": "cursor", "models": m}))
    assert brain(hard)[1:] == ("grok-4.7-medium", "medium"), "a fresh Cursor allocation sets the model"
    assert render(5, t, "park")["model"] == "composer-2.5", "the allocation sets the park model"
    ALLOCATION.write_text(json.dumps({"at": time.time() - 7200, "engine": "cursor", "models": m}))
    assert brain(hard)[1] == "grok-4.7-high", "a stale allocation is ignored"
    ALLOCATION.write_text(json.dumps({"at": time.time(), "engine": "hax", "models": m}))
    assert brain(hard)[1] == "grok-4.7-high", "an allocation for another engine is ignored: only Cursor runs here"
    ALLOCATION.write_text("{not json")
    assert brain(hard)[1] == "grok-4.7-high", "a broken allocation is ignored"
    held = {**t, "holders": [("runner 12", None)]}
    assert not orphan(held), "a live runner's ticket is not an orphan"
    (STATE / "stop-12").write_text("pacer\n")
    assert orphan(held), "a ticket held by a runner the pacer stopped is an orphan: live runners adopt it"
    (STATE / "stop-12").write_text("manual\n")
    assert not orphan(held), "a hand-made stop file does not hand the ticket away"
    print("fleet/pick self-test ok")


def main():
    global SNAP
    args = [a for a in sys.argv[1:]]
    if "--check-access" in args:
        return check_access()
    if args == ["--self-test"]:
        return self_test()
    dry = "--dry-run" in args
    pos = [a for a in args if not a.startswith("--")]
    if len(pos) != 1 or not pos[0].isdigit() or not 1 <= int(pos[0]) <= max(RUNNERS, 1):
        sys.exit(f"usage: fleet/pick <1..{RUNNERS}> [--dry-run] [--json] | --check-access")
    n = int(pos[0])
    lock = None
    if not dry:
        STATE.mkdir(parents=True, exist_ok=True)
        lock = open(STATE / ".lock", "a")
        fcntl.flock(lock, fcntl.LOCK_EX)
    try:
        SNAP = load_snapshot()
        try:
            t, source = choose(n, dry)
        except Pick as p:
            t, source = p.t, p.source
        if source in ("own", "cross-qa", "park"):
            record_claim(n, t["key"], dry)
        if source == "park" and not dry:
            record_park(n, t["key"])
        pick = render(n, t, source)
    except (RuntimeError, OSError, ValueError) as e:
        sys.exit(f"fleet/pick: board or claims unreadable ({type(e).__name__}: {e}); do not pick new work")
    if "--json" in args:
        print(json.dumps(pick))
    else:
        print("\t".join([pick["ticket"], pick["model"], pick["effort"], f"{pick['source']}{' (dry run)' if dry else ''}",
                         pick["lane"], pick["repo"]]))


# ---------------------------------------------------------------- access check

def check_access():
    """Read only: does Runner 1..N have a login file, and sit on each board? Prints no secrets."""
    cred = HOME / ".config/hypertask-agents/credentials/sessions"
    members = {}
    for b in BOARDS:
        d = ht("project", "members", "--project", b)
        members[b] = {(m.get("displayName") or "").lower() for m in (d or {}).get("members") or []} if d else None
    ids = {}
    d = ht("agents", "list", "--query", "Runner", "--limit", "200")
    for a in (d or {}).get("agents") or []:
        if re.fullmatch(r"Runner \d+", a.get("display_name") or ""):
            ids[a["display_name"].lower()] = a["id"]
    print("runner\tlogin\ttoken\t" + "\t".join(BOARDS) + "\tmissing")
    missing_any = []
    for n in range(1, RUNNERS + 1):
        name = f"runner {n}"
        token = (cred / f"runner-{n}-agent-token").is_file()
        row = ["yes" if name in ids else "NO", "yes" if token else "NO"]
        miss = []
        for b in BOARDS:
            ok = None if members[b] is None else name in members[b]
            row.append("?" if ok is None else "yes" if ok else "NO")
            if ok is False:
                miss.append(b)
        print(f"Runner {n}\t" + "\t".join(row) + "\t" + ",".join(miss))
        missing_any += [(n, b) for b in miss]
    if missing_any:
        print("\nAdd a missing member (board owner or Valentin's login), per board:")
        print("  hypertask project invite <board-id> --user <agent-uuid>")
        print("or with the management key:")
        print("  hypertask agents update --id <agent-uuid> --add-project <board-id>")
        for n, b in missing_any:
            print(f"  Runner {n} board {b}: hypertask project invite {b} --user {ids.get(f'runner {n}', '<no login found>')}")


if __name__ == "__main__":
    main()
