DRY_RUN = "--dry-run" in sys.argv


def access_incident(n, board, reason):
    """Record one runner missing from one board, at most once an hour per runner and board."""
    if DRY_RUN:
        return
    path = WATCH / "incidents.jsonl"
    now = time.time()
    try:
        lines = path.read_text().splitlines()[-500:]
    except OSError:
        lines = []
    for line in reversed(lines):
        try:
            hit = json.loads(line)
        except ValueError:
            continue
        if (hit.get("kind") == "board-access" and hit.get("runner") == f"runner {n}"
                and hit.get("board") == board):
            if now - hit.get("at", 0) < MEMBERS_INCIDENT_TTL:
                return
            break
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a") as f:
        f.write(json.dumps({"at": now, "kind": "board-access", "runner": f"runner {n}",
                            "board": board, "reason": reason}) + "\n")


def check_all_members(board, names):
    """An hourly membership read finds every roster runner missing from the board, so an owner can add them."""
    for n in range(1, RUNNERS + 1):
        if f"runner {n}" not in names:
            access_incident(n, board, "missing from board")


def fetch_members(board):
    d = ht("project", "members", "--project", board)
    return {(m.get("displayName") or "").lower() for m in (d or {}).get("members") or []} if d else None


def board_members(board, max_age=MEMBERS_TTL):
    """Who may join this board, cached an hour (a dry run reads the cache but never writes it). Unreadable: the stale cache, else None."""
    if board not in MEMBERS or max_age < MEMBERS_TTL:
        path = STATE / "members.json"
        try:
            cached = json.loads(path.read_text())
        except (OSError, ValueError):
            cached = {}
        hit = cached.get(board) or {}
        if time.time() - hit.get("at", 0) < max_age:
            MEMBERS[board] = set(hit["names"])
        else:
            fresh = fetch_members(board)
            MEMBERS[board] = fresh if fresh is not None else (set(hit["names"]) if hit else None)
            if fresh is not None and not DRY_RUN:
                cached[board] = {"at": time.time(), "names": sorted(fresh)}
                STATE.mkdir(parents=True, exist_ok=True)
                tmp = f"{path}.{os.getpid()}"
                json.dump(cached, open(tmp, "w"))
                os.replace(tmp, path)
            if fresh is not None:
                check_all_members(board, fresh)
    return MEMBERS[board]


def can_join(n, board):
    """May Runner n claim tickets on this board? ship-claim refuses a login the board did not add ("the board decides who may
    join it"), so the picker never offers those tickets. Membership unknown: offer them, ship-claim stays the backstop."""
    names = board_members(board)
    if names is not None and f"runner {n}" not in names and (n, board) not in LOGGED:
        access_incident(n, board, "not a member when picked")
        names = board_members(board, MEMBERS_MISS_TTL)  # once per pick: a board may have added the runner since the read
    if names is None or f"runner {n}" in names:
        return True
    if (n, board) not in LOGGED:
        LOGGED.add((n, board))
        log(f"runner {n} is not a member of board {board}: its tickets are not offered")
    return False


