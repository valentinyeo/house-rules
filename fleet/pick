        assert (t["key"], source) == ("HTPR-40", "park"), "an own ticket that rests is parked before anything else"
        (STATE / "runner-1.idle").unlink()
        # a runner whose login the board never added is offered nothing from it (HYCI-159: ship-claim refused Runner 5)
        set_members("11514", {"runner 1"})
        SNAP = {"tickets": [tk("HYCI-1", "Backlog")], "rel": {"HYCI-1": [[], []]}, "prs": [], "incidents": [], "open": {}}
        assert can_join(1, "11514") and not can_join(2, "11514") and can_join(2, "15")
        assert choose(1, True)[0]["key"] == "HYCI-1", "a member is offered the board's ticket"
        try:
            choose(2, True)
            raise AssertionError("offered a ticket on a board the runner is not a member of")
        except SystemExit as e:
            assert str(e).startswith("none:"), e
        # cap hit, Fleet CI & Infra blocker offered: Urgent and open-BlockedBy tickets go out, a plain one and a non-member do not
        set_members("11514", {"runner 1"})
        full_wip = [tk("HTPR-50", "In Progress", "runner 2"), tk("HTPR-51", "AI Review", "runner 2"), tk("HTPR-52", "Bugs")]
        ci = [tk("HYCI-2", "Backlog"), tk("HYCI-3", "Backlog"), tk("HYCI-4", "Backlog")]
        ci[2]["prio"] = "Urgent"
        SNAP = {"tickets": full_wip + ci, "rel": {t["key"]: [[], []] for t in full_wip + ci}, "prs": [], "incidents": [], "open": {}}
        SNAP["rel"]["HYCI-3"] = [[], ["HTPR-52"]]
        assert pipeline()[0] == {"HTPR-50", "HTPR-51"} and len(pipeline()[1]) == 2
        assert [t["key"] for t in ci_blockers(ci)] == ["HYCI-4", "HYCI-3"], "Urgent first, then the one an open ticket waits on"
        assert choose(1, True) == (ci[2], "kept-slot"), "cap hit: an Urgent checks ticket still goes out on the kept slot"
        ci[2]["prio"] = "Medium"
        assert choose(1, True) == (ci[1], "kept-slot"), "cap hit: a checks ticket an open ticket waits on still goes out"
        SNAP["rel"]["HYCI-3"] = [[], []]
        assert choose(1, True) == (ci[0], "kept-slot"), "cap hit: the kept slot still takes a plain checks ticket"
        gate_rows("HYCI-2")
        assert picked(1) != "HYCI-2", "wait gate: the kept slot leaves a gated ticket"
        gate_rows()
        (STATE / "runner-2.log").write_text(f"{iso(0.05)} cursor: HYCI-2 composer-2.5 medium\n")
        RUNNING.clear()
        slot_logs.clear()
        try:
            choose(1, True)
            raise AssertionError("held slot let a second runner start a plain checks ticket at the cap")
        except SystemExit as e:
            assert "new work closed" in str(e), e
        assert any(s.startswith("kept slot: held on HYCI-2") for s in slot_logs), slot_logs
        (STATE / "runner-2.log").unlink()
        RUNNING.clear()
        SNAP["rel"]["HYCI-3"] = [[], ["HTPR-52"]]
        set_members("11514", {"runner 2"})
        try:
            choose(1, True)
            raise AssertionError("cap hit: a non-member was offered a Fleet CI & Infra ticket")
        except SystemExit as e:
            assert "new work closed" in str(e), e
        # every runner that is picking while the others are on app work still gets the blocker
        set_members("11514", {"runner 1", "runner 2"})
        (STATE / "runner-2.log").write_text(f"{iso(0.05)} cursor: HTPR-50 composer-2.5 medium\n")
        RUNNING.clear()
        ci[2]["prio"] = "Urgent"
        assert choose(1, True) == (ci[2], "kept-slot"), "busy pool: the free runner still takes the blocker"
        # HYCI-277: a Backlog alarm that waits on an open ticket is not the kept slot. A closed blocker offers it again.
        alarm = tk("HYCI-277", "Backlog")
        alarm["prio"] = "Urgent"
        blocker = tk("HYCI-233", "Agent Blocked", "runner 9")
        plain = tk("HYCI-1", "Backlog")
        SNAP["tickets"] = [alarm, blocker, plain]
        SNAP["rel"] = {"HYCI-277": [["HYCI-233"], []], "HYCI-233": [[], ["HYCI-277"]], "HYCI-1": [[], []]}
        SNAP["prs"] = []
        SNAP["open"] = {}
        CHECKED[0] = 0
        set_members("11514", {"runner 1", "runner 2"})
        got = choose(2, True)
        assert (got[0]["key"], got[1]) == ("HYCI-1", "kept-slot"), got
        SNAP["tickets"] = [alarm, plain]
        SNAP["rel"] = {"HYCI-277": [["HYCI-233"], []], "HYCI-1": [[], []]}
        SNAP["open"] = {"HYCI-233": False}
        got = choose(2, True)
        assert (got[0]["key"], got[1]) == ("HYCI-277", "kept-slot"), got
        (STATE / "runner-2.log").unlink()
        RUNNING.clear()
        SNAP["tickets"] = [tk("HTPR-50", "AI Review")]
        SNAP["prs"] = [pr(100001, "HTPR-50")]
        SNAP["rel"] = {"HTPR-50": [[], []]}
        assert pr_orphan_rank(SNAP["prs"][0]) is not None, "a green PR on an orphan building ticket is a PR-queue candidate"
    finally:
        try_claim = real_claim
        log = real_log
        (STATE / "stop-3").unlink()


def main():
    global SNAP
    args = [a for a in sys.argv[1:]]
    if "--check-access" in args:
        return check_access()
    if args == ["--self-test"]:
        return self_test()
    if args[:1] == ["--replay-waits"]:  # offline: what the wait gate would have held in the last N days (default 7), from the ledger
        replay_waits(int(args[1]) if len(args) > 1 and args[1].isdigit() else 7)
        return
    if args == ["--wip"]:  # read only: the WIP line every pick logs, and the units behind it
        SNAP = load_snapshot()
        units, workers, excluded = pipeline()
        print(wip_line(units, workers, excluded))
        print("units: " + " ".join(sorted(units)))
        print("workers: " + " ".join(f"Runner {m}" for m in workers))
        for why, keys in sorted(excluded.items()):
            print(f"not counted, {why}: {' '.join(sorted(keys))}")
        return
    dry = "--dry-run" in args
    pos = [a for a in args if not a.startswith("--")]
    if len(pos) != 1 or not pos[0].isdigit() or not 1 <= int(pos[0]) <= max(RUNNERS, 1):
        sys.exit(f"usage: fleet/pick <1..{RUNNERS}> [--dry-run] [--json] | --check-access")
    n = int(pos[0])
    engine = runner_engine(n)
    if not engine:
        sys.exit(f"fleet/pick: runner {n} engine file names no known engine ({', '.join(ENGINES)}); do not pick")
    set_engine(engine)
    lock = None
    if not dry:
        STATE.mkdir(parents=True, exist_ok=True)
        lock = open(STATE / ".lock", "a")
        fcntl.flock(lock, fcntl.LOCK_EX)
    t = source = None
    ending = "picked"
    try:
        SNAP = load_snapshot()
        try:
            t, source = choose(n, dry)
        except Pick as p:
            t, source = p.t, p.source
        if source in ("own", "cross-qa", "park"):
            record_claim(n, t["key"], dry)
        if source == "park" and not dry:
            record_park(n, t["key"])
        pick = render(n, t, source)
    except SystemExit as e:
        ending = str(e.code)
        raise
    except (RuntimeError, OSError, ValueError) as e:
        ending = f"unreadable: {type(e).__name__}: {e}"
        sys.exit(f"fleet/pick: board or claims unreadable ({type(e).__name__}: {e}); do not pick new work")
    finally:
        write_trace(n, dry, t, source, ending)
    if "--json" in args:
        print(json.dumps(pick))
    else:
        print("\t".join([pick["ticket"], pick["model"], pick["effort"], f"{pick['source']}{' (dry run)' if dry else ''}",
                         pick["lane"], pick["repo"]]))


# ---------------------------------------------------------------- access check

def check_access():
    """Read only: does Runner 1..N have a login file, and sit on each board? Prints no secrets."""
    cred = HOME / ".config/hypertask-agents/credentials/sessions"
    members = {}
    for b in BOARDS:
        members[b] = fetch_members(b)
    ids = {}
    d = ht("agents", "list", "--query", "Runner", "--limit", "200")
    for a in (d or {}).get("agents") or []:
        if re.fullmatch(r"Runner \d+", a.get("display_name") or ""):
            ids[a["display_name"].lower()] = a["id"]
    print("runner\tlogin\ttoken\t" + "\t".join(BOARDS) + "\tmissing")
    missing_any = []
    for n in range(1, RUNNERS + 1):
        name = f"runner {n}"
        token = (cred / f"runner-{n}-agent-token").is_file()
        row = ["yes" if name in ids else "NO", "yes" if token else "NO"]
        miss = []
        for b in BOARDS:
            ok = None if members[b] is None else name in members[b]
            row.append("?" if ok is None else "yes" if ok else "NO")
            if ok is False:
                miss.append(b)
        print(f"Runner {n}\t" + "\t".join(row) + "\t" + ",".join(miss))
        missing_any += [(n, b) for b in miss]
    if missing_any:
        print("\nAdd a missing member (board owner or Valentin's login), per board:")
        print("  hypertask project invite <board-id> --user <agent-uuid>")
        print("or with the management key:")
        print("  hypertask agents update --id <agent-uuid> --add-project <board-id>")
        for n, b in missing_any:
            print(f"  Runner {n} board {b}: hypertask project invite {b} --user {ids.get(f'runner {n}', '<no login found>')}")


if __name__ == "__main__":
    main()
