def factory_stop_self_test():
    """HYCI-342: an active stop record takes every ticket except incidents. Absent, cleared: runs.
    HYCI-345: a cleared record with a ramp step caps how many runners take work, and the log names the cap."""
    global FACTORY_STOP
    saved = FACTORY_STOP
    tmp = STATE / "factory-stop-test.json"
    try:
        FACTORY_STOP = tmp
        tmp.unlink(missing_ok=True)
        assert factory_stopped() == "", "no record: the factory runs"
        assert factory_ramp() == (3, None), "no record: no cap"
        tmp.write_text(json.dumps({"at": "x", "tripped_by": ["R1", "R3"], "cleared": None}))
        assert factory_stopped() == "R1, R3", "an active record names its rules"
        assert factory_ramp() == (3, None), "a stopped record caps nothing: the stop already holds every runner"
        tmp.write_text(json.dumps({"at": "x", "tripped_by": ["R1"], "cleared": {"at": "y", "by": "t", "why": "t"}}))
        assert factory_stopped() == "", "a cleared record: the factory runs"
        assert factory_ramp() == (3, None), "a clear from before restart steps keeps every runner"
        tmp.write_text("{not json")
        assert factory_stopped() == "unreadable stop record", "an unreadable record stops the factory"
        assert factory_ramp() == (3, None), "an unreadable record caps nothing"
        tmp.write_text(json.dumps({"at": "x", "tripped_by": ["R2"], "cleared": None}))
        # an incident still goes out first
        saved_inc = incident_step
        globals()["incident_step"] = lambda n, dry: ({"key": "I-1"}, "incident")
        assert choose(5, True)[1] == "incident", "a stopped factory still takes an incident"
        globals()["incident_step"] = saved_inc

        def ramped(step):
            tmp.write_text(json.dumps({"at": "x", "tripped_by": ["R2"], "cleared": {
                "at": "y", "by": "t", "why": "t", "ramp": {"step": step, "at": "y"}}}))

        def exit_msg(n):
            """The message choose() ends on: the ramp guard runs before any ticket work, so the rest of the board is empty here."""
            try:
                choose(n, True)
                return ""
            except SystemExit as e:
                return str(e)

        saved_log, saved_snap, saved_inc, saved_eng, saved_n = log, SNAP, incident_step, runner_engine, RUNNERS
        lines = []
        globals()["log"], globals()["incident_step"] = lines.append, lambda n, dry: None
        globals()["SNAP"] = {"tickets": [], "rel": {}, "prs": [], "incidents": [], "open": {}}
        engines = {1: "opencode", 2: "opencode", 3: "opencode", 4: "opencode", 5: "codex"}
        globals()["runner_engine"], globals()["RUNNERS"] = engines.get, 5
        RUNNING.clear()
        RUNNING.update({m: None for m in engines})
        try:
            # Valentin 13 Nov, "one runner PER plan": the cap counts runners of the same plan in a run, not the runner number
            ramped(1)
            assert factory_ramp() == (1, 1) and not factory_stopped(), "a cleared step 1 record runs"
            assert "factory restart" not in exit_msg(1), "no opencode runner in a run: runner 1 goes"
            assert "factory restart step 1/3: 1 runner(s)" in lines, "the picker log names the cap"
