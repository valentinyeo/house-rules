def fresh_claims():
    """Claims younger than FRESH_CLAIM: the run has not started yet, so no launcher log line shows it."""
    out, now = {}, time.time()
    try:
        for p in STATE.joinpath("claims").iterdir():
            if not p.name.startswith(".") and now - p.stat().st_mtime < FRESH_CLAIM:
                n, key = p.read_text().split("\t")[:2]
                out[key] = n
    except OSError:
        pass
    return out


def active_run(m):
    """The ticket Runner m is running right now, from its launcher log: the last 'cursor: KEY' or 'hax: KEY' line with no
    'end' after it, started under CLAIM_TTL ago. None when idle, sleeping, or the log is missing."""
    key = stamp = None
    try:
        with open(RUNNER_STATE / f"runner-{m}.log", "rb") as f:
            f.seek(0, os.SEEK_END)
            f.seek(max(0, f.tell() - 65536))
            lines = f.read().decode(errors="replace").splitlines()
    except OSError:
        return None
    for line in lines:
        if line.endswith(" end"):
            key = None
        elif RUN_START.match(line):
            found = TICKET.match(RUN_START.match(line)[1])
            if found:
                key, stamp = found[0], line.split(" ", 1)[0]
    if not key:
        return None
    try:
        age = (dt.datetime.now(dt.timezone.utc) - dt.datetime.fromisoformat(stamp.replace("Z", "+00:00"))).total_seconds()
    except ValueError:
        return None
    return key if age < CLAIM_TTL else None


def incident_runner(key, n):
    """The runner other than N that works incident KEY right now (running it, or just claimed it), else None."""
    virtual = virtual_claims().get(key)
    if virtual and virtual != str(n):
        return virtual
    fresh = fresh_claims().get(key)
    if fresh and fresh != str(n):
        return fresh
    # a runner that ended on it under 30 minutes ago is waiting on its checks and comes back to it; a takeover would only
    # pile runners on one incident (HYCI-282 had runners 8, 10 and 12 assigned within 33 minutes, 11 Nov)
    for m in range(1, RUNNERS + 1):
        if m != n and (active_run(m) == key or just_ended(m, key)):
            return str(m)
    return None


def just_ended(n, key):
    """Did Runner N end a run on KEY less than 30 minutes ago? Then it does not spin on it again at once."""
    last = last_run(n)
    if not last or last[0] != key or not last[1]:
        return False
    try:
        end = dt.datetime.fromisoformat(last[1].replace("Z", "+00:00"))
    except ValueError:
        return False
    return (dt.datetime.now(dt.timezone.utc) - end).total_seconds() < 1800


def incident_step(n, dry):
    """Step 0. The open incident that no other runner works, oldest and most urgent first. Lane cap, app freeze and the
    skip sets of the other steps do not apply; an open BlockedBy link and a fresh IDLE rest (10 minutes, Urgent) do; only brain-extra-hard and design-pass tickets (which
    ship-claim refuses) and tickets that wait on a person are left out."""
    me = f"runner {n}"
    cands = [t for t in SNAP.get("incidents") or []
             if t["board"] in INCIDENT_BOARDS and free_for(t, me) and can_join(n, t["board"]) and not t["waiting"] and t["section"] != "Valentin Review" and not set(t["labels"]) & {"brain-extra-hard", "design-pass"}]
    rest = None
    for t in sorted(cands, key=lambda t: (rank(t), t["created"])):
        if incident_runner(t["key"], n):
            continue
        # An incident that waits on open tickets, or that a runner just ended waiting on (Urgent: 10 minute rest), is not
        # re-run: HYCI-309 (waits on HYCI-298, HYCI-299) took 9 Sol high runs in one hour, each ending "waits-on" (11 Nov).
        if rest is None:
            rest = resting(n, dry)
        if t["key"] in rest or ("rel" in SNAP and any(is_open(w) for w in relations(t["key"])[0])):
            note(t["key"], "incident waits on open tickets or rests after an IDLE end")
            continue
        if me in names(t):
            if just_ended(n, t["key"]):
                continue
            record_claim(n, t["key"], dry)
            return t, "incident"
        stale = any(live_runner(h) for h in names(t))  # assigned to a runner that is not running it: take it over
        if try_claim(n, t, "incident-takeover" if stale else "incident", dry):
            return t, "incident"
    return None


# ---------------------------------------------------------------- WIP cap (one runner, one ticket, until it is live)

def live_workers():
    return [m for m in range(1, RUNNERS + 1) if live_runner(f"runner {m}")]


def pool_skip(workers):
    """Brains no live runner's engine can do: nobody in the pool can finish those, so they are not the pool's pipeline."""
    can = {b for m in workers for b in ENGINES.get(runner_engine(m) or "", {}).get("brains", {})}
    return BASE_SKIP | {f"brain-{b}" for b in BRAINS if b not in can}


def pipeline_reason(t, skip_brains, pr, rest=frozenset()):
    """Why t is not a unit of the pool's pipeline, or None when it is. A unit is work some lane that stays open under the
    cap can take (own, orphan, cross-qa, PR queue, finish), so a closed cap can always drain."""
    labels = set(t["labels"])
    if in_not_now(t):
        return "not now"
    if INCIDENT_LABEL in labels:
        return "incident"
    if WASTED in labels:
        return "wasted runs"
    if labels & skip_brains:
        return "brain"
    if t["waiting"] or t["section"] == "Valentin Review":
        return "waits on a person"
    # a runner ended IDLE on it and nothing changed since: every lane skips it (Skip), so counting it would close new work
    # with nobody able to drain it (2026-11-08: 8 of 11 units resting held 3 runners idle)
    if t["key"] in rest:
        return "resting"
    if any(not re.fullmatch(r"runner \d+", h) and not retired(h) for h in names(t)):
        return "outside the pool"
    held = any(live_runner(h) for h in names(t))
    # an unheld ticket's link is read within the pick's relation budget, as the orphan lane does: a blocked orphan no lane takes
    if (t["key"] in SNAP["rel"] or (not held and CHECKED[0] < BLOCK_LOOKUPS * 2)) and held_back(t, own=True):
        return "blocked"
    if t["section"] in BOARDS[t["board"]][1]:
        if "design-pass" in labels:
            return "design-pass"
        if not held and not orphan_ok(t):
            return "not for the pool"
        return None
    if pr and not held and eligible_new(t):
        return None
    return "no lane"


def may_join(n, board):
    """Same answer as can_join, without the membership incident. The cap check asks every runner."""
    names = board_members(board)
    return names is None or f"runner {n}" in names


def worker_can_adopt(m, t):
    """Could free runner m take t on a lane that stays open: its brain, its boards, and a checks slot when t is checks work."""
    e = runner_engine(m)
    if not e or engine_skips(e, t):
        return False
    if not may_join(m, t["board"]):
        return False
    if in_lane(t) and lane_count(set()) >= LANE_CAP:
        return False
    if FREEZE.exists() and not in_lane(t):
        return False
    return True


def pipeline():
    """(units, workers, excluded {reason: [keys]}): tickets in a building column on any fleet board plus tickets in a
    new-work column with an open PR, one unit per ticket key, against live pool runners. An unheld ticket is a unit
    only when some runner who is not in a run and not already holding a unit can take it. Otherwise it is
    "no free taker" and does not close new work."""
    workers = live_workers()
    skip_brains = pool_skip(workers)
    with_pr = {pr_ticket(p) for p in open_prs()} - {None}
    units, excluded, seen = set(), {}, set()
    loose, busy = [], set()
    rest = resting(1, True)  # read only; runner 1's view already holds every runner's IDLE rests
    for t in SNAP["tickets"]:
        building = t["section"] in BOARDS[t["board"]][1]
        if (not building and t["key"] not in with_pr) or t["key"] in seen:
            continue
        seen.add(t["key"])
        why = pipeline_reason(t, skip_brains, t["key"] in with_pr, rest)
        if why:
            excluded.setdefault(why, []).append(t["key"])
            continue
        holders = []
        for h in names(t):
            found = re.fullmatch(r"runner (\d+)", h)
            if found and live_runner(h):
                holders.append(int(found[1]))
        if holders:
            units.add(t["key"])
            busy.update(holders)
        else:
            loose.append(t)
    for m in workers:
        if active_run(m):
            busy.add(m)
    for t in loose:
        if any(worker_can_adopt(m, t) for m in workers if m not in busy):
            units.add(t["key"])
        else:
            excluded.setdefault("no free taker", []).append(t["key"])
    return units, workers, excluded


def wip_line(units, workers, excluded):
    left = ", ".join(f"{why} {len(keys)}" for why, keys in sorted(excluded.items()))
    state = "closed" if len(units) >= len(workers) else "open"
    return f"wip: {len(units)} of {len(workers)}, new work {state}" + (f" (not counted: {left})" if left else "")


def choose(n, dry):
    PICKER[0] = n
    RELATION_CAP[0] = BLOCK_LOOKUPS * 2
    hit = incident_step(n, dry)
    if hit:
        return hit
    owned = [t for t in SNAP["tickets"] if (t.get("_owner") or {}).get("runner") == int(n)]
    if owned:
        t = sorted(owned, key=lambda t: (t["created"], t["key"]))[0]
        record = t["_owner"]
        if record.get("engine"):
            set_engine(record["engine"])
        taken = {**claim_files(), **virtual_claims()}
        SKIP[0] = Skip({key for key, who in taken.items() if who != str(n)}, resting(n, dry))
        if skipped(t) or t["waiting"] or t["key"] in SKIP[0] or held_back(t, own=True) or open_blocked_by(t):
            raise SystemExit(f"none: Runner {n} keeps {t['key']}; waiting, no hand-off")
        if f"runner {n}" not in names(t) and not try_claim(n, t, "board", dry):
            raise SystemExit(f"none: Runner {n} keeps {t['key']}; assignment could not resume")
        return t, "own"
    me = f"runner {n}"
    taken = {**claim_files(), **virtual_claims()}
    others = {k for k, who in taken.items() if who != str(n)}
    others.update(t["key"] for t in SNAP["tickets"]
                  if t.get("_owner") and t["_owner"]["runner"] != int(n))
    mine_claim = [k for k, who in taken.items() if who == str(n)]
    skip = Skip(others, resting(n, dry))
    SKIP[0] = skip
    building = [t for t in SNAP["tickets"] if t["section"] in BOARDS[t["board"]][1]]

    # kept slot: one runner on a checks or tools ticket before its own app work (HYCI-186)
    held = other_on_blocker(n)
    if held:
        log(f"kept slot: held on {held}")
    cands, empty = slot_candidates(n, me, skip)
    if not cands:
        if empty:
            log(empty)
    else:
        if held:
            # one kept slot only: with a runner already on Fleet CI & Infra, the rest build app work. A second runner
            # joins only for an incident or a ticket that blocks open app work (Valentin 13 Nov: "literally everything
            # is on infrastructure")
            full = infra_count(n) >= infra_cap()
            cands = [t for t in cands if t["key"] != held and (INCIDENT_LABEL in t["labels"] or (blocks_known(t) and not full))]
            log("kept slot: another runner holds it; this runner takes only blockers" if cands
                else "kept slot: another runner holds it; app work first")
        if cands:
            got = take_kept_slot(n, me, cands, dry)
            if got:
                return got
            own = any(me in names(t) and t["section"] in BOARDS[t["board"]][1] for t in SNAP["tickets"])
            if not own and not held:
                raise SystemExit(f"none: kept slot waiting on {cands[0]['key']}")
            if own:
                log("kept slot: blocker open but this runner is held on its own ticket")
            elif held:
                log("kept slot: another runner holds a blocker; none left for this runner")

    # a. own ticket
    # a merged ticket waiting for its live check is its merging runner's; a design-pass one needs another runner's QA
    for t in sorted((t for t in building if me in names(t) and not skipped(t)
                     and not (t["section"] == "QA" and "design-pass" in t["labels"])),
                    key=lambda t: (BOARD_ORDER[t["board"]], rank(t))):
        if t["key"] not in skip and not held_back(t, own=True):
            return t, "own"
    # a'. my own ticket rests or waits but still sits in a building column: park it first (one job per REST_MAX), so the
    # one-runner-one-ticket hold clears even while the WIP cap closes every lane that would have tried a claim
    for t in building:
        if me in names(t) and t["section"] != "QA" and not skipped(t) and parkable(t):
            return t, "park"
    qa_mine = [t for t in building if me in names(t) and t["section"] == "QA"]
    if qa_mine:
        theirs = sorted((t for t in building if t["section"] == "QA" and t["key"] not in skip and not skipped(t)
                         and any(live_runner(h) and h != me for h in names(t)) and "design-pass" not in t["labels"]),
                        key=lambda t: t["key"])
        if theirs:
            return theirs[n % len(theirs)], "cross-qa"
    full = lambda: lane_count(others) >= LANE_CAP
    frozen = FREEZE.exists()

    # b. orphans
    for t in sorted(building, key=lambda t: (rank(t), t["updated"])):
        why = None
        if not orphan(t):
            why = "held by " + ", ".join(names(t))
        elif t["key"] in skip:
            why = "claimed by another runner or resting"
        elif t["waiting"]:
            why = "waits on Valentin"
        elif skipped(t):
            why = "ticket engine or PC hold"
        elif "design-pass" in t["labels"] or not orphan_ok(t):
            why = "ticket design-pass or pool hold"
        elif not can_join(n, t["board"]):
            why = f"runner {n} is not a member of board {t['board']}"
        elif INCIDENT_LABEL not in t["labels"] and pr_checks_pending(t["key"], t):
            why = "open PR checks still running; the next run only merges once they end (HYCI-358 orphan parks 13 Nov 16:31, 16:33)"
        elif in_lane(t) and full():
            why = "checks lane full"
        elif frozen and not in_lane(t):
            why = "app freeze"
        elif focus_projects(n) and project(t) not in focus_projects(n):
            why = f"runner {n} focuses on {', '.join(sorted(focus_projects(n)))}"
        if why:
            note(t["key"], why)
            continue
        if held_back(t):
            continue
        if try_claim(n, t, "orphan", dry):
            return t, "orphan"

    # WIP cap: while the pool's pipeline is at or over its live runners, nothing new starts; only the PR queue and
    # tickets that already have an open PR (finish before you start)
    units, workers, excluded = pipeline()
    wip = wip_line(units, workers, excluded)
    log(wip)
    closed = len(units) >= len(workers)
    TRACE["wip"] = {"n": len(units), "of": len(workers), "new": "closed" if closed else "open"}
    TRACE["new"] = True

    # new work, ordered by priority across every board (Valentin 2026-11-07: use the priority field)
    def not_new(t):
        """Why this ticket in a new-work column is not offered to this runner, or None."""
        if t["key"] in skip:
            return "claimed by runner " + taken[t["key"]] if t["key"] in skip.hard else "resting after an IDLE end"
        if t["key"] in mine_claim:
            return "already claimed by this runner"
        why = eligible_reason(t)
        if why:
            return why
        if not free_for(t, me):
            return "held by " + ", ".join(names(t))
        if not can_join(n, t["board"]):
            return f"runner {n} is not a member of board {t['board']}"
        return None

    new = []
    for t in SNAP["tickets"]:
        if t["section"] not in BOARDS[t["board"]][0]:
            continue
        why = not_new(t)
        if why:
            note(t["key"], why)
        else:
            new.append(t)
    ready_summary()
    new.sort(key=lambda t: (rank(t), t["created"]))
    focus = focus_projects(n)
    if focus:
        for t in new:
            if project(t) not in focus:
                note(t["key"], f"runner {n} focuses on {', '.join(sorted(focus))}")
        new = [t for t in new if project(t) in focus]
    lane_new = [t for t in new if in_lane(t)]
    app_new = [t for t in new if not in_lane(t)]
    if full():
        for t in lane_new:
            note(t["key"], "checks lane full")
    if frozen:
        for t in app_new:
            note(t["key"], "app freeze")
    tries = 0

    def attempt(cands):
        nonlocal tries
        for i, t in enumerate(cands):
            if tries >= 8:
                for left in cands[i:]:
                    note(left["key"], "not tried: 8 claim tries used")
                return None
            if held_back(t):
                continue
            if not dry and admission_remembered(n, t["key"]):
                note(t["key"], "domain admission refused this runner under ten minutes ago")
                continue
            tries += 1
            if try_claim(n, t, "board", dry):
                return t
        return None

    # c0. Urgent app work on any board goes before the PR queue
    if not frozen and not closed:
        t = attempt(sorted((x for x in app_new if x["prio"] == "Urgent"), key=lambda t: (t["created"], BOARD_ORDER[t["board"]])))
        if t:
            return t, "board"

    # c. PR queue
    for p, key in pr_candidates(n, others):
        entry = TRACE["prs"][p["number"]]
        t = fetch_ticket(key)
        if not t:
            entry["result"] = DEAD.get(key, "ticket unreadable")
            continue
        if t["key"] in skip:
            entry["result"] = "ticket claimed by another runner or resting"
            continue
        if skipped(t) or "design-pass" in t["labels"]:
            entry["result"] = "ticket engine, PC or design-pass hold"
            continue
        if not can_join(n, t["board"]):
            entry["result"] = f"runner {n} is not a member of board {t['board']}"
            continue
        if focus_projects(n) and project(t) not in focus_projects(n):
            entry["result"] = f"runner {n} focuses on {', '.join(sorted(focus_projects(n)))}"
            continue
        if any(live_runner(h) and h != me for h in names(t)):
            entry["result"] = "ticket held by another live runner"
            continue
        if (in_lane(t) and full()) or (frozen and not in_lane(t)) or held_back(t):
            entry["result"] = TRACE["why"].get(key, "lane full or app freeze")
            continue
        if try_claim(n, t, "pr", dry):
            entry["result"] = "chosen"
            return t, "pr"
        entry["result"] = TRACE["why"].get(key, "claim refused")

    if closed:
        with_pr = {pr_ticket(p) for p in open_prs()}
        finish = [t for t in new if t["key"] in units and t["key"] in with_pr
                  and not (in_lane(t) and full()) and not (frozen and not in_lane(t))]
        t = attempt(sorted(finish, key=lambda t: (rank(t), t["created"])))
        if t:
            return t, "pr"
        if not full():
            t = attempt(ci_blockers(lane_new))
            if t:
                return t, "ci-lane"
        raise SystemExit(f"none: {wip}")
    if not full():
        # one relations read per ticket is slow, so only the top BLOCK_LOOKUPS non-Urgent tickets are checked
        pref = [t for t in lane_new if t["prio"] == "Urgent"]
        pref += [t for t in [x for x in lane_new if x["prio"] != "Urgent"][:BLOCK_LOOKUPS] if blocks_app(t)]
        t = attempt(sorted(pref, key=lambda t: (t["prio"] != "Urgent", rank(t), t["created"])))
        if t:
            return t, "ci-lane"
    if not frozen:
        load, board_load = project_load(), project_load(lambda t: t["board"])
        t = attempt(sorted(app_new, key=lambda t: (tuple(board_load[t["board"]]), tuple(load[project(t)]), rank(t), BOARD_ORDER[t["board"]], t["created"])))
        if t:
            return t, "board"
    if not full():
        t = attempt(lane_new)
        if t:
            return t, "ci-lane"
    # HYCI-388: nothing to start, yet some tickets were skipped only because this pick's relation reads ran out (104 of 366
    # on 13 Nov, three runners idle). Read their links, in the same priority order, up to the hard ceiling before ending idle.
    spent = {k for k, why in TRACE["why"].items() if why == SPENT_REASON}
    if spent:
        RELATION_CAP[0] = RELATION_CEILING
        for k in spent:
            del TRACE["why"][k]
        if not frozen:
            load, board_load = project_load(), project_load(lambda t: t["board"])
            t = attempt(sorted((x for x in app_new if x["key"] in spent),
                               key=lambda t: (tuple(board_load[t["board"]]), tuple(load[project(t)]), rank(t), BOARD_ORDER[t["board"]], t["created"])))
            if t:
                return t, "board"
        if not full():
            t = attempt([x for x in lane_new if x["key"] in spent])
            if t:
                return t, "ci-lane"
    raise SystemExit("none: no free ticket the pool may take" + (" (app freeze: CI and infra only)" if frozen else ""))


