# DeepSeek medium runs, 7 to 10 Nov: FEATURE or IMPROVEMENT tickets timed out on 9 of 26 (35%), others on 0 of 25 (HYCI-243).
OPENCODE_SKIP_LABELS = {"feature", "improvement", "design-pass"}


def engine_skips(e, t):
    """Engine e does not take t: it skips t's brain (opencode and brain-hard), t timed out on OpenCode in the last 24h,
    or t is a feature or improvement, which OpenCode keeps timing out on whatever its brain tag says."""
    return brain_tag(t) not in ENGINES[e]["brains"] or (e == "opencode" and (
        opencode_timed_out(t["key"]) or bool(OPENCODE_SKIP_LABELS & set(t["labels"]))))


