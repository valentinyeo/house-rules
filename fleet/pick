RUNNING = {}


def running(n):
    if n not in RUNNING:
        RUNNING[n] = active_run(n)
    return RUNNING[n]


def live_runner(name):
    """Runner N works: the pacer has not stopped it, or it still runs the ticket it had when the stop came (the stop
    lands between tickets). A stopped runner that runs nothing holds its tickets in name only: they are orphans."""
    m = re.fullmatch(r"runner (\d+)", name)
    return bool(m) and 1 <= int(m[1]) <= RUNNERS and (not paced_off(int(m[1])) or running(int(m[1])) is not None)


def legacy_alive(name):
    """A legacy MP runner still runs an agent. A bare shell does not count: Valentin's PC terminal tabs reattach with
    `tmux new-session -A -s mp-runner-N` and recreate the retired sessions empty (2026-11-08)."""
    m = re.fullmatch(r"mp runner (\d+)", name)
    if not m:
        return False
    r = subprocess.run(["tmux", "list-panes", "-t", f"mp-runner-{m[1]}", "-F", "#{pane_current_command}"],
                       capture_output=True, text=True)
    return r.returncode == 0 and any(c not in ("bash", "sh", "zsh", "-bash") for c in r.stdout.split())


def retired(name):
    return (bool(RETIRED.match(name)) and not legacy_alive(name)) or (bool(re.fullmatch(r"runner \d+", name)) and not live_runner(name))


def runner_engine(n):
    """Runner n's engine: engine-n (the pacer's per-runner choice), else the pool-wide engine file, else cursor.
    None: the file names no known engine."""
    for f in (RUNNER_STATE / f"engine-{n}", RUNNER_STATE / "engine"):
        try:
            e = f.read_text().strip()
        except OSError:
            continue
        return e if e in ENGINES else None
    return "cursor"


def brain_tag(t):
    return next((b for b in ("extra-hard", "hard", "medium", "light") if f"brain-{b}" in t["labels"]), "medium")


# DeepSeek medium runs, 7 to 10 Nov: FEATURE or IMPROVEMENT tickets timed out on 9 of 26 (35%), others on 0 of 25 (HYCI-243).
OPENCODE_SKIP_LABELS = {"feature", "improvement", "design-pass"}


def engine_skips(e, t):
    """Engine e does not take t: it skips t's brain (opencode and brain-hard), t timed out on OpenCode in the last 24h,
    or t is a feature or improvement, which OpenCode keeps timing out on whatever its brain tag says."""
    return brain_tag(t) not in ENGINES[e]["brains"] or (e == "opencode" and (
        opencode_timed_out(t["key"]) or bool(OPENCODE_SKIP_LABELS & set(t["labels"]))))


def timed_out_here(t):
    return ENGINE == "opencode" and opencode_timed_out(t["key"])


PC_PORT = int(os.environ.get("FLEET_PC_PORT", "15037"))
_PC_WAITS = None


def pc_waits():
    """Tickets a run handed back because Valentin's PC or the check phone was off. Empty once the PC tunnel answers:
    the file is cleared and every ticket goes back to the pool (IGSH-1923, HYCI-256 held runners 30+ min, 11 Nov)."""
    global _PC_WAITS
    if _PC_WAITS is None:
        import socket
        path = RUNNER_STATE / "pc-waits"
        try:
            socket.create_connection(("127.0.0.1", PC_PORT), timeout=2).close()
            path.unlink(missing_ok=True)
            _PC_WAITS = set()
        except OSError:
            try:
                _PC_WAITS = {ln.split()[1] for ln in open(path) if len(ln.split()) == 2}
            except OSError:
                _PC_WAITS = set()
            if _PC_WAITS:
                log(f"pc off: skipping {', '.join(sorted(_PC_WAITS))}")
    return _PC_WAITS


def skipped(t):
    """This runner's engine does not take t, or t waits on Valentin's PC while it is off."""
    return bool(set(t["labels"]) & SKIP_ALL) or WASTED in t["labels"] or timed_out_here(t) or t["key"] in pc_waits()


def hand_back_timeouts(n, dry):
    """An OpenCode runner leaves the tickets it timed out on: fleet/park --hand-back unassigns it and keeps column and PR,
    so ship-claim stops holding it and a runner on another engine adopts the ticket as an orphan."""
    me = f"runner {n}"
    for t in SNAP["tickets"]:
        if t["section"] not in BOARDS[t["board"]][1] or me not in names(t) or not timed_out_here(t):
            continue
        if dry:
            log(f"would hand back {t['key']}: timed out on OpenCode in the last 24 hours")
            continue
        r = subprocess.run([str(HERE / "park"), t["key"], "--hand-back",
                            "an OpenCode run hit the 3h limit on it; a runner on another engine finishes it."],
                           capture_output=True, text=True, env=dict(os.environ, SHIP_SESSION_NAME=f"RUNNER {n}"), timeout=300)
        out = (r.stdout + r.stderr).strip().splitlines()
        log(f"hand back {t['key']}: " + (out[-1] if out else f"rc {r.returncode}"))
        if r.returncode == 0:
            t["holders"] = [h for h in t["holders"] if h[0] != me]


def cannot_do(name, t):
    """A live runner whose engine skips this ticket: it holds the ticket in name only."""
    m = re.fullmatch(r"runner (\d+)", name)
    e = m and runner_engine(int(m[1]))
    return bool(e) and engine_skips(e, t)


def orphan(t):
    """Nobody holds it, or only retired logins or runners whose engine skips its brain: any runner may adopt it."""
    return all(retired(n) or cannot_do(n, t) for n in names(t))


