def sf_release_self_test():
    """HYCI-352, SOFT-2273 (13 Nov): five runs, four only waited. fleet/sf-release-watch writes what a script waits on; the picker
    must not hand such a ticket to a model as park, orphan or own. Replays the four follow-up moments from that evening."""
    global SNAP, ONE_RUN_FLAG, SF_RELEASE_WAIT, log
    import tempfile
    now = dt.datetime.now(dt.timezone.utc).replace(microsecond=0)
    fmt = "%Y-%m-%dT%H:%M:%SZ"
    ago = lambda m: (now - dt.timedelta(minutes=m)).strftime(fmt)
    tk = lambda key, section="Doing", labels=("multiprompt",), prio="Medium", holders=(): {
        "key": key, "idx": 1, "board": "2060", "section": section, "title": "x", "labels": list(labels), "prio": prio,
        "holders": [list(h) for h in holders], "waiting": False, "subs": False, "paid": False, "updated": ago(360), "created": ago(9999)}
    saved = (SNAP, ONE_RUN_FLAG, SF_RELEASE_WAIT, log)
    tmp = Path(tempfile.mkdtemp())
    wait, flag = tmp / "sf-release-wait.json", tmp / "one-run.on"
    SF_RELEASE_WAIT, ONE_RUN_FLAG, lines = wait, flag, []
    log = lines.append

    def write(rows, at=0):
        wait.write_text(json.dumps({"at": int(now.timestamp()) - at, "tickets": rows}))

    def held(tickets, dry=True):
        global SNAP
        SNAP = {"tickets": tickets, "rel": {}, "prs": [], "incidents": [], "open": {}}
        _ONE_RUN.clear()
        lines.clear()
        return one_run_hold(dry, now)

    def row(state, since=10, detail="PR #961 open, checks pending"):
        return {"SOFT-2273": {"state": state, "detail": detail, "since": ago(since)}}

    try:
        flag.write_text("")
        # The ticket key on the board is SOFT-2273; the PR title and the release note say IGSH-2273. Both are board 2060.
        assert ticket_id("SOFT-2273") == ticket_id("IGSH-2273") == ("2060", "2273") and ticket_id("HTPR-1") == "HTPR-1"
        assert ticket_id("SOFT-227") != ticket_id("IGSH-2273"), "compare by whole number"
        # Replay 1: 19:17 park job, PR open, one check running. 2: 20:08 orphan, merged, release not out. 3: 21:02 own, same.
        for moment, state, detail in (("19:17 park", "pr", "PR #961 open, checks pending"),
                                      ("20:08 orphan", "release", "PR #961 merged, release not out yet"),
                                      ("21:02 own", "release", "PR #961 merged, release not out yet")):
            write(row(state, detail=detail))
            assert held([tk("SOFT-2273")]) == {"SOFT-2273"}, f"{moment}: a script owns the wait"
            assert lines == [f"sf-wait: SOFT-2273 {state}: {detail}"], lines
            assert "SOFT-2273" in resting(2, True) and "SOFT-2273" in Skip(set(), resting(2, True)), f"{moment}: every lane reads it through resting()"
        # The real lanes through choose(): Runner 7 holds SOFT-2273 (own lane), Runner 8 sees it unheld (orphan lane). Control first:
        # with state attention the picker offers it; with pr or release it offers the runner other work instead.
        global RUNNER_STATE, RUNNERS, STATE
        saved_rs, saved_n, saved_state = RUNNER_STATE, RUNNERS, STATE
        RUNNER_STATE, RUNNERS, STATE = Path(tempfile.mkdtemp()), 8, Path(tempfile.mkdtemp())
        new = tk("SOFT-2300", "Todo")

        def lane(n, holders, rows):
            global SNAP
            write(rows)
            SNAP = {"tickets": [tk("SOFT-2273", holders=holders), new], "rel": {"SOFT-2273": [[], []], "SOFT-2300": [[], []]},
                    "prs": [], "incidents": [], "open": {}}
            _ONE_RUN.clear()
            try:
                got = choose(n, True)
                return got[0]["key"], got[1]
            except SystemExit as e:
                return str(e)

        try:
            mine7 = (("runner 7", True),)
            assert lane(7, mine7, row("attention", detail="PR #961 is red")) == ("SOFT-2273", "own"), "control: a red PR is offered as own"
            got8 = lane(8, (), row("attention", detail="PR #961 is red")); assert got8 == ("SOFT-2273", "orphan"), f"control: a red PR is offered as orphan, got {got8}"
            for moment, n, holders, state in (("21:02 own", 7, mine7, "release"), ("19:17 own", 7, mine7, "pr"),
                                              ("20:08 orphan", 8, (), "release"), ("19:17 orphan", 8, (), "pr")):
                got = lane(n, holders, row(state))
                assert got != ("SOFT-2273", "own") and got != ("SOFT-2273", "orphan") and not (isinstance(got, tuple) and got[0] == "SOFT-2273"), \
                    f"{moment}: a script owns the wait, SOFT-2273 must not start a run ({got})"
        finally:
            RUNNER_STATE, RUNNERS, STATE = saved_rs, saved_n, saved_state
        # What a model keeps: anything attention, a stale file, no file, a wait past its cap, an incident, a missing flag, a garbled file.
        for why, rows, at in (("a red PR", row("attention", detail="PR #961 is red"), 0), ("a stale file", row("pr"), 16 * 60),
                              ("a wait past 6 hours", row("pr", since=7 * 60), 0), ("a state the picker does not know", row("done"), 0)):
            write(rows, at)
            assert held([tk("SOFT-2273")]) == set(), f"{why}: a model has work, not held"
        write(row("pr", since=90), 0)
        assert held([tk("SOFT-2273", prio="Urgent")]) == set(), "an Urgent wait is released after an hour"
        write(row("pr"))
        assert held([tk("SOFT-2273", labels=("multiprompt", "incident"))]) == set(), "an incident is never held"
        assert held([tk("SOFT-2274")]) == set(), "another ticket is not this wait"
        wait.unlink()
        assert held([tk("SOFT-2273")]) == set() and not lines, "no file: nothing held, no noise"
        wait.write_text("{not json")
        assert held([tk("SOFT-2273")]) == set() and lines and lines[0].startswith("sf-wait: error"), lines
        write(row("pr"))
        flag.unlink()
        assert held([tk("SOFT-2273")]) == set() and lines == [f"sf-wait: SOFT-2273 pr: PR #961 open, checks pending (shadow: {flag} missing, not skipped)"], \
            "flag off: logged as shadow, not skipped"
        flag.write_text("")
        # Replay 4: 21:43. The 21:20 release holds the merge, so fleet/sf-release-watch moved SOFT-2273 to Done and dropped its row.
        write({})
        assert held([tk("SOFT-2273", "Done")]) == set(), "21:43: Done and out of the file, never offered"
        print("sf-release self-test ok: SOFT-2273 replay, 4 of 4 follow-up runs not started (19:17 park, 20:08 orphan, 21:02 own held by "
              "the picker; 21:43 moved to Done by fleet/sf-release-watch); red, stale, capped, incident and flag-off cases are not held")
    finally:
        SNAP, ONE_RUN_FLAG, SF_RELEASE_WAIT, log = saved
        _ONE_RUN.clear()


