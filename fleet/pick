# ---------------------------------------------------------------- board membership

MEMBERS = {}  # board -> lower-case display names of its members, or None when unreadable and nothing cached
MEMBERS_TTL = 3600
LOGGED = set()
DRY_RUN = "--dry-run" in sys.argv


def fetch_members(board):
    d = ht("project", "members", "--project", board)
    return {(m.get("displayName") or "").lower() for m in (d or {}).get("members") or []} if d else None


def board_members(board):
    """Who may join this board, cached an hour (a dry run reads the cache but never writes it). Unreadable: the stale cache, else None."""
    if board not in MEMBERS:
        path = STATE / "members.json"
        try:
            cached = json.loads(path.read_text())
        except (OSError, ValueError):
            cached = {}
        hit = cached.get(board) or {}
        if time.time() - hit.get("at", 0) < MEMBERS_TTL:
            MEMBERS[board] = set(hit["names"])
        else:
            fresh = fetch_members(board)
            MEMBERS[board] = fresh if fresh is not None else (set(hit["names"]) if hit else None)
            if fresh is not None and not DRY_RUN:
                cached[board] = {"at": time.time(), "names": sorted(fresh)}
                STATE.mkdir(parents=True, exist_ok=True)
                tmp = f"{path}.{os.getpid()}"
                json.dump(cached, open(tmp, "w"))
                os.replace(tmp, path)
    return MEMBERS[board]


def can_join(n, board):
    """May Runner n claim tickets on this board? ship-claim refuses a login the board did not add ("the board decides who may
    join it"), so the picker never offers those tickets. Membership unknown: offer them, ship-claim stays the backstop."""
    names = board_members(board)
    if names is None or f"runner {n}" in names:
        return True
    if (n, board) not in LOGGED:
        LOGGED.add((n, board))
        log(f"runner {n} is not a member of board {board}: its tickets are not offered")
    return False


# ---------------------------------------------------------------- snapshot

def slim(t, board):
    holders = []
    for a in t.get("assignees") or []:
        ag = a.get("agent") or {}
        name = (ag.get("displayName") or a.get("displayName") or a.get("name") or "").strip().lower()
        if name:
            holders.append([name, bool(ag) or a.get("type") == "agent"])
    p = t.get("priority")
    p = p if isinstance(p, str) else (p or {}).get("Priority_Value")
    return {"key": t["ticketNumber"], "idx": t.get("uniqueIndex"), "board": board, "section": t.get("section") or "",
            "title": " ".join((t.get("title") or "").split()), "prio": p or "Medium",
            "labels": sorted({(l.get("name") or "").strip().lower() for l in t.get("labels") or []}),
            "holders": holders, "waiting": bool(t.get("waitingOnUserId") or t.get("blockerCommentId")),
            "subs": bool(t.get("sub_tasks")), "paid": "paid" in (t.get("description") or "").lower(),
            "created": t.get("createdAt") or "", "updated": t.get("updatedAt") or ""}


def list_section(board, section):
    rows, offset = [], 0
    while True:
        d = ht("task", "list", "--project", board, "--section", section, "--limit", "100", "--offset", str(offset))
        if not d or not isinstance(d.get("tasks"), list):
            raise RuntimeError(f"board {board} column {section} unreadable")
        rows += d["tasks"]
        offset += len(d["tasks"])
        if len(d["tasks"]) < 100:
            return [slim(t, board) for t in rows if TICKET.fullmatch(t.get("ticketNumber") or "")]


def list_incidents():
    """Open board 15 tickets labelled incident, in any column (the column snapshot misses Valentin Review, Agent Blocked
    and the like). Done, archived and settled-flag tickets are dropped."""
    out = []
    for board in INCIDENT_BOARDS:
        rows, offset = [], 0
        while True:
            d = ht("task", "list", "--project", board, "--labels", INCIDENT_LABEL, "--limit", "100", "--offset", str(offset))
            if not d or not isinstance(d.get("tasks"), list):
                raise RuntimeError(f"board {board} incident label unreadable")
            rows += d["tasks"]
            offset += len(d["tasks"])
            if len(d["tasks"]) < 100:
                break
        out += [slim(t, board) for t in rows
                if TICKET.fullmatch(t.get("ticketNumber") or "") and not t.get("sectionIsDone")
                and (t.get("status") or "Normal") == "Normal" and (t.get("section") or "").lower() not in INCIDENT_DONE]
    return out


def load_snapshot():
    cache = os.environ.get("FLEET_PICK_CACHE")
    if cache and os.path.exists(cache) and time.time() - os.path.getmtime(cache) < (3600 if os.environ.get("FLEET_PICK_VIRTUAL") else CACHE_TTL):
        return json.load(open(cache))
    snap = {"tickets": [], "rel": {}, "prs": None, "incidents": []}
    for board, (new, building) in BOARDS.items():
        for section in new + building:
            snap["tickets"] += list_section(board, section)
    snap["incidents"] = list_incidents()
    if cache:
        save_cache(snap)
    return snap


def save_cache(snap):
    cache = os.environ.get("FLEET_PICK_CACHE")
    if cache:
        tmp = f"{cache}.{os.getpid()}"
        json.dump(snap, open(tmp, "w"))
        os.replace(tmp, cache)


SNAP = None


def relations(key):
    """(blocked_by_open: set of open tickets this one waits on, blocks_app: app tickets waiting on this one)."""
    rel = SNAP["rel"]
    if key not in rel:
        d = ht("task", "relations", key)
        waits, blocks = [], []
        for r in (d or {}).get("relations") or []:
            other = r.get("otherTask") or {}
            num = other.get("ticketNumber") or ""
            if r.get("relationType") != "BlockedBy" or other.get("status") == "Archive":
                continue
            # outgoing: this ticket waits on `other`; incoming: `other` waits on this ticket
            (waits if r.get("direction") == "outgoing" else blocks).append(num)
        rel[key] = [waits, blocks]
        save_cache(SNAP)
    return rel[key]


# ---------------------------------------------------------------- helpers

def rank(t):
    return RANK.get(t["prio"], 2)


def names(t):
    return [h[0] for h in t["holders"]]


def paced_off(n):
    """The pacer stopped Runner n (stop-n file marked "pacer"): it will not run again until the pacer frees it."""
    try:
        return (RUNNER_STATE / f"stop-{n}").read_text().startswith("pacer")
    except OSError:
        return False


RUNNING = {}


def running(n):
    if n not in RUNNING:
        RUNNING[n] = active_run(n)
    return RUNNING[n]


def live_runner(name):
    """Runner N works: the pacer has not stopped it, or it still runs the ticket it had when the stop came (the stop
    lands between tickets). A stopped runner that runs nothing holds its tickets in name only: they are orphans."""
    m = re.fullmatch(r"runner (\d+)", name)
    return bool(m) and 1 <= int(m[1]) <= RUNNERS and (not paced_off(int(m[1])) or running(int(m[1])) is not None)


def legacy_alive(name):
    m = re.fullmatch(r"mp runner (\d+)", name)
    return bool(m) and subprocess.run(["tmux", "has-session", "-t", f"mp-runner-{m[1]}"], capture_output=True).returncode == 0


def retired(name):
    return (bool(RETIRED.match(name)) and not legacy_alive(name)) or (bool(re.fullmatch(r"runner \d+", name)) and not live_runner(name))


def runner_engine(n):
    """Runner n's engine: engine-n (the pacer's per-runner choice), else the pool-wide engine file, else cursor.
    None: the file names no known engine."""
    for f in (RUNNER_STATE / f"engine-{n}", RUNNER_STATE / "engine"):
        try:
            e = f.read_text().strip()
        except OSError:
            continue
        return e if e in ENGINES else None
    return "cursor"


def brain_tag(t):
    return next((b for b in ("hard", "medium", "light") if f"brain-{b}" in t["labels"]), "medium")


def cannot_do(name, t):
    """A live runner whose engine skips this ticket's brain (opencode and brain-hard): it holds the ticket in name only."""
    m = re.fullmatch(r"runner (\d+)", name)
    e = m and runner_engine(int(m[1]))
    return bool(e) and brain_tag(t) not in ENGINES[e]["brains"]


def orphan(t):
    """Nobody holds it, or only retired logins or runners whose engine skips its brain: any runner may adopt it."""
    return all(retired(n) or cannot_do(n, t) for n in names(t))


def set_engine(engine):
    global ENGINE, SKIP_ALL
    ENGINE = engine
    SKIP_ALL = BASE_SKIP | {f"brain-{b}" for b in ("light", "medium", "hard") if b not in ENGINES[engine]["brains"]}


def free_for(t, me):
    return all(n == me or retired(n) for n in names(t))


def is_ci(t):
    return bool(set(t["labels"]) & CI_LABELS) or t["board"] == "11514"


def lane(t):
    if is_ci(t):
        return "ci"
    return {"15": "app", "2060": "sf", "4060": "infra"}[t["board"]]


def in_lane(t):
    return lane(t) in ("ci", "infra")


def paced_models():
    """Model per brain tag (light, medium, hard, park, incident) for this runner's engine, from the pacer (poteto-2-advisor
    bin/pacer, every 15 min): models_by_engine[ENGINE], or the older single-engine shape (engine + models). Used only when
    the allocation is fresh; otherwise the built-in ENGINES map applies."""
    try:
        a = json.loads(ALLOCATION.read_text())
        if time.time() - float(a["at"]) > ALLOCATION_MAX_AGE:
            return {}
        if "models_by_engine" in a:
            m = a["models_by_engine"].get(ENGINE)
        else:
            m = a.get("models") if a.get("engine") == ENGINE else None
        return {k: (v["id"], v["effort"]) for k, v in (m or {}).items() if v and v.get("id") and v.get("effort")}
    except (OSError, ValueError, KeyError, TypeError, AttributeError):
        return {}


def brain(t):
    b = brain_tag(t)
    return (f"brain-{b}", *paced_models().get(b, ENGINES[ENGINE]["brains"][b]))


def sf_repo(t):
    for label, d in SF_REPOS.items():
        if label in t["labels"]:
            return str(PROJECTS / d)
    return str(PROJECTS)


def repo_for(t):
