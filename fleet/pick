def build_need(text):
    """The first reason this ticket says it cannot be built yet, or "". Text only: no board or GitHub read (HYCI-355)."""
    flat = " ".join(re.sub(r"<[^>]+>", " ", text or "").replace("&#x27;", "'").replace("&quot;", '"')
                    .replace("&amp;", "&").lower().split())
    return next((why for rx, why in BUILD_NEED if rx.search(flat)), "")


def slim(t, board):
    holders = []
    for a in t.get("assignees") or []:
        ag = a.get("agent") or {}
        name = (ag.get("displayName") or a.get("displayName") or a.get("name") or "").strip().lower()
        if name:
            holders.append([name, bool(ag) or a.get("type") == "agent"])
    p = t.get("priority")
    p = p if isinstance(p, str) else (p or {}).get("Priority_Value")
    return {"key": t["ticketNumber"], "idx": t.get("uniqueIndex"), "board": board, "section": t.get("section") or "",
            "title": " ".join((t.get("title") or "").split()), "prio": p or "Medium",
            "labels": sorted({(l.get("name") or "").strip().lower() for l in t.get("labels") or []}),
            "holders": holders, "waiting": bool(t.get("waitingOnUserId") or t.get("waitingOnAgentId")
                                                or t.get("blockerCommentId")),
            "subs": bool(t.get("sub_tasks")), "paid": "paid" in (t.get("description") or "").lower(),
            "needs": build_need((t.get("title") or "") + " " + (t.get("description") or "")),
            "created": t.get("createdAt") or "", "updated": t.get("updatedAt") or ""}


def list_section(board, section):
    rows, offset = [], 0
    while True:
        d = ht("task", "list", "--project", board, "--section", section, "--limit", "100", "--offset", str(offset))
        if not d or not isinstance(d.get("tasks"), list):
            raise RuntimeError(f"board {board} column {section} unreadable")
        rows += d["tasks"]
        offset += len(d["tasks"])
        if len(d["tasks"]) < 100:
            return [slim(t, board) for t in rows if TICKET.fullmatch(t.get("ticketNumber") or "")]


def list_incidents():
    """Open board 15 tickets labelled incident, in any column (the column snapshot misses Valentin Review, Agent Blocked
    and the like). Done, archived and settled-flag tickets are dropped."""
    out = []
    for board in INCIDENT_BOARDS:
        rows, offset = [], 0
        while True:
            d = ht("task", "list", "--project", board, "--labels", INCIDENT_LABEL, "--limit", "100", "--offset", str(offset))
            if not d or not isinstance(d.get("tasks"), list):
                raise RuntimeError(f"board {board} incident label unreadable")
            rows += d["tasks"]
            offset += len(d["tasks"])
            if len(d["tasks"]) < 100:
                break
        out += [slim(t, board) for t in rows
                if TICKET.fullmatch(t.get("ticketNumber") or "") and not t.get("sectionIsDone")
                and (t.get("status") or "Normal") == "Normal" and (t.get("section") or "").lower() not in INCIDENT_DONE]
    return out


def load_snapshot():
    cache = os.environ.get("FLEET_PICK_CACHE")
    if cache and os.path.exists(cache) and time.time() - os.path.getmtime(cache) < (3600 if os.environ.get("FLEET_PICK_VIRTUAL") else CACHE_TTL):
        return json.load(open(cache))
    snap = {"tickets": [], "rel": {}, "prs": None, "prs_at": None, "incidents": []}
    for board, (new, building) in BOARDS.items():
        for section in new + building:
            snap["tickets"] += list_section(board, section)
    snap["incidents"] = list_incidents()
    if cache:
        save_cache(snap)
    else:
        # the per-pick read cap tests "key in SNAP['rel']", so stored links must sit there before any check runs
        snap["rel"] = {k: v[1] for k, v in stored_relations().items()}
    return snap


def save_cache(snap):
    cache = os.environ.get("FLEET_PICK_CACHE")
    if cache:
        tmp = f"{cache}.{os.getpid()}"
        json.dump(snap, open(tmp, "w"))
        os.replace(tmp, cache)


