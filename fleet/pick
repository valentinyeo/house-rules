    ALLOCATION.write_text(json.dumps({"at": time.time(), "engine": "cursor", "models": m,
                                      "models_by_engine": {"codex": {"hard": {"id": "gpt-6.1-sol", "effort": "medium"}}}}))
    assert brain(hard)[1:] == ("gpt-6.1-sol", "medium"), "the per-engine allocation sets the codex model"
