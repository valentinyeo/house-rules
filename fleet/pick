    wip_self_test()
    print("fleet/pick self-test ok")


def wip_self_test():
    """The stop lands between tickets, the short rest, and the WIP cap: closed means only own, orphan, PR queue and
    finish work, and every counted unit is something an open lane can take."""
    global RUNNERS, FREEZE, SNAP, try_claim
    now = dt.datetime.now(dt.timezone.utc)
    iso = lambda h: (now - dt.timedelta(hours=h)).strftime("%Y-%m-%dT%H:%M:%SZ")
    held = {"key": "HTPR-1", "board": "15", "section": "In Progress", "labels": [], "holders": [("runner 12", True)]}
    RUNNING.clear()
    (STATE / "stop-12").write_text("pacer\n")
    (STATE / "runner-12.log").write_text(f"{iso(0.5)} cursor: HTPR-1 composer-2.5 medium\n")
    assert not orphan(held), "a stopped runner keeps the ticket it is running: the stop lands between tickets"
    RUNNING.clear()
    with open(STATE / "runner-12.log", "a") as f:
        f.write(f"{iso(0.1)} end\n")
    assert orphan(held), "a stopped runner that runs nothing holds its tickets in name only"
    RUNNING.clear()
    (STATE / "stop-12").unlink()
    (STATE / "runner-12.log").unlink()

    RUNNERS, FREEZE = 3, STATE / "app-freeze"
    (STATE / "stop-3").write_text("pacer\n")

    def tk(key, section, *holders, labels=(), waiting=False):
        return {"key": key, "idx": 1, "board": PREFIX_BOARD[key.split("-")[0]], "section": section, "title": "x",
                "labels": list(labels), "prio": "Medium", "holders": [[h, True] for h in holders], "waiting": waiting,
                "subs": False, "paid": False, "created": "2026-01-01T00:00:00Z", "updated": "2026-01-01T00:00:00Z"}

    def pr(num, key, draft=False):
        return {"number": num, "title": f"{key} x", "draft": draft, "branch": f"runner-1/{key.lower()}",
                "updated": iso(0.2), "red": False}

    SNAP = {"tickets": [tk("HTPR-10", "In Progress"), tk("HTPR-11", "In Progress"), tk("HTPR-12", "In Progress", waiting=True)],
            "rel": {}, "prs": [], "incidents": []}
    (STATE / "runner-1.idle").write_text(f"{iso(3)} HTPR-10\n{iso(1)} HTPR-11\n{iso(3)} HTPR-12\n")
    assert resting(2, True) == {"HTPR-11", "HTPR-12"}, "an IDLE rest on work nobody waits on ends after SHORT_REST"
    (STATE / "runner-1.idle").unlink()

    tickets = [tk("HTPR-20", "In Progress", "runner 9"), tk("HTPR-21", "AI Review", "runner 1"),
               tk("HTPR-22", "QA", labels=["design-pass"]), tk("HTPR-23", "In Progress", labels=["incident"]),
               tk("HTPR-24", "In Progress", "postbox dev"), tk("HTPR-25", "Bugs"), tk("HTPR-26", "Bugs"),
               tk("HTPR-27", "AI Review", "runner 9"), tk("HYCI-1", "Backlog"), tk("HTPR-29", "QA", "runner 3")]
    SNAP = {"tickets": tickets, "rel": {t["key"]: [[], []] for t in tickets}, "prs": [pr(999991, "HTPR-21"),
            pr(999992, "HTPR-25"), pr(999993, "HTPR-21")], "incidents": [], "open": {}}
    SNAP["rel"]["HTPR-27"] = [["HYCI-1"], []]
    units, workers, excluded = pipeline()
    assert workers == [1, 2], "a runner the pacer stopped is no worker"
    assert units == {"HTPR-20", "HTPR-21", "HTPR-25", "HTPR-29"}, units
    assert excluded == {"design-pass": ["HTPR-22"], "incident": ["HTPR-23"], "outside the pool": ["HTPR-24"],
                        "blocked": ["HTPR-27"]}, excluded
    assert wip_line(units, workers, excluded).startswith("wip: 4 of 2, new work closed"), wip_line(units, workers, excluded)

    claimed = []
    real_claim = try_claim
    try_claim = lambda n, t, source, dry: claimed.append((t["key"], source)) or True
    try:
        t, source = choose(2, True)
        assert source == "orphan" and t["key"] in ("HTPR-20", "HTPR-29"), (t["key"], source)
        SNAP["tickets"] = [x for x in tickets if x["key"] not in ("HTPR-20", "HTPR-23", "HTPR-29")]
        t, source = choose(2, True)
        assert (t["key"], source) == ("HTPR-25", "pr"), (t["key"], source, "closed: a new-work ticket with an open PR is finished, not started")
        SNAP["tickets"].append(tk("HTPR-31", "In Progress", "runner 1"))
        SNAP["prs"] = [pr(999991, "HTPR-21")]
        try:
            choose(2, True)
            raise AssertionError("closed WIP started new work")
        except SystemExit as e:
            assert "wip: 2 of 2, new work closed" in str(e), e
        SNAP["tickets"] = [x for x in SNAP["tickets"] if x["key"] != "HTPR-31"]
        t, source = choose(2, True)
        assert source == "board" and t["key"] in ("HTPR-25", "HTPR-26"), "open WIP: new work starts again"
        SNAP["tickets"].append(tk("HTPR-32", "QA", "runner 2"))
        assert choose(2, True)[1] == "own", "a merged ticket waiting for its live check goes back to its runner"
        SNAP["tickets"] = [x for x in SNAP["tickets"] if x["key"] != "HTPR-32"] + [tk("HTPR-40", "In Progress", "runner 2")]
        SNAP["rel"]["HTPR-40"] = [[], []]
        (STATE / "runner-1.idle").write_text(f"{iso(0.5)} HTPR-40\n")
        t, source = choose(2, True)
        assert (t["key"], source) == ("HTPR-40", "park"), "an own ticket that rests is parked before anything else"
        (STATE / "runner-1.idle").unlink()
        # a runner whose login the board never added is offered nothing from it (HYCI-159: ship-claim refused Runner 5)
        MEMBERS["11514"] = {"runner 1"}
        SNAP = {"tickets": [tk("HYCI-1", "Backlog")], "rel": {"HYCI-1": [[], []]}, "prs": [], "incidents": [], "open": {}}
        assert can_join(1, "11514") and not can_join(2, "11514") and can_join(2, "15")
        assert choose(1, True)[0]["key"] == "HYCI-1", "a member is offered the board's ticket"
        try:
            choose(2, True)
            raise AssertionError("offered a ticket on a board the runner is not a member of")
        except SystemExit as e:
            assert str(e).startswith("none:"), e
    finally:
        try_claim = real_claim
        (STATE / "stop-3").unlink()


def main():
    global SNAP
    args = [a for a in sys.argv[1:]]
    if "--check-access" in args:
        return check_access()
    if args == ["--self-test"]:
        return self_test()
    if args == ["--wip"]:  # read only: the WIP line every pick logs, and the units behind it
        SNAP = load_snapshot()
        units, workers, excluded = pipeline()
        print(wip_line(units, workers, excluded))
        print("units: " + " ".join(sorted(units)))
        print("workers: " + " ".join(f"Runner {m}" for m in workers))
        for why, keys in sorted(excluded.items()):
            print(f"not counted, {why}: {' '.join(sorted(keys))}")
        return
    dry = "--dry-run" in args
    pos = [a for a in args if not a.startswith("--")]
    if len(pos) != 1 or not pos[0].isdigit() or not 1 <= int(pos[0]) <= max(RUNNERS, 1):
        sys.exit(f"usage: fleet/pick <1..{RUNNERS}> [--dry-run] [--json] | --check-access")
    n = int(pos[0])
    engine = runner_engine(n)
    if not engine:
        sys.exit(f"fleet/pick: runner {n} engine file names no known engine ({', '.join(ENGINES)}); do not pick")
    set_engine(engine)
    lock = None
    if not dry:
        STATE.mkdir(parents=True, exist_ok=True)
        lock = open(STATE / ".lock", "a")
        fcntl.flock(lock, fcntl.LOCK_EX)
    try:
        SNAP = load_snapshot()
        try:
            t, source = choose(n, dry)
        except Pick as p:
            t, source = p.t, p.source
        if source in ("own", "cross-qa", "park"):
            record_claim(n, t["key"], dry)
        if source == "park" and not dry:
            record_park(n, t["key"])
        pick = render(n, t, source)
    except (RuntimeError, OSError, ValueError) as e:
        sys.exit(f"fleet/pick: board or claims unreadable ({type(e).__name__}: {e}); do not pick new work")
    if "--json" in args:
        print(json.dumps(pick))
    else:
        print("\t".join([pick["ticket"], pick["model"], pick["effort"], f"{pick['source']}{' (dry run)' if dry else ''}",
                         pick["lane"], pick["repo"]]))


# ---------------------------------------------------------------- access check

def check_access():
    """Read only: does Runner 1..N have a login file, and sit on each board? Prints no secrets."""
    cred = HOME / ".config/hypertask-agents/credentials/sessions"
    members = {}
    for b in BOARDS:
        members[b] = fetch_members(b)
    ids = {}
    d = ht("agents", "list", "--query", "Runner", "--limit", "200")
    for a in (d or {}).get("agents") or []:
        if re.fullmatch(r"Runner \d+", a.get("display_name") or ""):
            ids[a["display_name"].lower()] = a["id"]
    print("runner\tlogin\ttoken\t" + "\t".join(BOARDS) + "\tmissing")
    missing_any = []
    for n in range(1, RUNNERS + 1):
        name = f"runner {n}"
        token = (cred / f"runner-{n}-agent-token").is_file()
        row = ["yes" if name in ids else "NO", "yes" if token else "NO"]
        miss = []
        for b in BOARDS:
            ok = None if members[b] is None else name in members[b]
            row.append("?" if ok is None else "yes" if ok else "NO")
            if ok is False:
                miss.append(b)
        print(f"Runner {n}\t" + "\t".join(row) + "\t" + ",".join(miss))
        missing_any += [(n, b) for b in miss]
    if missing_any:
        print("\nAdd a missing member (board owner or Valentin's login), per board:")
        print("  hypertask project invite <board-id> --user <agent-uuid>")
        print("or with the management key:")
        print("  hypertask agents update --id <agent-uuid> --add-project <board-id>")
        for n, b in missing_any:
            print(f"  Runner {n} board {b}: hypertask project invite {b} --user {ids.get(f'runner {n}', '<no login found>')}")


if __name__ == "__main__":
    main()
