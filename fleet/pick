def ticket_ready_self_test():
    """HYCI-396: a ticket that cannot ship in one run is not offered; one that can is; unread, incident and blocked-only
    tickets are not judged here; the off file keeps the log line and drops the skip; the column table matches ticket-ready's."""
    global log, READY_OFF
    import tempfile
    assert TICKET_READY is not None, "ticket-ready did not load"
    assert {b: tuple(c[0]) for b, c in BOARDS.items()} == {b: tuple(c) for b, c in TICKET_READY.COLUMNS.items()}, \
        "ticket-ready reads the same new-work columns as the picker"
    good = ("<h2>Problem</h2><p>The board header hides the ticket count on small screens, so people cannot see how full a column is.</p>"
            "<h2>Fix</h2><p>Show the count next to the column name at every width.</p>"
            "<h2>Done when</h2><ul><li><p>The count shows on a phone-sized screen.</p></li></ul><h2>Decision</h2><p>None.</p>")
    raw = {"ticketNumber": "HTPR-1", "uniqueIndex": 1, "title": "Show the ticket count on small screens", "description": good,
           "labels": [{"name": "brain-medium"}], "section": "Backlog", "sub_tasks": [], "blockingTasks": []}
    saved_log, saved_off, lines = log, READY_OFF, []
    log = lines.append
    try:
        READY_OFF = Path("/nonexistent/ticket-ready.off")
        READY_SEEN.clear()
        t = slim(raw, "15")
        assert t["ready"] == [] and eligible_reason(t) is None, "a one-run ticket is offered"
        plan = slim(dict(raw, ticketNumber="HTPR-2", sub_tasks=[{}] * 9), "15")
        assert plan["ready"] and plan["ready"][0].startswith("multi-step: "), plan["ready"]
        assert eligible_reason(plan).startswith("not ready: multi-step"), "a plan is not offered"
        assert eligible_reason(plan) and lines == [f"not-ready: HTPR-2 {plan['ready'][0]}"], lines
        eligible_reason(plan)
        assert len(lines) == 1, "one log line per ticket"
        assert eligible_reason(slim(dict(raw, ticketNumber="HTPR-3", labels=[]), "15")).startswith("not ready: brain-tag"), \
            "no brain tag: held until the tagger runs"
        assert eligible_reason(slim(dict(raw, ticketNumber="HTPR-4", labels=[{"name": "incident"}], sub_tasks=[{}] * 9), "15")) is None, \
            "an incident always runs"
        blocked_only = slim(dict(raw, ticketNumber="HTPR-5", blockingTasks=[{"ticketNumber": "HTPR-9", "status": "Normal", "section": "Backlog"}]), "15")
        assert blocked_only["ready"] == [], "BlockedBy is the picker's own check, not ticket-ready's"
        unread = slim({"ticketNumber": "HTPR-6", "uniqueIndex": 6, "title": "x", "section": "Backlog"}, "15")
        assert unread["ready"] == [] and eligible_reason(unread) is None, "a record with no description is not judged"
        assert eligible_reason(dict(plan, section="In Progress")) == "not in a new-work column", "a started ticket keeps its runner"
        READY_SEEN.clear()
        del lines[:]
        for i in range(20):
            eligible_reason(dict(plan, key=f"HTPR-{100 + i}"))
        assert len(lines) == READY_LOG_MAX, "the log names the first READY_LOG_MAX"
        ready_summary()
        assert lines[-1] == f"not-ready: 20 tickets skipped in all, {READY_LOG_MAX} named above", lines[-1]
        with tempfile.TemporaryDirectory() as d:
            READY_OFF = Path(d) / "off"
            READY_OFF.write_text("")
            READY_SEEN.clear()
            del lines[:]
            assert eligible_reason(plan) is None and lines == [f"not-ready: HTPR-2 {plan['ready'][0]}"], \
                "off file: the ticket is offered again, the line stays"
    finally:
        log, READY_OFF = saved_log, saved_off
        READY_SEEN.clear()


def one_run_self_test():
    """One ticket, one run, one PR: pending or green checks hold the ticket from every lane once the flag file exists; red,
    conflicting, change-requested, draft, unread, incident and stalled PRs are never held; off, the skip is only logged."""
    global SNAP, ONE_RUN_FLAG, log
    now = dt.datetime.now(dt.timezone.utc).replace(microsecond=0)
    fmt = "%Y-%m-%dT%H:%M:%SZ"
    ago = lambda m: (now - dt.timedelta(minutes=m)).strftime(fmt)
    tk = lambda key, labels=(), prio="Medium": {
        "key": key, "board": "15", "section": "AI Review", "title": "x", "labels": list(labels), "prio": prio, "holders": [],
        "waiting": False, "updated": ago(360), "created": ago(9999)}
    pr = lambda num, key, checks=("ci=SUCCESS",), updated=30, **kw: ({
        "number": num, "title": f"{key} x", "branch": f"runner-1/{key.lower()}", "draft": False, "red": False, "updated": ago(updated),
        "head": "aaa", "review": "", "mergeable": "MERGEABLE", "checks": None if checks is None else list(checks)} | kw)
    saved_snap, saved_flag, saved_log, lines = SNAP, ONE_RUN_FLAG, log, []
    log = lines.append
    flag = Path(STATE) / "one-run.on"
    ONE_RUN_FLAG = flag

    def held(tickets, prs, dry=True):
        global SNAP
        SNAP = {"tickets": tickets, "rel": {}, "prs": prs, "incidents": []}
        _ONE_RUN.clear()
        lines.clear()
        return one_run_hold(dry, now)

    try:
        flag.unlink(missing_ok=True)
        assert held([tk("HTPR-1")], [pr(1, "HTPR-1")]) == set(), "flag off: nothing is held"
        assert lines == [f"one-run: HTPR-1 PR open, checks green (shadow: {flag} missing, not skipped)"], lines
        flag.write_text("")
        assert held([tk("HTPR-1")], [pr(1, "HTPR-1", ("ci=IN_PROGRESS", "e2e=SUCCESS"))]) == {"HTPR-1"}, "pending checks hold the ticket"
        assert lines == ["one-run: HTPR-1 PR open, checks pending"], lines
        assert held([tk("HTPR-1")], [pr(1, "HTPR-1")]) == {"HTPR-1"} and lines == ["one-run: HTPR-1 PR open, checks green"], \
            "green checks hold the ticket"
        assert "HTPR-1" in resting(2, True) and "HTPR-1" in Skip(set(), resting(2, True)), "every lane reads the hold through resting()"
        for why, extra in (("a failed check", {"checks": ["ci=FAILURE", "e2e=IN_PROGRESS"]}), ("a red flag", {"red": True}),
                           ("a conflict", {"mergeable": "CONFLICTING"}), ("a change request", {"review": "CHANGES_REQUESTED"}),
                           ("a draft", {"draft": True}), ("an unread check list", {"checks": []}), ("a REST-only list", {"checks": None}),
                           ("a stalled PR", {"updated": 400})):
            assert held([tk("HTPR-1")], [pr(1, "HTPR-1", **extra)]) == set() and not lines, f"{why} is a model's job: not held"
        for why, checks, word in (("a cancelled check with a newer attempt running", ("bugfix-regression=CANCELLED", "bugfix-regression=IN_PROGRESS", "e2e=SUCCESS"), "pending"),
                                  ("a cancelled check with a newer attempt green", ("bugfix-regression=CANCELLED", "bugfix-regression=SUCCESS"), "green"),
                                  ("only a cancelled check left", ("bugfix-regression=CANCELLED", "e2e=SUCCESS"), "pending")):
            assert held([tk("HTPR-1")], [pr(1, "HTPR-1", checks)]) == {"HTPR-1"} and lines == [f"one-run: HTPR-1 PR open, checks {word}"], \
