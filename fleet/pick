class Pick(Exception):
    def __init__(self, t, source):
        self.t, self.source = t, source


SKIP = [()]  # the Skip of the pick in progress (a list so try_claim sees the current one)


def by_key(key):
    return next((t for t in SNAP["tickets"] if t["key"] == key), None)


DEAD = {}  # ticket key -> why fetch_ticket refused it, for the trace


def fetch_ticket(key):
    """A ticket the board lists in none of the pick columns (for example the ticket of a PR)."""
    t = by_key(key)
    if t:
        return t
    d = ht("task", "get", key)
    try:
        raw = d["tasks"][0]
        t = slim(raw, str(raw.get("projectId") or raw.get("boardId")))  # a moved ticket answers with its new key
    except (TypeError, KeyError, IndexError):
        return None
    if t["board"] not in BOARDS:
        return None
    # an archived or finished ticket has no work left, and ship-claim's domain admission refuses it every time (HYCI tickets
    # skip admission, so their open PRs stay offered)
    status = raw.get("status") or "Normal"
    if not key.startswith("HYCI-") and (status != "Normal" or raw.get("sectionIsDone")
                                        or (raw.get("section") or "").lower() in INCIDENT_DONE):
        DEAD[key] = f"ticket is {status if status != 'Normal' else raw.get('section')}: no work left"
        return None
    SNAP["tickets"].append(t)
    return t


def last_run(n):
    """(ticket, end time, result) of the run this runner finished last, from its launcher log and result file.
    The logs hold whole agent transcripts (100 MB and more), so only the tail that holds the last 'pick: <ticket>' line is read."""
    key = end = None
    try:
        with open(RUNNER_STATE / f"runner-{n}.log", "rb") as f:
            size = f.seek(0, 2)
            span = 1 << 21
            while True:
                start = max(0, size - span)
                f.seek(start)
                data = f.read(size - start)
                at = len(data)
                while True:
                    at = data.rfind(b" pick: ", 0, at)
                    if at < 0 or TICKET.match(data[at + 7:at + 40].decode("utf-8", "replace")):
                        break
                if at >= 0 and (start == 0 or data.rfind(b"\n", 0, at) >= 0):
                    break
                if start == 0:
                    break
                span *= 4
        if at >= 0:
            lines = data[data.rfind(b"\n", 0, at) + 1:].decode("utf-8", "replace").splitlines()
            key, end = TICKET.match(lines[0].partition(" pick: ")[2])[0], lines[0].split()[0]
            for line in lines[1:]:
                if line.rstrip().endswith(" end"):
                    end = line.split()[0]
        result = (RUNNER_STATE / f"runner-{n}.result").read_text().strip()
    except OSError:
        return None
    return (key, end, result) if key else None


def stamp_time(stamp):
    try:
        return dt.datetime.fromisoformat(stamp.replace("Z", "+00:00"))
    except ValueError:
        return None


def resting(n, dry):
    """Tickets some runner ended IDLE on that have not changed since: they wait on someone else, so every runner takes other work.
    IDLE ends are kept in runner-N.idle, so later runs and 'nothing to start' lines do not make a runner forget.
    A runner that just finished still shows in its runner-N.result and log, so its IDLE counts before its file is written."""
    path = RUNNER_STATE / f"runner-{n}.idle"
    seen = {}
    try:
        for line in open(path):
            stamp, key = line.split()
            seen[key] = max(seen.get(key, ""), stamp)
    except (OSError, ValueError):
        pass
    last = last_run(n)
    if last and last[2] in REST_RESULTS and last[1] and seen.get(last[0]) != last[1]:
        seen[last[0]] = last[1]
        if not dry:
            with open(path, "a") as f:
                f.write(f"{last[1]} {last[0]}\n")
    everyone = dict(seen)
    for m in range(1, RUNNERS + 1):
        if m == n:
            continue
        try:
            for line in open(RUNNER_STATE / f"runner-{m}.idle"):
                stamp, key = line.split()
                everyone[key] = max(everyone.get(key, ""), stamp)
        except (OSError, ValueError):
            pass
        other = last_run(m)
        if other and other[2] in REST_RESULTS and other[1]:
            everyone[other[0]] = max(everyone.get(other[0], ""), other[1])
    now = dt.datetime.now(dt.timezone.utc)
    rest = set()
    for key, stamp in everyone.items():
        when = stamp_time(stamp)
        if when is None or (now - when).total_seconds() > REST_MAX:
            continue
        t = by_key(key)
        if t is None:
            if (now - when).total_seconds() < SHORT_REST:
                rest.add(key)
            continue
        changed = stamp_time(t["updated"])
        if changed and (changed - when).total_seconds() > REST_GRACE:
            continue
        if (now - when).total_seconds() > REST_GRACE + SHORT_REST and not t["waiting"] and t["section"] != "Valentin Review":
            continue
        # an Urgent ticket that waits on nobody rests 10 minutes, not 2 hours (HYCI-245, release blocker, 10 Nov)
        if t.get("prio") == "Urgent" and not t["waiting"] and t["section"] != "Valentin Review" and (now - when).total_seconds() > URGENT_REST:
            continue
        rest.add(key)
    return rest | set(waits_until(now)) | wait_gate(dry, now)


class Skip:
    """Tickets this pick hands out to nobody: other runners' claims (hard) and tickets resting after an IDLE end.
    A resting ticket stays resting even when it has a BlockedBy link: an open link holds it anyway, and a closed link once
    lifted every rest, so HTPR-8863 (closed HYCI-265) was re-adopted every few minutes while it waited to 02:30 (11 Nov).
    The blocker's fix wakes it: ci-unblock-waiters changes the ticket, and a changed ticket ends its rest."""

    def __init__(self, hard, rest):
        self.hard, self.rest = hard, rest

    def __contains__(self, key):
        if key in self.hard:
            return True
        return key in self.rest


def lane_count(taken):
    """Runners that hold CI or infra work: by board assignment, plus claims the board does not show yet."""
    held = [t for t in SNAP["tickets"] if t["section"] in BOARDS[t["board"]][1] and in_lane(t)]
    runners = {n for t in held for n in names(t) if live_runner(n)}
    shown = {t["key"] for t in held if any(live_runner(n) for n in names(t))}
    return len(runners) + len({k for k in taken if k not in shown and by_key(k) and in_lane(by_key(k))})


def sf_reason(t):
    labels = set(t["labels"])
    if labels & (SKIP_SF | CI_LABELS | SKIP_ALL) or t["subs"] or t["waiting"] or t["paid"] or t["key"] in SF_SKIP_TICKETS:
        return "Software Factory skip: label, sub-tasks, paid or ticket list"
    if SF_LEAD in names(t):
        return "held by the Software Factory lead"
    try:
        hold = {l.split()[0] for l in open(SF_HOLD) if l.strip() and not l.startswith("#")}
    except OSError:
        hold = set()
    return "on the multibot hold file" if t["key"] in hold else None


def sf_eligible(t):
    return sf_reason(t) is None


def pr_ticket_for(key):
    """The open PR that names this ticket, or None. Unreadable GitHub is no PR: a lost read never holds a ticket."""
    try:
        return next((p for p in open_prs() if pr_ticket(p) == key), None)
    except Exception:
        return None


def cannot_build(t):
    """Why this new-work ticket cannot be built yet, or "". A ticket that states it needs Valentin, a key only he or an
    admin can place, access, a design sign-off or a person at a PC never starts a model (HYCI-355). An incident and a
    ticket with an open PR are never held: the incident lane owns the first, the PR lane offers the second. Only new-work
    tickets are asked, so a runner that already started a ticket keeps it."""
    why = t.get("needs") or ""
    if not why or INCIDENT_LABEL in (t.get("labels") or []):
        return ""
    return "" if pr_ticket_for(t["key"]) else why


def eligible_reason(t):
    """Why a runner may not start this ticket from its new-work column, or None when it may."""
    labels = set(t["labels"])
    if WASTED in labels:
        return WASTED_WHY
    if labels & SKIP_ALL:
        return "label skip: " + ", ".join(sorted(labels & SKIP_ALL))
    if skipped(t):
        return "timed out on OpenCode in the last 24 hours"
    if t["waiting"]:
        return "waits on Valentin"
    if not t["section"] in BOARDS[t["board"]][0]:
        return "not in a new-work column"
    need = cannot_build(t)
    if need:
        return "cannot be built yet: " + need
    if t["board"] == "2060":
        return sf_reason(t)
    if t["board"] == "15" and not is_ci(t):
        if labels & SKIP_APP:
            return "label skip: " + ", ".join(sorted(labels & SKIP_APP))
        agents = [h[0] for h in t["holders"] if h[1]]
        return "held by agent " + ", ".join(agents) if agents else None
    if t["board"] == "11514":
        if labels & SKIP_INFRA:
            return "label skip: " + ", ".join(sorted(labels & SKIP_INFRA))
        agents = [h[0] for h in t["holders"] if h[1]]
        return "held by agent " + ", ".join(agents) if agents else None
    return None


def eligible_new(t):
    """May a runner start this ticket from its new-work column? Rules of the five old pickers."""
    return eligible_reason(t) is None


def orphan_ok(t):
    if t["board"] == "2060":
        return sf_eligible(t)
    return is_ci(t) or t["board"] != "15" or not set(t["labels"]) & SKIP_APP


def is_open(key):
    """Is this blocker still open? Tickets in a pick column are; any other is read once (done column or archived = closed)."""
    if by_key(key):
        return True
    known = SNAP.setdefault("open", {})
    if key not in known:
        d = ht("task", "get", key)
        try:
            raw = d["tasks"][0]
            # task get carries no sectionIsDone any more: the column name decides
            known[key] = raw.get("status") != "Archive" and not raw.get("sectionIsDone") \
                and not re.match(r"(done|flag:|no flag)", raw.get("section") or "", re.I)
        except (TypeError, KeyError, IndexError):
            known[key] = True  # unreadable: assume it still blocks
        save_cache(SNAP)
    return known[key]


def blocked(t):
    return any(is_open(w) for w in relations(t["key"])[0])


