TRACE_KEEP_DAYS = 7


def archive_trace(path):
    """Rotate: move the full trace aside (atomic, so only one runner wins), gzip it into pick-trace-archive, prune old ones."""
    arch = path.parent / "pick-trace-archive"
    arch.mkdir(parents=True, exist_ok=True)
    stamp = dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    moved = arch / f"pick-trace-{stamp}-{os.getpid()}.jsonl.part"
    try:
        os.replace(path, moved)
    except FileNotFoundError:
        return  # another runner rotated it first
    final = arch / f"pick-trace-{stamp}-{os.getpid()}.jsonl.gz"
    with open(moved, "rb") as src, gzip.open(f"{final}.tmp", "wb") as dst:
        shutil.copyfileobj(src, dst)
    os.replace(f"{final}.tmp", final)
    moved.unlink()
    cutoff = time.time() - TRACE_KEEP_DAYS * 86400
    for old in arch.glob("pick-trace-*.jsonl.gz"):
        try:
            if old.stat().st_mtime < cutoff:
                old.unlink()
        except OSError:
            pass


def write_trace(n, dry, ticket, source, ending):
    """One JSON line per pick: every ticket and PR outcome, plus refusal counts. Never fails the pick."""
    try:
        path = trace_path(dry)
        if path is None or SNAP is None:
            return
        now = dt.datetime.now(dt.timezone.utc)
        pool = sorted(SNAP["tickets"], key=lambda t: (rank(t), BOARD_ORDER[t["board"]], t["created"]))
        closed = (TRACE["wip"] or {}).get("new") == "closed"
        top = []
        for t in pool:
            if ticket and t["key"] == ticket["key"]:
                result = "chosen"
            elif t["key"] in TRACE["why"]:
                result = TRACE["why"][t["key"]]
            elif not TRACE["new"]:
                result = f"not reached: {source or 'none'} chose first"
            elif closed and t["section"] in BOARDS[t["board"]][0]:
                result = "new work closed by the WIP cap"
            else:
                result = "not tried"
            created = stamp_time(t["created"])
            top.append({"key": t["key"], "prio": t["prio"], "brain": next((l for l in t["labels"] if l.startswith("brain-")), ""),
                        "board": t["board"], "section": t["section"],
                        "age_h": round((now - created).total_seconds() / 3600, 1) if created else None, "result": result})
        prs = [TRACE["prs"].get(p["number"], {"pr": p["number"], "ticket": pr_ticket(p),
               "result": f"not reached: {source or 'none'} chose first"}) for p in SNAP.get("prs") or []]
        line = {"ts": now.strftime("%Y-%m-%dT%H:%M:%SZ"), "runner": n, "dry": dry, "wip": TRACE["wip"], "step": source or "none",
                "ticket": ticket["key"] if ticket else None, "ending": ending, "candidates": top, "prs": prs,
                "refusal_counts": dict(Counter(t["result"] for t in top if t["result"] != "chosen")),
                "pr_refusal_counts": dict(Counter(p["result"] for p in prs if p["result"] != "chosen"))}
        path.parent.mkdir(parents=True, exist_ok=True)
        if path.exists() and path.stat().st_size > TRACE_MAX:
            archive_trace(path)
        with open(path, "a") as f:
            f.write(json.dumps(line, separators=(",", ":")) + "\n")
    except Exception as e:
        log(f"pick-trace: not written ({type(e).__name__}: {e})")


