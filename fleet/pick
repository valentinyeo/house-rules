    iso = lambda h: (now - dt.timedelta(hours=h)).strftime("%Y-%m-%dT%H:%M:%SZ")

    def ledger(*rows):
        _LEDGER.clear()
        (RUNNER_STATE / "run-ledger.jsonl").write_text("".join(json.dumps(r) + "\n" for r in rows))

    def run(key, engine, hours, detail="timeout: hit the 3h run limit"):
        return {"ts": iso(hours), "runner": 2, "ticket": key, "engine": engine, "model": "m", "result": "FAIL",
                "state": "FAULT", "detail": detail, "source": "board"}

    t = {"key": "HTPR-70", "idx": 1, "board": "15", "section": "In Progress", "title": "x", "labels": [], "prio": "Medium",
         "holders": [["runner 2", True]], "waiting": False, "subs": False, "paid": False,
         "created": "2026-01-01T00:00:00Z", "updated": "2026-01-01T00:00:00Z"}
    new_t = {**t, "key": "HTPR-71", "section": "Bugs", "holders": []}
    (RUNNER_STATE / "engine-1").write_text("codex\n")
    (RUNNER_STATE / "engine-2").write_text("opencode\n")
    (RUNNER_STATE / "engine-3").write_text("opencode\n")
    try_claim = lambda n, t, source, dry: True
    try:
        ledger(run("HTPR-70", "pi-opencode", 1), run("HTPR-71", "opencode", 2))
        assert opencode_timed_out("HTPR-70") and opencode_timed_out("HTPR-71"), "pi-opencode and opencode both count"
        assert orphan(t), "timed out on OpenCode within 24h: its OpenCode holder holds it in name only"
        assert not worker_can_adopt(3, t) and worker_can_adopt(1, t), "only a runner on another engine may adopt it"
        set_engine("opencode")
        assert skipped(t) and eligible_reason(new_t) == "timed out on OpenCode in the last 24 hours"
        SNAP = {"tickets": [t, new_t], "rel": {"HTPR-70": [[], []], "HTPR-71": [[], []]}, "prs": [], "incidents": [], "open": {}}
        for n in (2, 3):
            try:
                got = choose(n, True)
                raise AssertionError(f"OpenCode runner {n} took {got[0]['key']} as {got[1]}")
            except SystemExit as e:
                assert str(e).startswith("none:"), e
        set_engine("codex")
        assert not skipped(t) and eligible_reason(new_t) is None
        assert choose(1, True) == (t, "orphan"), "a Codex runner adopts the timed-out ticket"

        set_engine("opencode")
        try_claim = saved[3]
        hold = "ship-claim: HOLD. RUNNER 2 has unfinished merged work: https://app.hypertask.ai/detail/project-15/70 (HTPR-70)."
        globals()["ship_claim"] = lambda n, key, incident=False, dry=False: (4, hold)
        SNAP["tickets"] = [t, {**new_t, "key": "HTPR-72"}]
        SNAP["rel"]["HTPR-72"] = [[], []]
        try:
            got = choose(2, True)
            raise AssertionError(f"ship-claim's hold handed the holder {got[0]['key']} as {got[1]}")
        except Pick as p:
            raise AssertionError(f"ship-claim's hold resumed the timed-out {p.t['key']} as {p.source}")
        except SystemExit as e:
            assert str(e).startswith("none:"), e
        calls, real_run = [], subprocess.run
        subprocess.run = lambda args, **kw: calls.append((args, kw["env"]["SHIP_SESSION_NAME"])) or \
            subprocess.CompletedProcess(args, 0, "HTPR-70 stays in In Progress, RUNNER 2 unassigned\n", "")
        try:
            hand_back_timeouts(2, True)
            assert not calls and names(t) == ["runner 2"], "a dry run hands nothing back"
            hand_back_timeouts(2, False)
        finally:
            subprocess.run = real_run
        assert [(a[1:3], who) for a, who in calls] == [(["HTPR-70", "--hand-back"], "RUNNER 2")], calls
        assert names(t) == [], "the handed-back ticket no longer names its OpenCode runner"
        t["holders"] = [["runner 2", True]]

        ledger(run("HTPR-70", "pi-opencode", 25))
        assert not opencode_timed_out("HTPR-70") and not orphan(t), "a timeout older than 24h changes nothing"
        set_engine("opencode")
        assert not skipped(t) and choose(2, True) == (t, "own"), "after 24h its OpenCode holder resumes it"

        ledger(run("HTPR-70", "codex", 1), run("HTPR-70", "cursor", 1), run("HTPR-70", "pi-opencode", 1, "rc 1"))
        assert not opencode_timed_out("HTPR-70") and not orphan(t), "a timeout on another engine, or another fault, changes nothing"
        assert not skipped(t) and choose(2, True) == (t, "own")
    finally:
        _LEDGER.clear()
        set_engine(saved[4])
        globals()["ship_claim"] = saved[5]
        RUNNER_STATE, RUNNERS, SNAP, try_claim = saved[:4]


