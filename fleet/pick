        tmp.unlink(missing_ok=True)


def stage_self_test():
    """HYCI-345: during a restart a loose orphan does not close new work, a held ticket does. A clear with no ramp field made under
    RESTART_WINDOW_H ago is a restart (the coordinator's 13 Nov clear, with a `reopened` block); an old one, a full ramp and a
    stopped factory are not."""
    global FACTORY_STOP, SNAP
    saved = (FACTORY_STOP, SNAP)
    tmp = STATE / "stage-test.json"
    now = dt.datetime(2026, 11, 13, 12, 0, tzinfo=dt.timezone.utc)
    recent = {"at": "2026-11-13T01:18:32Z", "by": "t", "why": "t"}
    try:
        FACTORY_STOP = tmp
        tmp.unlink(missing_ok=True)
        assert not in_restart(now), "no record: no restart"
        tmp.write_text(json.dumps({"at": "x", "tripped_by": ["R2"], "cleared": None}))
        assert not in_restart(now), "an active stop is not a restart; factory_stopped() handles it"
        tmp.write_text(json.dumps({"at": "x", "tripped_by": ["R2"], "cleared": recent,
                                   "reopened": {"at": "z", "by": "c", "why": "w", "undone_clear": recent}}))
        assert in_restart(now) and factory_ramp() == (3, None), "a recent clear with no ramp and a reopened block is a restart that caps no runner"
        assert not in_restart(now + dt.timedelta(hours=40)), "a clear 40 hours old is over"
        tmp.write_text(json.dumps({"at": "x", "tripped_by": ["R2"], "cleared": {**recent, "ramp": {"step": 3, "at": "y"}}}))
        assert not in_restart(now), "the last ramp step is no restart"
        tmp.write_text(json.dumps({"at": "x", "tripped_by": ["R2"], "cleared": {**recent, "ramp": {"step": 1, "at": "y"}}}))
        assert in_restart(now)
        # units: the unheld orphan stops counting only during a restart; a held ticket always counts
        RUNNING.clear()
        RUNNING.update({3: "HTPR-5"})
        tk = lambda key, *holders: {"key": key, "holders": [[h, True] for h in holders]}
        SNAP = {"tickets": [tk("HYCI-346"), tk("HTPR-5", "runner 3")]}
        units = {"HYCI-346", "HTPR-5"}
        assert staged_units(units) == {"HTPR-5"}, "restart: the unheld orphan is not a canary's work"
        tmp.write_text(json.dumps({"at": "x", "tripped_by": ["R2"], "cleared": {**recent, "ramp": {"step": 3, "at": "y"}}}))
        assert staged_units(units) == units, "after the restart every unit counts"
    finally:
        FACTORY_STOP, SNAP = saved
        RUNNING.clear()
        tmp.unlink(missing_ok=True)


def escalate_self_test():
    """A ticket an OpenCode run timed out on in the last 24h leaves OpenCode: its holder neither resumes nor parks it, no
    OpenCode runner takes it, and a runner on another engine adopts it as an orphan."""
    global RUNNER_STATE, RUNNERS, SNAP, try_claim
    import tempfile
    saved = (RUNNER_STATE, RUNNERS, SNAP, try_claim, ENGINE, ship_claim)
    RUNNER_STATE = Path(tempfile.mkdtemp())
    assert RUNNER_STATE != STATE, "the ledger is read where fleet/runner writes it, not from the picker's state"
    RUNNERS = 3
