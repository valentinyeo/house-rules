    at = lambda m: (now - dt.timedelta(minutes=m)).strftime("%Y-%m-%dT%H:%M:%SZ")
    saved = list(_LEDGER)
    _LEDGER[:] = [[{"ticket": "HTPR-1", "ts": at(5), "state": "WAIT_CHECK", "reason": "RUNNER IDLE recheck 2026-11-12T02:30Z"},
                   {"ticket": "HTPR-2", "ts": at(30), "state": "WAIT_CHECK", "reason": "ci-pending"},
                   {"ticket": "HTPR-2", "ts": at(20), "state": "WAIT_CHECK", "reason": "x"},
                   {"ticket": "HTPR-2", "ts": at(10), "state": "WAIT_CHECK", "reason": "ci-pending"},
                   {"ticket": "HTPR-3", "ts": at(10), "state": "WAIT_CHECK", "reason": "ci-pending"},
                   {"ticket": "HTPR-4", "ts": at(10), "state": "WAIT_CHECK", "reason": "until 2026-11-11T11:00Z"}]]
    try:
        h = waits_until(now)
    finally:
        _LEDGER[:] = saved
    assert h.get("HTPR-1") == dt.datetime(2026, 11, 12, 2, 30, tzinfo=dt.timezone.utc), "a stated recheck time holds the ticket"
    assert "HTPR-2" in h, "three waits in two hours rest the ticket two hours"
    assert "HTPR-3" not in h, "one wait alone keeps the old rest rules"
    assert "HTPR-4" not in h, "a recheck time already past holds nothing"


def wait_gate_self_test():
    """The wait gate: a waiting ticket is held until what it waits on changes, in every lane (they all read resting())."""
    global SNAP, open_prs
    now = dt.datetime.now(dt.timezone.utc).replace(microsecond=0)
    fmt = "%Y-%m-%dT%H:%M:%SZ"
    ago = lambda m: (now - dt.timedelta(minutes=m)).strftime(fmt)
    tk = lambda key, updated=360, labels=(), prio="Medium", section="In Progress": {
        "key": key, "board": "15", "section": section, "title": "x", "labels": list(labels), "prio": prio, "holders": [],
        "waiting": False, "updated": ago(updated), "created": ago(9999)}
    pr = lambda num, key, head="aaa", checks=("ci=IN_PROGRESS",), review="", merge="MERGEABLE": {
        "number": num, "title": f"{key} x", "branch": f"runner-1/{key.lower()}", "draft": False, "red": False, "updated": ago(30),
        "head": head, "review": review, "mergeable": merge, "checks": list(checks)}
    wait = lambda key, m, reason="RUNNER IDLE CI pending on the PR", state="WAIT_CHECK", detail="": {
        "ticket": key, "ts": ago(m), "state": state, "reason": reason, "detail": detail}

    def fresh(rows, tickets, prs=None, rel=None):
        global SNAP
        _LEDGER[:] = [rows]
        _GATE.clear()
        if gate_state_path().exists():
            gate_state_path().unlink()
        SNAP = {"tickets": tickets, "rel": rel or {}, "prs": prs if prs is not None else [], "incidents": []}

    def held(at=None, dry=False):
        _GATE.clear()
        return wait_gate(dry, at or now)

    saved_ledger, saved_snap, saved_open = list(_LEDGER), SNAP, open_prs
    try:
        # hold: the PR waits on a running check, nothing changed
        fresh([wait("HTPR-1", 5)], [tk("HTPR-1")], [pr(1, "HTPR-1")])
        assert held() == {"HTPR-1"}, "a ticket that ended waiting on a running check is held"
        assert "HTPR-1" in resting(2, True) and "HTPR-1" in Skip(set(), resting(2, True)), "every lane reads the gate through resting()"
        assert json.loads(gate_state_path().read_text())["HTPR-1"]["parts"]["pr"][0][1] == "aaa", "the fingerprint is kept at the first pick"
        # each part releases
        for field, value, why in (("head", "bbb", "a new commit"), ("review", "APPROVED", "a review decision"),
                                  ("mergeable", "CONFLICTING", "a merge conflict"), ("checks", ["ci=SUCCESS"], "a finished check")):
            fresh([wait("HTPR-1", 5)], [tk("HTPR-1")], [pr(1, "HTPR-1")])
            assert held() == {"HTPR-1"}
            SNAP["prs"][0][field] = value
            assert held() == set(), f"{why} lifts the hold"
            SNAP["prs"][0][field] = pr(1, "HTPR-1")[field]
            assert held() == set(), "the lift stays when the fingerprint flips back"
        # HYCI-343: one of eight checks finishing is not news, and a wake per check transition is a run that burns
        eight = [f"c{i}=IN_PROGRESS" for i in range(7)] + ["c7=SUCCESS"]
        fresh([wait("HTPR-1", 5)], [tk("HTPR-1")], [pr(1, "HTPR-1", checks=eight)])
        assert held() == {"HTPR-1"}
        SNAP["prs"][0]["checks"] = [f"c{i}=IN_PROGRESS" for i in range(6)] + ["c6=SUCCESS", "c7=SUCCESS"]
        assert held() == {"HTPR-1"}, "a check finishing while six still run does not wake the pool"
        SNAP["prs"][0]["checks"] = [f"c{i}=SUCCESS" for i in range(8)]
        assert held() == set(), "checks that all finished lift the hold: a run has the merge to do"
        fresh([wait("HTPR-1", 5)], [tk("HTPR-1")], [pr(1, "HTPR-1")])
        assert held() == {"HTPR-1"}
        SNAP["prs"][0]["checks"] = ["ci=FAILURE", "e2e=IN_PROGRESS"]
        assert held() == set(), "a failed check lifts the hold while the rest still run"

        fresh([wait("HTPR-1", 5)], [tk("HTPR-1")], [pr(1, "HTPR-1")])
        held()
        SNAP["prs"][0]["mergeable"] = "UNKNOWN"
        assert held() == {"HTPR-1"}, "GitHub recomputing mergeable after a push to base is not a change"
        # ticket updated
        fresh([wait("HTPR-1", 5)], [tk("HTPR-1")], [pr(1, "HTPR-1")])
        held()
        SNAP["tickets"][0]["updated"] = ago(2)
        assert held() == set(), "a ticket edit more than a minute after the end lifts the hold"
        fresh([wait("HTPR-1", 5)], [tk("HTPR-1", 4.5)], [pr(1, "HTPR-1")])
        assert held() == {"HTPR-1"}, "the run's own park note inside the grace does not lift it"
        fresh([wait("HTPR-1", 5)], [tk("HTPR-1", 2)] + [tk(f"HTPR-9{i}", 2) for i in range(5)], [pr(1, "HTPR-1")])
        assert "HTPR-1" in held(), "a script that touched six tickets in one minute is not news about this one"
        # a PR that appears, or goes
        fresh([wait("HTPR-1", 5)], [tk("HTPR-1")], [pr(1, "HTPR-1")])
        held()
        SNAP["prs"] = []
        assert held() == set(), "the PR closing lifts the hold"
        # BlockedBy
        blocker = tk("HYCI-9", section="Backlog")
        fresh([wait("HTPR-2", 5, "RUNNER IDLE waits on HYCI-9")], [tk("HTPR-2"), blocker], rel={"HTPR-2": [["HYCI-9"], []]})
        assert held() == {"HTPR-2"}, "a ticket whose blocker has not moved is held"
        blocker["section"] = "Done"
        assert held() == set(), "the blocker moving lifts the hold"
        fresh([wait("HTPR-2", 5, "RUNNER IDLE waits on HYCI-9")], [tk("HTPR-2"), tk("HYCI-9", section="Backlog")], rel={"HTPR-2": [["HYCI-9"], []]})
        held()
        SNAP["tickets"] = [tk("HTPR-2")]
        assert held() == set(), "the blocker leaving the board lifts the hold"
        # cap, by type
        rows = [wait("HTPR-1", 5)]
        fresh(rows, [tk("HTPR-1")], [pr(1, "HTPR-1")])
        assert held() == {"HTPR-1"}
        assert held(now + dt.timedelta(minutes=300)) == {"HTPR-1"} and held(now + dt.timedelta(minutes=365)) == set(), "the cap is 6 hours"
        fresh(rows, [tk("HTPR-1", prio="Urgent")], [pr(1, "HTPR-1")])
        held()
        assert held(now + dt.timedelta(minutes=50)) == {"HTPR-1"} and held(now + dt.timedelta(minutes=57)) == set(), "an Urgent ticket is looked at hourly"
        fresh(rows, [tk("HTPR-1", labels=["incident"])], [pr(1, "HTPR-1")])
        held()
        assert held(now + dt.timedelta(minutes=10)) == {"HTPR-1"} and held(now + dt.timedelta(minutes=17)) == set(), "an incident every 20 minutes"
        # fail open
        fresh([wait("HTPR-1", 25)], [tk("HTPR-1")], [pr(1, "HTPR-1")])
        assert held() == set(), "a first look 25 minutes after the end cannot say what changed: not held"
        fresh([wait("HTPR-1", 5), {"ticket": "HTPR-1", "ts": ago(2), "state": "BUILDING", "reason": "RUNNER DONE"}], [tk("HTPR-1")], [pr(1, "HTPR-1")])
        assert held() == set(), "a later run that built clears the wait"
        fresh([wait("HTPR-1", 5, "RUNNER IDLE crash exit 1", "FAULT", "exit 1"), wait("HTPR-3", 5, "CI RUNNER IDLE no model reply", "FAULT", "reply cap")],
              [tk("HTPR-1"), tk("HTPR-3")], [pr(1, "HTPR-1")])
        assert held() == set(), "a crash FAULT is not a wait, and the word CI in the CI-lane prefix does not make one"
        fresh([wait("HTPR-1", 5, "CI RUNNER IDLE waiting on required checks for PR 1", "FAULT", "WAIT_CHECK exceeded 30 min")],
              [tk("HTPR-1")], [pr(1, "HTPR-1")])
        assert held() == {"HTPR-1"}, "a FAULT that exceeded the wait limit on a PR is held like a WAIT_CHECK"
        fresh([wait("HTPR-1", 5, "RUNNER IDLE CI pending")], [tk("HTPR-1")], [pr(1, "HTPR-1", checks=("ci=SUCCESS",))])
        assert held() == set(), "CI named as the wait but every check had finished at the first look: not held"
        fresh([wait("HTPR-1", 5, "RUNNER IDLE waiting on human review")], [tk("HTPR-1")], [pr(1, "HTPR-1", checks=("ci=SUCCESS",))])
        assert held() == {"HTPR-1"}, "a review wait with green checks is held until the review changes"
        # a run that built and left the PR in AI Review waits for its checks (canary HYCI-358)
        built = lambda key, m, reason="DONE AI Review": wait(key, m, reason, "BUILDING")
        fresh([built("HTPR-1", 1)], [tk("HTPR-1")], [pr(1, "HTPR-1")])
        assert held() == {"HTPR-1"}, "a build that left running checks on its PR is held"
        SNAP["prs"][0]["checks"] = ["ci=SUCCESS"]
        assert held() == set(), "its checks finishing releases it"
        fresh([built("HTPR-1", 1)], [tk("HTPR-1")], [pr(1, "HTPR-1", checks=("ci=SUCCESS",))])
        assert held() == set(), "a build whose checks had finished is not held"
        fresh([built("HTPR-1", 1)], [tk("HTPR-1")])
        assert held() == set(), "a build with no PR is not held"
        fresh([built("HTPR-1", 1, "DONE Done")], [tk("HTPR-1")], [pr(1, "HTPR-1")])
        assert held() == set(), "a build that ended in another column is not a PR wait"
        # nothing to observe: the stated recheck time, else 30 minutes
        fresh([wait("HTPR-4", 5, f"RUNNER IDLE production deploy in flight, recheck {(now + dt.timedelta(minutes=30)).strftime('%H:%M')}Z")], [tk("HTPR-4")])
        assert held() == {"HTPR-4"} and held(now + dt.timedelta(minutes=29)) == {"HTPR-4"} and held(now + dt.timedelta(minutes=31)) == set(), \
            "a stated recheck time ends the blind hold"
        fresh([wait("HTPR-4", 5, "RUNNER IDLE production deploy in flight")], [tk("HTPR-4")])
        assert held() == {"HTPR-4"} and held(now + dt.timedelta(minutes=31)) == set(), "a blind wait is held 30 minutes"
        # dry runs write nothing; unreadable data and errors never hold
        fresh([wait("HTPR-1", 5)], [tk("HTPR-1")], [pr(1, "HTPR-1")])
        assert held(dry=True) == {"HTPR-1"} and not gate_state_path().exists(), "a dry run keeps no state"
        SNAP["prs"] = None

        def unreadable():
            raise RuntimeError("GitHub unreachable")
        open_prs = unreadable
        assert held() == {"HTPR-1"}, "an unreadable PR list leaves that part uncompared, not released or crashed"
        open_prs = saved_open
        SNAP["tickets"] = None
        assert held() == set(), "an error in the gate hands every ticket back"
    finally:
        _LEDGER[:] = saved_ledger
        SNAP, open_prs = saved_snap, saved_open
        _GATE.clear()


def self_test():
    """The park hand-back: due once per rest window, never for a foreign claim or a ticket outside a building column, and the
    job's brief and model. Needs no board, no network."""
    global STATE, ALLOCATION, RUNNER_STATE, WATCH, FACTORY_STOP
    import tempfile
    STATE = Path(tempfile.mkdtemp())
    FACTORY_STOP = STATE / "no-factory-stop.json"  # a live stop record must not change the offline test
    ALLOCATION = STATE / "allocation.json"
    RUNNER_STATE = STATE
    WATCH = STATE
    MEMBERS.update({b: None for b in BOARDS})  # membership unknown: the offline test offers every board
    t = {"key": "HTPR-1", "idx": 1, "board": "15", "section": "In Progress", "title": "x", "labels": [], "prio": "Medium"}
    SKIP[0] = Skip(set(), set())
