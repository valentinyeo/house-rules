WAIT_STREAK = 3  # this many WAIT_CHECK ends (a crash may retry) on one ticket within WAIT_WINDOW: it rests WAIT_WINDOW from the last
WAIT_WINDOW = 2 * 3600
ISO_AT = re.compile(r"(20\d\d-\d\d-\d\dT\d\d:\d\d(?::\d\d)?Z?)")


def waits_until(now=None):
    """Tickets a run said wait to a time, or that keep ending WAIT_CHECK/FAULT, mapped to when they may be offered again.
    Valentin 2026-11-13: 1,735 Codex runs 9 to 12 Nov, 105 built anything. HTPR-8863 said "recheck 2026-11-12T02:30Z" and
    was woken 117 times on 11 Nov, every 3 minutes, because each run's own park note changed the ticket and lifted its rest.
    A stated recheck time and a streak hold whatever the ticket's updates say."""
    now = now or dt.datetime.now(dt.timezone.utc)
    hold, ends = {}, defaultdict(list)
    for r in ledger_rows():
        key, when = r.get("ticket"), stamp_time(r.get("ts", ""))
        if not key or not when or (now - when).total_seconds() > REST_MAX or r.get("state") not in ("WAIT_CHECK", "FAULT"):
            continue
        if r.get("state") == "WAIT_CHECK":
            ends[key].append(when)
        for iso in ISO_AT.findall(str(r.get("reason", "")) + " " + str(r.get("detail", ""))):
            at = stamp_time(iso if iso.endswith("Z") else iso + "Z")
            if at and when < at and (at - when).total_seconds() <= REST_MAX:
                hold[key] = max(hold.get(key, at), at)
    for key, times in ends.items():
        recent = [t for t in times if (now - t).total_seconds() < WAIT_WINDOW]
        if len(recent) >= WAIT_STREAK:
            until = max(recent) + dt.timedelta(seconds=WAIT_WINDOW)
            hold[key] = max(hold.get(key, until), until)
    return {k: v for k, v in hold.items() if v > now}


# ---------------------------------------------------------------- wait gate
# Valentin 2026-11-13: "the built share is horrible ... we are hemorrhaging money". 7 to 13 Nov: 3,087 runs, 1,782 ended
# WAIT_CHECK, 715 FAULT, 413 BUILDING. A model session was started again and again only to look at a ticket that waits on CI,
# a review or a blocker. Rests lifted when a run's own park note touched the ticket, and the 3-in-2h streak and ISO-time hold
# ignored "recheck 17:30Z" and "WAIT_CHECK exceeded 30 min". The gate is a script: it records what the ticket waits on and
# hands the ticket to no model until that changes.
WAIT_GATE_CAP = 6 * 3600       # a wait is never held longer than this, whatever the fingerprint says
WAIT_GATE_CAP_URGENT = 3600    # an Urgent ticket is looked at hourly
WAIT_GATE_CAP_INCIDENT = 1200  # an incident or release-stop ticket every 20 minutes
WAIT_GATE_BLIND = 1800         # nothing observable (no open PR, no BlockedBy): a stated recheck time, else 30 minutes
WAIT_GATE_LATE = 1200          # a first look this long after the end cannot show what changed since: fail open
WAIT_GATE_BUMP = 5             # tickets that share one updated minute were bulk-touched by a script, not by the work
WAIT_PREFIX = re.compile(r"^\s*(?:CI/INFRA |CI |INFRA )?RUNNER IDLE\s*", re.I)
WAIT_FAULT = re.compile(r"WAIT_CHECK exceeded|\bchecks?\b|\bCI\b|\bPR\b|BlockedBy|blocked on|waits? on|waiting on|recheck|pending|in flight|deploy", re.I)
WAIT_CI = re.compile(r"\bchecks?\b|\bCI\b|pending|in flight|deploy|running|required", re.I)
RECHECK_HM = re.compile(r"recheck(?: at)?\s+(\d{1,2}):(\d\d)\s*Z", re.I)
_GATE = {}
_ONE_RUN = {}


def wait_end(r):
    """True when a ledger row is a run that ended waiting: WAIT_CHECK, or a FAULT whose text names CI, a PR or a blocker.
    The 'CI RUNNER IDLE' prefix is stripped first, or every CI-lane FAULT would match on the word CI."""
    # PARKED: a run that ended by parking a ticket whose work is merged or waiting. It is the same wait, so the same gate
    # holds it (HYCI-358, 13 Nov 16:31 to 16:43: six PARKED runs in 12 minutes on a merged PR, none held, because only
    # WAIT_CHECK and FAULT counted)
    if r.get("state") in ("WAIT_CHECK", "PARKED"):
        return True
    if r.get("state") != "FAULT":
        return False
    text = WAIT_PREFIX.sub("", str(r.get("reason", ""))) + " " + str(r.get("detail", ""))
    return bool(WAIT_FAULT.search(text))


BUILT_PR_END = re.compile(r"\b(AI Review|QA)\b", re.I)
# HYCI-396, 13 Nov (HTPR-8207, run on R2): the run left "In Progress (PR 3476 checks running; recheck after 2026-11-13T23:54Z)" on a BUILDING
# row. That names neither AI Review nor QA, so no gate saw it, and the ticket was picked again 19 minutes before its own recheck time.
BUILT_PR_NOTE = re.compile(r"\bPR\s*#?\d+\b[^;]{0,40}\bchecks?\s+(?:running|pending)|\brecheck(?:\s+after|\s+at)?\s+\d", re.I)
RECHECK_ISO = re.compile(r"recheck(?:\s+after|\s+at)?\s+(\d{4}-\d\d-\d\d)[T ](\d\d):(\d\d)", re.I)


def built_pr_end(r):
    """A run that built and left its ticket in AI Review or QA (PR open), or whose own note says the PR's checks run or gives a
    recheck time. Its next run only merges, so it has nothing to do until the PR's checks finish (canary HYCI-358, 13 Nov: DONE at 10:56,
    picked again at once, 135 s run, WAIT_CHECK on still-running checks). Held only while the PR's checks read "running" at the first
    pick, or until the stated recheck time; see gate_verdict."""
    if r.get("state") != "BUILDING":
        return False
    text = str(r.get("reason", "")) + " " + str(r.get("detail", ""))
    return bool(BUILT_PR_END.search(text) or BUILT_PR_NOTE.search(text))


def note_recheck(r):
    """The ISO recheck time a run's own note states ("recheck after 2026-11-13T23:54Z"), as a datetime, else None."""
    m = RECHECK_ISO.search(str(r.get("reason", "")) + " " + str(r.get("detail", "")))
    try:
        return dt.datetime(int(m[1][:4]), int(m[1][5:7]), int(m[1][8:10]), int(m[2]), int(m[3]), tzinfo=dt.timezone.utc) if m else None
    except ValueError:
        return None


def gate_cap(t):
    """How long a wait may be held, by ticket type."""
    if INCIDENT_LABEL in t["labels"]:
        return WAIT_GATE_CAP_INCIDENT
    return WAIT_GATE_CAP_URGENT if t.get("prio") == "Urgent" else WAIT_GATE_CAP


def gate_parts(key):
    """What a ticket waits on, read from data this pick already holds (the open-PR list, the relations cache, the board
    snapshot): no new GitHub or board call. A part that cannot be read is None and is never compared."""
    prs = None
    if "prs" in SNAP:
        if SNAP["prs"] is None:
            try:
                open_prs()
            except Exception as e:
                log(f"wait gate: open PR list unreadable ({str(e)[:60]}); PR part not compared")
        if SNAP["prs"] is not None:
            # GitHub sets every open PR to UNKNOWN for a while after each push to its base: only CONFLICTING counts as news
            prs = sorted([p["number"], p.get("head"), p.get("review"), p.get("mergeable") == "CONFLICTING",
                          gate_checks(p.get("checks"))]
                         for p in SNAP["prs"] if pr_ticket(p) == key)
    rel = SNAP.get("rel", {}).get(key)
    if rel is None:
        rel = (stored_relations().get(key) or [0, None])[1]
    blk = None
    if rel is not None:
        blk = sorted([b, (by_key(b) or {}).get("section") or "gone"] for b in rel[0])
    return {"pr": prs, "blk": blk}


def gate_state_path():
    return STATE / "wait-gate.json"


def gate_load():
    try:
        d = json.loads(gate_state_path().read_text())
        return d if isinstance(d, dict) else {}
    except (OSError, ValueError):
        return {}


def gate_save(state):
    tmp = gate_state_path().with_suffix(f".{os.getpid()}")
    try:
        tmp.write_text(json.dumps(state))
        os.replace(tmp, gate_state_path())
    except OSError:
        pass


def bulk_touched(stamp):
    return sum(1 for x in SNAP["tickets"] if x["updated"][:16] == stamp[:16]) >= WAIT_GATE_BUMP


def gate_verdict(t, when, row, base, parts, now):
    """(held, cause) for one waiting ticket. `base` is the fingerprint kept at the first pick after the end."""
    age = (now - when).total_seconds()
    if base.get("cause"):  # once lifted it stays lifted for this end: a fingerprint that flips back is not a reason to hold again
        return False, base["cause"]
    if age > gate_cap(t):
        return False, "cap"
    changed = stamp_time(t["updated"])
    if changed and (changed - when).total_seconds() > REST_GRACE and not bulk_touched(t["updated"]):
        return False, "ticket updated"
    if base.get("late"):
        return False, "late baseline"
    for name in ("pr", "blk"):
        if parts[name] is not None and base["parts"].get(name) is not None and parts[name] != base["parts"][name]:
            return False, f"{name} changed"
    seen = base["parts"].get("pr"), base["parts"].get("blk")
    if built_pr_end(row):  # held only while a PR's checks run at the first look; no PR or finished checks: a run has work
        due = note_recheck(row)
        if due and now < due and age <= gate_cap(t):  # the run named its own recheck time; a stale PR list cannot say the checks are over
            return True, "held"
        if seen[0] and any((p[4] or [""])[0] == "running" for p in seen[0]):
            return True, "held"
        return False, "no checks running"
    text = WAIT_PREFIX.sub("", str(row.get("reason", "")))
    # the wait names CI and the PR's checks had all finished when first read: the CI wait is over, a run has work to do
    if seen[0] and any((p[4] or [""])[0] == "finished" for p in seen[0]) \
            and WAIT_CI.search(text) and not re.search(r"review", text, re.I):
        return False, "checks already finished"
    if not seen[0] and not seen[1]:
        m = RECHECK_HM.search(text)
        until = WAIT_GATE_BLIND
        if m:
            at = when.replace(hour=int(m[1]) % 24, minute=int(m[2]), second=0)
            at = at + dt.timedelta(days=1) if at <= when else at
            until = min((at - when).total_seconds(), gate_cap(t))
        if age > until:
            # HYCI-388, 13 Nov (SOFT-1966, SOFT-2273, HYCI-404 each ran again after 30 blind minutes with checks still pending): a
            # ticket fleet/sf-release-watch lists as pr or release has a script waiting on it, so the blind wait is not over.
            if sf_wait_listed(t, now):
                return True, "held"
            return False, "blind wait over"
    return True, "held"


def sf_wait_listed(t, now):
    """The detail line when fleet/sf-release-watch lists this ticket as pr or release (a script's wait), else "". Same file, freshness and
    cap as sf_wait_hold, but no flag and no log: the wait gate asks it for one ticket at the moment its blind wait would end. Fails open."""
    try:
        doc = json.loads(SF_RELEASE_WAIT.read_text())
        if now.timestamp() - float(doc["at"]) > SF_WAIT_FRESH_S or INCIDENT_LABEL in t["labels"]:
            return ""
        row = next((r for k, r in doc["tickets"].items() if ticket_id(k) == ticket_id(t["key"])), None)
        since = stamp_time((row or {}).get("since", ""))
        if not row or row.get("state") not in ("pr", "release") or since is None or (now - since).total_seconds() > gate_cap(t):
            return ""
        return row.get("detail") or row["state"]
    except Exception:
        return ""


def wait_gate(dry, now=None):
    """Tickets whose last run ended waiting and whose wait has not changed: no lane hands them to a model.
    The fingerprint is the PR head commit, review decision, mergeable state and check states, the BlockedBy tickets and their
    columns, and the ticket's updated time. It is recorded at the first pick after the end. The hold lifts when a part
    changes, or after the cap (6 hours, Urgent 1 hour, incident 20 minutes). Anything unreadable or late fails open, and an
    error in the gate hands every ticket back, so the gate can only save runs, never stop the pool."""
    now = now or dt.datetime.now(dt.timezone.utc)
    memo = (id(SNAP), dry)
    if _GATE.get("memo") == memo:
        return _GATE["held"]
    held, tracked = set(), set()
    try:
        last = {}
        for r in ledger_rows():
            key, when = r.get("ticket"), stamp_time(r.get("ts", ""))
            if key and when and (key not in last or when >= last[key][0]):
                last[key] = (when, r)
        state, dirty = gate_load(), False
        for key, (when, row) in last.items():
            if not (wait_end(row) or built_pr_end(row)) or (now - when).total_seconds() > WAIT_GATE_CAP:
                if key in state and not dry:
                    del state[key]
                    dirty = True
                continue
            t = by_key(key)
            if t is None:
                continue
            end = row["ts"]
            parts = gate_parts(key)
            base = state.get(key)
            if not base or base.get("end") != end:
                late = (now - when).total_seconds() > WAIT_GATE_LATE
                base = {"end": end, "at": int(now.timestamp()), "late": late, "parts": parts}
                state[key] = base
                dirty = True
                if late:
                    log(f"wait gate: {key} first seen {int((now - when).total_seconds())}s after its wait ended; not held")
            else:
                for name in ("pr", "blk"):  # a part unreadable at the first look is filled in by the first readable one
                    if base["parts"].get(name) is None and parts[name] is not None and not base.get("late"):
                        base["parts"][name] = parts[name]
                        dirty = True
            ok, cause = gate_verdict(t, when, row, base, parts, now)
            if not base.get("late"):
                tracked.add(key)
            if ok:
                held.add(key)
            elif base.get("cause") != cause:
                base["cause"] = cause
                dirty = True
                log(f"wait gate: {key} released ({cause}) {int((now - when).total_seconds())}s after its wait ended")
        if dirty and not dry:
            gate_save({k: v for k, v in state.items() if k in last})
    except Exception as e:
        log(f"wait gate: error, nothing held ({type(e).__name__}: {str(e)[:80]})")
        held, tracked = set(), set()
    _GATE.update(memo=memo, held=held, tracked=tracked)
    return held



def one_run_state(p):
    """(word, script's) for one open PR: what it needs next. Pending or green checks need a script (the check watch and the
    merge), not a model. Red, conflicting, change-requested, draft and unreadable PRs need a model, so they are never held:
    an empty or missing check list fails open, as every gate in this file does."""
    checks = p.get("checks")
    if p.get("draft"):
        return "draft", False
    if not checks:
        return "unread", False
    failed = failed_checks(checks)
    if p.get("red") or any(not CANCELLED_CHECK.search(c) for c in failed):
        return "red", False
    if p.get("mergeable") == "CONFLICTING":
        return "conflicting", False
    if p.get("review") == "CHANGES_REQUESTED":
        return "change request", False
    if any(RUNNING_CHECK.search(c) for c in checks):
        return "pending", True
    # Only CANCELLED checks are left (HYCI-388, 13 Nov: HTPR-9106 woke a runner each time): bin/pr-merger reruns the PR once, so a
    # script owns it. A cancelled check whose newer attempt exists is already dropped by failed_checks().
    if failed:
        return "pending", True
    # Every listed check is done but GitHub still says BLOCKED: a required check has not reported yet (HYCI-358, 13 Nov 16:36:
    # ai-review and claude-review were not on the list, the PR read green, a run started and parked). Nothing a model can do.
    return ("pending", True) if p.get("merge_state") == "BLOCKED" else ("green", True)


_SF_PRS = {}


def gh_app_env():
    """Environment for a gh call made as the runner App, as open_prs() does it. None (default auth) when the App gives nothing."""
    cred = subprocess.run(["gh-app-token"], capture_output=True, text=True).stdout.strip()
    return dict(os.environ, GH_TOKEN=cred) if cred else None


def sf_open_prs(t):
    """Open PRs of a Software Factory ticket's own app repo, shaped like open_prs() rows. open_prs() reads only
    hypertask-ai/hypertask, so a SOFT ticket with a PR in its app repo looked PR-less: canary run 13 Nov 17:01 (SOFT-2166)
    was offered as an orphan while its checks ran and ended WAIT_CHECK, empty. One GitHub read per repo per pick. Fails open."""
    if not t or t.get("board") != "2060":
        return []
    d = sf_repo(t)
    if d == str(PROJECTS):
        return []
    if d not in _SF_PRS:
        rows = []
        try:
            url_ = subprocess.run(["git", "-C", d, "remote", "get-url", "origin"], capture_output=True, text=True, timeout=20).stdout.strip()
            m = re.search(r"github\.com[:/]([\w.-]+/[\w.-]+?)(?:\.git)?$", url_)
            r = subprocess.run(["gh", "pr", "list", "--repo", m[1], "--state", "open", "--limit", "100",
                                "--json", "number,title,isDraft,headRefName,updatedAt,statusCheckRollup,headRefOid,reviewDecision,mergeable,mergeStateStatus"],
                               capture_output=True, text=True, env=gh_app_env(), timeout=60)
            if r.returncode == 0:
                for p in json.loads(r.stdout):
                    rows.append({"number": p["number"], "title": p["title"], "draft": p["isDraft"], "branch": p["headRefName"],
                                 "updated": p["updatedAt"],
                                 "red": any(c.get("conclusion") in ("FAILURE", "TIMED_OUT") or c.get("state") in ("FAILURE", "ERROR")
                                            for c in p.get("statusCheckRollup") or []),
                                 "head": p.get("headRefOid"), "review": p.get("reviewDecision") or "", "mergeable": p.get("mergeable") or "",
                                 "merge_state": p.get("mergeStateStatus") or "", "checks": check_states(p.get("statusCheckRollup"))})
        except Exception:
            rows = []
        _SF_PRS[d] = rows
    return _SF_PRS[d]


def pr_checks_pending(key, t=None):
    """Does ticket `key` have an open, non-draft PR whose checks are still running and that nothing else blocks (no conflict, no
    change request, no red check)? Then a park job has nothing to do: the next run only merges once checks end. Not behind
    ONE_RUN_FLAG: parks 10:49 and 11:01 UTC on 13 Nov (HYCI-352, HYCI-358) were 60 and 75 second runs on exactly this. Fails open.
    `t`: the ticket, so a Software Factory ticket's PR in its own app repo counts too (SOFT-2166, 13 Nov 17:01)."""
    try:
        prs = open_prs() + sf_open_prs(t)
        if not any(ticket_id(pr_ticket(p)) == ticket_id(key) for p in prs) and just_waited(key):
            # The run ended on a PR it opened a minute ago, but the shared PR copy is up to ten minutes old and does not list it.
            # The park job then started on a PR nobody could see (13 Nov: HTPR-9099 18:01, HTPR-9106 18:33, HTPR-9130 19:47).
            prs = open_prs(fresh=True) + sf_open_prs(t)
        for p in prs:
            if ticket_id(pr_ticket(p)) == ticket_id(key) and one_run_state(p) == ("pending", True):
                return True
    except Exception:
        pass
    return False


def just_waited(key, now=None):
    """Did this ticket's latest run end WAIT_CHECK (a PR with running checks) in the last JUST_WAITED_S?"""
    now = now or time.time()
    last = next((r for r in reversed(ledger_rows()) if r.get("ticket") == key and r.get("state") in ("WAIT_CHECK", "PARKED", "BUILDING")), None)
    if not last or last.get("state") != "WAIT_CHECK":
        return False
    try:
        return now - dt.datetime.strptime(last["ts"][:19], "%Y-%m-%dT%H:%M:%S").replace(tzinfo=dt.timezone.utc).timestamp() < JUST_WAITED_S
    except (KeyError, ValueError, TypeError):
        return False


def ticket_id(key):
    """The ticket a key names. IGSH and SOFT are both board 2060 (a SOFT-2273 board key, an IGSH-2273 PR title and release note),
    so they compare by number; any other key is its own id."""
    m = re.fullmatch(r"(?:IGSH|SOFT)-(\d+)", key or "")
    return ("2060", m[1]) if m else key


def sf_wait_hold(on, now):
    """Software Factory tickets a script is waiting on (HYCI-352, SOFT-2273: five runs, four only waited). fleet/sf-release-watch
    writes SF_RELEASE_WAIT every five minutes: state pr (PR open, checks pending or green) or release (merged, release not out)
    means the next step is a script's, so no lane hands the ticket to a model. Red, conflicting, change-requested, failed-release
    and notes-missing tickets are state attention and never held. A file older than SF_WAIT_FRESH_S holds nothing, and so does a
    wait older than gate_cap(t). Incidents are never held. Makes no GitHub call. Fails open."""
    held = set()
    try:
        doc = json.loads(SF_RELEASE_WAIT.read_text())
        age = now.timestamp() - float(doc["at"])
        if age > SF_WAIT_FRESH_S:
            log(f"sf-wait: {SF_RELEASE_WAIT.name} is {int(age / 60)} minutes old, nothing held")
            return held
        for key, row in sorted(doc["tickets"].items()):
            if row.get("state") not in ("pr", "release"):
                continue
            t = next((x for x in SNAP["tickets"] if ticket_id(x["key"]) == ticket_id(key)), None)
            since = stamp_time(row.get("since", ""))
            if t is None or INCIDENT_LABEL in t["labels"] or since is None or (now - since).total_seconds() > gate_cap(t):
                continue
            msg = f"sf-wait: {t['key']} {row.get('state')}: {row.get('detail', '')}"
            log(msg if on else f"{msg} (shadow: {ONE_RUN_FLAG} missing, not skipped)")
            if on:
                held.add(t["key"])
                note(t["key"], f"sf-wait: {row.get('detail', '')}")
    except FileNotFoundError:
        pass
    except Exception as e:
        log(f"sf-wait: error, nothing held ({type(e).__name__}: {str(e)[:80]})")
        held = set()
    return held


def one_run_hold(dry, now=None):
    """One ticket, one run, one PR (13 Nov). Tickets whose open PR has pending or green checks, no conflict and no change
    request: no lane hands them to a model (they all read resting()). A script watches the checks, merges green and does the
    live check (HYCI-352); a model wakes on the ticket again only when the PR is red, conflicting or has a change request.
    Read from the open-PR list the pick already holds (shared 10-minute cache): no new GitHub call. An incident is never
    held, and a PR untouched for gate_cap(t) (6 hours, Urgent 1 hour) is released so a stalled merge gets looked at.
    Off unless ONE_RUN_FLAG exists: the log line is written either way ("shadow" when off) so the effect is measurable first."""
    now = now or dt.datetime.now(dt.timezone.utc)
    memo = (id(SNAP), dry, ONE_RUN_FLAG.exists())
    if _ONE_RUN.get("memo") == memo:
        return _ONE_RUN["held"]
    on, held = memo[2], set()
    try:
        by = defaultdict(list)
        for p in open_prs():
            key = pr_ticket(p)
            if key:
                by[key].append(p)
        for key, prs in sorted(by.items()):
            t = by_key(key)
            if t is None or INCIDENT_LABEL in t["labels"]:
                continue
            states = [one_run_state(p) for p in prs]
            if not all(s[1] for s in states):
                continue
            stamps = [stamp_time(p.get("updated", "")) for p in prs]
            newest = max((x for x in stamps if x), default=None)
            if newest is None or (now - newest).total_seconds() > gate_cap(t):
                continue
            word = "pending" if any(s[0] == "pending" for s in states) else "green"
            msg = f"one-run: {key} PR open, checks {word}"
            log(msg if on else f"{msg} (shadow: {ONE_RUN_FLAG} missing, not skipped)")
            if on:
                held.add(key)
                note(key, f"one-run: PR open, checks {word}")
    except Exception as e:
        log(f"one-run: error, nothing held ({type(e).__name__}: {str(e)[:80]})")
        held = set()
    held |= sf_wait_hold(on, now)
    _ONE_RUN.update(memo=memo, held=held)
    return held


def replay_waits(days=7, out=print):
    """Offline: what the wait gate would have held, from the run ledger alone (no board, no GitHub).
    The ledger holds no PR or check history, so two bounds. MAX: no fingerprint ever changes, so every run that ended
    inside a wait's cap window after the last unheld wait-end is held, including runs that built. MIN: the fingerprint
    changes exactly when a run built, so the window closes at the first run that ended BUILDING or OWN_PR and that run is
    not held. The true number lies between. Caps: a blind wait (nothing to observe) is 30 minutes; an observable one is 6
    hours. Run ts is the END time, so a run is counted held when it ended inside the window; the reference stays at the last
    unheld wait-end. Priority and incident labels are not in the ledger, so the 6-hour cap applies to every ticket."""
    now = dt.datetime.now(dt.timezone.utc)
    rows = []
    for r in ledger_rows():
        when = stamp_time(r.get("ts", ""))
        if r.get("ticket") and when:
            rows.append((when, r))
    rows.sort(key=lambda x: x[0])
    since = now - dt.timedelta(days=days)
    split = dt.datetime(2026, 11, 11, 20, 14, tzinfo=dt.timezone.utc)  # PR 358: WAIT_CHECK and FAULT ends began to rest tickets
    by_ticket = defaultdict(list)
    for when, r in rows:
        by_ticket[r["ticket"]].append((when, r))
    eras = ("all", "before PR 358", "after PR 358")
    tally = {(cap, bound, era): defaultdict(lambda: [0, 0]) for cap in ("observable", "blind") for bound in ("max", "min") for era in eras}
    total = defaultdict(int)
    lanes = {b: defaultdict(lambda: [0, 0, 0]) for b in ("min", "max")}  # lane -> held, held that built, all runs (6-hour cap)
    productive = ("BUILDING", "OWN_PR")
    for key, runs in by_ticket.items():
        for cap_name, cap in (("observable", WAIT_GATE_CAP), ("blind", WAIT_GATE_BLIND)):
            for bound in ("max", "min"):
                ref = None
                for when, r in runs:
                    held = ref is not None and 0 < (when - ref).total_seconds() < cap
                    if held and bound == "min" and r.get("state") in productive:
                        held = False
                    if held and when >= since:
                        eng = r.get("engine") or "(park)"
                        if cap_name == "observable":
                            lane = lanes[bound][r.get("source") or "(none)"]
                            lane[0] += 1
                            lane[1] += r.get("state") in productive
                        for era in eras:
                            if era == "all" or (era == "before PR 358") == (when < split):
                                cell = tally[(cap_name, bound, era)][eng]
                                cell[0] += 1
                                cell[1] += r.get("state") in productive
                    if held:
                        continue  # a held run never happened: the reference stays at the last unheld wait-end
                    ref = when if wait_end(r) else None
    for when, r in rows:
        if when >= since:
            total[r.get("engine") or "(park)"] += 1
            total["BUILDING"] += r.get("state") in productive
            total["ALL"] += 1
            for b in lanes:
                lanes[b][r.get("source") or "(none)"][2] += 1
    out(f"replay of the run ledger, last {days} days: {total['ALL']} runs, {total['BUILDING']} ended BUILDING or OWN_PR")
    for cap_name in ("observable", "blind"):
        for era in eras:
            for bound in ("min", "max"):
                cells = tally[(cap_name, bound, era)]
                held = sum(c[0] for c in cells.values())
                built = sum(c[1] for c in cells.values())
                per = ", ".join(f"{e} {c[0]}/{total[e]}" for e, c in sorted(cells.items(), key=lambda x: -x[1][0]))
                out(f"{cap_name:10} {era:14} {bound}: held {held:5} runs, {built:4} of them ended BUILDING | {per}")
    for bound in ("min", "max"):
        out(f"by lane, {bound}, 6-hour cap: " + ", ".join(f"{k} {v[0]}/{v[2]} (built {v[1]})" for k, v in sorted(lanes[bound].items(), key=lambda x: -x[1][0])))
    return tally, total


def opencode_timed_out(key):
    """An OpenCode (DeepSeek) run on this ticket hit the 3h run limit in the last 24 hours. DeepSeek ping-pongs with the
    review bot until the clock runs out (9 of 88 runs on 2026-11-10), so the ticket goes to another engine."""
    now = dt.datetime.now(dt.timezone.utc)
    for r in ledger_rows():
        if (r.get("ticket") == key and r.get("engine") in ("opencode", "pi-opencode")
                and str(r.get("detail", "")).startswith("timeout")):
            when = stamp_time(r.get("ts", ""))
            if when and (now - when).total_seconds() < ESCALATE_WINDOW:
                return True
    return False


PARK_MERGE = 90  # seconds: a run's PARKED result and the fleet/park action it triggers are one park


def park_event_times(key):
    """Completed parks of one ticket: fleet/park actions plus runs that ended PARKED on their own. HYCI-413, 14 Nov: HYCI-358,
    HYCI-352, HTPR-9106 and HTPR-9086 ended PARKED 3 to 5 times in 6 hours with no fleet/park action behind them, so the
    three-parks rule never saw them and each was offered again (11 runs, 4 tickets). A PARKED result within PARK_MERGE
    seconds of a fleet/park action is the same park, counted once; WAIT_CHECK and FAULT results are never parks."""
    out = []
    try:
        for line in open(STATE / "park-events"):
            parts = line.split()
            if len(parts) >= 2 and parts[1] == key:
                when = stamp_time(parts[0])
                if when:
                    out.append(when)
    except OSError:
        pass
    for row in ledger_rows():
        if row.get("ticket") == key and row.get("state") == "PARKED":
            when = stamp_time(str(row.get("ts", "")))
            if when:
                out.append(when)
    merged = []
    for when in sorted(out):
        if not merged or (when - merged[-1]).total_seconds() > PARK_MERGE:
            merged.append(when)
    return merged


def board_lead(board):
    try:
        scopes = json.load(open(HERE.parent / "skills/hypertask-triage/scripts/scopes.json"))
        return scopes[str(board)]["lead"]
    except (OSError, ValueError, KeyError, TypeError):
        return ""


def lead_comment_at(t):
    """When the board lead (or Chief Of Staff, who oversees every lead) last wrote on t, or None. Used only after the
    third park."""
    lead = board_lead(t.get("board"))
    if not lead:
        return None
    best = None

    def consider(name, stamp):
        nonlocal best
        if name not in (lead, "Chief Of Staff"):
            return
        when = stamp_time(stamp or "")
        if when and (best is None or when > best):
            best = when

    try:
        for a in (ht("task", "agent-log", t["key"]).get("activities") or []):
            consider(a.get("agentName") or "", a.get("createdAt"))
    except (OSError, subprocess.SubprocessError, TypeError, ValueError):
        pass
    try:
        for c in (ht("comment", "list", t["key"]).get("comments") or []):
            who = ((c.get("creator") or {}).get("displayName")
                   or ((c.get("agent") or {}).get("displayName")) or "")
            consider(who, c.get("createdAt"))
    except (OSError, subprocess.SubprocessError, TypeError, ValueError):
        pass
    return best


def repark_suppressed(t):
    """Same ticket parked 3 times in 6 h is not offered until its BlockedBy closes or its lead comments."""
    if INCIDENT_LABEL in (t.get("labels") or []):
        return False
    now = dt.datetime.now(dt.timezone.utc)
    recent = [w for w in park_event_times(t["key"]) if (now - w).total_seconds() < PARK_WINDOW]
    if len(recent) < PARK_LIMIT:
        return False
    third = sorted(recent)[PARK_LIMIT - 1]
    lead_at = lead_comment_at(t)
    blockers = relations(t["key"])[0]
    open_keys = [b for b in blockers if is_open(b)]
    return decide_suppress(len(recent), bool(lead_at and lead_at > third), blockers, open_keys)


def open_blocked_by(t):
    """Open outgoing BlockedBy, when this pick can read the links.
    A spent lookup is not a block. The kept slot never reaches held_back, so a known blocker has to drop the ticket here."""
    if t["key"] not in SNAP["rel"]:
        if CHECKED[0] >= RELATION_CAP[0]:
            return False
        CHECKED[0] += 1
    return any(is_open(w) for w in relations(t["key"])[0])


PICKER = [0]  # the runner number this pick runs for


def infra_closed(t):
    """Features first (Valentin 13 Nov: "they are still only on infra"). A Fleet CI & Infra ticket is new work for this runner
    only under the infra cap (HYCI-388: no factory stop any more).
    Incidents are outside both. A runner's own held ticket is not new work."""
    if not t["key"].startswith("HYCI-") or INCIDENT_LABEL in t["labels"]:
        return None
    if infra_count(PICKER[0]) >= infra_cap():
        return f"features first: {infra_cap()} runner(s) already on Fleet CI & Infra"
    return None


def held_reason(t, own=False):
    """Why no runner takes this ticket now, or None. It waits on someone: Valentin Review, a marked Question to Valentin
    (not for the runner's own ticket), an open BlockedBy link, or a ticket parked three times in six hours. The relation
    reads are capped per pick; out of reads, nothing unchecked is taken."""
    if repark_suppressed(t):
        return "parked three times in six hours"
    if not own and infra_closed(t):
        return infra_closed(t)
    if not own and t["section"] == "Valentin Review":
        return "in Valentin Review"
    if not own and t["waiting"]:
        return "waits on Valentin"
    if t["key"] not in SNAP["rel"]:
        if CHECKED[0] >= RELATION_CAP[0]:
            return SPENT_REASON
        CHECKED[0] += 1
    open_blocker = next((w for w in relations(t["key"])[0] if is_open(w)), None)
    return f"BlockedBy {open_blocker}" if open_blocker else None


def held_back(t, own=False):
    why = held_reason(t, own)
    if why:
        note(t["key"], why)
    return bool(why)


def blocks_open(t):
    return any(is_open(k) for k in relations(t["key"])[1])


def blocks_known(t):
    """True when this snapshot already shows an open ticket waiting on t. No extra board read."""
    rel = (SNAP.get("rel") or {}).get(t["key"])
    return bool(rel) and any(is_open(k) for k in rel[1])


def infra_count(n):
    """Other runners running a Fleet CI & Infra ticket right now."""
    return sum(1 for m in range(1, RUNNERS + 1) if m != n and (active_run(m) or "").startswith("HYCI-"))


def infra_cap():
    """Most runners on Fleet CI & Infra at once: 1 up to 5 live runners, else 2. Incidents are outside the cap.
    Valentin 13 Nov: "the ratio should be heavily in favor of producing something productive. I don't mind one or two
    runners on infrastructure stuff"."""
    live = sum(1 for m in range(1, RUNNERS + 1) if live_runner(f"runner {m}"))
    return 1 if live <= 5 else 2


def other_on_blocker(n):
    """Ticket key another runner is running, or claimed in the last two minutes, when that ticket is checks or tools work.
    An older claim is not enough: the run may have ended and the slot has to be free again."""
    for m in range(1, RUNNERS + 1):
        if m == n:
            continue
        key = active_run(m)
        if key and key.startswith("HYCI-"):
            return key
    now_s = time.time()
    try:
        for path in (STATE / "claims").iterdir():
            if path.name.startswith(".") or now_s - path.stat().st_mtime >= FRESH_CLAIM:
                continue
            who, key = path.read_text().split("\t")[:2]
            if who != str(n) and key.startswith("HYCI-"):
                return key
    except OSError:
        pass
    for key, who in virtual_claims().items():
        if who != str(n) and key.startswith("HYCI-"):
            return key
    return None


def slot_candidates(n, me, skip):
    """(candidates, log line or None). Candidates are Fleet CI & Infra (11514) tickets this runner may take."""
    cands, missed, waiting = [], False, False
    for t in SNAP["tickets"]:
        if t["board"] != "11514":
            continue
        if t["waiting"] or "design-pass" in t["labels"] or skipped(t) or t["key"] in skip or repark_suppressed(t):
            continue
        if open_blocked_by(t):
            continue
        new_col = t["section"] in BOARDS[t["board"]][0]
        building_col = t["section"] in BOARDS[t["board"]][1]
        if not new_col and not building_col:
            continue
        if not can_join(n, t["board"]):
            missed = True
            continue
        if any(live_runner(h) and h != me for h in names(t)):
            waiting = True
            continue
        if new_col and eligible_new(t) and free_for(t, me):
            cands.append(t)
        elif building_col and (me in names(t) or (orphan(t) and orphan_ok(t))):
            cands.append(t)
    if cands:
        cands.sort(key=lambda t: (t["prio"] != "Urgent", not blocks_known(t), rank(t), 0 if t["board"] == "11514" else 1, t["created"]))
        return cands, None
    if waiting:
        return [], "kept slot: blocker open; its runner is not on it"
    if missed:
        return [], "kept slot: blocker open; this runner cannot take it"
    return [], "kept slot: no blocker open"


def take_kept_slot(n, me, cands, dry):
    """Claim the first checks or tools ticket. None when every claim is refused."""
    log(f"kept slot: blocker {cands[0]['key']} open; app work withheld")
    for t in cands:
        if me in names(t) and t["section"] in BOARDS[t["board"]][1]:
            record_claim(n, t["key"], dry)
            return t, "incident" if INCIDENT_LABEL in t["labels"] else "kept-slot"
        how = "incident" if INCIDENT_LABEL in t["labels"] else (
            "orphan" if t["section"] in BOARDS[t["board"]][1] and orphan(t) else "board")
        if try_claim(n, t, how, dry):
            return t, "incident" if INCIDENT_LABEL in t["labels"] else "kept-slot"
    return None


def ci_blockers(cands):
    """Fleet CI & Infra tickets the WIP cap must not hold: Urgent ones, then ones an open ticket waits on (one relations read per
    ticket, so only the top BLOCK_LOOKUPS non-Urgent are checked). They unblock the pipeline the cap is waiting on."""
    ci = [t for t in cands if t["board"] == "11514"]
    urgent = [t for t in ci if t["prio"] == "Urgent"]
    rest = [t for t in ci if t["prio"] != "Urgent"][:BLOCK_LOOKUPS]
    return sorted(urgent + [t for t in rest if blocks_open(t)], key=lambda t: (t["prio"] != "Urgent", rank(t), t["created"]))


def blocks_app(t):
    return any(PREFIX_BOARD.get(k.split("-")[0]) in ("15", "2060") for k in relations(t["key"])[1])


def park_ledger():
    """{ticket: stamp of its newest park job}, any runner. One line per job: ISO stamp, ticket, runner."""
    seen = {}
    try:
        for line in open(STATE / "parks"):
            stamp, key = line.split()[:2]
            seen[key] = max(seen.get(key, ""), stamp)
    except (OSError, ValueError):
