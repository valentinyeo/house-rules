            ramped(3)
            assert factory_ramp() == (3, None) and "factory restart" not in exit_msg(1), "the last step caps nothing"
            ramped(9)
            assert factory_ramp() == (3, None), "a step past the last is the last"

            # HYCI-359: a stop no longer idles every runner. It probes with one runner per plan at the step 1 cap, so its own
            # replay can fill; the record still says stopped until bin/factory-breaker clears it on 90% of 10 runs.
            tmp.write_text(json.dumps({"at": "2026-11-13T09:00:00Z", "tripped_by": ["R2"], "cleared": None}))
            RUNNING.clear()
            lines.clear()
            assert factory_stopped() == "R2", "a probe is not a clear"
            assert "factory stopped" not in exit_msg(1), "a stopped factory lets its probe runner through"
            assert "factory stopped: R2; probe: 1 runner(s) per plan take clean tickets" in lines, lines
            assert factory_stopped() == "R2", "the probe leaves the record stopped"
            RUNNING[2] = "HTPR-1"
            assert exit_msg(1) == ("none: factory stopped: R2; probe, 1 runner(s) per plan: "
                                  "opencode runners 2 already in a run"), exit_msg(1)
            assert exit_msg(4).startswith("none: factory stopped: R2; probe, 1 runner(s) per plan"), "runner 4 is the same plan"
            assert "factory stopped" not in exit_msg(5), "codex probes with a runner of its own plan"
            RUNNING.clear()
            tmp.write_text(json.dumps({"at": "x", "tripped_by": ["R2"], "cleared": {"at": "y", "by": "t", "why": "t"}}))
        finally:
            globals()["log"], globals()["SNAP"], globals()["incident_step"] = saved_log, saved_snap, saved_inc
            globals()["runner_engine"], globals()["RUNNERS"] = saved_eng, saved_n
            RUNNING.clear()
    finally:
