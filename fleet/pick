def live_runner(name):
    """Runner N works: the pacer has not stopped it, or it still runs the ticket it had when the stop came (the stop
    lands between tickets). A stopped runner that runs nothing holds its tickets in name only: they are orphans."""
    m = re.fullmatch(r"runner (\d+)", name)
    return bool(m) and 1 <= int(m[1]) <= RUNNERS and (not paced_off(int(m[1])) or running(int(m[1])) is not None)


def legacy_alive(name):
    """A legacy MP runner still runs an agent. A bare shell does not count: Valentin's PC terminal tabs reattach with
    `tmux new-session -A -s mp-runner-N` and recreate the retired sessions empty (2026-11-08)."""
    m = re.fullmatch(r"mp runner (\d+)", name)
    if not m:
        return False
    r = subprocess.run(["tmux", "list-panes", "-t", f"mp-runner-{m[1]}", "-F", "#{pane_current_command}"],
                       capture_output=True, text=True)
    return r.returncode == 0 and any(c not in ("bash", "sh", "zsh", "-bash") for c in r.stdout.split())


def retired(name):
    return (bool(RETIRED.match(name)) and not legacy_alive(name)) or (bool(re.fullmatch(r"runner \d+", name)) and not live_runner(name))


def runner_engine(n):
    """Runner n's engine: engine-n (the pacer's per-runner choice), else the pool-wide engine file, else cursor.
    None: the file names no known engine."""
    for f in (RUNNER_STATE / f"engine-{n}", RUNNER_STATE / "engine"):
        try:
            e = f.read_text().strip()
        except OSError:
            continue
        return e if e in ENGINES else None
    return "cursor"


def brain_tag(t):
