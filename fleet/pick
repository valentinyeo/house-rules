    m = {"light": {"id": "composer-2.5", "effort": "medium"}, "medium": {"id": "composer-2.5", "effort": "medium"},
         "hard": {"id": "grok-4.7-medium", "effort": "medium"}, "park": {"id": "composer-2.5", "effort": "low"}}
    ALLOCATION.write_text(json.dumps({"at": time.time(), "engine": "cursor", "models": m}))
    assert brain(hard)[1:] == ("grok-4.7-medium", "medium"), "a fresh Cursor allocation sets the model"
    assert render(5, t, "park")["model"] == "composer-2.5", "the allocation sets the park model"
    ALLOCATION.write_text(json.dumps({"at": time.time() - 7200, "engine": "cursor", "models": m}))
    assert brain(hard)[1] == "grok-4.7-high", "a stale allocation is ignored"
    ALLOCATION.write_text(json.dumps({"at": time.time(), "engine": "hax", "models": m}))
    assert brain(hard)[1] == "grok-4.7-high", "an old-shape allocation for another engine is ignored"
    ALLOCATION.write_text("{not json")
    assert brain(hard)[1] == "grok-4.7-high", "a broken allocation is ignored"
    held = {**t, "holders": [("runner 12", None)]}
    assert not orphan(held), "a live runner's ticket is not an orphan"
    (STATE / "stop-12").write_text("pacer\n")
    assert orphan(held), "a ticket held by a runner the pacer stopped is an orphan: live runners adopt it"
    (STATE / "stop-12").write_text("manual\n")
    assert not orphan(held), "a hand-made stop file does not hand the ticket away"
    hard_held = {**held, "labels": ["brain-hard"]}
    (STATE / "engine-12").write_text("opencode\n")
    assert orphan(hard_held), "a hard ticket held by an OpenCode runner is an orphan: a runner that can do it adopts it"
    assert not orphan(held), "a medium ticket held by an OpenCode runner stays with it"
    (STATE / "engine-12").write_text("gemini\n")
