def yaml_blocks(source):
    source = textwrap.dedent(source).strip("\n")
    matches = list(re.finditer(r"(?m)^['\"]?([\w-]+)['\"]?[ \t]*:[ \t]*(.*)$", source))
    return {match[1]: textwrap.dedent(source[match.start(2):
            matches[index + 1].start() if index + 1 < len(matches) else len(source)]).strip()
            for index, match in enumerate(matches)}


def concurrency_policy(source):
    group = re.search(r"(?:^|[\n,{])\s*['\"]?group['\"]?\s*:\s*([^\n,]+)", source)
    cancel = re.search(r"(?:^|[\n,{])\s*['\"]?cancel-in-progress['\"]?\s*:\s*(['\"]?)(true|false|\$\{\{.*?\}\})\1[ \t]*(?:[,}\n]|$)", source, re.S)
    value = cancel[2] if cancel else ""
    valid_group = group and group[1].strip().strip("'\"") not in {"", "null", "~"}
    expression = value[3:-2].strip() if value.startswith("${{") else ""
    events = re.findall(r"\bgithub\.event_name\s*==\s*['\"]([^'\"]+)['\"]", expression, re.I)
    valid_expression = bool(expression) and expression.lower() != "false" and all(
        event.lower() in {"pull_request", "pull_request_target"} for event in events)
    return bool(valid_group and (value == "true" or valid_expression)), value == "false"


def workflow_policy(source, name="", path="", default_branch="main"):
    source = "\n".join(re.sub(r"('(?:[^']|'')*'|\"(?:[^\"\\]|\\.)*\")|#.*",
                              lambda match: match[1] or "", line)
                       for line in textwrap.dedent(source).splitlines())
    blocks = yaml_blocks(source)
    concurrency, exempt = concurrency_policy(blocks.get("concurrency", ""))
    if exempt or re.search(r"release|deploy|publish", name + " " + path + " " + blocks.get("name", ""), re.I):
        return False, concurrency
    events = blocks.get("on", "")
    event_blocks = yaml_blocks(events)
    if events.startswith("{"):
        triggered = bool(re.search(r"[,{]\s*['\"]?(pull_request|pull_request_target)['\"]?\s*:", events))
        push = re.search(r"[,{]\s*['\"]?push['\"]?\s*:", events)
        push_source = events[push.end():] if push else ""
    elif event_blocks:
        triggered = bool({"pull_request", "pull_request_target"} & event_blocks.keys())
        push = "push" in event_blocks
        push_source = event_blocks.get("push", "")
    else:
        triggered = bool(re.search(r"\b(pull_request|pull_request_target)\b", events))
        push = bool(re.search(r"\bpush\b", events))
        push_source = ""
    if push:
        branches = re.search(r"(?:^|[\n,{])\s*['\"]?branches['\"]?\s*:\s*(\[[^]]*\]|[^\n}]+(?:\n[ \t]+-[^\n]+)*)", push_source)
        tags_only = bool(re.search(r"(?:^|[\n,{])\s*['\"]?tags['\"]?\s*:", push_source))
        if branches:
            names = [value.strip().strip("'\"") for value in re.split(r"[,\n]", branches[1].strip().strip("[]"))]
            names = [value.removeprefix("- ").strip().strip("'\"") for value in names if value.strip()]
            triggered |= not names or any(value != default_branch and not value.startswith("!") for value in names)
        elif not tags_only:
            triggered = True
    jobs = yaml_blocks(blocks.get("jobs", ""))
    valid_jobs = bool(jobs) and all(concurrency_policy(yaml_blocks(job).get("concurrency", ""))[0]
                                   for job in jobs.values())
    return triggered, concurrency or valid_jobs


def report(repo, pr_runs, jobs, branch_runs, merged_at, workflows, debug=False, default_branch="main"):
    problems = []
    maximum = max((jobs[str(run["id"])] for run in pr_runs
                   if run["event"] in {"pull_request", "pull_request_target"}
                   and str(run["id"]) in jobs), default=None)
    if maximum is not None and maximum > 20:
        problems.append(f"max PR run {maximum} jobs > 20")
    releases = {workflow["id"] for workflow in workflows
                if re.search(r"release|deploy|publish", workflow["name"] + " " + workflow["path"], re.I)}
    successful = sorted((run for run in branch_runs if run.get("conclusion") == "success"
                         and run["workflow_id"] in releases and run["head_sha"] in merged_at),
                        key=lambda run: run["created_at"], reverse=True)[:5]
    durations = [(datetime.datetime.fromisoformat(run["updated_at"].replace("Z", "+00:00")) -
                  datetime.datetime.fromisoformat(merged_at[run["head_sha"]].replace("Z", "+00:00"))).total_seconds() / 60
                 for run in successful]
    slowest = max(durations, default=None)
    if slowest is not None and slowest > 15:
        problems.append(f"slowest merge-to-release {slowest:.1f} min of last {len(durations)} > 15")
    policies = [workflow_policy(workflow["source"], workflow["name"], workflow["path"], default_branch)
                for workflow in workflows]
    checked = sum(triggered for triggered, valid in policies)
    missing = sum(triggered and not valid for triggered, valid in policies)
    if debug:
        ship_minutes = f"{slowest:.1f}" if slowest is not None else "unavailable"
        print(f"checks-budget: {repo}: max jobs={maximum if maximum is not None else 'unavailable'}; slowest ship minutes={ship_minutes}; "
              f"workflows missing cancel-in-progress={missing}/{checked}", file=sys.stderr)
    if missing:
        problems.append(f"{missing}/{checked} workflows lack concurrency group with cancel-in-progress true")
    if not problems:
        return ""
    return (f"CHECKS OVER BUDGET: {repo}: {', '.join(problems)}. "
            "Fix the checks before new feature work (valentin-mode Checks).")


def github_repo(origin):
    match = re.fullmatch(r"(?:https?://(?:[^/@]+@)?github\.com/|(?:ssh://)?git@github\.com[:/])([^/]+/[^/]+?)(?:\.git)?/?", origin)
    return match[1] if match else None


def cached_repo(path, refresh=False, debug=False):
    origin = subprocess.run(["git", "-C", path, "remote", "get-url", "origin"], check=True,
                            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, timeout=1).stdout.strip()
    repo = github_repo(origin)
    if not repo:
        return ""
    cache = Path(os.environ.get("CHECKS_BUDGET_CACHE", str(Path.home() / ".cache/checks-budget"))) / (repo.replace("/", "__") + ".txt")
    if refresh:
        output = inspect_repo(path, debug=debug)
        cache.parent.mkdir(parents=True, exist_ok=True)
        temporary = cache.with_name(f"{cache.name}.{os.getpid()}.tmp")
        try:
            temporary.write_text(output + "\n" if output else "", encoding="utf-8")
            temporary.replace(cache)
        finally:
            temporary.unlink(missing_ok=True)
        return ""
    try:
        if time.time() - cache.stat().st_mtime < 6 * 60 * 60:
            return cache.read_text(encoding="utf-8").strip()
    except (OSError, UnicodeError):
        pass
    subprocess.Popen([sys.executable, str(Path(__file__).resolve()), "--refresh-cache", str(Path(path).resolve())],
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True, close_fds=True)
    return ""


def inspect_repo(path, debug=False):
    deadline = time.monotonic() + 19.5

    def command(args):
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise TimeoutError
        return subprocess.run(args, check=True, stdout=subprocess.PIPE,
                              stderr=None if debug else subprocess.DEVNULL, text=True, timeout=min(remaining, 4),
                              env={**os.environ, "GH_PROMPT_DISABLED": "1", "GH_PAGER": "cat"}).stdout

    origin = command(["git", "-C", path, "remote", "get-url", "origin"]).strip()
    repo = github_repo(origin)
    if not repo:
        return ""

    def api(endpoint, collection=None):
        url = f"repos/{repo}/{endpoint}".rstrip("/")
        items = []
        page = 1
        while deadline - time.monotonic() > 0.25:
            target = url if collection is None else f"{url}&page={page}"
            try:
                data = json.loads(command(["gh", "api", "--hostname", "github.com", target]))
            except (subprocess.SubprocessError, OSError, ValueError, TimeoutError) as error:
                if debug:
                    print(f"checks-budget: {target}: {type(error).__name__}: {error}", file=sys.stderr)
                return None if collection is None else items
            if collection is None:
                return data
            batch = data[collection] if collection else data
            items.extend(batch)
            if len(batch) < 100:
                return items
            page += 1
        return None if collection is None else items

    workflows = []
    workflow_directory = Path(path) / ".github/workflows"
    for workflow_path in sorted(workflow_directory.glob("*")):
        if workflow_path.suffix not in {".yml", ".yaml"}:
            continue
        try:
            source = workflow_path.read_text(encoding="utf-8")
        except (OSError, UnicodeError) as error:
            if debug:
                print(f"checks-budget: {workflow_path}: {type(error).__name__}: {error}", file=sys.stderr)
            continue
        workflows.append({"id": None, "name": workflow_path.stem,
                          "path": f".github/workflows/{workflow_path.name}", "source": source})
    local_workflows = {workflow["path"]: workflow for workflow in workflows}
    for workflow in api("actions/workflows?per_page=100", collection="workflows"):
        if workflow.get("state") == "active" and workflow["path"] in local_workflows:
            local_workflows[workflow["path"]].update(workflow)
    pr_runs = (api("actions/runs?event=pull_request&status=completed&per_page=5") or {}).get("workflow_runs", [])
    target_runs = (api("actions/runs?event=pull_request_target&status=completed&per_page=5") or {}).get("workflow_runs", [])
    pr_runs = sorted(pr_runs + target_runs, key=lambda run: run["created_at"], reverse=True)[:5]
    jobs = {}
    for run in pr_runs:
        measurement = api(f"actions/runs/{run['id']}/jobs?per_page=1")
        if measurement is not None:
            jobs[str(run["id"])] = measurement["total_count"]
    branch = (api("") or {}).get("default_branch")
    branch_runs = []
    if branch:
        branch_query = urllib.parse.urlencode({"branch": branch, "status": "completed", "per_page": 100})
        branch_runs = (api(f"actions/runs?{branch_query}") or {}).get("workflow_runs", [])
    releases = {workflow["id"] for workflow in workflows
                if re.search(r"release|deploy|publish", workflow["name"] + " " + workflow["path"], re.I)}
    branch_runs = sorted((run for run in branch_runs if run["workflow_id"] in releases and run.get("conclusion") == "success"),
                         key=lambda run: run["created_at"], reverse=True)[:5]
    merged_at = {}
    for sha in dict.fromkeys(run["head_sha"] for run in branch_runs):
        pulls = api(f"commits/{sha}/pulls?per_page=100", collection="")
        times = [pull["merged_at"] for pull in pulls if pull.get("merged_at")
                 and pull.get("merge_commit_sha") == sha and pull["base"]["ref"] == branch]
        if times:
            merged_at[sha] = min(times)
    return report(repo, pr_runs, jobs, branch_runs, merged_at, workflows, debug=debug, default_branch=branch)


