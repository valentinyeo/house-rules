def workflow_policy(source):
    source = "\n".join(re.sub(r"('(?:[^']|'')*'|\"(?:[^\"\\]|\\.)*\")|#.*",
                              lambda match: match[1] or "", line)
                       for line in textwrap.dedent(source).splitlines())
    blocks = {}
    matches = list(re.finditer(r"(?m)^['\"]?([\w-]+)['\"]?[ \t]*:[ \t]*(.*)$", source))
    for index, match in enumerate(matches):
        end = matches[index + 1].start() if index + 1 < len(matches) else len(source)
        blocks[match[1]] = textwrap.dedent(source[match.start(2):end]).strip()
    events = blocks.get("on", "")
    triggered = bool(re.fullmatch(r"['\"]?(push|pull_request|pull_request_target)['\"]?", events))
    if events.startswith("["):
        triggered = bool(re.search(r"\b(push|pull_request|pull_request_target)\b", events))
    elif re.search(r"(?m)^\s*-\s*['\"]?(push|pull_request|pull_request_target)['\"]?\s*$", events):
        triggered = True
    elif events.startswith("{"):
        triggered = bool(re.search(r"(?:^|[,{])\s*['\"]?(push|pull_request|pull_request_target)['\"]?\s*:", events))
    elif "\n" in events or events.endswith(":"):
        keys = list(re.finditer(r"(?m)^( *)(?:['\"]?)([\w-]+)['\"]?:", events))
        if keys:
            indent = min(len(match[1]) for match in keys)
            triggered = any(len(match[1]) == indent and match[2] in
                            {"push", "pull_request", "pull_request_target"} for match in keys)
    concurrency = blocks.get("concurrency", "")
    group = re.search(r"(?:^|[\n,{])\s*['\"]?group['\"]?\s*:\s*([^\n,]+)", concurrency)
    cancel = re.search(r"(?:^|[\n,{])\s*['\"]?cancel-in-progress['\"]?\s*:\s*true[ \t]*(?:[,}\n]|$)", concurrency)
    valid_group = group and group[1].strip().strip("'\"") not in {"", "null", "~"}
    return triggered, bool(valid_group and cancel)


def report(repo, pr_runs, jobs, branch_runs, merged_at, workflows, debug=False):
    problems = []
    maximum = max((jobs[str(run["id"])] for run in pr_runs
                   if run["event"] in {"pull_request", "pull_request_target"}
                   and str(run["id"]) in jobs), default=None)
    if maximum is not None and maximum > 20:
        problems.append(f"max PR run {maximum} jobs > 20")
    releases = {workflow["id"] for workflow in workflows
                if re.search(r"release|deploy|publish", workflow["name"] + " " + workflow["path"], re.I)}
    durations = [(datetime.datetime.fromisoformat(run["updated_at"].replace("Z", "+00:00")) -
                  datetime.datetime.fromisoformat(merged_at[run["head_sha"]].replace("Z", "+00:00"))).total_seconds() / 60
                 for run in branch_runs if run["workflow_id"] in releases and run["head_sha"] in merged_at]
    median = statistics.median(durations) if durations else None
    if median is not None and median > 15:
        problems.append(f"median merge-to-release {median:.1f} minutes > 15")
    policies = [workflow_policy(workflow["source"]) for workflow in workflows]
    checked = sum(triggered for triggered, valid in policies)
    missing = sum(triggered and not valid for triggered, valid in policies)
    if debug:
        ship_minutes = f"{median:.1f}" if median is not None else "unavailable"
        print(f"checks-budget: {repo}: max jobs={maximum if maximum is not None else 'unavailable'}; median ship minutes={ship_minutes}; "
              f"workflows missing cancel-in-progress={missing}/{checked}", file=sys.stderr)
    if missing:
        problems.append(f"{missing}/{checked} workflows lack concurrency group with cancel-in-progress true")
    if not problems:
        return ""
    return (f"CHECKS OVER BUDGET: {repo}: {', '.join(problems)}. "
            "Fix the checks before new feature work (valentin-mode Checks).")


def inspect_repo(path, debug=False):
    deadline = time.monotonic() + 19.5

    def command(args):
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise TimeoutError
        return subprocess.run(args, check=True, stdout=subprocess.PIPE,
                              stderr=None if debug else subprocess.DEVNULL, text=True, timeout=min(remaining, 4),
                              env={**os.environ, "GH_PROMPT_DISABLED": "1", "GH_PAGER": "cat"}).stdout

    origin = command(["git", "-C", path, "remote", "get-url", "origin"]).strip()
    match = re.fullmatch(r"(?:https?://(?:[^/@]+@)?github\.com/|(?:ssh://)?git@github\.com[:/])([^/]+/[^/]+?)(?:\.git)?/?", origin)
    if not match:
        return ""
    repo = match[1]

    def api(endpoint, collection=None):
        url = f"repos/{repo}/{endpoint}".rstrip("/")
        items = []
        page = 1
        while deadline - time.monotonic() > 0.25:
            target = url if collection is None else f"{url}&page={page}"
            try:
                data = json.loads(command(["gh", "api", "--hostname", "github.com", target]))
            except (subprocess.SubprocessError, OSError, ValueError, TimeoutError) as error:
                if debug:
                    print(f"checks-budget: {target}: {type(error).__name__}: {error}", file=sys.stderr)
                return None if collection is None else items
            if collection is None:
                return data
            batch = data[collection] if collection else data
            items.extend(batch)
            if len(batch) < 100:
                return items
            page += 1
        return None if collection is None else items

    workflows = []
    workflow_directory = Path(path) / ".github/workflows"
    for workflow_path in sorted(workflow_directory.glob("*")):
        if workflow_path.suffix not in {".yml", ".yaml"}:
            continue
        try:
            source = workflow_path.read_text(encoding="utf-8")
        except (OSError, UnicodeError) as error:
            if debug:
                print(f"checks-budget: {workflow_path}: {type(error).__name__}: {error}", file=sys.stderr)
            continue
        workflows.append({"id": None, "name": workflow_path.stem,
                          "path": f".github/workflows/{workflow_path.name}", "source": source})
    local_workflows = {workflow["path"]: workflow for workflow in workflows}
    for workflow in api("actions/workflows?per_page=100", collection="workflows"):
        if workflow.get("state") == "active" and workflow["path"] in local_workflows:
            local_workflows[workflow["path"]].update(workflow)
    pr_runs = (api("actions/runs?event=pull_request&status=completed&per_page=5") or {}).get("workflow_runs", [])
    target_runs = (api("actions/runs?event=pull_request_target&status=completed&per_page=5") or {}).get("workflow_runs", [])
    pr_runs = sorted(pr_runs + target_runs, key=lambda run: run["created_at"], reverse=True)[:5]
    jobs = {}
    for run in pr_runs:
        measurement = api(f"actions/runs/{run['id']}/jobs?per_page=1")
        if measurement is not None:
            jobs[str(run["id"])] = measurement["total_count"]
    branch = (api("") or {}).get("default_branch")
    branch_runs = []
    if branch:
        branch_query = urllib.parse.urlencode({"branch": branch, "status": "completed", "per_page": 100})
        branch_runs = (api(f"actions/runs?{branch_query}") or {}).get("workflow_runs", [])
    releases = {workflow["id"] for workflow in workflows
                if re.search(r"release|deploy|publish", workflow["name"] + " " + workflow["path"], re.I)}
    branch_runs = sorted((run for run in branch_runs if run["workflow_id"] in releases),
                         key=lambda run: run["created_at"], reverse=True)[:5]
    merged_at = {}
    for sha in dict.fromkeys(run["head_sha"] for run in branch_runs):
        pulls = api(f"commits/{sha}/pulls?per_page=100", collection="")
        times = [pull["merged_at"] for pull in pulls if pull.get("merged_at")
                 and pull.get("merge_commit_sha") == sha and pull["base"]["ref"] == branch]
        if times:
            merged_at[sha] = min(times)
    return report(repo, pr_runs, jobs, branch_runs, merged_at, workflows, debug=debug)


def self_test():
    import contextlib
    import io
    import tempfile
    from unittest.mock import patch

    fixture = json.loads('''{
      "pr_runs": [{"id": 1, "event": "pull_request"}],
      "jobs": {"1": 21},
      "branch_runs": [{"event": "push", "head_sha": "merged", "workflow_id": 7,
        "updated_at": "2026-11-16T12:16:00Z", "created_at": "2026-11-16T12:00:00Z"}],
      "merged_at": {"merged": "2026-11-16T12:00:00Z"},
      "workflows": [{"id": 7, "name": "Release", "path": ".github/workflows/release.yml",
        "source": "on: [push, pull_request]\\nconcurrency:\\n  group: release-${{ github.ref }}\\n  cancel-in-progress: true\\njobs: {}\\n"}]
    }''')
    def check(data):
        return report("owner/repo", data["pr_runs"], data["jobs"],
                      data["branch_runs"], data["merged_at"], data["workflows"])
    def gh245(args, **kwargs):
        assert "--slurp" not in args and "--paginate" not in args, args
        if args[0] == "git":
            return subprocess.CompletedProcess(args, 0, "git@github.com:owner/repo.git\n")
        endpoint = args[-1].removeprefix("repos/owner/repo/")
        responses = {
            "repos/owner/repo": {"default_branch": "main"},
            "actions/runs?branch=main&status=completed&per_page=100": {"workflow_runs": fixture["branch_runs"]},
            "actions/runs?event=pull_request&status=completed&per_page=5": {
                "workflow_runs": [dict(fixture["pr_runs"][0], created_at="2026-11-16T12:00:00Z")]},
            "actions/runs?event=pull_request_target&status=completed&per_page=5": {"workflow_runs": []},
            "actions/runs/1/jobs?per_page=1": {"total_count": fixture["jobs"]["1"]},
            "actions/workflows?per_page=100&page=1": {"workflows": [dict(fixture["workflows"][0], state="active")]},
            "commits/merged/pulls?per_page=100&page=1": [{
                "merged_at": fixture["merged_at"]["merged"], "merge_commit_sha": "merged", "base": {"ref": "main"}}],
        }
        if multiple_pages and endpoint == "actions/workflows?per_page=100&page=1":
            data = {"workflows": [{"state": "disabled_manually"}] * 100}
        elif multiple_pages and endpoint == "actions/workflows?per_page=100&page=2":
            data = responses["actions/workflows?per_page=100&page=1"]
        elif multiple_pages and endpoint == "commits/merged/pulls?per_page=100&page=1":
            data = [{"merged_at": None}] * 100
        elif multiple_pages and endpoint == "commits/merged/pulls?per_page=100&page=2":
            data = responses["commits/merged/pulls?per_page=100&page=1"]
        else:
            data = responses[endpoint]
        return subprocess.CompletedProcess(args, 0, json.dumps(data))

    directory = tempfile.TemporaryDirectory()
    fixture_path = Path(directory.name)
    (fixture_path / ".github/workflows").mkdir(parents=True)
    source_path = fixture_path / ".github/workflows/release.yml"
    source_path.write_text(fixture["workflows"][0]["source"])
    output = check(fixture)
    multiple_pages = False
    with patch.object(subprocess, "run", side_effect=gh245):
        assert inspect_repo(str(fixture_path)) == output
    multiple_pages = True
    with patch.object(subprocess, "run", side_effect=gh245):
        assert inspect_repo(str(fixture_path)) == output
    assert output.startswith("CHECKS OVER BUDGET: owner/repo:"), output
    assert "21 jobs" in output and "16.0 minutes" in output, output
    fixture["jobs"]["1"] = 20
    fixture["branch_runs"][0]["updated_at"] = "2026-11-16T12:15:00Z"
    assert check(fixture) == ""
    stderr = io.StringIO()
    with patch.object(subprocess, "run", side_effect=gh245), contextlib.redirect_stderr(stderr):
        assert inspect_repo(str(fixture_path), debug=True) == ""
    assert "max jobs=20" in stderr.getvalue(), stderr.getvalue()
    assert "median ship minutes=15.0" in stderr.getvalue(), stderr.getvalue()
    assert "workflows missing cancel-in-progress=0/1" in stderr.getvalue(), stderr.getvalue()
    source_path.unlink()
    stderr = io.StringIO()
    with patch.object(subprocess, "run", side_effect=gh245), contextlib.redirect_stderr(stderr):
        assert inspect_repo(str(fixture_path), debug=True) == ""
    assert "workflows missing cancel-in-progress=0/0" in stderr.getvalue(), stderr.getvalue()
    assert "max jobs=20" in stderr.getvalue(), stderr.getvalue()
    source_path.write_text(fixture["workflows"][0]["source"])
    def failing_api(args, **kwargs):
        if "actions/runs/1/jobs" in args[-1]:
            raise subprocess.CalledProcessError(1, args)
        return gh245(args, **kwargs)
    stderr = io.StringIO()
    with patch.object(subprocess, "run", side_effect=failing_api), contextlib.redirect_stderr(stderr):
        assert inspect_repo(str(fixture_path), debug=True) == ""
    assert "CalledProcessError" in stderr.getvalue(), stderr.getvalue()
    assert "max jobs=unavailable" in stderr.getvalue(), stderr.getvalue()
    assert "median ship minutes=15.0" in stderr.getvalue(), stderr.getvalue()
    calls = []
    def capped_api(args, **kwargs):
        endpoint = args[-1]
        calls.append(endpoint)
        if "event=pull_request&" in endpoint:
            runs = [dict(fixture["pr_runs"][0], id=index,
                         created_at=f"2026-11-16T12:00:{index:02d}Z") for index in range(8)]
            return subprocess.CompletedProcess(args, 0, json.dumps({"workflow_runs": runs}))
        if "actions/runs?branch=" in endpoint:
            runs = [dict(fixture["branch_runs"][0], head_sha=f"merge{index}",
                         created_at=f"2026-11-16T12:00:{index:02d}Z") for index in range(8)]
            return subprocess.CompletedProcess(args, 0, json.dumps({"workflow_runs": runs}))
        if "/jobs?" in endpoint:
            return subprocess.CompletedProcess(args, 0, json.dumps({"total_count": 20}))
        if "/commits/merge" in endpoint:
            sha = endpoint.split("/commits/")[1].split("/")[0]
            return subprocess.CompletedProcess(args, 0, json.dumps([{
                "merged_at": fixture["merged_at"]["merged"],
                "merge_commit_sha": sha, "base": {"ref": "main"}}]))
        return gh245(args, **kwargs)
    with patch.object(subprocess, "run", side_effect=capped_api):
        assert inspect_repo(str(fixture_path)) == ""
    assert len([call for call in calls if "/jobs?" in call]) == 5, calls
    assert not any(f"/runs/{index}/jobs?" in call for index in range(3) for call in calls), calls
    assert len([call for call in calls if "/commits/" in call]) == 5, calls
    assert not any(f"/commits/merge{index}/" in call for index in range(3) for call in calls), calls
    def one_failed_job_api(args, **kwargs):
        if "/runs/7/jobs?" in args[-1]:
            raise subprocess.CalledProcessError(1, args)
        return capped_api(args, **kwargs)
    stderr = io.StringIO()
    with patch.object(subprocess, "run", side_effect=one_failed_job_api), contextlib.redirect_stderr(stderr):
        assert inspect_repo(str(fixture_path), debug=True) == ""
    assert "CalledProcessError" in stderr.getvalue(), stderr.getvalue()
    assert "max jobs=20" in stderr.getvalue(), stderr.getvalue()
    clock = [0]
    def timed_out_api(args, **kwargs):
        if "/runs/6/jobs?" in args[-1]:
            clock[0] = 19.3
            raise subprocess.TimeoutExpired(args, kwargs["timeout"])
        assert clock[0] == 0, args
        return capped_api(args, **kwargs)
    stderr = io.StringIO()
    with patch.object(time, "monotonic", side_effect=lambda: clock[0]), \
            patch.object(subprocess, "run", side_effect=timed_out_api), contextlib.redirect_stderr(stderr):
        assert inspect_repo(str(fixture_path), debug=True) == ""
    assert "TimeoutExpired" in stderr.getvalue(), stderr.getvalue()
    assert "max jobs=20" in stderr.getvalue(), stderr.getvalue()
    assert "workflows missing cancel-in-progress=0/1" in stderr.getvalue(), stderr.getvalue()
    def failed_workflows_api(args, **kwargs):
        if "actions/workflows?" in args[-1]:
            raise subprocess.CalledProcessError(1, args)
        return gh245(args, **kwargs)
    stderr = io.StringIO()
    with patch.object(subprocess, "run", side_effect=failed_workflows_api), contextlib.redirect_stderr(stderr):
        assert inspect_repo(str(fixture_path), debug=True) == ""
    assert "max jobs=20" in stderr.getvalue(), stderr.getvalue()
    assert "workflows missing cancel-in-progress=0/1" in stderr.getvalue(), stderr.getvalue()
    fixture["workflows"][0]["source"] = "on: push\njobs: {}\n"
    assert "1/1 workflows" in check(fixture)
    assert workflow_policy("on: push\nconcurrency: {group: '${{ github.ref }}', cancel-in-progress: true}\n") == (True, True)
    assert workflow_policy('"on":\n  pull_request:\n    branches: [main]\nconcurrency:\n  group: ci\n  cancel-in-progress: false\n') == (True, False)
    assert workflow_policy("on: workflow_dispatch\n") == (False, False)
    assert workflow_policy("on: push\n# concurrency: {group: ci, cancel-in-progress: true}\n") == (True, False)
    assert workflow_policy("on: push\njobs:\n  test:\n    concurrency:\n      group: test\n      cancel-in-progress: true\n") == (True, False)
    assert workflow_policy("on:\n  workflow_dispatch:\n  push:\n    branches: [main]\nconcurrency:\n  cancel-in-progress: true\n  group: ci\n") == (True, True)
    assert workflow_policy("on:\n  - push\n  - pull_request\n") == (True, False)
    fixture["branch_runs"] += [dict(fixture["branch_runs"][0], updated_at="2026-11-16T12:40:00Z")]
    fixture["workflows"][0]["source"] = "on: workflow_dispatch\n"
    assert "27.5 minutes" in check(fixture)
    fixture["workflows"] = []
    assert check(fixture) == ""
    fixture["jobs"]["1"] = 21
    fixture["pr_runs"][0]["event"] = "push"
    assert check(fixture) == ""
    directory.cleanup()
    print("checks-budget self-test: PASS (over, under, boundaries, missing concurrency, workflow forms, no release, gh 2.45 pages, debug metrics, missing workflow, failing API, five-run limits, partial deadline)")


def timeout(signum, frame):
    raise TimeoutError


if __name__ == "__main__":
    args = sys.argv[1:]
    debug = "--debug" in args
    args = [arg for arg in args if arg != "--debug"]
    signal.signal(signal.SIGALRM, timeout)
    signal.setitimer(signal.ITIMER_REAL, 20)
    try:
        if args == ["--self-test"]:
            self_test()
        elif len(args) <= 1:
            output = inspect_repo(args[0] if args else os.getcwd(), debug=debug)
            if output:
                print(output)
    except Exception as error:
        if debug:
            traceback.print_exc()
        if args == ["--self-test"]:
            print(f"checks-budget self-test: FAIL ({error})")
    finally:
        signal.setitimer(signal.ITIMER_REAL, 0)
