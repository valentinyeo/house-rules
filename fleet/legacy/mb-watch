#!/usr/bin/env bash
set -uo pipefail
state=~/.local/state/multibot
mkdir -p "$state"
log="$state/watch.log"
for s in $(tmux ls -F '#S' 2>/dev/null | grep '^multibot-runner-'); do
  r=${s#multibot-runner-}
  if tmux capture-pane -p -t "$s" | tail -6 | grep -qP '[\x{2800}-\x{28FF}]|working|composing|esc to interrupt'; then
    rm -f "$state/idle-$r"
    continue
  fi
  if [ ! -f "$state/idle-$r" ]; then
    touch "$state/idle-$r"
    continue
  fi
  next=$(mb-pick "$r" 2>&1 | tail -1)
  case "$next" in
    NEXT*) ;;
    *) echo "$(date -u +%FT%H:%M) $r idle, pick said: $next" >> "$log"; continue ;;
  esac
  ticket=$(echo "$next" | awk '{print $2}')
  want=$(echo "$next" | grep -oP 'BRAIN \K\S+')
  model=${want%%:*}
  effort=${want##*:}
  repo=$(echo "$next" | grep -oP 'DIR \K\S+')
  mine=$(python3 -c "import json;print(json.load(open('$state/owners.json')).get('$r',{}).get('ticket',''))" 2>/dev/null)
  [ "$mine" = "$ticket" ] || mb-pick "$r" --claim "$ticket" >/dev/null
  pid=$(tmux display -p -t "$s" '#{pane_pid}')
  running=$( (ps -o args= -p "$pid"; ps -o args= --ppid "$pid") | grep -oP -- '--model=\S+ --effort=\S+' | head -1)
  if [ -n "$model" ] && [ "$running" != "--model=$model --effort=$effort" ]; then
    dir=${repo:-$HOME/projects}
    [ -d "$dir" ] || dir=$HOME/projects
    tmux respawn-pane -k -t "$s" "$HOME/.local/bin/mb-runner-launch $r $model $effort $dir; exec bash"
    echo "$(date -u +%FT%H:%M) $r relaunched on $model $effort for $ticket" >> "$log"
    sleep 15
  fi
  brief="Single thread, single brain (Valentin 2026-11-05): the launcher chose your model from the ticket's brain tag. Plan, edit, test in CI and review yourself. Never start hax helpers, subagents or any other agent. CI snag blocks your ticket? Never fix CI yourself: search board 11514 (Fleet CI), +1 an existing ticket or file one per problem, link your ticket BlockedBy it, then hold it as below. Ticket blocked by anything you cannot clear (CI, other work, a spending answer, banned runners)? Note the blocker in its agent lane, append one line \"IGSH-N reason with link\" to ~/.local/state/multibot/hold.txt, move the ticket back to Todo and unassign yourself, then run mb-pick <your letter> and take the next ticket. Never sit idle on a blocked ticket."
  who=${r^^}; [ "$r" = c ] && who=H  # Runner C login revoked 2026-11-06; slot c writes as Runner H
  msg="Lead watcher: you are idle. Open PR of yours still not merged? Drive it first (gh pr checks, 300s polls). Otherwise take the top ticket by Valentin's priority: ${next#NEXT }. It is claimed for you. Move it to Doing. Work in its app repo (DIR above; find it under ~/projects if missing). Fresh branch from the default branch. Drive it until merged and live. Never touch Multiprompt, Multiprompt Android, Postbox or Live Chat work: they have their own sessions. Then run mb-pick $r for the next one. Board writes only as yourself: CEO_AGENT=\"Multi Bot Runner $who\" ~/projects/ceo/bin/ceo-ht, never plain hypertask. Never ask Valentin for a fact. $brief"
  [ "$mine" = "$ticket" ] && msg="Lead watcher: you are idle on $ticket. Keep driving it: fix red checks, push, merge when green and gates met. Then run mb-pick $r for the next one. Board writes only as yourself: CEO_AGENT=\"Multi Bot Runner $who\" ~/projects/ceo/bin/ceo-ht, never plain hypertask. Never ask Valentin for a fact. $brief"
  tmux send-keys -t "$s" "$msg" Enter
  sleep 1
  tmux send-keys -t "$s" Enter
  rm -f "$state/idle-$r"
  echo "$(date -u +%FT%H:%M) $r nudged: $next" >> "$log"
done
