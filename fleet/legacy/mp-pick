#!/usr/bin/env python3
# Multiprompt desktop runner picker (Valentin 2026-11-06, IGSH-1816): MP Runner 1..3 take board 2060
# orphaned Doing or AI Review tickets labelled Multiprompt (no assignee) first, then Todo, light, medium or hard brain (Cursor model per brain, Valentin 2026-11-07), not Urgent, not held by the lead. Separate from mb-pick.
import json, os, subprocess, sys, time

STATE = os.path.expanduser('~/.local/state/mp-runners')
OWNERS = os.path.join(STATE, 'owners.json')
RUNNERS = ('1', '2', '3')
LEAD = 'multi bot opus lead'
RANK = {'Urgent': 0, 'High': 1, 'Medium': 2, 'Low': 3}
EXCLUDE = {'multiprompt android', 'live chat', 'ci', 'hypertask ci', 'brain-extra-hard'}
SKIP = {'IGSH-1816'}
HT = os.path.expanduser('~/.local/bin/hypertask')


def tasks(section):
    out, offset = [], 0
    while True:
        r = subprocess.run([HT, 'task', 'list', '--project', '2060', '--section', section,
                            '--limit', '100', '--offset', str(offset), '--json'],
                           capture_output=True, text=True, check=True).stdout
        page = json.loads(r).get('tasks', [])
        out += page
        if len(page) < 100:
            return out
        offset += 100


def labels(t):
    return {(l.get('name') or '').lower() for l in t.get('labels', [])}


def names(t):
    out = set()
    for a in t.get('assignees') or []:
        if isinstance(a, dict):
            out |= {str(a.get(k) or '').lower() for k in ('name', 'displayName', 'display_name', 'fullName')}
        else:
            out.add(str(a).lower())
    return out


def priority(t):
    p = t.get('priority')
    if isinstance(p, dict):
        p = p.get('Priority_Value')
    return RANK.get(p or 'Medium', 2), p or 'None'


def brain(t):
    l = labels(t)
    for b in ('extra-hard', 'hard', 'light'):
        if 'brain-' + b in l:
            return b
    return 'medium'


def line(t):
    return (f"NEXT {t['ticketNumber']} {priority(t)[1]} https://app.hypertask.ai/detail/project-2060/{t['uniqueIndex']} "
            f"BRAIN {brain(t)} {t['title']}")


def load():
    try:
        return json.load(open(OWNERS))
    except FileNotFoundError:
        return {}


def eligible(t, taken):
    l = labels(t)
    return ('multiprompt' in l and not (l & EXCLUDE) and priority(t)[1] != 'Urgent'
            and LEAD not in names(t) and not t.get('sub_tasks')
            and t['ticketNumber'] not in taken and t['ticketNumber'] not in SKIP
            and 'paid' not in (t.get('description') or '').lower())


def main():
    if len(sys.argv) < 2:
        sys.exit('usage: mp-pick <1|2|3> [--claim TICKET [--workdir DIR] | --release] | mp-pick --list')
    me = sys.argv[1]
    if me != '--list' and me not in RUNNERS:
        sys.exit(f'unknown runner {me}')
    owners = load()
    if len(sys.argv) >= 3 and sys.argv[2] in ('--claim', '--release'):
        if sys.argv[2] == '--claim':
            owners[me] = {'ticket': sys.argv[3], 'at': int(time.time())}
            if len(sys.argv) >= 6 and sys.argv[4] == '--workdir':
                owners[me]['workdir'] = sys.argv[5]
        else:
            owners.pop(me, None)
        os.makedirs(STATE, exist_ok=True)
        json.dump(owners, open(OWNERS, 'w'), indent=1)
        print(f"{'CLAIMED ' + sys.argv[3] if sys.argv[2] == '--claim' else 'RELEASED'} for runner {me}")
        return
    taken = {v.get('ticket') for k, v in owners.items() if k != me}
    every = [t for s in ('Todo', 'Doing', 'AI Review') for t in tasks(s)]
    # House rule 2026-11-05: orphans first (unassigned Doing or AI Review, usually with an open PR), then Todo.
    pool = [t for t in every if eligible(t, taken) and (t['section'] == 'Todo' or not t.get('assignees'))]
    pool.sort(key=lambda t: (0 if t['section'] != 'Todo' else 1, priority(t)[0], t['createdAt']))
    if me == '--list':
        for t in pool:
            print(t['ticketNumber'], priority(t)[1], brain(t), t['section'], t['title'][:70])
        return
    own = owners.get(me, {}).get('ticket')
    if own:
        held = [t for t in every if t['ticketNumber'] == own]
        if held:
            print('HELD ' + line(held[0])[5:])
            return
    print(line(pool[0]) if pool else 'NOTHING_TO_PICK')


main()
