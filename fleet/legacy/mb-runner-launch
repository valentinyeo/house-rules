#!/usr/bin/env bash
set -euo pipefail
name=$1
model=$2
effort=$3
dir=$4
unset ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN ANTHROPIC_BASE_URL CLAUDE_CODE_SESSION_ID CODEX_THREAD_ID OPENCODE_API_KEY
export SHIP_SESSION_NAME="Multi Bot Runner ${name^^}"
cd "$dir"
exec "$HOME/.local/bin/hax" --provider=codex --model="$model" --effort="$effort"
