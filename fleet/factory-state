WORKER_PATTERNS = (
    re.compile(r"^(?:\S*/)?hax(?:\s|$)"),
    re.compile(r"^(?:\S*/)?codex\s+exec(?:\s|$)"),
    re.compile(r"^(?:\S*/)?claude\s+(?:.*\s)?(?:--print|-p)(?:\s|=|$)"),
    re.compile(r"^(?:\S*/)?cursor-agent(?:\s|$)"),
    re.compile(r"^(?:\S*/)?(?:pi|pi-agent)(?:\s|$)|^(?:\S*/)?node\s+\S*pi-coding-agent/\S*"),
)


@dataclass
class Process:
    ppid: int
    command: str
    cwd: str | None
    worker: bool


@dataclass
class Orchestrator:
    name: str
    kind: str
    board: str | None
    view: str | None
    live: bool
    loop: str
    loop_why: str
    allowed: int
    active: int | None
    shipped: dict
    left: int | None
    repo: str | None = None
    model: str = "?"
    ranked: bool = False
    process_why: str = "no live session"
    prs: dict | None = None


class Snapshot(list):
    def __init__(self):
        super().__init__()
        self.server_workers = None
        self.unattributed = None
        self.boards = {}
        self.failures = []
        self.live_known = True
        self.ticket_sets = {}
        self.prs = {}
        self.all_rows = True

    def failed(self, source):
        if source not in self.failures:
            self.failures.append(source)


def load_solo_wake():
    loader = SourceFileLoader("solo_wake", str(HERE / "solo-wake"))
    module = module_from_spec(spec_from_loader(loader.name, loader))
    sys.modules[loader.name] = module
    loader.exec_module(module)
    return module


def processes(proc):
    result = {}
    for path in proc.iterdir():
        if not path.name.isdigit():
            continue
        try:
            fields = (path / "stat").read_text().rsplit(")", 1)[1].split()
            command = (path / "cmdline").read_bytes().replace(b"\0", b" ").decode(errors="replace").strip()
            try:
                cwd = str((path / "cwd").readlink())
            except OSError:
                cwd = None
            result[int(path.name)] = Process(int(fields[1]), command, cwd,
                                             any(p.search(command) for p in WORKER_PATTERNS))
        except FileNotFoundError:
            continue
    return result


def chat_owners(roster, chats, records):
    """pid -> {row name} for a chat process, from Claude session records and live Multibot host pids."""
    keys_by_pid = {}
    for record in (r for group in (records or {}).values() for r in group if isinstance(r, dict)):
        pid, sid = record.get("pid"), record.get("sessionId")
        if not isinstance(pid, int):
            continue
        keys = {sid, record.get("tmux")}
        for chat in chats.values():
            if sid and sid in (chat.get("sid"), chat.get("transcript")):
                keys.update((chat.get("tmux"), chat.get("name")))
        keys_by_pid.setdefault(pid, set()).update(key for key in keys if isinstance(key, str) and key)
    for key, chat in chats.items():
        if isinstance(chat.get("pid"), int):
            keys_by_pid.setdefault(chat["pid"], set()).update(k for k in (key, chat.get("name")) if k)
    owners = {}
    for pid, keys in keys_by_pid.items():
        names = {row["name"] for row in roster
                 if any(row.get(field) in keys for field in ("name", "tmux", "multibot", "login", "sid"))}
        if len(names) == 1:
            owners[pid] = names
    return owners


def parent_rows(tree, pid, owners):
    """Roster rows owning any ancestor of this process: which chat started it."""
    names, seen, parent = set(), {pid}, tree[pid].ppid
    while parent in tree and parent not in seen:
        seen.add(parent)
        names |= owners.get(parent, set())
        parent = tree[parent].ppid
    return names


def attribute_workers(tree, roster, row_tickets, home, scoped_boards=(), owner_by_pid=None):
    assigned = {row["name"]: set() for row in roster}
    unattributed = set()
    ticket_rows = {}
    for name, boards in row_tickets.items():
        for board, tickets in boards.items():
            for ticket in tickets:
                keys = re.findall(r"project-\d+/[\w-]+", str(ticket.get("url") or ""))
                if ticket.get("uniqueIndex") is not None:
                    keys.append(f"project-{board}/{ticket['uniqueIndex']}")
                keys.extend(str(ticket[k]) for k in ("ticketNumber", "ticketKey") if ticket.get(k))
                for key in keys:
                    ticket_rows.setdefault(key, {})[name] = (name, board) in scoped_boards
    for pid, process in tree.items():
        if not process.worker:
            continue
        parents = parent_rows(tree, pid, owner_by_pid or {})
        if len(parents) == 1:
            assigned[next(iter(parents))].add(pid)
            continue
        references = set(re.findall(r"project-\d+/[\w-]+|\b[A-Z][A-Z0-9]*-\d+\b", process.command))
        candidates = set()
        for key in references:
            owners = ticket_rows.get(key, {})
            candidates.update({name for name, scoped in owners.items() if scoped} or owners)
        if len(candidates) != 1:
            eligible = [row for row in roster if not candidates or row["name"] in candidates]
            exact = {row["name"] for row in eligible if process.cwd and row.get("cwd")
                     and str(Path(str(row["cwd"]).replace("~/", str(home) + "/", 1)).resolve()) == process.cwd}
            folders = {row["name"] for row in eligible if process.cwd and row.get("repo")
                       and Path(process.cwd).name.casefold() == row["repo"].rsplit("/", 1)[-1].casefold()}
            candidates = exact or folders
        if len(candidates) == 1:
            assigned[next(iter(candidates))].add(pid)
        else:
            unattributed.add(pid)
    return assigned, unattributed


def board_views(board, token, run=subprocess.run):
    views, offset = [], 0
    while True:
        command = [hypertask(), "view", "list", "--project", str(board), "--limit", "100",
                   "--offset", str(offset), "--json", "--token", token]
        result = run(command, capture_output=True, text=True, timeout=120)
        result.check_returncode()
        data = json.loads(result.stdout)
        page = data.get("views")
        if not isinstance(page, list):
            raise ValueError("missing views")
        views.extend(page)
        if len(views) >= data.get("total", len(views)) or not page:
            return views
        offset += len(page)


def resolve_view(row, views):
    names = {str(row.get(key) or "").casefold() for key in ("name", "login", "app", "multibot")}
    names.discard("")
    matches = {view["id"] for view in views
               if any(str(view.get(key) or "").casefold() in names for key in ("title", "slug"))}
    if len(matches) > 1:
        raise ValueError(f"ambiguous view for {row['name']}")
    return next(iter(matches), None)


def session_records(home):
    result = {}
    directory = home / ".claude/sessions"
    for path in directory.glob("*.json"):
        record = json.loads(path.read_text())
        if not isinstance(record, dict):
            raise ValueError("invalid session record")
        sid = record.get("sessionId")
        if isinstance(sid, str):
            result.setdefault(("sid", sid), []).append(record)
        name = record.get("tmux")
        if isinstance(name, str):
            name = name.split(":", 1)[0]
            result.setdefault(name, []).append(record)
    return result


def hypertask(home=None):
    path = (Path.home() if home is None else home) / ".local/bin/hypertask"
    return str(path) if path.is_file() else shutil.which("hypertask") or str(path)


def board_status(board, token, run=subprocess.run):
    command = [hypertask(), "project", "show", str(board), "--json", "--token", token]
    result = run(command, capture_output=True, text=True, timeout=120)
    result.check_returncode()
    return json.loads(result.stdout)["project"]["status"]


def board_tickets(board, token, run=subprocess.run):
    tickets, offset = [], 0
    while True:
        command = [hypertask(), "task", "list", "--project", str(board), "--status", "Normal",
                   "--limit", "100", "--offset", str(offset), "--json", "--token", token]
        result = run(command, capture_output=True, text=True, timeout=120)
        if result.returncode:
            raise ValueError("task list failed")
        data = json.loads(result.stdout)
        page = data.get("tasks") if isinstance(data, dict) else None
        if not isinstance(page, list):
            raise ValueError("missing tasks")
        tickets.extend(page)
        if len(page) < 100:
            return tickets
        offset += 100


def ticket_counts(tasks, now):
    shipped, left = dict.fromkeys(WINDOWS, 0), 0
    for task in tasks:
        done = task.get("sectionIsDone")
        if type(done) is not bool:
            raise ValueError("missing sectionIsDone")
        if not done:
            left += 1
            continue
        updated = datetime.fromisoformat(task["updatedAt"].replace("Z", "+00:00"))
        if updated.tzinfo is None:
            raise ValueError("updatedAt has no timezone")
        age = now.timestamp() - updated.timestamp()
        for hours in WINDOWS:
            shipped[hours] += int(0 <= age <= hours * 3600)
    return shipped, left


def read_token(home):
    token = os.environ.get("HT_TOKEN")
    if token is not None and len(token) < 4096 and Path(token).is_file():
        token = Path(token).read_text().strip()
    if token is None:
        token = (home / ".config/hypertask-agents/credentials/sessions/poteto-agent-token").read_text().strip()
    if not token:
        raise ValueError("empty token")
    return token


def view_filter(view, token, run=subprocess.run):
    result = run([hypertask(), "view", "get", view, "--json", "--token", token],
                 capture_output=True, text=True, timeout=120)
    result.check_returncode()
    data = json.loads(result.stdout)
    filters = data.get("view", data).get("board_filters")
    if not isinstance(filters, dict) or not isinstance(filters.get("addedFilters"), list):
        raise ValueError("missing view filter")
    labels = set()
    for item in filters["addedFilters"]:
        if item.get("type") != "Labels":
            raise ValueError("unsupported view filter")
        payload = item.get("searchPayload")
        if not isinstance(payload, list) or not payload or any("id" not in p for p in payload):
            raise ValueError("invalid label filter")
        labels.update(p["id"] for p in payload)
    if not labels:
        raise ValueError("view has no label filter")
    return labels


def search_count(repo, checks, run=subprocess.run, sleep=time.sleep):
    command = ["gh", "api", "--include", "--method", "GET", "search/issues",
               "-f", f"q=repo:{repo} is:pr is:open status:{checks}", "-f", "per_page=1"]
    for attempt in range(2):
        result = run(command, capture_output=True, text=True, timeout=120)
        parts = re.split(r"\r?\n\r?\n", result.stdout.strip(), maxsplit=1)
        headers, body = parts if len(parts) == 2 else ("", result.stdout)
        if result.returncode and "403" in headers + result.stderr and attempt == 0:
            reset = re.search(r"(?im)^x-ratelimit-reset:\s*(\d+)", headers)
            retry = re.search(r"(?im)^retry-after:\s*(\d+)", headers)
            if reset or retry:
                delay = int(retry[1]) if retry else max(0, int(reset[1]) - time.time()) + 1
                sleep(delay)
                continue
        result.check_returncode()
        data = json.loads(body)
        if data.get("incomplete_results") is not False or type(data.get("total_count")) is not int:
            raise ValueError("incomplete PR search")
        return data["total_count"]


def pr_counts(repo, run=subprocess.run):
    result = run(["gh", "pr", "list", "-R", repo, "--state", "open", "--json",
                  "number,comments", "--limit", "1000"], capture_output=True, text=True, timeout=120)
    result.check_returncode()
    prs = json.loads(result.stdout)
    if not isinstance(prs, list) or len(prs) >= 1000:
        raise ValueError("incomplete PR comments")
    counts = dict(open=len(prs))
    for checks, key in (("failure", "red"), ("pending", "pending"), ("success", "green")):
        counts[key] = search_count(repo, checks, run) if prs else 0
    counts["waiting"] = sum(not any(re.search(r"(?im)^\s*(?:\#{1,6}\s*)?(?:(?:verdict|pstack verifier)\s*:\s*)?(?:\*\*)?(?:PASS\+NOTES|PASS|FAIL)(?=\s|[:.,*]|$)", c["body"])
                                    for c in pr["comments"]) for pr in prs)
    return counts


def transcript_state(home, sid, now, codex_cwd=None):
    paths = list((home / ".claude/projects").glob(f"*/{sid}.jsonl")) if sid else []
    if sid and not paths:
        paths = list((home / ".codex/sessions").glob(f"**/*{sid}.jsonl"))
    if not paths and not sid and codex_cwd:
        for path in sorted((home / ".codex/sessions").glob("**/*.jsonl"), key=lambda p: p.stat().st_mtime, reverse=True):
            try:
                with path.open() as transcript:
                    meta = json.loads(next(transcript))
                if meta.get("type") == "session_meta" and meta.get("payload", {}).get("cwd") == codex_cwd:
                    paths = [path]
                    break
            except (OSError, ValueError, StopIteration):
                continue
    model, fire = "unavailable", None
    for path in sorted(paths):
        with path.open(errors="replace") as transcript:
            for line in transcript:
                try:
                    record = json.loads(line)
                except ValueError:
                    continue
                if not isinstance(record, dict):
                    continue
                payload = record.get("payload")
                message = record.get("message")
                data = payload if isinstance(payload, dict) else record
                value = data.get("model") or (message.get("model") if isinstance(message, dict) else None)
                if isinstance(value, str):
                    model = value
                if data.get("turnOrigin") == "scheduled" or data.get("turn_origin") == "scheduled":
                    stamp = data.get("timestamp") or record.get("timestamp")
                    if isinstance(stamp, str):
                        try:
                            fired = datetime.fromisoformat(stamp.replace("Z", "+00:00")).timestamp()
                            if fired <= now + 60:
                                fire = max(fire or fired, fired)
                        except ValueError:
                            pass
    return model, fire, bool(paths)


def git_identity(run=subprocess.run):
    root = run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True)
    remote = run(["git", "remote", "get-url", "origin"], capture_output=True, text=True)
    repo = remote.stdout.strip().removesuffix(".git")
    repo = re.sub(r"^(?:https?://github.com/|git@github.com:|ssh://git@github.com/)", "", repo)
    return root.stdout.strip() if root.returncode == 0 else "", repo if remote.returncode == 0 else ""


def select_rows(rows, root, repo, all_rows=False, home=None, keys=()):
    home = Path.home() if home is None else home
    def path(value):
        return str(Path(str(value).replace("~/", str(home) + "/", 1)).resolve()) if value else ""
    if all_rows or path(root) == str((home / "projects/poteto-2-advisor").resolve()):
        return rows, True
    folder = Path(root).name.lower() if root else ""
    def folders(row):
        return {str(row.get("name") or "").lower(), str(row.get("repo") or "").rsplit("/", 1)[-1].lower()}
    exact = [r for r in rows if root and path(r.get("cwd")) == path(root)]
    matches = (exact or [r for r in rows if repo and r.get("repo") == repo]
               or [r for r in rows if folder and folder in folders(r)])
    if len(matches) > 1 and keys:
        matches = [r for r in matches if any(r.get(k) in keys for k in ("name", "tmux", "multibot", "sid"))]
    if len(matches) == 1:
        return matches, False
    if len(matches) > 1 and exact:
        return exact, False
    raise ValueError("caller matches no unique roster row; use --all")


def gather(solo, now, roster_path=HERE / "roster.json", home=None, proc=Path("/proc"), tasks=None,
           views=None, prs=None, all_rows=True, identity=None, caller_keys=(), list_views=None, statuses=None):
    home = Path.home() if home is None else home
    snapshot = Snapshot()
    snapshot.all_rows = all_rows
    try:
        roster = json.loads(roster_path.read_text())["rows"]
        roster = [r for r in roster if r.get("kind") in KINDS and r.get("status") != "closed"]
    except (OSError, ValueError, KeyError, TypeError) as error:
        snapshot.failed(f"roster: {error}")
        return snapshot
    try:
        chats = solo.roster.hosted_chats()
    except (OSError, ValueError, subprocess.SubprocessError, ImportError):
        chats = {}
        snapshot.live_known = False
        snapshot.failed("live chats failed")
    try:
        panes = solo.tmux_states()
    except (OSError, ValueError, subprocess.SubprocessError):
        panes = {}
        snapshot.live_known = False
        snapshot.failed("tmux sessions failed")
    try:
        tree = processes(proc)
        snapshot.server_workers = sum(process.worker for process in tree.values())
    except (OSError, ValueError, IndexError):
        tree = None
        snapshot.failed("/proc failed")
    try:
        records = session_records(home)
    except (OSError, ValueError, TypeError):
        records = None
        snapshot.failed("session records failed")
    if not all_rows and not caller_keys and tree is not None and records is not None:
        ancestors, pid = set(), os.getpid()
        while pid in tree and pid not in ancestors:
            ancestors.add(pid)
            pid = tree[pid].ppid
        native = {r.get("sessionId") for group in records.values() for r in group if r.get("pid") in ancestors}
        caller_keys = tuple(value for key, chat in chats.items()
                            if chat.get("sid") in native or chat.get("transcript") in native
                            or chat.get("pid") in ancestors
                            for value in (key, chat.get("name")) if value)
        caller_keys += tuple(r.get("tmux", "").split(":", 1)[0] for group in records.values()
                             for r in group if r.get("pid") in ancestors)
    try:
        roster, snapshot.all_rows = select_rows(roster, *(identity or ("", "")), all_rows, home, caller_keys)
    except ValueError as error:
        snapshot.failed(str(error))
        return snapshot
    if tasks is None or views is None or statuses is None:
        try:
            token = read_token(home)
            tasks = tasks or (lambda board: board_tickets(board, token))
            views = views or (lambda view: view_filter(view, token))
            list_views = list_views or (lambda board: board_views(board, token))
            statuses = statuses or (lambda board: board_status(board, token))
        except (OSError, ValueError):
            snapshot.failed("Hypertask token failed")
    prs = prs or pr_counts
    view_cache, board_view_cache, status_cache, row_tickets, scoped_boards = {}, {}, {}, {}, set()
    for row in roster:
        session, sid, loop, why, model = None, None, "no chat", "no chat", "no chat"
        try:
            session = solo.session_of(row, chats, panes)
            if session and session["via"] == "live":
                sid = chats[session["key"]].get("transcript") or session.get("sid")
            elif session:
                sid = solo.tmux_transcript(session["key"])
            if session is None:
                pane = panes.get(row.get("tmux") or row["name"])
                if pane and pane.get("harness") not in (None, "bash", "other"):
                    session = dict(pane, via="tmux", key=row.get("tmux") or row["name"])
                    sid = pane.get("sid") or pane.get("sessionId")
            if session:
                codex_cwd = session.get("cwd") if session.get("harness") == "codex" else None
                model, fire, found = transcript_state(home, sid, now.timestamp(), codex_cwd)
                if found:
                    verdict, why = solo.loop_verdict(session, fire, [], now.timestamp())
                    loop = "on" if verdict == "ok" else "off"
                else:
                    provider = chats.get(session["key"], {}).get("provider")
                    model = provider or "unavailable"
                    loop, why = "unavailable", "session found, transcript unavailable"
        except (OSError, ValueError, KeyError, TypeError):
            why = "transcript failed"
            snapshot.failed(f"transcript {row['name']} failed")
        active = 0 if tree is not None else None
        process_why = "ticket/cwd attribution" if tree is not None else "/proc unavailable"
        boards = list(dict.fromkeys(b.strip() for b in str(row.get("board") or "").split(",") if b.strip()))
        selected, good = [], bool(boards)
        if not boards:
            snapshot.failed(f"board {row['name']} missing")
        view = row.get("view")
        if view in solo.scopes.SCOPES:
            view = solo.scopes.SCOPES[view].get("view")
        resolved_view = view
        for board in boards:
            try:
                if board not in status_cache:
                    status_cache[board] = statuses(board)
                if status_cache[board] == "Archive":
                    continue
                board_view = view
                if board == "2060" and not board_view:
                    if board not in board_view_cache:
                        board_view_cache[board] = list_views(board) if list_views else []
                    board_view = resolve_view(row, board_view_cache[board])
                    resolved_view = board_view
                    if not board_view:
                        snapshot.failed(f"{row['name']} has no view")
                        good = False
                        continue
                if board not in snapshot.boards:
                    snapshot.boards[board] = tasks(board)
                tickets = snapshot.boards[board]
                if board_view:
                    scoped_boards.add((row["name"], board))
                    if board_view not in view_cache:
                        view_cache[board_view] = views(board_view)
                    tickets = [t for t in tickets if solo.scopes.in_view(t, view_cache[board_view])]
                ticket_counts(tickets, now)
                selected.extend(tickets)
                row_tickets.setdefault(row["name"], {})[board] = tickets
                snapshot.ticket_sets.setdefault(board, {}).update({str(t.get("id", t.get("ticketNumber", json.dumps(t, sort_keys=True)))): t for t in tickets})
            except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError) as error:
                good = False
                snapshot.failed(f"board {board} failed: {error}")
        try:
            shipped, left = ticket_counts(selected, now) if good else (dict.fromkeys(WINDOWS), None)
        except (ValueError, KeyError, TypeError):
            shipped, left = dict.fromkeys(WINDOWS), None
            snapshot.failed(f"tickets {row['name']} failed")
        repo = row.get("repo")
        if repo and repo not in snapshot.prs:
            try:
                snapshot.prs[repo] = prs(repo)
            except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError):
                snapshot.prs[repo] = None
                snapshot.failed(f"PRs {repo} failed")
        snapshot.append(Orchestrator(row["name"], row["kind"], row.get("board"), resolved_view,
                                     session is not None, loop, why, row.get("workers", 2), active, shipped, left,
                                     repo, model, str(row.get("workers_by", "")).startswith("Valentin"),
                                     process_why, snapshot.prs.get(repo)))
    if tree is not None:
        assigned, unattributed = attribute_workers(tree, roster, row_tickets, home, scoped_boards,
                                                   chat_owners(roster, chats, records))
        snapshot.unattributed = len(unattributed)
        for row in snapshot:
            row.active = len(assigned[row.name])
        assert sum(row.active for row in snapshot) + snapshot.unattributed == snapshot.server_workers
    return snapshot


def number(value):
    return "?" if value is None else str(value)


def total(values):
    values = list(values)
    return sum(values) if all(v is not None for v in values) else None


def render(rows, now, why=False):
    lines = []
    if rows.all_rows:
        tasks = [t for board in rows.ticket_sets.values() for t in board.values()]
        shipped, left = ticket_counts(tasks, now)
        board_unknown = sum(r.left is None for r in rows)
        pr_unknown = sum(r.prs is None for r in rows)
        board_note = f" ({board_unknown} rows unknown)" if board_unknown else ""
        pr_note = f" ({pr_unknown} rows unknown)" if pr_unknown else ""
        live = sum(r.live for r in rows) if rows.live_known else None
        loops = sum(r.live and r.loop == "on" for r in rows) if rows.live_known and not any(r.live and r.loop in ("unknown", "unavailable") for r in rows) else None
        counts = {key: sum(p[key] for p in rows.prs.values() if p is not None)
                  for key in ("open", "red", "pending", "green", "waiting")}
        clock = now.astimezone(ZoneInfo("Europe/London")).strftime("%H:%M")
        lines.append(f"Factory {clock} (Europe/London): {len(rows)} orchestrators, {number(live)} live, "
                     f"loops on {number(loops)}/{number(live)}, workers {number(total(r.active for r in rows))}/"
                     f"{sum(r.allowed for r in rows)}, server workers {number(rows.server_workers)}, unattributed {number(rows.unattributed)}. "
                     f"Shipped 1h/3h/12h: {'/'.join(number(shipped[h]) for h in WINDOWS)}{board_note}. Left: {number(left)}{board_note}. "
                     f"PRs open/red/pending/green/waiting verifier: {'/'.join(number(counts[k]) for k in ('open', 'red', 'pending', 'green', 'waiting'))}{pr_note}.")
    lines.append("name | model | loop | workers active/allowed | shipped 1h/3h/12h (Done, last update) | left | PRs open/red/pending/green/waiting verifier")
    for row in sorted(rows, key=lambda r: not r.live):
        ranking = "" if row.ranked else " not ranked"
        prs = "/".join(number(row.prs[k]) for k in ("open", "red", "pending", "green", "waiting")) if row.prs else "?/?/?/?/?"
        lines.append(f"{row.name} | {row.model} | {row.loop} | {number(row.active)}/{row.allowed}{ranking} | "
                     f"{'/'.join(number(row.shipped[h]) for h in WINDOWS)} | {number(row.left)} | {prs}")
        for board in str(row.board or "").split(","):
            if board.strip():
                lines.append(f"  https://app.hypertask.ai/project?id={board.strip()}")
        if why:
            lines.append(f"  Loop: {row.loop_why}. Process: {row.process_why}.")
    lines.extend(f"Not good: {source}" for source in rows.failures)
    return "\n".join(lines)


