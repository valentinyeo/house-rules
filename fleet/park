#!/usr/bin/env python3
"""Park a ticket a run cannot move, so it never sits In Progress (house rule "No column piles up").

    fleet/park <TICKET> --waits-on <T1[,T2..]>   waits on other tickets: home column, BlockedBy link per blocker, owner retained
    fleet/park <TICKET> --valentin [--comment ID] waits on Valentin: Valentin Review, his name and the red border on ONE marked Question
    fleet/park <TICKET> --unstarted              nothing built, no PR: home column, owner retained
    fleet/park <TICKET> --hand-back "<left to do>"  unfinished work: keep its starting runner and PR;
                                                 resume on that runner after the wait
    fleet/park <TICKET> --lead --why "reason"    unknown state, or a wait on a person: home column, waiting on the board lead
                                                 and held by it, so the pool leaves it there
    fleet/park <TICKET> --release                another runner owns the work (you were co-assigned, e.g. a cross-check): unassigns only you,
                                                 the ticket and its column stay as they are
    fleet/park --sweep [--apply] [--waits-on KEY=T1,T2 ...] [--valentin KEY[=COMMENT] ...]
    fleet/park --self-test

Home column: board 15 Bugs, Features or Improvements by label then title tag; 2060 Todo; 11514 Backlog.
A runner calls it before it ends a run with `RUNNER IDLE`. It writes as the caller (SHIP_SESSION_NAME), never as Valentin.
--sweep is the one-time cleanup through the same code: it reads the runner launcher logs, finds board 15 tickets still In
Progress that a runner ended IDLE on, classifies each (open BlockedBy link, waiting on Valentin, no PR at all) and prints the
plan. Without --apply it writes nothing. A ticket it cannot classify is listed with its newest agent note and left alone,
unless --waits-on KEY=.. or --valentin KEY names the class. fleet/pick skips a ticket with an open BlockedBy link.
"""
import datetime as dt
import json
import os
import re
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from ticket_owner import store

HOME = Path.home()
os.environ["PATH"] = f"{HOME}/.local/bin:{HOME}/bin:{os.environ.get('PATH', '')}"
RUNNER_STATE = Path(os.environ.get("FLEET_RUNNER_STATE", HOME / ".local/state/ht-or-runners"))
BUILDING = {"15": ("In Progress", "AI Review", "QA"), "2060": ("Doing", "AI Review"),
            "11514": ("In Progress", "AI Review")}
HOME_COLUMN = {"2060": "Todo", "11514": "Backlog"}
TICKET = re.compile(r"^(HTPR|HYFA|IGSH|SOFT|HYCI)-[0-9]+$")
RUNNERISH = re.compile(r"^(?:runner \d+|ci runner \d+|infra runner \d+|mp runner \d+|multi bot runner [a-z])$")
VALENTIN_REVIEW = "Valentin Review"


def vcc(*args, check=True):
    r = subprocess.run(["vcc", "--json", *args], capture_output=True, text=True, timeout=600)
    try:
        out = json.loads(r.stdout[r.stdout.index("{"):])
    except ValueError:
        out = None
    if check and (r.returncode != 0 or out is None or out.get("success") is False):
        raise RuntimeError(f"vcc {' '.join(args[:3])} failed: {(r.stderr or r.stdout).strip()[-300:]}")
    return out


def home_section(board, labels, title):
    """Where a ticket that is not being built lives: the board's intake column (board 15: Backlog)."""
    return HOME_COLUMN.get(str(board), "Backlog")


def get(key):
    return vcc("task", "get", key)["tasks"][0]


def holders(t):
    out = []
    for a in t.get("assignees") or []:
        name = ((a.get("agent") or {}).get("displayName") or a.get("displayName") or "").strip()
        if name and RUNNERISH.match(name.lower()):
            out.append(name)
    return out


def blockers(key):
    """Open outgoing BlockedBy tickets, using each board's completion columns."""
    out, done_sections = [], {}
    for r in vcc("task", "relations", key).get("relations") or []:
        other = r.get("otherTask") or {}
        if r.get("relationType") != "BlockedBy" or r.get("direction") != "outgoing" or other.get("status") == "Archive":
            continue
        task = get(other["ticketNumber"])
        if task.get("status") == "Archive":
            continue
        board = str(task["projectId"])
        if board not in done_sections:
            done_sections[board] = {s["id"] for s in vcc("section", "list", "--project", board)["sections"] if s.get("isDone")}
        if task.get("sectionId") not in done_sections[board]:
            out.append(other["ticketNumber"])
    return out


PREFIX_BOARD = {"HTPR": "15", "HYFA": "15", "IGSH": "2060", "SOFT": "2060", "HYCI": "11514"}


def lead_for(key):
    """(lead name, board id) from scopes.json. The board key with no view wins."""
    board = PREFIX_BOARD[key.split("-", 1)[0]]
    scopes = json.loads((Path(__file__).resolve().parents[1] / "skills/hypertask-triage/scripts/scopes.json").read_text())
    return scopes[board]["lead"], board


def record_event(key):
    """One completed park. fleet/pick stops offering a ticket after three of these in six hours."""
    state = Path(os.environ.get("FLEET_PICK_STATE", HOME / ".local/state/fleet-pick"))
    state.mkdir(parents=True, exist_ok=True)
    stamp = dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    with open(state / "park-events", "a") as f:
        f.write(f"{stamp} {key}\n")


def note(key, text):
    """The agent-lane note that says why the ticket left In Progress. `activity add` takes no --json."""
    r = subprocess.run(["vcc", "activity", "add", key, text], capture_output=True, text=True, timeout=600)
    if r.returncode != 0:
        print(f"WARNING {key}: agent-lane note not written: {(r.stderr or r.stdout).strip()[-200:]}", file=sys.stderr)


def free_claim(key):
    """fleet/pick keeps a claim file for 3h10 so no other runner takes the ticket. A parked or handed-back ticket is free
    now (HYCI-245 sat unpicked 3 hours after a park, then its green PR sat 80 minutes after a hand-back, 11 Nov)."""
    try:
        (Path(os.environ.get("FLEET_PICK_STATE", HOME / ".local/state/fleet-pick")) / "claims" / key).unlink()
    except OSError:
        pass


def preserve_owner(key, t):
    owners = store()
    record = owners.read(key)
    if record:
        return record
    for name in holders(t):
        match = re.fullmatch(r"runner (\d+)", name, re.I)
        if match and owners.exists(int(match[1])):
            return owners.bind(key, int(match[1]))
    return None


def release(key, t):
    record = preserve_owner(key, t)
    for name in holders(t):
        if record and name.lower() == f"runner {record['runner']}":
            continue
        vcc("task", "unassign", key, "--agent", name, check=False)
    free_claim(key)


def park_waits(key, waits, t=None):
    t = t or get(key)
    for w in waits:
        if not TICKET.match(w) or w == key:
            raise RuntimeError(f"bad blocker {w!r}")
        get(w)
    have = set(blockers(key))
    for w in waits:
        if w not in have:
            vcc("task", "link", key, w, "--type", "BlockedBy")
    now = set(blockers(key))
    if not set(waits) <= now:
        raise RuntimeError(f"{key}: BlockedBy link not on the ticket after linking ({sorted(now)}); not moving it")
    home = home_section(t.get("projectId"), [l.get("name", "") for l in t.get("labels") or []], t.get("title"))
    if t.get("section") != home:
        vcc("task", "move", key, "--section", home)
    release(key, t)
    note(key, f"Parked by fleet/park: waits on {', '.join(waits)} (BlockedBy). Back in {home}, starting runner retained. The picker skips it until every blocker is done. "
              "Nobody needs to touch it before then.")
    record_event(key)
    return f"{key} -> {home}, BlockedBy {', '.join(waits)}, starting runner retained"


def park_unstarted(key, t=None):
    t = t or get(key)
    if t.get("pullRequests"):
        raise RuntimeError(f"{key} has a PR; --unstarted is only for tickets with nothing built")
    home = home_section(t.get("projectId"), [l.get("name", "") for l in t.get("labels") or []], t.get("title"))
    if t.get("section") != home:
        vcc("task", "move", key, "--section", home)
    release(key, t)
    note(key, f"Parked by fleet/park: nothing was built and no PR exists. Back in {home}, starting runner retained. The same runner resumes; "
              "fleet/pick rests it until the ticket changes.")
    record_event(key)
    return f"{key} -> {home}, starting runner retained"


# A hand-back that only waits on checks, review or a deploy is a timed wait, not a failed try: it must not count toward the
# three-parks hold in fleet/pick (HYCI-269 hit three in five minutes on "checks pending" and its PR sat hidden, 11 Nov).
CHECK_WAIT = re.compile(r"\brecheck\b|\b(?:pending|running|queued|awaiting|in progress)\b", re.I)


def park_hand_back(key, why, t=None):
    """Pause unfinished work without transferring its owner or losing its PR."""
    t = t or get(key)
    who = os.environ["SHIP_SESSION_NAME"]
    mine, others = co_holders(t, who)
    if not mine:
        raise RuntimeError(f"{key}: {who} is not assigned to it, nothing to hand back")
    if blockers(key):
        raise RuntimeError(f"{key} has an open BlockedBy link; use --waits-on")
    if not why.strip():
        raise RuntimeError("--hand-back needs a reason: what is left to do")
    record = preserve_owner(key, t)
    if not record or mine[0].lower() != f"runner {record['runner']}":
        raise RuntimeError(f"{key}: only its starting runner may schedule its next run")
    section = t.get("section")
    if section in ("In Progress", "Doing"):
        section = "AI Review" if t.get("pullRequests") else home_section(t.get("projectId"), [], t.get("title"))
        vcc("task", "move", key, "--section", section)
    free_claim(key)
    note(key, f"Paused by fleet/park: {mine[0]} keeps this ticket until Done. Left to do: {why.strip()} "
              f"Column {section}; PR retained. Only this runner resumes it.")
    if not CHECK_WAIT.search(why):
        record_event(key)
    return f"{key} -> {section}, {mine[0]} retained for its next run"


def co_holders(t, me):
    """(mine, others): the runner logins on t that are the caller, and those that are not."""
    names = holders(t)
    return [h for h in names if h.lower() == me.lower()], [h for h in names if h.lower() != me.lower()]


def park_release(key, t=None):
    """Hand a ticket back to the runner that owns it. Moving it home would pull it from that runner, so only the caller leaves."""
    t = t or get(key)
    who = os.environ["SHIP_SESSION_NAME"]
    mine, others = co_holders(t, who)
    if not mine:
        raise RuntimeError(f"{key}: {who} is not assigned to it, nothing to release")
    if not others:
        raise RuntimeError(f"{key}: no other runner holds it, so releasing would orphan it; use --waits-on, --valentin or --unstarted")
    record = preserve_owner(key, t)
    if record and mine[0].lower() == f"runner {record['runner']}":
        raise RuntimeError(f"{key}: its starting runner keeps ownership until Done")
    vcc("task", "unassign", key, "--agent", mine[0])
    note(key, f"Released by fleet/park: {mine[0]} no longer holds this ticket; {', '.join(others)} continues. Column unchanged. "
              "The picker no longer holds this runner for it.")
    return f"{key} stays in {t.get('section')}, {mine[0]} unassigned, {', '.join(others)} continues"


def valentin_id(board):
    for m in vcc("project", "members", "--project", str(board)).get("members") or []:
        if (m.get("displayName") or "") == "Valentin Yeo" and isinstance(m.get("id"), int):
            return m["id"]
    raise RuntimeError("Valentin Yeo not found on the board")


def park_valentin(key, comment=None, t=None):
    t = t or get(key)
    cid = comment or t.get("blockerCommentId")
    if not cid:
        raise RuntimeError(f"{key}: post ONE Question first (vcc comment add {key} --kind question, format in skills/tickets), then run again")
    if t.get("section") != VALENTIN_REVIEW:
        vcc("task", "move", key, "--section", VALENTIN_REVIEW)
    vcc("task", "waiting-on", key, "--user", str(valentin_id(t.get("projectId"))))
    vcc("task", "blocker-comment", key, "--comment-id", str(cid))
    note(key, f"Parked by fleet/park: waits on Valentin's answer to comment {cid}. In {VALENTIN_REVIEW}. The picker leaves it alone.")
    record_event(key)
    return f"{key} -> {VALENTIN_REVIEW}, waiting on Valentin, Question comment {cid}"


def park_lead(key, why, t=None):
    """An unknown state, including a wait on a person. The board lead becomes the waiting person. The runner is free."""
    t = t or get(key)
    if (t.get("section") or "").lower() in ("done", "archive", "archived"):
        return f"{key} already {t.get('section')}, not parked"
    name, board = lead_for(key)
    uid = ""
    for m in vcc("project", "members", "--project", board).get("members") or []:
        if (m.get("displayName") or "") == name and m.get("id"):
            uid = str(m["id"])
            break
    if not uid:
        raise RuntimeError(f"lead {name} not on board {board}")
    home = home_section(t.get("projectId"), [l.get("name", "") for l in t.get("labels") or []], t.get("title"))
    if t.get("section") != home:
        vcc("task", "move", key, "--section", home)
    vcc("task", "waiting-on", key, "--user", uid)
    release(key, t)
    vcc("task", "assign", key, "--agent", name, check=False)
    record_event(key)
    note(key, f"Parked by fleet/park: unknown state. {why.strip()} Waiting person is {name}, who now holds it. "
              f"Back in {home}, starting runner retained for the next run.")
    return f"{key} -> {home}, waiting on {name}, starting runner retained"


# ---------------------------------------------------------------- one-time sweep

def run_lines(path):
    """The lines of a runner log from its last 'pick: <ticket>' line on. The logs hold whole agent transcripts
    (100 MB and more), so only a tail is read, widened until it holds that line."""
    with open(path, "rb") as f:
        size = f.seek(0, 2)
        span = 1 << 21
        while True:
            start = max(0, size - span)
            f.seek(start)
            data = f.read(size - start)
            at = len(data)
            while True:
                at = data.rfind(b" pick: ", 0, at)
                if at < 0 or re.match(r"[A-Z0-9]+-[0-9]+", data[at + 7:at + 40].decode("utf-8", "replace")):
                    break
            if at >= 0 and (start == 0 or data.rfind(b"\n", 0, at) >= 0):
                return data[data.rfind(b"\n", 0, at) + 1:].decode("utf-8", "replace").splitlines()
            if start == 0:
                return []
            span *= 4


def idle_tickets():
    """Tickets some runner ended IDLE on, from the launcher files fleet/pick reads: runner-N.idle and runner-N.log with runner-N.result."""
    keys = {}
    for p in RUNNER_STATE.glob("runner-*.idle"):
        for line in p.read_text().splitlines():
            try:
                stamp, key = line.split()
            except ValueError:
                continue
            keys[key] = max(keys.get(key, ""), stamp)
    for p in RUNNER_STATE.glob("runner-*.result"):
        if p.read_text().strip() != "IDLE":
            continue
        key = end = None
        for line in run_lines(RUNNER_STATE / p.name.replace(".result", ".log")):
            stamp, sep, rest = line.partition(" pick: ")
            m = re.match(r"[A-Z0-9]+-[0-9]+", rest) if sep else None
            if m:
                key, end = m[0], stamp.strip()
            elif key and line.endswith(" end"):
                end = line.split()[0]
        if key:
            keys[key] = max(keys.get(key, ""), end or "")
    return keys


def running_now():
    """Tickets a runner is working this minute: its newest pick has no end line after it."""
    out = set()
    for p in RUNNER_STATE.glob("runner-*.log"):
        key = None
        for line in run_lines(p):
            _, sep, rest = line.partition(" pick: ")
            m = re.match(r"[A-Z0-9]+-[0-9]+", rest) if sep else None
            if m:
                key = m[0]
            elif line.endswith(" end"):
                key = None
        if key:
            out.add(key)
    return out


def last_note(key):
    acts = vcc("task", "agent-log", key, "--limit", "1", check=False) or {}
    a = (acts.get("activities") or [{}])[0]
    return " ".join((a.get("text") or "").split())[:160]


def later(stamp, seconds):
    return (dt.datetime.fromisoformat(stamp.replace("Z", "+00:00")) + dt.timedelta(seconds=seconds)).strftime("%Y-%m-%dT%H:%M:%S.999Z")


def classify(t, waits, forced):
    if t["ticketNumber"] in forced:
        return forced[t["ticketNumber"]]
    if waits:
        return ("waits", waits)
    if t.get("waitingOnUserId") or t.get("blockerCommentId"):
        return ("valentin", t.get("blockerCommentId"))
    if not t.get("pullRequests"):
        return ("unstarted", None)
    return None


def sweep(apply, forced):
    idle, busy = idle_tickets(), running_now()
    rows = vcc("task", "list", "--project", "15", "--section", "In Progress", "--limit", "100").get("tasks") or []
    done, left = [], []
    for row in sorted(rows, key=lambda r: r["ticketNumber"]):
        key = row["ticketNumber"]
        if key not in idle:
            continue
        if key in busy:
            left.append(f"{key}: a runner is on it right now, skipped")
            continue
        t = get(key)
        if t.get("updatedAt", "") > later(idle[key], 60):
            left.append(f"{key}: changed after the IDLE end ({t['updatedAt']}), left for the picker")
            continue
        plan = classify(t, blockers(key), forced)
        if plan is None:
            left.append(f"{key} {t['title'][:60]!r} holders={holders(t)} PRs={[p['number'] for p in t.get('pullRequests') or []]}: {last_note(key)}")
            continue
        kind, arg = plan
        desc = {"waits": lambda: f"waits on {arg}", "valentin": lambda: f"waits on Valentin (comment {arg})",
                "unstarted": lambda: "nothing built, no PR"}[kind]()
        if not apply:
            done.append(f"PLAN {key} {t['title'][:60]!r}: {desc}")
            continue
        if kind == "waits":
            done.append("DONE " + park_waits(key, arg, t))
        elif kind == "valentin":
            done.append("DONE " + park_valentin(key, arg, t))
        else:
            done.append("DONE " + park_unstarted(key, t))
    print("\n".join(done) or "nothing to park")
    if left:
        print("\nNOT CLASSIFIED (left In Progress; name the class with --waits-on KEY=.. or --valentin KEY):")
        print("\n".join(left))


# ---------------------------------------------------------------- main

def self_test():
    assert CHECK_WAIT.search("PR 3364 is pending hosted tests. Recheck after 11:45") and not CHECK_WAIT.search("QA FAIL: 8px corners")
    assert home_section(15, ["AI Cost", "Bug", "brain-hard"], "Own AI keys") == "Backlog"
    assert home_section(2060, [], "x") == "Todo" and home_section(11514, [], "x") == "Backlog"
    t = {"ticketNumber": "HTPR-1", "pullRequests": [], "waitingOnUserId": None, "blockerCommentId": None}
    assert classify(t, ["HTPR-2"], {}) == ("waits", ["HTPR-2"])
    assert classify(t, [], {}) == ("unstarted", None)
    assert classify({**t, "blockerCommentId": 5}, [], {}) == ("valentin", 5)
    assert classify({**t, "pullRequests": [{"number": 1}]}, [], {}) is None
    assert classify({**t, "pullRequests": [{"number": 1}]}, [], {"HTPR-1": ("waits", ["HTPR-9"])}) == ("waits", ["HTPR-9"])
    assert holders({"assignees": [{"agent": {"displayName": "Runner 11"}}, {"displayName": "Poteto Advisor"}, {"displayName": "Valentin Yeo"}]}) == ["Runner 11"]
    co = {"assignees": [{"agent": {"displayName": "Infra Runner 3"}}, {"agent": {"displayName": "Runner 6"}}]}
    assert co_holders(co, "RUNNER 6") == (["Runner 6"], ["Infra Runner 3"]), "the caller leaves, the owner stays"
    assert co_holders(co, "RUNNER 7") == ([], ["Infra Runner 3", "Runner 6"]), "a runner that is not assigned releases nothing"
    assert lead_for("HTPR-1") == ("HT Product Lead", "15")
    assert lead_for("HYCI-1")[0] == "Chief Of Staff" and lead_for("IGSH-1")[0] == "Chief Of Staff"
    from unittest.mock import patch

    tasks = {
        "HYCI-244": {"projectId": 11514, "sectionId": 32929, "status": "Normal"},
        "IGSH-3": {"projectId": 2060, "sectionId": 900, "status": "Normal"},
        "HTPR-4": {"projectId": 15, "sectionId": 29521, "status": "Normal"},
        "HTPR-5": {"projectId": 15, "sectionId": 4312, "status": "Normal"},
        "HTPR-6": {"projectId": 15, "sectionId": 29803, "status": "Normal"},
        "HTPR-7": {"projectId": 15, "sectionId": 30997, "status": "Normal"},
        "HYCI-8": {"projectId": 11514, "sectionId": 32924, "status": "Normal"},
        "HYCI-9": {"projectId": 11514, "status": "Archive"},
    }
    sections = {
        "11514": [{"id": 32929, "name": "Done", "isDone": True}, {"id": 32924, "name": "In Progress"}],
        "2060": [{"id": 900, "name": "Released", "isDone": True}],
        "15": [{"id": n, "isDone": n != 30997} for n in (29521, 4312, 29803, 30997)],
    }
    relations = [{"relationType": "BlockedBy", "direction": "outgoing",
                  "otherTask": {"ticketNumber": k, "status": "Normal"}} for k in tasks]
    relations += [
        {"relationType": "BlockedBy", "direction": "incoming", "otherTask": {"ticketNumber": "HTPR-200"}},
        {"relationType": "RelatedTo", "direction": "outgoing", "otherTask": {"ticketNumber": "HTPR-201"}},
        {"relationType": "BlockedBy", "direction": "outgoing", "otherTask": {"ticketNumber": "HYCI-202", "status": "Archive"}},
    ]

    def fake_vcc(*args, **kwargs):
        if args[:2] == ("task", "relations"):
            return {"relations": relations}
        if args[:2] == ("task", "get"):
            return {"tasks": [tasks[args[2]]]}
        if args[:2] == ("section", "list"):
            return {"sections": sections[args[-1]]}
        assert args == ("task", "unassign", "HTPR-1", "--agent", "Runner 4"), args
        return {"success": True}

    ticket = {**t, "section": "AI Review", "pullRequests": [{"number": 1}],
              "assignees": [{"agent": {"displayName": "Runner 4"}}, {"agent": {"displayName": "Runner 6"}}]}
    with patch.dict(os.environ, {"SHIP_SESSION_NAME": "RUNNER 4"}), \
            patch(__name__ + ".vcc", side_effect=fake_vcc) as api, \
            patch(__name__ + ".note") as posted, patch(__name__ + ".record_event") as event, \
            patch(__name__ + ".preserve_owner", return_value={"runner": 4}):
        assert blockers("HTPR-1") == ["HTPR-7", "HYCI-8"], "completed and incoming links must not block; Flag: Off must block"
        try:
            park_hand_back("HTPR-1", "finish the PR", ticket)
        except RuntimeError as error:
            assert "open BlockedBy" in str(error)
        else:
            raise AssertionError("an active blocker must refuse hand-back")
        assert not any(c.args[:2] == ("task", "unassign") for c in api.call_args_list)
        posted.assert_not_called()
        event.assert_not_called()
        relations[:] = [r for r in relations if r["otherTask"]["ticketNumber"] not in ("HTPR-7", "HYCI-8")]
        result = park_hand_back("HTPR-1", "finish the PR", ticket)
        assert "Runner 4 retained" in result and "AI Review" in result
        assert not any(c.args[:2] == ("task", "unassign") for c in api.call_args_list)
        assert ticket["section"] == "AI Review" and ticket["pullRequests"] == [{"number": 1}]
        posted.assert_called_once()
        event.assert_called_once_with("HTPR-1")
        api.reset_mock()
        api.side_effect = RuntimeError("blocker read unavailable")
        try:
            park_hand_back("HTPR-1", "finish the PR", ticket)
        except RuntimeError as error:
            assert "blocker read unavailable" in str(error)
        else:
            raise AssertionError("an unreadable blocker must refuse hand-back")
        assert not any(c.args[:2] == ("task", "unassign") for c in api.call_args_list)
    print("fleet/park completed-blocker owner-resume regression ok")
    print("fleet/park self-test ok")


def main():
    a = sys.argv[1:]
    if not a or a[0] in ("-h", "--help"):
        print(__doc__)
        return
    if a == ["--self-test"]:
        return self_test()
    who = os.environ.get("SHIP_SESSION_NAME", "")
    if not who or who == "Valentins Claude Code":
        sys.exit("fleet/park: set SHIP_SESSION_NAME to your own agent login (never Valentin's)")
    if a[0] == "--sweep":
        forced, apply, i = {}, False, 1
        while i < len(a):
            if a[i] == "--apply":
                apply = True
            elif a[i] == "--waits-on" and i + 1 < len(a) and "=" in a[i + 1]:
                k, v = a[i + 1].split("=", 1)
                forced[k] = ("waits", [x for x in v.split(",") if x])
                i += 1
            elif a[i] == "--valentin" and i + 1 < len(a):
                k, _, c = a[i + 1].partition("=")
                forced[k] = ("valentin", int(c) if c else None)
                i += 1
            else:
                sys.exit(f"fleet/park: unknown sweep argument {a[i]}")
            i += 1
        return sweep(apply, forced)
    key = a[0]
    if not TICKET.match(key) or len(a) < 2:
        sys.exit("usage: fleet/park <TICKET> --waits-on T1,T2 | --valentin [--comment ID] | --unstarted | --release | --hand-back \"what is left\" | --lead --why TEXT")
    try:
        if a[1] == "--waits-on" and len(a) > 2:
            print(park_waits(key, [x for x in a[2].split(",") if x]))
        elif a[1] == "--valentin":
            c = a[a.index("--comment") + 1] if "--comment" in a else None
            print(park_valentin(key, c))
        elif a[1] == "--unstarted":
            print(park_unstarted(key))
        elif a[1] == "--release":
            print(park_release(key))
        elif a[1] == "--hand-back" and len(a) > 2:
            print(park_hand_back(key, " ".join(a[2:])))
        elif a[1] == "--lead":
            why = a[a.index("--why") + 1] if "--why" in a else "unknown state"
            print(park_lead(key, why))
        else:
            sys.exit("usage: fleet/park <TICKET> --waits-on T1,T2 | --valentin [--comment ID] | --unstarted | --release | --hand-back \"what is left\" | --lead --why TEXT")
    except RuntimeError as e:
        sys.exit(f"fleet/park: {e}")


