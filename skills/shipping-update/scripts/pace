#!/usr/bin/env python3
"""Ship pace for a repo: today vs the same clock time on earlier days, plus recent hours.

One shipped change = one merged PR into base, or one commit pushed straight to base.
A commit that is a merged PR's merge commit counts once, as that PR.

Usage: pace <owner/repo> [base-branch] [days-back]
Base defaults to the repo's default branch. Read only.
"""
import datetime as dt
import json
import subprocess
import sys
from collections import Counter


def gh(*args):
    return subprocess.run(["gh", *args], capture_output=True, text=True, check=True).stdout


repo = sys.argv[1]
base = sys.argv[2] if len(sys.argv) > 2 else gh("api", f"repos/{repo}", "--jq", ".default_branch").strip()
days = int(sys.argv[3]) if len(sys.argv) > 3 else 4
now = dt.datetime.now(dt.timezone.utc)
since = (now - dt.timedelta(days=days)).date().isoformat()

prs = json.loads(gh("pr", "list", "-R", repo, "--state", "merged", "--base", base, "--limit", "1000",
                    "--search", f"merged:>={since}", "--json", "number,title,mergedAt,mergeCommit"))
pr_commits = {p["mergeCommit"]["oid"] for p in prs if p.get("mergeCommit")}
commits = json.loads(gh("api", "--paginate", "--slurp",
                        f"repos/{repo}/commits?sha={base}&since={since}T00:00:00Z&per_page=100"))
shipped = [(p["mergedAt"], f"PR #{p['number']} {p['title']}") for p in prs]
shipped += [(c["commit"]["committer"]["date"], f"push {c['sha'][:7]} {c['commit']['message'].splitlines()[0]}")
            for page in commits for c in page if c["sha"] not in pr_commits]
shipped.sort()
times = [dt.datetime.fromisoformat(at.replace("Z", "+00:00")) for at, _ in shipped]

print(f"now {now:%Y-%m-%d %H:%M}Z  base {base}  ({len(prs)} PRs, {len(shipped) - len(prs)} direct pushes)")
for back in range(days, -1, -1):
    start = dt.datetime.combine((now - dt.timedelta(days=back)).date(), dt.time(), dt.timezone.utc)
    cut = start.replace(hour=now.hour, minute=now.minute)
    by_now = sum(start <= t < cut for t in times)
    full = sum(start <= t < start + dt.timedelta(days=1) for t in times)
    print(f"{start:%Y-%m-%d} by {now:%H:%M}Z: {by_now}  full day: {full}")
for h in (1, 3, 6, 24):
    print(f"last {h}h: {sum(t > now - dt.timedelta(hours=h) for t in times)}")
hours = Counter(t.strftime("%m-%d %H:00Z") for t in times)
print("best hours:", ", ".join(f"{k} ({v})" for k, v in hours.most_common(3)))
print("shipped last 3h:")
for (at, what), t in zip(shipped, times):
    if t > now - dt.timedelta(hours=3):
        print(f"  {t:%H:%M}Z {what}")
