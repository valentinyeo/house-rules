#!/usr/bin/env python3
"""Merge pace for a repo: today vs the same clock time on earlier days, plus recent hours.

Usage: pace <owner/repo> [base-branch] [days-back]
Read only. One gh call.
"""
import datetime as dt
import json
import subprocess
import sys
from collections import Counter

repo = sys.argv[1]
base = sys.argv[2] if len(sys.argv) > 2 else "production"
days = int(sys.argv[3]) if len(sys.argv) > 3 else 4
now = dt.datetime.now(dt.timezone.utc)
since = (now - dt.timedelta(days=days)).date().isoformat()
out = subprocess.run(["gh", "pr", "list", "-R", repo, "--state", "merged", "--base", base, "--limit", "1000",
                      "--search", f"merged:>={since}", "--json", "number,title,mergedAt"],
                     capture_output=True, text=True, check=True).stdout
prs = sorted(json.loads(out), key=lambda p: p["mergedAt"])
merged = [dt.datetime.fromisoformat(p["mergedAt"].replace("Z", "+00:00")) for p in prs]

print(f"now {now:%Y-%m-%d %H:%M}Z")
for back in range(days, -1, -1):
    start = dt.datetime.combine((now - dt.timedelta(days=back)).date(), dt.time(), dt.timezone.utc)
    cut = start.replace(hour=now.hour, minute=now.minute)
    by_now = sum(start <= t < cut for t in merged)
    full = sum(start <= t < start + dt.timedelta(days=1) for t in merged)
    print(f"{start:%Y-%m-%d} by {now:%H:%M}Z: {by_now}  full day: {full}")
for h in (1, 3, 6, 24):
    print(f"last {h}h: {sum(t > now - dt.timedelta(hours=h) for t in merged)}")
hours = Counter(t.strftime("%m-%d %H:00Z") for t in merged)
print("best hours:", ", ".join(f"{k} ({v})" for k, v in hours.most_common(3)))
print("merged last 3h:")
for p, t in zip(prs, merged):
    if t > now - dt.timedelta(hours=3):
        print(f"  {t:%H:%M}Z #{p['number']} {p['title']}")
