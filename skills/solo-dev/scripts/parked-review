#!/usr/bin/env python3
"""List stale review tickets, including board 2060's migration aliases."""
import argparse
import json
import subprocess
import sys
from datetime import datetime, timezone

p = argparse.ArgumentParser()
p.add_argument('--board', default='2060')
p.add_argument('--section', help='Exact column override; default checks every review stage')
p.add_argument('--hours', type=float, default=1)
a = p.parse_args()
names = {a.section} if a.section else ({'Checks', 'Verifier', 'AI Review'} if a.board == '2060' else {'AI Review'})
now = datetime.now(timezone.utc)
parked = []
offset = 0
while True:
    result = subprocess.run(['hypertask', '--json', 'task', 'list', '--project', a.board,
                             '--status', 'Normal', '--limit', '100', '--offset', str(offset)],
                            capture_output=True, text=True, check=True)
    data = json.loads(result.stdout)
    if data.get('success') is False or not isinstance(data.get('tasks'), list):
        raise RuntimeError('Board tickets unreadable')
    for t in data['tasks']:
        if t.get('section') not in names:
            continue
        age = (now - datetime.fromisoformat(t['updatedAt'].replace('Z', '+00:00'))).total_seconds() / 3600
        if age >= a.hours:
            parked.append((age, t))
    if len(data['tasks']) < 100:
        break
    offset += 100
for age, t in sorted(parked, key=lambda x: -x[0]):
    print(f"PARKED {age:6.1f}h {t['ticketNumber']:10} {t['url']}  {t['title'][:70]}")
print(f"SUMMARY board {a.board} {', '.join(sorted(names))}: {len(parked)} parked over {a.hours:g}h")
sys.exit(1 if parked else 0)
