#!/usr/bin/env python3
"""List tickets parked in a review column. Exit 1 when any is found.

Usage: parked-review [--board 2060] [--section "AI Review"] [--hours 1]
A ticket counts as parked when it has not changed for --hours.
Released and proved: move it to Done. Not finished: back to Todo with one line why.
"""
import argparse
import json
import subprocess
import sys
from datetime import datetime, timezone

p = argparse.ArgumentParser()
p.add_argument('--board', default='2060')
p.add_argument('--section', default='AI Review')
p.add_argument('--hours', type=float, default=1)
a = p.parse_args()

out = subprocess.run(['hypertask', '--json', 'task', 'list', '--project', a.board, '--section', a.section,
                      '--status', 'Normal', '--limit', '200'], capture_output=True, text=True, check=True).stdout
now = datetime.now(timezone.utc)
parked = []
for t in json.loads(out).get('tasks', []):
    age = (now - datetime.fromisoformat(t['updatedAt'].replace('Z', '+00:00'))).total_seconds() / 3600
    if age >= a.hours:
        parked.append((age, t))
for age, t in sorted(parked, key=lambda x: -x[0]):
    print(f"PARKED {age:6.1f}h {t['ticketNumber']:10} {t['url']}  {t['title'][:70]}")
print(f"SUMMARY board {a.board} {a.section}: {len(parked)} parked over {a.hours:g}h")
sys.exit(1 if parked else 0)
