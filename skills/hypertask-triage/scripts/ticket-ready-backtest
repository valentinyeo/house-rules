#!/usr/bin/env python3
"""Backtest ticket-ready against the run ledger. No model, read-only.

Ground truth: ~/.local/state/goal/run-census.json (runner runs per ticket) and heavy.json (tickets with many runs and the
main cause of each). Ticket text comes from a fetched sample, `ticket-ready-backtest --fetch DIR`, one `hypertask task get`
per ticket, because the ledger holds no text.

Two honest limits, printed with the result:
  - the text is today's, not as first written; older tickets lack the Done when shape and brain tags, so only tickets
    created on or after --since are scored on content;
  - `task get` carries no BlockedBy links, so Blocked cannot be scored here; the brain tag is scored apart.

usage:
  ticket-ready-backtest --fetch DIR      read the sample tickets into DIR/sample.json and DIR/meta.json (about 0.5 s each)
  ticket-ready-backtest DIR              confusion matrices from DIR
  ticket-ready-backtest DIR --misses 15  also list the wrongly judged tickets with reasons
"""
import argparse
import collections
import importlib.machinery
import importlib.util
import json
import subprocess
import sys
import time
from pathlib import Path

HERE = Path(__file__).resolve().parent
GOAL = Path.home() / ".local/state/goal"
loader = importlib.machinery.SourceFileLoader("ticket_ready", str(HERE / "ticket-ready"))
spec = importlib.util.spec_from_loader("ticket_ready", loader)
TR = importlib.util.module_from_spec(spec)
loader.exec_module(TR)

DONE = ("Done", "No Flag", "Flag: Everyone", "Flag: Off", "Flag: Only Me + QA", "QA")
# Causes in heavy.json that are not the ticket's shape: the launcher, CI or the checks failed, not the text.
NOT_SHAPE = ("Waited on checks", "No end note", "Handed back", "Cross-QA not passed")


def fetch(out):
    out = Path(out)
    out.mkdir(parents=True, exist_ok=True)
    runs = collections.Counter(x["ticket"] for x in json.loads((GOAL / "run-census.json").read_text())["rows"]
                               if x.get("kind") == "runner" and x.get("ticket"))
    tickets = json.loads((GOAL / "tickets.json").read_text())
    heavy = {x["key"]: x for x in json.loads((GOAL / "heavy.json").read_text())["windows"]["30d"]["tickets"]}
    one = [k for k, v in runs.items() if v == 1 and k in tickets and (tickets[k].get("section") or "") in DONE]
    many = [k for k, v in runs.items() if v >= 5 and k in tickets]
    keys = sorted(set(one) | set(many) | set(heavy))
    have = json.loads((out / "sample.json").read_text()) if (out / "sample.json").exists() else {}
    for i, k in enumerate(keys):
        if k in have:
            continue
        p = subprocess.run(["hypertask", "--json", "task", "get", k], capture_output=True, text=True)
        try:
            have[k] = TR.payload(p.stdout)["tasks"][0]
        except Exception:
            have[k] = None
        if i % 25 == 0:
            (out / "sample.json").write_text(json.dumps(have))
        time.sleep(0.15)
    (out / "sample.json").write_text(json.dumps(have))
    (out / "meta.json").write_text(json.dumps({"runs": dict(runs), "one": one, "many": many, "heavy": heavy}))
    print("fetched", len(have))


def matrix(title, rows, pred_ready):
    """rows: (key, is_one_run_good). Ready is the positive class for one-run tickets."""
    tp = sum(1 for k, good in rows if good and pred_ready(k))
    fn = sum(1 for k, good in rows if good and not pred_ready(k))
    fp = sum(1 for k, good in rows if not good and pred_ready(k))
    tn = sum(1 for k, good in rows if not good and not pred_ready(k))
    print(f"\n{title}")
    print(f"                       judged Ready   judged Not Ready")
    print(f"  shipped in 1 run     {tp:>12}   {fn:>16}")
    print(f"  heavy (many runs)    {fp:>12}   {tn:>16}")
    n1, nm = tp + fn, fp + tn
    print(f"  one-run tickets kept Ready: {tp}/{n1} = {tp / max(n1, 1):.0%}   heavy tickets caught Not Ready: {tn}/{nm} = {tn / max(nm, 1):.0%}")
    if tn + fn:
        print(f"  of everything judged Not Ready, {tn / (tn + fn):.0%} really was heavy (precision)")


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("dir")
    ap.add_argument("--fetch", action="store_true")
    ap.add_argument("--since", default="2026-11-07", help="score content only on tickets created on or after this date")
    ap.add_argument("--misses", type=int, default=0)
    a = ap.parse_args()
    if a.fetch:
        return fetch(a.dir)
    d = Path(a.dir)
    sample = json.loads((d / "sample.json").read_text())
    meta = json.loads((d / "meta.json").read_text())
    heavy = meta["heavy"]
    CONTENT = {TR.MULTI, TR.VALENTIN, TR.NODONE, TR.VAGUE}

    def verdict(k):
        t = sample.get(k)
        return {r["code"] for r in TR.assess(t)["reasons"]} if t else None

    def recent(k):
        t = sample.get(k)
        return bool(t) and (t.get("createdAt") or "")[:10] >= a.since

    one = [k for k in meta["one"] if recent(k)]
    many = [k for k in meta["many"] if recent(k)]
    shape = [k for k in many if (heavy.get(k, {}).get("main") or "") not in NOT_SHAPE]
    print(f"sample: {sum(1 for v in sample.values() if v)} tickets read; created since {a.since}: {len(one)} one-run, {len(many)} with 5+ runs "
          f"({len(shape)} where the main cause is not launcher or CI)")
    ready = lambda k: not (verdict(k) & CONTENT)
    matrix("Content rules (multi-step, needs Valentin, done line, vague): one-run vs ALL heavy", [(k, True) for k in one] + [(k, False) for k in many], ready)
    matrix("Same, heavy limited to causes that come from the ticket's shape", [(k, True) for k in one] + [(k, False) for k in shape], ready)
    allr = lambda k: not verdict(k)
    matrix("All rules except Blocked (adds the brain tag; older tickets lack it)", [(k, True) for k in one] + [(k, False) for k in many], allr)
    print("\nWhich rule fires (one-run / heavy, recent tickets):")
    for c in TR.ORDER:
        print(f"  {TR.TITLES[c]:<18} one-run {sum(1 for k in one if c in verdict(k)):>4}   heavy {sum(1 for k in many if c in verdict(k)):>4}")
    if a.misses:
        for title, ks, want in (("One-run tickets judged Not Ready", one, True), ("Heavy tickets judged Ready", many, False)):
            bad = [k for k in ks if (not ready(k)) == want]
            print(f"\n{title}: {len(bad)}")
            for k in bad[: a.misses]:
                print(f"  {k} runs={meta['runs'].get(k)} {(sample[k].get('title') or '')[:60]} {sorted(verdict(k))} {heavy.get(k, {}).get('main', '')}")


if __name__ == "__main__":
    sys.exit(main())
