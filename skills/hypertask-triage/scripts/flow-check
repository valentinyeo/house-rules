#!/usr/bin/env python3
"""Flag tickets that sit in a column nobody can be working.

The assignee is the one record of who owns a ticket. Workers are live
runners plus HT Design Builder and Speed Runner. Tickets being built (In
Progress, AI Review) never outnumber workers; QA has its own cap.

Per ticket, from the board and the ticket's own agent log:
  In Progress  OK only when its assigned worker is live, holds no other ticket
               being built, and the log moved in the last few hours.
               Otherwise NO-OWNER, DEAD-RUNNER, NOT-A-RUNNER, DOUBLE or STALE.
  QA           merged work waiting for its live proof. Over a day: the runner
               left before shipping.
  AI Review    a PR waiting for review. Over a few hours: nobody drives it.
  Agent Blocked  only real tool or server failures, cleared fast. Over a day.
Column totals are checked against the live runner count.

Brain tags: every open ticket carries one of brain-light, brain-medium,
brain-hard or brain-extra-hard, so the runner picks the right brain. Counts
open tickets without one, per column. Done and flag columns are skipped.

CI blocks: CI Boss owns CI on board 11514. A ticket blocked by CI links an
Urgent HYCI ticket in its log. CI-WAIT lists those; CI-SLOW marks a CI ticket
open over 6 hours, not Urgent or not In Progress; CI-DONE means CI is fixed
but the ticket still waits; CI-NO-TICKET is a CI failure blocker with no CI
ticket, so CI Boss never hears of it.

Valentin, 2026-11-05: "20 tickets in progress. That's impossible. We don't
have that many runners."

usage: flow-check [--board 15] [--json PATH] [--self-test]
Read-only. It flags; the board lead moves tickets.
"""
import argparse
import json
import re
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor
from datetime import datetime, timezone

# board: (runner tmux prefix and agent name pattern, columns with their limits in hours)
BOARDS = {
    15: {
        "runners": [("ht-or-runner-", "Runner {n}")],
        "in_progress": "In Progress",
        "waits": {"QA": 24, "AI Review": 6, "Agent Blocked (Infra)": 24},
        "blocked_cap": 5,
        "qa_cap": 15,
    },
    4060: {
        "runners": [("infra-runner-", "Infra Runner {n}")],
        "in_progress": "In Progress",
        "waits": {"AI Review": 6, "Agent Blocked": 24},
        "blocked_cap": 5,
    },
    11514: {
        "runners": [("ht-ci-runner-", "CI Runner {n}")],
        "in_progress": "In Progress",
        "waits": {"AI Review": 6},
        "blocked_cap": 5,
    },
}
ACTIVE_HOURS = 3
BRAINS = {"brain-light", "brain-medium", "brain-hard", "brain-extra-hard"}
SHIPPED = re.compile(r"^(done|flag:|no flag)", re.I)
CLAIM = re.compile(r"^\s*(?:\S+\s+){0,3}claimed\b", re.I)
CI_SLOW_HOURS = 6
CI_REF = re.compile(r"\bHYCI-(\d+)\b|project-11514/(\d+)")
BLOCKER = re.compile(r"^\W*(blocker|blocked|waiting on ci|ci block)", re.I)
CI_FAIL = re.compile(r"\b(ci|feature-flag-gate|test-shard\d*|visual regression|workflow|hosted (?:retry|run|check)\w*"
                     r"|github checks?|check runs?|required checks?)\b[^.]{0,80}"
                     r"\b(fail\w*|red|stuck|timed out|cancel\w*|queued)\b", re.I)


def ci_block(log):
    recent = []
    for a in log:
        recent.append(a.get("text") or "")
        if CLAIM.search((a.get("text") or "")[:60]):
            break
    for text in recent:
        m = CI_REF.search(text)
        if m:
            return "HYCI-" + (m.group(1) or m.group(2))
    newest_blocker = next((t for t in recent if BLOCKER.search(t)), "")
    return "NO-TICKET" if CI_FAIL.search(newest_blocker) else None


def ci_link(relations):
    """House rule 2026-11-06: the app ticket is linked BlockedBy its Fleet CI ticket on board 11514."""
    for rel in relations:
        other = rel.get("otherTask") or {}
        if other.get("projectId") == 11514 and "block" in (rel.get("relationType") or "").lower() \
                and (other.get("status") or "Normal") == "Normal":
            return other.get("ticketNumber")
    return None


def ci_verdict(ci_task, now):
    if not ci_task:
        return "CI-WAIT", None
    open_h = hours_since(ci_task.get("createdAt"), now)
    section = ci_task.get("section") or ""
    if SHIPPED.match(section) or ci_task.get("status") not in (None, "Normal"):
        return "CI-DONE", open_h
    urgent = ((ci_task.get("priority") or {}).get("Priority_Value") or "").lower() == "urgent"
    slow = (open_h or 0) > CI_SLOW_HOURS or not urgent or section != "In Progress"
    return ("CI-SLOW" if slow else "CI-WAIT"), open_h


def ht(*args):
    r = subprocess.run(["hypertask", "--json", *args], capture_output=True, text=True)
    try:
        return json.loads(r.stdout)
    except ValueError:
        return {}


def hours_since(stamp, now):
    try:
        return (now - datetime.fromisoformat(stamp.replace("Z", "+00:00"))).total_seconds() / 3600
    except (AttributeError, ValueError):
        return None


def live_runners(board):
    out = subprocess.run(["tmux", "ls", "-F", "#S"], capture_output=True, text=True).stdout.split()
    names = set()
    for prefix, pattern in BOARDS[board]["runners"]:
        for s in out:
            m = re.fullmatch(re.escape(prefix) + r"(\d+)", s)
            if m:
                names.add(pattern.format(n=m.group(1)).lower())
    return names


def column(board, name):
    tickets, offset = [], 0
    while True:
        page = ht("task", "list", "--project", str(board), "--section", name, "--status", "Normal",
                  "--limit", "100", "--offset", str(offset)).get("tasks", [])
        tickets += page
        if len(page) < 100:
            return tickets
        offset += 100


def open_tickets(board):
    tickets, offset = [], 0
    while True:
        page = ht("task", "list", "--project", str(board), "--status", "Normal",
                  "--limit", "100", "--offset", str(offset)).get("tasks", [])
        tickets += page
        if len(page) < 100:
            return [t for t in tickets if not SHIPPED.match(t.get("section") or "")]
        offset += 100


FEEDBACK_TITLE = re.compile(r"^(Agent feedback, |An agent's (MCP|API|CLI) call)")


def writer(t):
    """Which tool or login wrote the ticket: names the source to fix, not only the ticket."""
    if FEEDBACK_TITLE.match(t.get("title") or ""):
        return "app feedback reporter"
    log = ht("task", "agent-log", t["ticketNumber"]).get("activities") or []
    first = min(log, key=lambda a: a.get("createdAt") or "", default={})
    if first.get("agentName"):
        return first["agentName"]
    task = (ht("task", "get", t["ticketNumber"]).get("tasks") or [{}])[0]
    return ((task.get("createdBy") or {}).get("displayName") or "unknown") + " login"


def no_brain(tickets):
    return [t for t in tickets if not BRAINS & {(l.get("name") or "").lower() for l in t.get("labels") or []}]


def details(t):
    num = t["ticketNumber"]
    log = ht("task", "agent-log", num).get("activities", [])
    task = (ht("task", "get", num).get("tasks") or [{}])[0]
    return num, log, (task.get("staleness") or {}).get("sectionChangedAt") or t.get("updatedAt")


BUILDING = ("In Progress", "AI Review")
QUEUE = {"bugs", "improvements", "features", "backlog", "todo"}
WORKERS = {"ht design builder", "speed runner"}


def holder(t, live):
    """The assignee is the one record of ownership. Returns (kind, name): owned, orphan or outside."""
    agents = [a["agent"]["displayName"] for a in t.get("assignees") or [] if a.get("agent")]
    workers = [n for n in agents if n.lower().startswith(("runner ", "ci runner ")) or n.lower() in WORKERS]
    if not workers:
        return ("outside", agents[0]) if agents else ("orphan", "nobody assigned")
    alive = [n for n in workers if n.lower() in WORKERS or n.lower() in live]
    return ("owned", alive[0]) if alive else ("orphan", f"{workers[0]} not running")


def ownership(building, live):
    """One runner, one ticket being built. QA waits on its own cap."""
    owners, orphans, outside = {}, [], []
    for t in building:
        kind, who = holder(t, live)
        if kind == "owned":
            owners.setdefault(who, []).append(t["ticketNumber"])
        else:
            (orphans if kind == "orphan" else outside).append((t["ticketNumber"], who))
    workers_busy = sum(1 for w in owners if w.lower() in WORKERS)
    return {"active": len(building), "live": len(live) + workers_busy, "owners": owners, "orphans": orphans,
            "outside": outside, "doubles": {w: n for w, n in owners.items() if len(n) > 1},
            "idle_runners": sorted(r for r in live if r not in {o.lower() for o in owners})}


def in_progress_verdict(t, own, log, now):
    idle = hours_since(log[0].get("createdAt"), now) if log else None
    num = t["ticketNumber"]
    if own:
        hit = next((who for n, who in own["orphans"] if n == num), None)
        if hit:
            return ("NO-OWNER" if hit == "nobody assigned" else "DEAD-RUNNER"), hit, idle
        hit = next((who for n, who in own["outside"] if n == num), None)
        if hit:
            return "NOT-A-RUNNER", hit, idle
        who = next((w for w, nums in own["owners"].items() if num in nums), None)
        if who in own["doubles"]:
            return "DOUBLE", who, idle
    else:
        who = next((a["agent"]["displayName"] for a in t.get("assignees") or [] if a.get("agent")), None)
    if idle is None or idle > ACTIVE_HOURS:
        return "STALE", who, idle
    return "OK", who, idle


def run(board):
    cfg = BOARDS[board]
    now = datetime.now(timezone.utc)
    live = live_runners(board) if cfg["runners"] else None
    cols = {name: column(board, name) for name in [cfg["in_progress"], *cfg["waits"]]}
    with ThreadPoolExecutor(6) as ex:
        info = {num: (log, moved) for num, log, moved in ex.map(details, [t for ts in cols.values() for t in ts])}
    own = None
    if live is not None:
        own = ownership([t for c in BUILDING if c in cols for t in cols[c]], live)
    rows = []
    for t in cols[cfg["in_progress"]]:
        num = t["ticketNumber"]
        verdict, who, idle = in_progress_verdict(t, own, info[num][0], now)
        rows.append({"ticket": num, "column": cfg["in_progress"], "verdict": verdict, "holder": who,
                     "idle_h": idle, "title": t["title"]})
    for name, limit in cfg["waits"].items():
        for t in cols[name]:
            num = t["ticketNumber"]
            waited = hours_since(info[num][1], now)
            last = info[num][0][0] if info[num][0] else {}
            rows.append({"ticket": num, "column": name, "verdict": "OVERDUE" if waited and waited > limit else "OK",
                         "holder": last.get("agentName"), "idle_h": waited, "title": t["title"]})
    ci_rows, ci_boss_h = [], None
    if board != 11514:
        with ThreadPoolExecutor(6) as ex:
            linked = list(ex.map(lambda r: ci_link(ht("task", "relations", r["ticket"]).get("relations") or []), rows))
        found = [(r, link or ci_block(info[r["ticket"]][0]), bool(link)) for r, link in zip(rows, linked)]
        found = [f for f in found if f[1]]
        refs = sorted({ref for _, ref, _ in found if ref != "NO-TICKET"})
        with ThreadPoolExecutor(6) as ex:
            ci_tasks = dict(zip(refs, ex.map(lambda n: (ht("task", "get", n).get("tasks") or [None])[0], refs)))
        for r, ref, is_linked in found:
            verdict, open_h = ("CI-NO-TICKET", None) if ref == "NO-TICKET" else ci_verdict(ci_tasks.get(ref), now)
            if ref != "NO-TICKET" and not is_linked and verdict != "CI-DONE":
                verdict = "CI-NO-LINK"
            ci_rows.append({"ticket": r["ticket"], "column": r["column"], "verdict": verdict,
                            "ci_ticket": None if ref == "NO-TICKET" else ref, "ci_open_h": open_h,
                            "waited_h": r["idle_h"], "title": r["title"]})
        with ThreadPoolExecutor(6) as ex:
            ci_logs = list(ex.map(lambda n: ht("task", "agent-log", n).get("activities", []), refs))
        boss = max((a.get("createdAt") or "" for log in ci_logs for a in log
                    if (a.get("agentName") or "").lower() == "ci boss"), default="")
        ci_boss_h = hours_since(boss, now) if boss else None
    opened = open_tickets(board)
    bare = no_brain(opened)
    working = sum(1 for r in rows if r["column"] == cfg["in_progress"] and r["verdict"] == "OK")
    blocked = [c for c in cfg["waits"] if c.startswith("Agent Blocked")]
    summary = {
        "board": board,
        "live_runners": len(live) if live is not None else None,
        "in_progress": len(cols[cfg["in_progress"]]),
        "really_worked": working,
        "out_of_place": [r for r in rows if r["verdict"] != "OK"],
        "columns": {c: len(ts) for c, ts in cols.items()},
        "blocked_over_cap": bool(blocked) and len(cols[blocked[0]]) > cfg["blocked_cap"],
        "ci_blocked": ci_rows,
        "ci_boss_h": ci_boss_h,
        "ownership": own,
        "open": len(opened),
        "queue": sum(1 for t in opened if (t.get("section") or "").lower() in QUEUE),
        "no_brain": [{"ticket": t["ticketNumber"], "column": t.get("section"), "title": t["title"],
                      "writer": writer(t)} for t in bare],
        "qa": len(cols.get("QA", [])),
        "qa_cap": cfg.get("qa_cap"),
    }
    return rows, summary


def show(rows, s):
    url = "https://app.hypertask.ai/detail/project-{b}/{n}"
    for r in sorted(rows, key=lambda r: (r["column"], r["verdict"] == "OK", -(r["idle_h"] or 0))):
        if r["verdict"] == "OK":
            continue
        idle = f"{r['idle_h']:.0f}h" if r["idle_h"] is not None else "-"
        print(f"{r['verdict']:<11} {r['column']:<22} {idle:>5}  {(r['holder'] or '-')[:18]:<18} "
              f"{url.format(b=s['board'], n=r['ticket'].rsplit('-', 1)[1])}  {r['title'][:60]}")
    runners = "no runner pool" if s["live_runners"] is None else f"{s['live_runners']} live runners"
    print(f"COLUMNS board {s['board']}: " + ", ".join(f"{c} {n}" for c, n in s["columns"].items()))
    print(f"SUMMARY board {s['board']}: {s['in_progress']} In Progress, {s['really_worked']} really worked, "
          f"{runners}, {len(s['out_of_place'])} out of place"
          + (", Agent Blocked over cap" if s["blocked_over_cap"] else ""))
    if s["live_runners"] is not None and s["in_progress"] > s["live_runners"]:
        print(f"IMPOSSIBLE In Progress holds {s['in_progress']} tickets for {s['live_runners']} runners")
    o = s.get("ownership")
    if o:
        link = lambda n: url.format(b=s["board"], n=n.rsplit("-", 1)[1])
        print(f"WIP board {s['board']}: {o['active']} being built (In Progress, AI Review) for {o['live']} workers"
              + (" OVER" if o["active"] > o["live"] else ""))
        if s.get("qa_cap"):
            print(f"QA board {s['board']}: {s['qa']} merged, waiting for the live check, cap {s['qa_cap']}"
                  + (" OVER" if s["qa"] > s["qa_cap"] else ""))
        for num, why in o["orphans"]:
            print(f"ORPHAN       {link(num)}  {why}")
        for num, who in o["outside"]:
            print(f"NOT-A-RUNNER {link(num)}  held by {who}")
        for who, nums in o["doubles"].items():
            print(f"DOUBLE       {who} holds {len(nums)}: " + " ".join(link(n) for n in nums))
        if o["idle_runners"]:
            print(f"IDLE-RUNNERS {', '.join(o['idle_runners'])}")
    ci_url = "https://app.hypertask.ai/detail/project-11514/{n}"
    for r in sorted(s["ci_blocked"], key=lambda r: r["verdict"]):
        ci = ci_url.format(n=r["ci_ticket"].split("-")[1]) if r["ci_ticket"] else "no CI ticket"
        age = f"CI open {r['ci_open_h']:.0f}h" if r["ci_open_h"] is not None else ""
        print(f"{r['verdict']:<12} {r['column']:<22} {url.format(b=s['board'], n=r['ticket'].rsplit('-', 1)[1])}  "
              f"{ci}  {age}  {r['title'][:50]}")
    if s["ci_blocked"]:
        count = {}
        for r in s["ci_blocked"]:
            count[r["verdict"]] = count.get(r["verdict"], 0) + 1
        print(f"CI-BLOCKED board {s['board']}: {len(s['ci_blocked'])} tickets wait on CI: "
              + ", ".join(f"{v} {n}" for v, n in sorted(count.items())))
        h = s["ci_boss_h"]
        if any(r["ci_ticket"] for r in s["ci_blocked"]):
            seen = "never on these CI tickets" if h is None else f"last note {h:.0f}h ago on these CI tickets"
            quiet = h is None or h > CI_SLOW_HOURS
            print(f"{'CI-BOSS-QUIET' if quiet else 'CI-BOSS'}: {seen}")
    by_col = {}
    for t in s["no_brain"]:
        by_col[t["column"]] = by_col.get(t["column"], 0) + 1
    print(f"NO-BRAIN board {s['board']}: {len(s['no_brain'])} of {s['open']} open tickets have no brain tag"
          + (": " + ", ".join(f"{c} {n}" for c, n in sorted(by_col.items(), key=lambda x: -x[1])) if by_col else ""))


def self_test():
    now = datetime(2026, 11, 5, 22, 0, tzinfo=timezone.utc)
    fresh, old = "2026-11-05T21:30:00Z", "2026-11-01T10:00:00Z"
    live = {"runner 1", "runner 2"}
    claim = lambda who, at: {"agentName": who, "createdAt": at, "text": "Claimed. Session working it now."}
    note = lambda who, at: {"agentName": who, "createdAt": at, "text": "Plan: reproduce"}
    tk = lambda num, *names: {"ticketNumber": num, "assignees": [{"agent": {"displayName": n}} for n in names]}
    board = [tk("A", "Runner 1"), tk("B", "Runner 1"), tk("C", "Runner 12"), tk("D"), tk("E", "HT Design Builder"),
             tk("F", "HT Product Lead"), tk("G", "Speed Runner")]
    o = ownership(board, live)
    assert o["doubles"] == {"Runner 1": ["A", "B"]}, o
    assert o["orphans"] == [("C", "Runner 12 not running"), ("D", "nobody assigned")], o
    assert o["outside"] == [("F", "HT Product Lead")], "design builder or speed runner counted as outsiders"
    assert o["idle_runners"] == ["runner 2"] and o["active"] == 7 and o["live"] == 4, o
    o2 = ownership([tk("A", "Runner 1"), tk("B")], live)
    assert o2["doubles"] == {}, "unassigning a runner must clear its double at once"
    assert in_progress_verdict(tk("A", "Runner 1"), o, [note("Runner 1", fresh)], now)[0] == "DOUBLE"
    assert in_progress_verdict(tk("C", "Runner 12"), o, [claim("Runner 12", fresh)], now)[0] == "DEAD-RUNNER"
    assert in_progress_verdict(tk("D"), o, [claim("Runner 2", fresh)], now)[0] == "NO-OWNER", "old claim note used as owner"
    assert in_progress_verdict(tk("A", "Runner 1"), o2, [note("Runner 1", fresh)], now)[0] == "OK"
    assert in_progress_verdict(tk("A", "Runner 1"), o2, [note("Runner 1", old)], now)[0] == "STALE"
    tag = lambda *names: {"labels": [{"name": n} for n in names]}
    assert no_brain([tag("Bug"), tag("Bug", "Brain-Hard"), tag(), {"labels": None}]) == [tag("Bug"), tag(), {"labels": None}]
    assert [bool(SHIPPED.match(c)) for c in ("Done", "Flag: Everyone", "No Flag", "Bugs", "QA")] == [True, True, True, False, False]
    entry = lambda text: {"text": text}
    assert ci_block([entry("Blocker: waiting on https://app.hypertask.ai/detail/project-11514/133"), claim("Runner 1", old)]) == "HYCI-133"
    assert ci_block([entry("Blocker: hosted feature-flag-gate failed again"), claim("Runner 1", old)]) == "NO-TICKET"
    assert ci_block([entry("Plan: fix the test"), claim("Runner 1", old)]) is None
    assert ci_block([entry("Blocker: Vercel env returns 403, the ship gate fails"), claim("Runner 1", old)]) is None
    assert ci_block([claim("Runner 1", fresh), entry("Blocker: see HYCI-9")]) is None, "CI link before the claim counted"
    rel = lambda kind, board, num, status="Normal": {"relationType": kind, "otherTask": {"projectId": board, "ticketNumber": num, "status": status}}
    assert ci_link([rel("RelatedTo", 11514, "HYCI-1"), rel("BlockedBy", 11514, "HYCI-2")]) == "HYCI-2"
    assert ci_link([rel("BlockedBy", 15, "HTPR-1"), rel("BlockedBy", 11514, "HYCI-3", "Archive")]) is None
    task = lambda h, sec="In Progress", pri="Urgent": {"createdAt": f"2026-11-05T{22 - h:02d}:00:00Z", "section": sec,
                                                       "status": "Normal", "priority": {"Priority_Value": pri}}
    assert ci_verdict(task(1), now)[0] == "CI-WAIT"
    assert ci_verdict(task(8), now)[0] == "CI-SLOW"
    assert ci_verdict(task(1, pri="Normal"), now)[0] == "CI-SLOW"
    assert ci_verdict(task(1, sec="Later (parked)"), now)[0] == "CI-SLOW"
    assert ci_verdict(task(1, sec="Done"), now)[0] == "CI-DONE"
    print("SELF_TEST_OK")


def main():
    p = argparse.ArgumentParser()
    p.add_argument("--board", type=int, default=15, choices=sorted(BOARDS))
    p.add_argument("--json")
    p.add_argument("--self-test", action="store_true")
    a = p.parse_args()
    if a.self_test:
        return self_test()
    rows, summary = run(a.board)
    show(rows, summary)
    if a.json:
        json.dump({"rows": rows, "summary": summary}, open(a.json, "w"), indent=1, default=str)


if __name__ == "__main__":
    sys.exit(main())
