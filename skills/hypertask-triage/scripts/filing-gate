#!/usr/bin/env python3
"""Cut self-maintenance tickets at the source: vcc asks this before every new ticket on Fleet CI & Infra.

Valentin, 2026-11-08: "210 tickets to build 3 apps!!!!!!!!!! that is insane".

On board 11514 (Fleet CI & Infra):
1. An open ticket with a near-duplicate title exists: add a +1 note to its agent lane, print its link, file nothing.
2. The board holds its backlog cap (2 open tickets per live pool runner, the pileup-watch cap) or more:
   file nothing.
Board 4060 (old Fleet Infra) is archived (Valentin, 8 Nov): a ticket for it is refused, file on 11514.
A ticket labelled Incident skips both: outage filers (production-red-alert, fleet-watch) keep their own dedupe.
Any other board, or any other command: allowed, no network call.
A board read that fails lets the ticket through with a warning, so a rate limit never blocks an outage.

usage: filing-gate [--dry-run] [--who NAME] -- <vcc arguments>
exit 0 file it, 5 refused (over cap), 6 not filed (duplicate, +1 added). FILING_GATE_DRY_RUN=1 = --dry-run:
print the decision, write nothing.
"""
import argparse
import importlib.machinery
import json
import os
import re
import subprocess
import sys
import time
from datetime import datetime, timezone

HERE = os.path.dirname(os.path.abspath(__file__))
pileup = importlib.machinery.SourceFileLoader("pileup_watch", os.path.join(HERE, "pileup-watch")).load_module()
dupes = importlib.machinery.SourceFileLoader("board_dupes", os.path.join(HERE, "board-dupes")).load_module()

BOARDS = {11514: "Fleet CI & Infra"}
RETIRED = {4060: 11514}
SAME = 0.6  # board-dupes default
RUNNER_CACHE = os.path.expanduser("~/.local/state/filing-gate/runners.json")
RUNNER_CACHE_SECONDS = 900
URL = "https://app.hypertask.ai/detail/project-{board}/{number}"
REFUSE, DUPLICATE = 5, 6


def create_args(argv):
    """(board, title, labels) for a vcc task create, else None."""
    words, flags, i = [], {}, 0
    while i < len(argv):
        arg = argv[i]
        if arg.startswith("--"):
            name, eq, value = arg[2:].partition("=")
            if eq:
                flags.setdefault(name, []).append(value)
            elif name in ("json", "human", "markdown", "help") or i + 1 >= len(argv):
                flags.setdefault(name, []).append("")
            else:
                flags.setdefault(name, []).append(argv[i + 1])
                i += 1
        else:
            words.append(arg)
        i += 1
    if words[:2] not in (["task", "create"], ["tasks", "create"]) or "help" in flags:
        return None
    try:
        board = int(flags.get("project", [""])[-1])
    except ValueError:
        return None
    labels = {l.strip().lower() for v in flags.get("labels", []) for l in v.split(",") if l.strip()}
    return board, flags.get("title", [""])[-1], labels


def live_runners():
    try:
        cached = json.load(open(RUNNER_CACHE))
        if time.time() - cached["at"] < RUNNER_CACHE_SECONDS:
            return cached["runners"]
    except (OSError, ValueError, KeyError):
        pass
    runners = pileup.live_runner_count()
    os.makedirs(os.path.dirname(RUNNER_CACHE), exist_ok=True)
    json.dump({"at": time.time(), "runners": runners}, open(RUNNER_CACHE, "w"))
    return runners


def numbers(title):
    return set(re.findall(r"\d+", title))


def score(a, b):
    """board-dupes word overlap; titles naming different numbers (board 15 vs board 2060) never match."""
    wa, wb = dupes.words(a), dupes.words(b)
    if not wa or not wb or numbers(a) != numbers(b):
        return 0.0
    return len(wa & wb) / len(wa | wb)


def link(board, t):
    return URL.format(board=board, number=t["uniqueIndex"])


def main():
    p = argparse.ArgumentParser()
    p.add_argument("--dry-run", action="store_true", default=os.environ.get("FILING_GATE_DRY_RUN") == "1")
    p.add_argument("--who", default=os.environ.get("SHIP_SESSION_NAME") or "an agent")
    p.add_argument("args", nargs=argparse.REMAINDER)
    a = p.parse_args()
    args = a.args[1:] if a.args[:1] == ["--"] else a.args
    parsed = create_args(args)
    if parsed and parsed[0] in RETIRED and "incident" not in parsed[2]:
        print(f"REFUSE board {parsed[0]} is archived: file on board {RETIRED[parsed[0]]} (Fleet CI & Infra)")
        return REFUSE
    if not parsed or parsed[0] not in BOARDS:
        return 0
    board, title, labels = parsed
    name = f"{BOARDS[board]} ({board})"
    if "incident" in labels:
        if a.dry_run:
            print(f"ALLOW incident on {name}")
        return 0
    tickets = [t for t in pileup.column_tickets(board, None) if t.get("section") != "Done"]
    if not tickets:
        print(f"filing-gate: {name} read back no open tickets; not checked", file=sys.stderr)
        return 0

    best = max(((score(title, t.get("title") or ""), t) for t in tickets), key=lambda x: x[0], default=(0.0, None))
    if best[0] >= SAME:
        t = best[1]
        url = link(board, t)
        note = (f"+1 from {a.who} {datetime.now(timezone.utc):%Y-%m-%d}: tried to file \"{title}\". "
                "filing-gate added this note instead of a second ticket.")
        if a.dry_run:
            print(f"+1 {t['ticketNumber']} {url} (match {best[0]:.2f}: {t.get('title')})")
        else:
            r = subprocess.run(["vcc", "activity", "add", t["ticketNumber"], note], capture_output=True, text=True)
            if r.returncode:
                print(f"filing-gate: +1 note failed: {(r.stderr or r.stdout).strip()[:200]}", file=sys.stderr)
        print(f"vcc: not filed. The same problem is already open on {name}: {t['ticketNumber']} \"{t.get('title')}\" "
              f"{url}\n{'Dry run: no note added.' if a.dry_run else 'A +1 note went to its agent lane.'} Add your detail there: vcc activity add {t['ticketNumber']} "
              "\"<what you saw>\". Link your app ticket BlockedBy it if it blocks you.", file=sys.stderr)
        return DUPLICATE

    counted = [t for t in tickets if "incident" not in {l["name"].lower() for l in t.get("labels", [])}]
    runners = live_runners()
    cap = pileup.BACKLOG_PER_RUNNER * runners
    if len(counted) < cap:
        if a.dry_run:
            print(f"ALLOW {name} open {len(counted)}/{cap}")
        return 0
    close = sorted(((score(title, t.get("title") or ""), t) for t in counted), key=lambda x: -x[0])[:3]
    hint = "".join(f"\n  {t['ticketNumber']} \"{t.get('title')}\" {link(board, t)}" for s, t in close if s > 0)
    if a.dry_run:
        print(f"REFUSE {name} open {len(counted)}/{cap}")
    print(f"vcc: not filed. {name} is full: {len(counted)} open tickets, cap {cap} (2 per live runner, "
          f"{runners} runners). Valentin, 2026-11-08: \"210 tickets to build 3 apps!!!!!!!!!! that is insane\".\n"
          "Do this instead: search the board and +1 the open ticket for the same problem with "
          "vcc activity add <ticket> \"<what you saw>\", or wait until the board drops under its cap." + (f"\nClosest open tickets:{hint}" if hint else ""),
          file=sys.stderr)
    return REFUSE


if __name__ == "__main__":
    sys.exit(main())
