#!/usr/bin/env python3
"""Refuse tickets on archived boards using their live project status.

Board 4060 remains refused even when its lookup fails.
A failed board read warns and allows filing, so outages can still be reported.
Ticket readiness warnings never block filing.

usage: filing-gate [--dry-run] [--who NAME] -- <vcc arguments>
exit 0 file it, 5 refused (archived board).
"""
import argparse
import json
import importlib.machinery
import os
import subprocess
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
REFUSE = 5

def create_args(argv):
    """(board, title, labels) for a vcc task create, else None."""
    words, flags, i = [], {}, 0
    while i < len(argv):
        arg = argv[i]
        if arg.startswith("--"):
            name, eq, value = arg[2:].partition("=")
            if eq:
                flags.setdefault(name, []).append(value)
            elif name in ("json", "human", "markdown", "help") or i + 1 >= len(argv):
                flags.setdefault(name, []).append("")
            else:
                flags.setdefault(name, []).append(argv[i + 1])
                i += 1
        else:
            words.append(arg)
        i += 1
    if words[:2] not in (["task", "create"], ["tasks", "create"]) or "help" in flags:
        return None
    try:
        board = int(flags.get("project", [""])[-1])
    except ValueError:
        return None
    labels = {l.strip().lower() for v in flags.get("labels", []) for l in v.split(",") if l.strip()}
    return board, flags.get("title", [""])[-1], labels


def ready_warning(argv):
    """ticket-ready's warning for a new ticket that would be Not Ready, or "". Never raises: a broken check lets the ticket through."""
    try:
        ready = importlib.machinery.SourceFileLoader("ticket_ready", os.path.join(HERE, "ticket-ready")).load_module()
        return ready.check_create(argv)
    except Exception as e:  # noqa: BLE001
        print(f"filing-gate: ticket-ready check skipped ({type(e).__name__}: {e})", file=sys.stderr)
        return ""


def board_status(board):
    result = subprocess.run(["hypertask", "project", "show", str(board), "--json"],
                            capture_output=True, text=True, timeout=30)
    result.check_returncode()
    return json.loads(result.stdout)["project"]["status"]


def self_test():
    from contextlib import redirect_stdout, redirect_stderr
    from io import StringIO
    from unittest.mock import patch
    for board, status, labels, expected in (
        (11514, "Archive", "", REFUSE),  # HYCI-233 was wrongly filed here.
        (11514, "Archive", "Incident", REFUSE),
        (98765, "Archive", "", REFUSE),
        (4060, "Normal", "Incident", REFUSE),
        (15, "Normal", "", 0),
        (2060, "Normal", "Incident", 0),
    ):
        argv = ["filing-gate", "--", "task", "create", "--project", str(board),
                "--title", "HYCI-233 regression", "--labels", labels]
        output = StringIO()
        with patch.object(sys, "argv", argv), patch.dict(globals(), board_status=lambda _: status, ready_warning=lambda _: ""), redirect_stdout(output):
            assert main() == expected
        if expected == REFUSE:
            assert output.getvalue().strip() == f"REFUSE board {board} is archived: file on your own board"
    with patch.object(sys, "argv", ["filing-gate", "--", "task", "create", "--project", "15"]), patch.dict(globals(), ready_warning=lambda _: ""), patch("subprocess.run", side_effect=OSError("offline")), redirect_stderr(StringIO()) as warning:
        assert main() == 0
        assert "board 15 read failed" in warning.getvalue()
    with patch("subprocess.run", return_value=subprocess.CompletedProcess([], 0, '{"project":{"status":"Archive"}}', "")) as lookup:
        assert board_status(11514) == "Archive"
        assert lookup.call_args.args[0] == ["hypertask", "project", "show", "11514", "--json"]
    print("filing-gate self-test ok: HYCI-233, archived boards, incidents, 4060, active boards, lookup failure")


def main():
    p = argparse.ArgumentParser()
    p.add_argument("--self-test", action="store_true")
    p.add_argument("--dry-run", action="store_true", default=os.environ.get("FILING_GATE_DRY_RUN") == "1")
    p.add_argument("--who", default=os.environ.get("SHIP_SESSION_NAME") or "an agent")
    p.add_argument("args", nargs=argparse.REMAINDER)
    a = p.parse_args()
    if a.self_test:
        return self_test()
    args = a.args[1:] if a.args[:1] == ["--"] else a.args
    parsed = create_args(args)
    if parsed:
        board = parsed[0]
        status = None
        if board != 4060:
            try:
                status = board_status(board)
            except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError) as error:
                print(f"filing-gate: board {board} read failed ({error}); not checked", file=sys.stderr)
        if board == 4060 or status == "Archive":
            print(f"REFUSE board {board} is archived: file on your own board")
            return REFUSE
    if parsed:
        warning = ready_warning(args)
        if warning:
            print(warning, file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
