#!/usr/bin/env python3
"""File feedback about Hypertask itself on board 15, as the agent you are.

Hit something wrong, slow, confusing or missing in Hypertask (app, CLI, MCP,
API, vcc)? File it, then carry on. One open ticket per problem: a repeat adds a
+1 note instead of a second ticket. Your note is cleaned first (no links,
emails, keys or long numbers) and lands in the agent lane; the ticket title
holds its short form.

Valentin, 2026-11-02: "agents workign with hypertask cli or otherwise can file
FEEDBACK for us on board 15". Interim lever until HTPR-8275 makes
`hypertask feedback --kind` native (YPER4-1001).

usage: agent-feedback --kind bug|friction|missing|idea --tool NAME [--detail TEXT] [--dry-run] "plain summary"

The summary becomes the ticket title: plain words a product owner reads, no
flags, field names or code. Technical bits go in --detail (agent lane).
"""
import argparse
import difflib
import json
import re
import subprocess
import sys
import tempfile

BOARD = 12057
LABEL = "ai-feedback"
SECTION = {"bug": "34534", "friction": "34534", "missing": "34534", "idea": "34534"}
# Our own agent tools are not Hypertask: their reports go to board HT Agent Feedback (Valentin 2026-11-05).
OWN_BOARD, OWN_SECTION, OWN_LABEL = 12057, "34534", "Agent Feedback"
# One label per cluster (Valentin 2026-11-05). First match wins.
CLUSTERS = [
    ("Flag Switch", r"turn.*off|off order|safety switch|thumbs|left off|un-park|ht-flag"),
    ("Cross-Board Access", r"ci board|ci ticket|ci problem|another board|board 2060|non-member|software factory"),
    ("Agent Log", r"activity|agent note|agent log|agent lane|--text|help"),
    ("Design Review Loop", r"design|corner"),
    ("Claim And Pickup", r"claim|resum|pick|hold|protected|lead merge|ship-claim|pr-drain-pick"),
    ("Comment Lint", r"comment|lint|voice|sentence|word|robot status|description|validator"),
    ("Proof Gates", r"proof|gate|deeper|ledger|cleanup"),
    ("Ship Check And Guards", r"guard|hook|ship-check|bind|deploy|move|release"),
    ("HTML Pages", r"html|page|report|picture|upload"),
]
OWN_TOOLS = {"vcc", "ship", "ship-check", "ship-claim", "ship-gates", "guard", "pr-drain-pick", "ticket-lint",
             "ht-flag", "dispatch", "hax", "pileup-watch", "agent-feedback", "blocker-sweep", "gate-check",
             "token-ladder", "stack-key", "tl-launch", "runner"}
WHAT = {
    "bug": "Something in Hypertask gave a wrong result or failed.",
    "friction": "Something in Hypertask worked, but slowed the agent down.",
    "missing": "The agent needed something Hypertask does not offer.",
    "idea": "The agent has an idea to make Hypertask better.",
}
CREDENTIAL = re.compile(r"vck_|httk_|htk_|htmk_|eyJ|ghp_|gho_|github_pat_|xox[abp]-|\bsk[-_]|Bearer\s", re.I)


def clean(note):
    note = re.sub(r"\b[^\s<>@]+@[^\s<>@]+\.[^\s<>@]+", " ", note)
    note = re.sub(r"\b(?:[a-z][a-z0-9+.-]*://|www\.)\S+", " ", note, flags=re.I)
    note = re.sub(r"\b[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\b", " ", note, flags=re.I)
    note = re.sub(r"\d{5,}|\S{40,}", " ", note)
    return re.sub(r"\s+", " ", note.replace("—", "-")).strip()[:300]


def key(text):
    return re.sub(r"[^a-z0-9 ]", "", text.lower()).strip()


def title_for(kind, note):
    short = note if len(note) <= 64 else note[:61].rsplit(" ", 1)[0] + "..."
    return f"Agent feedback, {kind}: {short}"


def run(*args):
    return subprocess.run(list(args), capture_output=True, text=True)


def own_tool(tool):
    return tool.strip().split(" ")[0].lower() in OWN_TOOLS


def open_feedback(board=BOARD, label=LABEL):
    tickets = []
    while True:
        r = run("hypertask", "task", "list", "--project", str(board), "--label", label,
                "--status", "Normal", "--limit", "100", "--offset", str(len(tickets)), "--json")
        try:
            page = json.loads(r.stdout).get("tasks", [])
        except ValueError:
            sys.exit(f"agent-feedback: cannot read board {board}: {(r.stderr or r.stdout).strip()[:200]}")
        tickets += page
        if len(page) < 100:
            return tickets


def same(note, title):
    gist = key(re.sub(r"^Agent feedback, \w+: ", "", title).removesuffix("..."))
    want = key(note)[:len(gist)] if title.endswith("...") else key(note)
    return difflib.SequenceMatcher(None, want, gist).ratio()


STOP = {"hypertask", "the", "a", "an", "for", "of", "on", "in", "to", "command", "cli", "board", "my",
        "htpr", "yper4", "hyci", "igsh"}


def cluster(text):
    return next((name for name, pat in CLUSTERS if re.search(pat, text.lower())), "CLI Rough Edges")


def stems(text):
    return {w.rstrip("s") for w in re.findall(r"[a-z0-9_]+", re.sub(r"--\S+", " ", text.lower()))
            if w not in STOP and not w.isdigit()}


def cli_commands():
    r = run("hypertask", "capabilities", "--json")
    try:
        tree = json.loads(r.stdout)
    except ValueError:
        return []
    paths = []

    def walk(node, prefix):
        for c in node.get("commands") or []:
            for name in [c["name"], *(c.get("aliases") or [])]:
                path = f"{prefix} {name}".strip()
                paths.append((path if name == c["name"] else f"{prefix} {c['name']}".strip(), stems(path)))
            walk(c, f"{prefix} {c['name']}".strip())
    walk(tree, "")
    return paths


def where(tool, catalog=None):
    # Agents name one command many ways ("section list for a board"); snap it to the CLI's own catalog.
    words = stems(tool)
    if catalog and not tool.strip().startswith(("hypertask_", "vcc")):
        score, path = max(((len(words & s) / len(words | s), p) for p, s in catalog if s), default=(0, ""))
        if score >= 0.5:
            return path
    return " ".join(sorted(words))


def recorded_where(ticket, catalog):
    m = re.search(r"It happened in ([^<]*?)\.<", ticket.get("description") or "")
    return where(m.group(1), catalog) if m else ""


def duplicate(kind, place, note, tickets, catalog):
    # Agents word one problem many ways; like the app's fingerprint, kind plus place decides.
    for t in tickets:
        if t.get("title", "").startswith(f"Agent feedback, {kind}:") and recorded_where(t, catalog) == place:
            return t
    best = max(tickets, key=lambda t: same(note, t.get("title", "")), default=None)
    return best if best and same(note, best.get("title", "")) >= 0.8 else None


URGENCY = [(6, "urgent"), (3, "high")]


def bump_comment(ticket):
    # Valentin 2026-11-05: repeats show as comments, so many comments means urgent.
    number = ticket["ticketNumber"]
    with tempfile.NamedTemporaryFile("w", suffix=".md", delete=False) as f:
        f.write("**+1. Another agent hit this problem.**\n")
    run("vcc", "comment", "add", number, "--kind", "qa", "--markdown", "--file", f.name)
    count = int(ticket.get("totalComments") or 0) + 1
    level = next((p for n, p in URGENCY if count >= n), None)
    if level and str((ticket.get("priority") or {}).get("Priority_Value", "")).lower() != level:
        run("vcc", "task", "update", number, "--priority", level)


def description(kind, tool):
    where = f"It happened in {tool}."
    return "\n".join([
        "**Now**", f"- {WHAT[kind]}", f"- {where}",
        "- The agent's note is in the agent log.", "",
        "**Problem**", "- Agents lose time on it. Customer agents will too.", "",
        "**Fix**", "- Read the note. Reproduce it. Fix the cause.", "",
        "**Done when**", "- The agent's case works. A test proves it.", "",
        "**Risk:** low. Undo: roll back the fix.", "",
        "**Decision:** none.", "",
    ])


def main():
    p = argparse.ArgumentParser(description="File agent feedback on board 12057 HT Agent Feedback.")
    p.add_argument("--kind", required=True, choices=sorted(SECTION))
    p.add_argument("--tool", required=True, help="the exact command, MCP tool or screen: 'sections list', 'hypertask_comments', 'inbox'")
    p.add_argument("--dry-run", action="store_true")
    p.add_argument("--detail", default="", help="technical detail for the agent lane: command, field, error")
    p.add_argument("--same", type=int, metavar="N", help="ticket number on the board that already reports this problem")
    p.add_argument("--new", action="store_true", help="you read the closest open tickets and none is this problem")
    p.add_argument("note", metavar="summary")
    a = p.parse_args()
    if CREDENTIAL.search(a.note + " " + a.detail):
        sys.exit("agent-feedback: the note looks like it holds a key; rewrite it without one")
    note = clean(a.note)
    if len(note) < 12:
        sys.exit("agent-feedback: say what happened in a short sentence")
    tool = clean(a.tool)[:40]
    if not stems(tool) - {"app", "mcp", "api", "web"}:
        sys.exit("agent-feedback: --tool must name the exact command, MCP tool or screen, like 'sections list' or 'inbox'")
    detail = clean(a.detail)
    lane = f"{note} Detail: {detail}" if detail else note
    catalog = cli_commands()
    own = own_tool(tool)
    board, section, label = (OWN_BOARD, OWN_SECTION, OWN_LABEL) if own else (BOARD, SECTION[a.kind], LABEL)
    place = where(tool, None if own else catalog)
    pool = [t for t in open_feedback(board, label) if t.get("title", "").startswith("Agent feedback")]
    found = next((t for t in pool if t.get("uniqueIndex") == a.same), None) if a.same else duplicate(a.kind, place, note, pool, catalog)
    if a.same and not found:
        sys.exit(f"agent-feedback: no open feedback ticket {a.same} on board {board}")
    if not found and not a.new:
        topic = f"Feedback: {cluster(tool + ' ' + note)}"
        words = stems(note)
        def near(t):
            title = stems(t.get("title", ""))
            on_topic = any(l.get("name") == topic for l in t.get("labels", []))
            return (on_topic, len(words & title) / (len(words | title) or 1))
        close = sorted(pool, key=near, reverse=True)[:8]
        print("agent-feedback: check these open tickets first. Same problem? Rerun with --same N. None? Rerun with --new.")
        for t in close:
            print(f"  {t['uniqueIndex']}  https://app.hypertask.ai/detail/project-{board}/{t['uniqueIndex']}  {t.get('title', '')[:110]}")
        sys.exit(2)
    if found:
        url = f"https://app.hypertask.ai/detail/project-{board}/{found['uniqueIndex']}"
        if not a.dry_run:
            r = run("vcc", "activity", "add", found["ticketNumber"], f"agent-feedback +1 ({a.kind}{', ' + tool if tool else ''}): {lane}")
            if r.returncode:
                sys.exit(f"agent-feedback: bump failed: {(r.stderr or r.stdout).strip()[:200]}")
            bump_comment(found)
        print(f"{'would bump' if a.dry_run else 'bumped'} {found['ticketNumber']} {url}")
        return
    title = title_for(a.kind, note)
    if a.dry_run:
        print(f"would file on board {board} section {section}: {title}")
        return
    labels = f"Infra,{label},Feedback: {cluster(tool + ' ' + note)}" if own else f"{label},Feedback: App"
    with tempfile.NamedTemporaryFile("w", suffix=".md", delete=False) as f:
        f.write(description(a.kind, place))
    r = run("vcc", "task", "create", "--project", str(board), "--section", section,
            "--priority", "medium", "--labels", labels, "--title", title, "--description-file", f.name, "--markdown")
    try:
        made = json.loads(r.stdout.splitlines()[0])
        ticket = (made.get("task") or made.get("tasks", [{}])[0])["ticketNumber"]
    except (ValueError, IndexError, KeyError, TypeError):
        why = (r.stdout or r.stderr).strip()[:300]
        hint = "\nRewrite the summary in plain words; move flags, fields and code to --detail." if "title" in why else ""
        sys.exit(f"agent-feedback: filing failed: {why}{hint}")
    run("vcc", "activity", "add", ticket, f"agent-feedback ({a.kind}{', ' + tool if tool else ''}): {lane}")
    print(f"filed {ticket} https://app.hypertask.ai/detail/project-{board}/{ticket.split('-')[-1]}")


if __name__ == "__main__":
    main()
