#!/usr/bin/env python3
"""Catch board pile-ups before they grow.

Every waiting column has a cap. Over the cap, one urgent alarm ticket goes to
the alarm board, naming the column, the count, the oldest tickets and the
owner who must clear it. A rerun adds a count note to the open alarm instead
of filing a second one. Back under the cap: the alarm gets a note and goes to
Done.

Valentin, 2026-11-02: "this type of pile up is not acceptable".

Backlog cap (Valentin, 2026-11-08: "archive everything that we dont need to keep working"): the
self-maintenance board Fleet CI & Infra (11514) holds at most 2 open tickets per live pool
runner. Over it, the oldest tickets untouched for 7 days are archived (status Archive, reversible) with a note in
their agent lane, until the board is back under the cap. Never archived: Incident, In Progress / AI Review / QA,
open PR, waiting on a person, security, or a ticket an open app ticket on board 15 or 2060 is BlockedBy.

usage: pileup-watch [--caps 15:QA=15,11514:Agent Blocked=5] [--alarm-board 11514]
                    [--alarm-section 32923] [--done-section 32929] [--backlog-boards 11514] [--apply]
Without --caps it uses the Hypertask caps below. Other fleets pass their own.
"""
import os
import re
import argparse
import json
import subprocess
import sys
import tempfile
from datetime import datetime, timezone

# board: {column: (cap, owner)}. Columns where work waits on someone; home columns are not capped.
HT_CAPS = {
    15: {
        "Agent Blocked (Infra)": (5, "HT Product Lead"),
        "QA": (15, "runners via HT Product Lead"),
        "AI Review": (10, "HT Product Lead"),
        "Valentin Review": (10, "HT Product Lead"),
        "UX needed": (20, "HT Design Lead"),
        "UX Sign-off": (10, "HT Design Lead"),
        "Flag: Only Me + QA": (10, "HT Product Lead"),
        "In Progress": (15, "HT Product Lead"),
    },
    11514: {
        "Agent Blocked": (5, "CI Boss"),
        "AI Review": (10, "CI Boss"),
        "Valentin Review": (10, "CI Boss"),
        "In Progress": (15, "CI Boss"),
    },
}
STALE_DAYS = 3
BACKLOG_BOARDS = "11514"
BACKLOG_PER_RUNNER = 2
BACKLOG_UNTOUCHED_DAYS = 7
BACKLOG_MIN_RUNNERS = 5  # house rules: never under 5 runners
BUSY_SECTIONS = {"In Progress", "AI Review", "QA", "Done"}
APP_BOARDS = {15, 2060}
DONE_NOTE = "Archived from Done: fleet boards keep only open work (Valentin, 8 Nov). Undo: set status Normal."
BACKLOG_NOTE = ("Archived by the backlog cap: board over {cap} open tickets (2 per live runner), untouched {days} days. "
                "Valentin, 2026-11-08: archive what we do not need to keep working. Reopen if it happens again.")
PICK = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "..", "..", "fleet", "pick")
TITLE = "Pile-up: {column} on board {board}"


def ht(*args):
    r = subprocess.run(["hypertask", *args, "--json"], capture_output=True, text=True)
    try:
        return json.loads(r.stdout)
    except ValueError:
        return {}


def vcc(*args):
    return subprocess.run(["vcc", *args], capture_output=True, text=True)


def parse_caps(text):
    caps = {}
    for item in filter(None, (x.strip() for x in text.split(","))):
        board, rest = item.split(":", 1)
        column, cap = rest.rsplit("=", 1)
        caps.setdefault(int(board), {})[column] = (int(cap), "the board lead")
    return caps


def age_days(t, now):
    stamp = t.get("updatedAt") or t.get("createdAt") or ""
    try:
        return (now - datetime.fromisoformat(stamp.replace("Z", "+00:00"))).days
    except ValueError:
        return 0


def column_tickets(board, column):
    where = [] if column is None else ["--label", column[6:]] if column.startswith("label:") else ["--section", column]
    tickets, offset = [], 0
    while True:
        page = ht("task", "list", "--project", str(board), *where, "--status", "Normal",
                  "--limit", "100", "--offset", str(offset)).get("tasks", [])
        tickets += page
        if len(page) < 100:
            return tickets
        offset += len(page)


def open_alarm(alarm_board, done_section, title):
    found = ht("task", "search", title, "--project", str(alarm_board)).get("tasks", [])
    # Archive is a status, not a section: an archived alarm keeps its old section.
    return next((t for t in found if t.get("title") == title and t.get("section") not in ("Done", "Archive")
                 and t.get("status", "Normal") == "Normal"), None)


def description(board, column, count, cap, stale, owner):
    board_url = f"https://app.hypertask.ai/project?id={board}"
    lines = [
        "> this type of pile up is not acceptable",
        "",
        f"Valentin, 2026-11-02. Board: {board_url}",
        "",
        "**Now**",
        f"- {column} holds {count} tickets. The cap is {cap}.",
        f"- {len(stale)} of them waited over {STALE_DAYS} days.",
        "",
        "**Problem**",
        "- Work piles up there instead of moving.",
        "",
        "**Fix**",
        f"- Owner: {owner}.",
        "- Move each ticket to where it belongs, with a note.",
        "- Merged work gets a live check, then Done.",
        "- Design goes to UX needed. His call gets one Question.",
        "- Waiting on a ticket or date goes home, with a link.",
        "",
        "**Done when**",
        f"- The column holds {cap} tickets or fewer.",
        "",
        "**Risk:** a ticket lands in the wrong column. Undo: move it back.",
        "",
        "**Decision:** none.",
    ]
    return "\n".join(lines) + "\n"


def oldest(stale, board, n=10):
    return ", ".join(f"https://app.hypertask.ai/detail/project-{board}/{t['uniqueIndex']} ({d}d)" for d, t in stale[:n])


def live_runner_count():
    """Live pool runners, read from the same place the WIP cap reads them (fleet/pick --wip)."""
    try:
        out = subprocess.run([PICK, "--wip"], capture_output=True, text=True, timeout=300).stdout
    except (OSError, subprocess.TimeoutExpired):
        out = ""
    m = re.search(r"^workers:(.*)$", out, re.M)
    n = len(re.findall(r"Runner \d+", m[1])) if m else 0
    return max(n, BACKLOG_MIN_RUNNERS)


def last_touch(t):
    st = t.get("staleness") or {}
    stamps = [st.get("lastCommentAt"), st.get("sectionChangedAt"), t.get("createdAt")]
    return max(datetime.fromisoformat(x.replace("Z", "+00:00")) for x in stamps if x)


def keep_reason(t):
    """Why the backlog cap must not archive t, or None."""
    labels = {l["name"].lower() for l in t.get("labels", [])}
    if "incident" in labels:
        return "incident"
    if t.get("section") in BUSY_SECTIONS:
        return "busy"
    if any(p.get("lifecycle") == "open" for p in t.get("pullRequests", [])):
        return "open PR"
    if t.get("waitingOnUserId"):
        return "waiting on a person"
    if any("security" in l or "secret" in l for l in labels) or "[security]" in t.get("title", "").lower():
        return "security"
    if t.get("title", "").startswith(("Pile-up:", "Board health:")):
        return "alarm, closed by its own watcher"
    for r in ht("task", "relations", t["ticketNumber"]).get("relations", []):
        o = r.get("otherTask") or {}
        if r.get("relationType") == "BlockedBy" and r.get("direction") == "incoming" and o.get("projectId") in APP_BOARDS:
            g = (ht("task", "get", str(o["uniqueIndex"]), "--project", str(o["projectId"]),
                    "--fields", "section,status").get("tasks") or [{}])[0]
            if g.get("status") == "Normal" and g.get("section") != "Done":
                return f"blocks {o.get('ticketNumber')}"
    return None


def backlog_cap(boards, apply, now):
    runners = live_runner_count()
    cap = BACKLOG_PER_RUNNER * runners
    failed = 0
    for board in boards:
        done = [t for t in column_tickets(board, None) if t.get("section") == "Done"]
        print(f"{'archive' if done else 'ok':7} board {board:5} done {len(done)}: fleet boards keep only open work")
        for t in done if apply else []:
            r = vcc("task", "update", t["ticketNumber"], "--status", "Archive", "--project", str(board))
            if r.returncode == 0:
                r = vcc("activity", "add", t["ticketNumber"], DONE_NOTE)
            failed += r.returncode != 0
        tickets = [t for t in column_tickets(board, None) if t.get("section") != "Done"
                   and "incident" not in {l["name"].lower() for l in t.get("labels", [])}]
        over = len(tickets) - cap
        print(f"{'BACKLOG' if over > 0 else 'ok':7} board {board:5} open {len(tickets)}/{cap} (2 x {runners} runners)")
        if over <= 0:
            continue
        for t in sorted(tickets, key=lambda t: t.get("createdAt") or ""):
            if over <= 0:
                break
            full = (ht("task", "get", t["ticketNumber"]).get("tasks") or [{}])[0]
            if not full or (now - last_touch(full)).days < BACKLOG_UNTOUCHED_DAYS or keep_reason(full):
                continue
            over -= 1
            print(f"    archive {t['ticketNumber']} ({(now - last_touch(full)).days}d) {t['title'][:60]}")
            if not apply:
                continue
            r = vcc("task", "update", t["ticketNumber"], "--status", "Archive", "--project", str(board))
            if r.returncode == 0:
                r = vcc("activity", "add", t["ticketNumber"],
                        BACKLOG_NOTE.format(cap=cap, days=BACKLOG_UNTOUCHED_DAYS))
            failed += r.returncode != 0
        if over > 0:
            print(f"    {over} over cap with nothing safe to archive: the board lead clears it")
    return failed


def main():
    p = argparse.ArgumentParser()
    p.add_argument("--caps", default="")
    p.add_argument("--alarm-board", type=int, default=11514)
    p.add_argument("--alarm-section", default="32923")
    p.add_argument("--done-section", default="32929")
    p.add_argument("--labels", default="Infra")
    p.add_argument("--backlog-boards", default=BACKLOG_BOARDS, help="comma list; empty turns the backlog cap off")
    p.add_argument("--apply", action="store_true")
    a = p.parse_args()
    caps = parse_caps(a.caps) if a.caps else HT_CAPS
    now = datetime.now(timezone.utc)
    over = failed = 0
    for board, columns in caps.items():
        for column, (cap, owner) in columns.items():
            tickets = column_tickets(board, column)
            stale = sorted(((age_days(t, now), t) for t in tickets if age_days(t, now) > STALE_DAYS),
                           key=lambda x: -x[0])
            title = TITLE.format(column=column, board=board)
            pile = len(tickets) > cap
            over += pile
            print(f"{'PILEUP' if pile else 'ok':6} board {board:5} {column:24} {len(tickets):3}/{cap:<3} stale>{STALE_DAYS}d: {len(stale)}")
            if not a.apply:
                continue
            alarm = open_alarm(a.alarm_board, a.done_section, title)
            if pile and not alarm:
                with tempfile.NamedTemporaryFile("w", suffix=".md", delete=False) as f:
                    f.write(description(board, column, len(tickets), cap, stale, owner))
                r = vcc("task", "create", "--project", str(a.alarm_board), "--section", a.alarm_section,
                        "--priority", "urgent", "--labels", a.labels, "--title", title,
                        "--description-file", f.name, "--markdown")
                failed += r.returncode != 0
                print(f"    alarm {'FAILED: ' + (r.stderr or r.stdout).strip()[:200] if r.returncode else 'filed'}")
            elif pile and alarm:
                r = vcc("activity", "add", alarm["ticketNumber"],
                        f"pileup-watch {now:%Y-%m-%d}: {column} on board {board} holds {len(tickets)} (cap {cap}); "
                        f"{len(stale)} stale over {STALE_DAYS}d. Oldest: {oldest(stale, board)}")
                failed += r.returncode != 0
            elif alarm:
                vcc("activity", "add", alarm["ticketNumber"],
                    f"pileup-watch {now:%Y-%m-%d}: back under cap ({len(tickets)}/{cap}). Closing.")
                r = vcc("task", "update", alarm["ticketNumber"], "--section", a.done_section)
                if r.returncode:
                    # The ship guard refuses Done for tickets without a PR (YPER4-993); an alarm has no code.
                    r = vcc("task", "update", alarm["ticketNumber"], "--status", "Archive")
                failed += r.returncode != 0
                print(f"    alarm {alarm['ticketNumber']} {'close FAILED: ' + (r.stderr or r.stdout).strip()[:200] if r.returncode else 'closed'}")
    boards = [int(b) for b in a.backlog_boards.split(",") if b.strip()]
    if boards:
        failed += backlog_cap(boards, a.apply, now)
    print(f"SUMMARY {over} column(s) over cap")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
