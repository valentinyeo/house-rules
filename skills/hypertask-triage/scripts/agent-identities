#!/usr/bin/env python3
"""Compare runner agent logins in Hypertask with runner sessions alive on this server.

One agent, one identity. Runners that restart often mint a new login and
leave the old one active, so the login count drifts from the real fleet.
Per pool: active logins against live tmux sessions. Extra logins and
duplicate names are flagged. Pools that run on another server are listed,
not judged.

Valentin, 2026-11-06: "runners create new agent identities, but they do not
frequently release the old ones ... the hyper task triage skill needs to
flag that too if that is out of shape or out of control".

usage: agent-identities [--json PATH] [--self-test]
Reads only. Revoking a login is Valentin's call: /agent-housekeeping files the list.
"""
import argparse
import collections
import json
import re
import subprocess
import sys

# pool name: (login name pattern, tmux session prefix or None when the pool lives on another server)
POOLS = {
    "Runner N": (r"^runner (\d+)$", "ht-or-runner-"),
    "CI Runner N": (r"^ci runner (\d+)$", "ht-ci-runner-"),
    "Infra Runner N": (r"^infra runner (\d+)$", "infra-runner-"),
    "CEO Runner N": (r"^ceo runner (\d+)$", "ceo-runner-"),
    "Hax Runner N": (r"^hax runner (\d+)$", "hax-runner-"),
    "Multi Bot Runner X": (r"^multi bot runner ([a-z])$", "multibot-runner-"),
    "inne Runner N": (r"^inne runner (\d+)$", None),
}


def agents():
    out, cursor = [], ""
    while True:
        path = "/mcp/admin/agents?limit=100" + (f"&cursor={cursor}" if cursor else "")
        r = subprocess.run(["ht", "GET", path], capture_output=True, text=True)
        page = json.loads(r.stdout or "{}")
        out += page.get("agents", [])
        cursor = page.get("nextCursor")
        if not cursor:
            return out


def sessions():
    r = subprocess.run(["tmux", "ls", "-F", "#S"], capture_output=True, text=True)
    return r.stdout.split()


def judge(active, live_sessions):
    pools, dupes = {}, []
    names = collections.Counter(a["display_name"].strip().lower() for a in active)
    dupes = sorted(n for n, c in names.items() if c > 1)
    for pool, (pattern, prefix) in POOLS.items():
        rx = re.compile(pattern, re.I)
        ids = sorted({rx.match(a["display_name"]).group(1).lower() for a in active if rx.match(a["display_name"])})
        if not ids:
            continue
        if prefix is None:
            pools[pool] = {"logins": len(ids), "live": None, "extra": []}
            continue
        live = {s[len(prefix):].lower() for s in live_sessions if s.startswith(prefix)}
        pools[pool] = {"logins": len(ids), "live": len(live), "extra": [i for i in ids if i not in live]}
    return pools, dupes


def show(pools, dupes, total):
    print(f"IDENTITIES {total} active agent logins")
    for pool, p in pools.items():
        if p["live"] is None:
            print(f"  {pool:<20} {p['logins']:3} logins, runs on another server, not judged")
            continue
        flag = "EXTRA" if p["extra"] else "OK"
        print(f"  {flag:<5} {pool:<20} {p['logins']:3} logins for {p['live']} live sessions"
              + (f"; no session: {', '.join(p['extra'])}" if p["extra"] else ""))
    for name in dupes:
        print(f"  DUPLICATE {name}: more than one active login")
    extra = sum(len(p["extra"]) for p in pools.values())
    print(f"IDENTITIES SUMMARY {extra} runner logins with no live session, {len(dupes)} duplicate names")
    return extra, len(dupes)


def self_test():
    active = [{"display_name": n} for n in ["Runner 1", "Runner 2", "Runner 11", "RUNNER 2", "CI Runner 1",
                                           "inne Runner 1", "Mini Boss CEO", "Mini Boss CEO"]]
    pools, dupes = judge(active, ["ht-or-runner-1", "ht-or-runner-2", "ht-ci-runner-1", "shell"])
    assert pools["Runner N"] == {"logins": 3, "live": 2, "extra": ["11"]}, pools
    assert pools["CI Runner N"]["extra"] == [] and pools["inne Runner N"]["live"] is None, pools
    assert dupes == ["mini boss ceo", "runner 2"], dupes
    print("SELF_TEST_OK")


def main():
    p = argparse.ArgumentParser()
    p.add_argument("--json")
    p.add_argument("--self-test", action="store_true")
    a = p.parse_args()
    if a.self_test:
        return self_test()
    active = [x for x in agents() if not x.get("revoked")]
    pools, dupes = judge(active, sessions())
    extra, dup = show(pools, dupes, len(active))
    if a.json:
        json.dump({"active": len(active), "pools": pools, "duplicates": dupes, "extra": extra}, open(a.json, "w"),
                  indent=1)


if __name__ == "__main__":
    sys.exit(main())
