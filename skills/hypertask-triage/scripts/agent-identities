#!/usr/bin/env python3
"""Compare runner agent logins in Hypertask with runner sessions alive on this server.

One agent, one identity. Runners that restart often mint a new login and
leave the old one active, so the login count drifts from the real fleet.
Per pool: active logins against live tmux sessions. Extra logins and
duplicate names are flagged. Pools that run on another server are listed,
not judged.

Valentin, 2026-11-06: "runners create new agent identities, but they do not
frequently release the old ones ... the hyper task triage skill needs to
flag that too if that is out of shape or out of control".

Valentin, 2026-11-08: "why would e keep a round a dismantled runner idenitty.
of course deletion". His order is the standing yes.

usage: agent-identities [--json PATH] [--apply] [--self-test]
Without --apply it only reads. With --apply it deletes dismantled runner
logins: an EXTRA login (no live session) seen extra 24 hours in a row, not
used by any live process, not in KEEP_POOLS. Comments keep the author name;
board memberships and ticket assignments go. Each delete is logged to
~/.local/state/agent-housekeeping/deleted-<date>.json.
Duplicate names are only listed, never deleted automatically.
"""
import argparse
import collections
import json
import re
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

# pool name: (login name pattern, tmux session prefix or None when the pool lives on another server)
POOLS = {
    "Runner N": (r"^runner (\d+)$", "ht-or-runner-"),
    "CI Runner N": (r"^ci runner (\d+)$", "ht-ci-runner-"),
    "Infra Runner N": (r"^infra runner (\d+)$", "infra-runner-"),
    "CEO Runner N": (r"^ceo runner (\d+)$", "ceo-runner-"),
    "Hax Runner N": (r"^hax runner (\d+)$", "hax-runner-"),
    "Multi Bot Runner X": (r"^multi bot runner ([a-z])$", "multibot-runner-"),
    "MP Runner N": (r"^mp runner (\d+)$", "mp-runner-"),
    "inne Runner N": (r"^inne runner (\d+)$", None),
}
# Fixed logins of the shared pool (roster.json ht-or-runner-{n}, poteto-cursor-{n}) and inne: never deleted.
KEEP_POOLS = {"Runner N", "inne Runner N"}
GRACE_S = 24 * 3600
STATE = Path.home() / ".local/state/agent-housekeeping"


def agents():
    out, cursor = [], ""
    while True:
        path = "/mcp/admin/agents?limit=100" + (f"&cursor={cursor}" if cursor else "")
        r = subprocess.run(["ht", "GET", path], capture_output=True, text=True)
        page = json.loads(r.stdout or "{}")
        out += page.get("agents", [])
        cursor = page.get("nextCursor")
        if not cursor:
            return out


def sessions():
    r = subprocess.run(["tmux", "ls", "-F", "#S"], capture_output=True, text=True)
    return r.stdout.split()


def judge(active, live_sessions):
    pools, dupes = {}, []
    names = collections.Counter(a["display_name"].strip().lower() for a in active)
    dupes = sorted(n for n, c in names.items() if c > 1)
    for pool, (pattern, prefix) in POOLS.items():
        rx = re.compile(pattern, re.I)
        ids = sorted({rx.match(a["display_name"]).group(1).lower() for a in active if rx.match(a["display_name"])})
        if not ids:
            continue
        if prefix is None:
            pools[pool] = {"logins": len(ids), "live": None, "extra": []}
            continue
        live = {s[len(prefix):].lower() for s in live_sessions if s.startswith(prefix)}
        pools[pool] = {"logins": len(ids), "live": len(live), "extra": [i for i in ids if i not in live]}
    return pools, dupes


def extra_logins(active, pools):
    """Active agents whose login is EXTRA in a pool that may be cleaned."""
    out = []
    for pool, p in pools.items():
        if pool in KEEP_POOLS or not p.get("extra"):
            continue
        rx = re.compile(POOLS[pool][0], re.I)
        out += [a for a in active if (m := rx.match(a["display_name"].strip())) and m.group(1).lower() in p["extra"]]
    return out


def process_names():
    """Agent names live processes run as. Those logins stay."""
    names = set()
    for d in Path("/proc").iterdir():
        if not d.name.isdigit():
            continue
        try:
            for kv in (d / "environ").read_bytes().split(b"\0"):
                k, _, v = kv.decode(errors="ignore").partition("=")
                if k in ("SHIP_SESSION_NAME", "CEO_AGENT") and v:
                    names.add(v.strip().lower())
        except OSError:
            continue
    return names


def due(extra, seen, now, in_use):
    """Extra logins seen extra for GRACE_S and unused by live processes. Updates seen in place."""
    ids = {a["id"] for a in extra}
    for k in [k for k in seen if k not in ids]:
        del seen[k]  # back in use or already gone: its clock restarts
    out = []
    for a in extra:
        first = seen.setdefault(a["id"], now)
        if now - first >= GRACE_S and a["display_name"].strip().lower() not in in_use:
            out.append(a)
    return out


def apply(active, pools):
    STATE.mkdir(parents=True, exist_ok=True)
    seen_f = STATE / "extra-seen.json"
    seen = json.loads(seen_f.read_text()) if seen_f.exists() else {}
    todo = due(extra_logins(active, pools), seen, time.time(), process_names())
    seen_f.write_text(json.dumps(seen, indent=1))
    if not todo:
        print("IDENTITIES APPLY 0 deleted")
        return 0
    day = datetime.now(timezone.utc).strftime("%Y-%m-%d")
    log_f = STATE / f"deleted-{day}.json"
    log = json.loads(log_f.read_text()) if log_f.exists() else {"date": day, "action": "delete", "deleted": []}
    n = 0
    for a in todo:
        for _ in range(6):
            r = subprocess.run(["ht", "DELETE", f"/mcp/agents/{a['id']}"], capture_output=True, text=True).stdout
            if "Rate limit" not in r:
                break
            time.sleep(20)
        ok = '"success":true' in r.replace(" ", "")
        log["deleted"].append({"id": a["id"], "display_name": a["display_name"], "deleted": ok,
                               "at": datetime.now(timezone.utc).isoformat(timespec="seconds"),
                               "by": "agent-identities --apply", "error": None if ok else r[:200]})
        if ok:
            seen.pop(a["id"], None)
        n += ok
        print(f"  DELETED {a['display_name']} {a['id']}" if ok else f"  DELETE FAILED {a['display_name']}: {r[:120]}")
    log_f.write_text(json.dumps(log, indent=1))
    seen_f.write_text(json.dumps(seen, indent=1))
    print(f"IDENTITIES APPLY {n} deleted, log {log_f}")
    return n


def show(pools, dupes, total):
    print(f"IDENTITIES {total} active agent logins")
    for pool, p in pools.items():
        if p["live"] is None:
            print(f"  {pool:<20} {p['logins']:3} logins, runs on another server, not judged")
            continue
        flag = "EXTRA" if p["extra"] else "OK"
        print(f"  {flag:<5} {pool:<20} {p['logins']:3} logins for {p['live']} live sessions"
              + (f"; no session: {', '.join(p['extra'])}" if p["extra"] else ""))
    for name in dupes:
        print(f"  DUPLICATE {name}: more than one active login")
    extra = sum(len(p["extra"]) for p in pools.values())
    print(f"IDENTITIES SUMMARY {extra} runner logins with no live session, {len(dupes)} duplicate names")
    return extra, len(dupes)


def self_test():
    active = [{"display_name": n} for n in ["Runner 1", "Runner 2", "Runner 11", "RUNNER 2", "CI Runner 1",
                                           "inne Runner 1", "Mini Boss CEO", "Mini Boss CEO"]]
    pools, dupes = judge(active, ["ht-or-runner-1", "ht-or-runner-2", "ht-ci-runner-1", "shell"])
    assert pools["Runner N"] == {"logins": 3, "live": 2, "extra": ["11"]}, pools
    assert pools["CI Runner N"]["extra"] == [] and pools["inne Runner N"]["live"] is None, pools
    assert dupes == ["mini boss ceo", "runner 2"], dupes
    active = [{"id": n, "display_name": n} for n in ["Runner 11", "CI Runner 1", "CI Runner 2", "CI Runner 3", "inne Runner 1"]]
    pools, _ = judge(active, ["ht-ci-runner-3"])
    extra = extra_logins(active, pools)
    assert [a["id"] for a in extra] == ["CI Runner 1", "CI Runner 2"], extra  # Runner N and inne never
    seen = {"gone": 0}
    assert due(extra, seen, 1000, set()) == [] and "gone" not in seen  # first sighting starts the clock
    assert [a["id"] for a in due(extra, seen, 1000 + GRACE_S, {"ci runner 2"})] == ["CI Runner 1"]  # live process keeps it
    print("SELF_TEST_OK")


def main():
    p = argparse.ArgumentParser()
    p.add_argument("--json")
    p.add_argument("--apply", action="store_true", help="delete dismantled runner logins (24h extra, no live process)")
    p.add_argument("--self-test", action="store_true")
    a = p.parse_args()
    if a.self_test:
        return self_test()
    active = [x for x in agents() if not x.get("revoked")]
    pools, dupes = judge(active, sessions())
    if a.apply and apply(active, pools):
        active = [x for x in agents() if not x.get("revoked")]
        pools, dupes = judge(active, sessions())
    extra, dup = show(pools, dupes, len(active))
    if a.json:
        json.dump({"active": len(active), "pools": pools, "duplicates": dupes, "extra": extra}, open(a.json, "w"),
                  indent=1)


if __name__ == "__main__":
    sys.exit(main())
