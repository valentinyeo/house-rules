#!/usr/bin/env python3
"""Find open tickets whose column no longer matches their pull request.

A runner that forgets to move its ticket leaves shipped work in In Progress
or AI Review. Per open ticket in a work column, this reads every GitHub pull
request link in the description, comments and agent log, asks GitHub for its
state, and judges the newest one:
  MERGED-NOT-MOVED  newest PR merged, ticket still in a pre-merge column.
                    Board 15: move to QA for the live proof. Other boards:
                    merged means released, move to Done after the live check.
  PR-CLOSED         newest PR closed unmerged, no open PR. Back to the queue.
  NO-PR             in AI Review with no PR link at all.

Valentin, 2026-11-06: "a bunch of tickets that are in AI review, but really
the feature is already in the app ... the runner just forgot to move it".

usage: wrong-status [--board 15] [--json PATH] [--self-test]
Reads only. The board lead moves the tickets.
"""
import argparse
import json
import re
import subprocess
import sys
import time
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

# board: (columns before merge, column a merged ticket belongs in)
BOARDS = {
    15: (["In Progress", "AI Review", "Agent Blocked (Infra)", "Valentin Review"], "QA"),
    4060: (["In Progress", "AI Review", "Agent Blocked", "Valentin Review"], "Done"),
    11514: (["In Progress", "AI Review", "Agent Blocked", "Valentin Review"], "Done"),
    2060: (["Doing", "AI Review", "Valentin Review"], "Done"),
    8783: (["Doing"], "Done"),
}
PR = re.compile(r"https://github\.com/([\w.-]+/[\w.-]+)/pull/(\d+)")


def ht(*args):
    r = subprocess.run(["hypertask", "--json", *args], capture_output=True, text=True)
    try:
        return json.loads(r.stdout)
    except ValueError:
        return {}


def column(board, name):
    out, offset = [], 0
    while True:
        page = ht("task", "list", "--project", str(board), "--section", name, "--status", "Normal",
                  "--limit", "100", "--offset", str(offset)).get("tasks", [])
        out += page
        if len(page) < 100:
            return out
        offset += 100


CACHE = Path.home() / ".local/state/board-health/pr-links.json"
CACHE_MAX_S = 6 * 3600


def cached_links(t, cache, now):
    """Reuse a ticket's PR links while it is unchanged and the entry is under 6 hours old."""
    key = f"{t.get('updatedAt')}|{t.get('commentCount')}"
    hit = cache.get(t["ticketNumber"])
    if hit and hit["key"] == key and now - hit["at"] < CACHE_MAX_S:
        return hit["links"]
    links = pr_links(t)
    cache[t["ticketNumber"]] = {"key": key, "at": now, "links": links}
    return links


def pr_links(t):
    """Newest mention last: description, then comments and log entries in time order."""
    num = t["ticketNumber"]
    task = (ht("task", "get", num).get("tasks") or [{}])[0]
    desc = (task.get("description") or "") + " " + json.dumps(task.get("pullRequests") or [])
    entries = [(c.get("createdAt") or "", c.get("text") or "") for c in ht("comment", "list", num).get("comments") or []]
    entries += [(a.get("createdAt") or "", a.get("text") or "") for a in ht("task", "agent-log", num).get("activities") or []]
    seen = []
    for _, text in [("", desc)] + sorted(entries):
        for repo, n in PR.findall(text):
            key = f"{repo}#{n}"
            if key in seen:
                seen.remove(key)
            seen.append(key)
    return seen


def pr_state(key):
    """Returns (OPEN|MERGED|CLOSED|UNKNOWN, live): live is True when production already runs the merge."""
    repo, n = key.split("#")
    r = subprocess.run(["gh", "pr", "view", n, "--repo", repo, "--json", "state,mergeCommit"], capture_output=True, text=True)
    try:
        d = json.loads(r.stdout)
    except ValueError:
        return "UNKNOWN", False
    return d.get("state", "UNKNOWN"), (d.get("mergeCommit") or {}).get("oid")


def production_sha(repo):
    """Newest successful Production deployment on GitHub, or None when the repo has none."""
    if repo not in PROD_CACHE:
        deps = gh_json(f"repos/{repo}/deployments?environment=Production&per_page=10") or []
        PROD_CACHE[repo] = next((d["sha"] for d in deps if isinstance(d, dict) and
                                 (gh_json(f"repos/{repo}/deployments/{d['id']}/statuses?per_page=1") or [{}])[0]
                                 .get("state") == "success"), None)
    return PROD_CACHE[repo]


def in_production(repo, merge):
    """Production runs the merge. A repo with no Production deployments (our tools, house-rules) is live on merge."""
    prod = production_sha(repo)
    if not prod:
        return bool(merge)
    cmp = gh_json(f"repos/{repo}/compare/{merge}...{prod}") or {}
    return cmp.get("status") in ("ahead", "identical")


def gh_json(path):
    r = subprocess.run(["gh", "api", path], capture_output=True, text=True)
    try:
        return json.loads(r.stdout)
    except ValueError:
        return None


PROD_CACHE = {}


def verdict(col, prs, states, waiting_on_him=False):
    """prs oldest to newest mention; states maps pr key to (state, live)."""
    if col == "Valentin Review" and waiting_on_him:
        return None
    if not prs:
        return "NO-PR" if col == "AI Review" else None
    if any(states.get(p, ("",))[0] == "OPEN" for p in prs):
        return None
    newest, live = states.get(prs[-1], ("UNKNOWN", False))
    if col == "QA":
        return "LIVE-READY" if newest == "MERGED" and live else None
    if newest == "MERGED":
        return "MERGED-NOT-MOVED"
    if newest == "CLOSED":
        return "PR-CLOSED"
    return None


def run(board):
    cols, merged_to = BOARDS[board]
    tickets = [(c, t) for c in cols + (["QA"] if merged_to == "QA" else []) for t in column(board, c)]
    try:
        cache = json.loads(CACHE.read_text())
    except (OSError, ValueError):
        cache = {}
    now = time.time()
    with ThreadPoolExecutor(6) as ex:
        links = list(ex.map(lambda ct: cached_links(ct[1], cache, now), tickets))
    CACHE.parent.mkdir(parents=True, exist_ok=True)
    CACHE.write_text(json.dumps({k: v for k, v in cache.items() if now - v["at"] < CACHE_MAX_S}))
    keys = sorted({k for ls in links for k in ls})
    with ThreadPoolExecutor(4) as ex:
        raw = dict(zip(keys, ex.map(pr_state, keys)))
    # every merged newest PR, not only QA's: a merged ticket off board 15 goes to Done once its merge is live
    merged_newest = {ls[-1] for ls in links if ls and raw[ls[-1]][0] == "MERGED"}
    for repo in {k.split("#")[0] for k in merged_newest}:
        production_sha(repo)
    with ThreadPoolExecutor(4) as ex:
        live = dict(zip(merged_newest, ex.map(lambda k: in_production(k.split("#")[0], raw[k][1]), merged_newest)))
    states = {k: (s, live.get(k, False)) for k, (s, _) in raw.items()}
    rows = []
    for (col, t), prs in zip(tickets, links):
        v = verdict(col, prs, states, bool(t.get("blockerCommentId")))
        if v:
            rows.append({"ticket": t["ticketNumber"], "column": col, "verdict": v, "pr": prs[-1] if prs else None,
                         "move_to": {"MERGED-NOT-MOVED": merged_to, "LIVE-READY": "Done after the runner's live check"}
                         .get(v, "home column"), "title": t["title"], "assignees": t.get("assignees") or [],
                         "labels": [l.get("name") for l in t.get("labels") or []],
                         "live": bool(prs) and states.get(prs[-1], ("", False))[1]})
    return rows, len(tickets)


def show(board, rows, scanned):
    url = "https://app.hypertask.ai/detail/project-{b}/{n}"
    for r in sorted(rows, key=lambda r: (r["verdict"], r["column"])):
        pr = r["pr"] and "https://github.com/{0}/pull/{1}".format(*r["pr"].split("#"))
        print(f"{r['verdict']:<17} {r['column']:<16} {url.format(b=board, n=r['ticket'].rsplit('-', 1)[1])}  "
              f"{pr or 'no PR'}  move to {r['move_to']}  {r['title'][:50]}")
    count = {}
    for r in rows:
        count[r["verdict"]] = count.get(r["verdict"], 0) + 1
    print(f"WRONG-STATUS board {board}: {len(rows)} of {scanned} work tickets in the wrong column"
          + (": " + ", ".join(f"{k} {v}" for k, v in sorted(count.items())) if count else ""))


def self_test():
    s = {"a#1": ("MERGED", False), "a#2": ("OPEN", False), "a#3": ("CLOSED", False), "a#4": ("MERGED", True)}
    assert verdict("QA", ["a#4"], s) == "LIVE-READY" and verdict("QA", ["a#1"], s) is None, "QA live check"
    assert verdict("AI Review", ["a#1"], s) == "MERGED-NOT-MOVED"
    assert verdict("AI Review", ["a#1", "a#2"], s) is None, "open PR still in flight"
    assert verdict("In Progress", ["a#1", "a#3"], s) == "PR-CLOSED"
    assert verdict("In Progress", ["a#3", "a#1"], s) == "MERGED-NOT-MOVED"
    assert verdict("AI Review", [], s) == "NO-PR" and verdict("In Progress", [], s) is None
    assert verdict("Valentin Review", ["a#1"], s, waiting_on_him=True) is None, "open Question waits on him"
    assert verdict("Valentin Review", ["a#1"], s) == "MERGED-NOT-MOVED", "no Question: merged work must move"
    assert PR.findall("see https://github.com/hypertask-ai/hypertask/pull/2939.") == [("hypertask-ai/hypertask", "2939")]
    print("SELF_TEST_OK")


def main():
    p = argparse.ArgumentParser()
    p.add_argument("--board", type=int, default=15, choices=sorted(BOARDS))
    p.add_argument("--json")
    p.add_argument("--self-test", action="store_true")
    a = p.parse_args()
    if a.self_test:
        return self_test()
    rows, scanned = run(a.board)
    show(a.board, rows, scanned)
    if a.json:
        json.dump({"rows": rows, "scanned": scanned}, open(a.json, "w"), indent=1)


if __name__ == "__main__":
    sys.exit(main())
