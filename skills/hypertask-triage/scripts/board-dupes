#!/usr/bin/env python3
"""List likely duplicate open tickets on a board, so they get closed the same turn.

Pairs open tickets whose titles share most of their words. Read only: it prints
pairs, the agent closes the newer one with a "Duplicate of <link>" note.
Exit 1 when any pair is found, so a lead turn or timer can fail loudly.

Valentin, 2026-11-04: "duplciates you can clean ou tpls don't let them sit around".

usage: board-dupes <board> [<board> ...] [--min 0.6] [--label NAME]
"""
import argparse
import json
import re
import subprocess
import sys

STOP = set("a an the and or of to in on for with is are be it its by at from as that this not no is his her desktop android phone live chat multibot multiprompt".split())
URL = "https://app.hypertask.ai/detail/project-{board}/{number}"


def first_json(text):
    try:
        value, _ = json.JSONDecoder().raw_decode(text.strip())
        return value
    except ValueError:
        return {}


def open_tasks(board, label):
    args = ["hypertask", "--json", "task", "list", "--project", str(board), "--limit", "500"]
    if label:
        args += ["--label", label]
    out = subprocess.run(args, capture_output=True, text=True).stdout
    tasks = first_json(out).get("tasks", [])
    return [t for t in tasks if not t.get("sectionIsDone") and t.get("section") != "Done"]


def words(title):
    return {w for w in re.findall(r"[a-z0-9]+", title.lower()) if w not in STOP and len(w) > 2}


def platform(task):
    text = (task.get("title", "") + " " + " ".join(l.get("name", "") for l in task.get("labels", []))).lower()
    return "android" if "android" in text or "phone" in text else "other"


def pair_marker(task):
    m = re.search(r"MP-PAIR:[A-Z0-9-]+:[a-z]+", task.get("description") or "")
    return m.group(0) if m else None


def pairs(tasks, minimum):
    found = []
    for i, a in enumerate(tasks):
        wa = words(a["title"])
        for b in tasks[i + 1:]:
            if platform(a) != platform(b):
                continue
            ma, mb = pair_marker(a), pair_marker(b)
            if ma or mb:
                if ma == mb:
                    found.append((1.0, a, b))
                continue
            wb = words(b["title"])
            if not wa or not wb:
                continue
            score = len(wa & wb) / len(wa | wb)
            if score >= minimum:
                found.append((score, a, b))
    return sorted(found, key=lambda p: -p[0])


def main():
    p = argparse.ArgumentParser()
    p.add_argument("boards", nargs="+", type=int)
    p.add_argument("--min", type=float, default=0.6)
    p.add_argument("--label")
    o = p.parse_args()
    total = 0
    for board in o.boards:
        for score, a, b in pairs(open_tasks(board, o.label), o.min):
            total += 1
            older, newer = sorted((a, b), key=lambda t: t.get("uniqueIndex", 0))
            print(f"{score:.2f} keep {URL.format(board=board, number=older['uniqueIndex'])} {older['title']}")
            print(f"     close? {URL.format(board=board, number=newer['uniqueIndex'])} {newer['title']}")
    print(f"pairs: {total}")
    sys.exit(1 if total else 0)


if __name__ == "__main__":
    main()
