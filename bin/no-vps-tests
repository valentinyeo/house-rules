#!/usr/bin/env python3
"""PreToolUse hook for Bash: refuse test runners and local CI on this server. GitHub runs them on the PR.

Usage: as a Claude Code PreToolUse hook (reads the tool call on stdin), or `no-vps-tests --self-test`.
"""
import json
import re
import shlex
import sys

FIX = ("House rules: tests and reviews never run on this server. Push the branch and let GitHub run them: "
       "`gh pr checks <pr> --watch`, then read the failing job with `gh run view <run> --log-failed`.")

TEST_EXES = {"pytest", "py.test", "vitest", "jest", "mocha", "ava", "playwright", "cypress", "karma", "phpunit", "rspec", "act"}
SCRIPT_RUNNERS = {"npm", "pnpm", "yarn", "bun"}
EXEC_RUNNERS = {"npx", "bunx", "pnpx"}
WRAPPERS = {"nohup", "setsid", "env", "exec", "nice", "time", "command", "stdbuf", "timeout", "sudo"}
TEST_SCRIPT = re.compile(r"(^|/)(test_[^/]*|[^/]*[._-](test|spec))\.(py|js|mjs|cjs|ts)$")
GRADLE_TEST = re.compile(r"^(:?[\w-]+:)*(test\w*|check|connected\w*Test|\w*UnitTest)$")


def segments(cmd):
    for part in re.split(r"&&|\|\||[;|\n&]|\$\(|`", cmd):
        try:
            words = shlex.split(part, comments=True)
        except ValueError:
            words = part.split()
        while words and (re.match(r"^\w+=", words[0]) or words[0] in WRAPPERS or re.match(r"^\d+[smhd]?$", words[0])
                         or (words[0].startswith("-") and len(words) > 1)):
            words = words[1:]
        if words:
            yield words


def refusal(cmd):
    for words in segments(cmd):
        exe, args = words[0].rsplit("/", 1)[-1], words[1:]
        if exe in TEST_EXES:
            return exe
        if exe in SCRIPT_RUNNERS and args:
            first = args[1] if args[0] == "run" and len(args) > 1 else args[0]
            if first in ("test", "t") or first.startswith(("test:", "test-", "e2e", "spec")):
                return f"{exe} {first}"
        if exe in EXEC_RUNNERS or (exe in ("pnpm", "yarn") and args[:1] == ["exec"]):
            rest = [a for a in args if not a.startswith("-") and a != "exec"]
            if rest and rest[0].split("@")[0] in TEST_EXES:
                return f"{exe} {rest[0]}"
        if re.match(r"^python[\d.]*$", exe):
            if "-m" in args and args[args.index("-m") + 1:args.index("-m") + 2] in (["pytest"], ["unittest"]):
                return f"{exe} -m {args[args.index('-m') + 1]}"
            scripts = [a for a in args if not a.startswith("-")]
            if scripts and TEST_SCRIPT.search(scripts[0]):
                return scripts[0]
        if exe in ("node", "deno", "bun") and args[:1] in (["--test"], ["test"]):
            return f"{exe} {args[0]}"
        if exe in ("go", "cargo") and args[:1] == ["test"]:
            return f"{exe} test"
        if exe in ("gradle", "gradlew") and any(GRADLE_TEST.match(a) for a in args):
            return f"{exe} {next(a for a in args if GRADLE_TEST.match(a))}"
    return None


CASES = [
    ("python3 -I scripts/invoice-archive.test.py", True),
    ("cd ~/projects/pecunia && python3 -I scripts/invoice-archive.test.py", True),
    ("npx vitest run src/lib/flags", True),
    ("pnpm test -- --run", True),
    ("npm run test:unit", True),
    ("CI=1 npx playwright test e2e/login.spec.ts", True),
    ("python3 -m pytest tests/", True),
    ("python3 -m unittest tests.test_house_rules_sync -v", True),
    ("./gradlew :app:testDebugUnitTest", True),
    ("./gradlew connectedDebugAndroidTest", True),
    ("go test ./...", True),
    ("node --test test/", True),
    ("act pull_request", True),
    ("timeout 60 npx jest", True),
    ("grep -rn pytest .", False),
    ("git commit -m 'run vitest in CI'", False),
    ("gh pr checks 538 --watch", False),
    ("npm install", False),
    ("python3 scripts/rules-lint --self-test", False),
    ("./gradlew assembleDebug", False),
    ("cat tests/test_ci_wait.py", False),
    ("ls node_modules/.bin/vitest", False),
]


def self_test():
    bad = 0
    for cmd, blocked in CASES:
        got = refusal(cmd) is not None
        print(("ok  " if got == blocked else "FAIL") + f" {'refuse' if blocked else 'allow '} {cmd}")
        bad += got != blocked
    print("no-vps-tests self-test " + ("ok" if not bad else f"FAILED ({bad})"))
    return 1 if bad else 0


def main():
    if "--self-test" in sys.argv:
        return self_test()
    try:
        cmd = json.load(sys.stdin).get("tool_input", {}).get("command", "")
    except ValueError:
        return 0
    hit = refusal(cmd)
    if hit:
        print(json.dumps({"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "deny",
                                                 "permissionDecisionReason": f"`{hit}`: {FIX}"}}))
    return 0


if __name__ == "__main__":
    sys.exit(main())
