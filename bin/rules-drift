#!/usr/bin/env python3
"""rules-drift: one source of truth for standing rules.

house-rules.md is the only place a standing rule lives. Every other instruction source
agents read on this server may only point to it or hold project-only rules. This script
greps those other sources for banned stale phrases (texts that once contradicted house
rules) and exits 1 with file:line for every hit.

  rules-drift               scan, print hits, log to ~/.local/state/rules-drift.log, exit 1 on any hit
  rules-drift --house-rules scan only house-rules.md for retired runner-pool prose
  rules-drift --self-check  prove the scanner on fixtures (hit, no hit, allow marker, house-rules block skip)

A line that must keep a banned phrase (for example a rule that forbids it) ends with
the marker `rules-drift:ok`. Run every 5 minutes from house-rules-sync.
Read only: it never edits a source and starts no build, test or CI job.
"""
import glob
import os
import re
import subprocess
import sys
import tempfile
import time

HOME = os.path.expanduser("~")
LOG = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.join(HOME, ".local/state")), "rules-drift.log")
ALLOW = "rules-drift:ok"

# (regex, why it is banned). Case-insensitive. Add a phrase here when a stale text is found.
BANNED = [
    (r"self-hosted runners?", "CI runs only on GitHub-hosted runners; no runner on this server (house rules, Doing the work, 2026-11-03 and 2026-11-08)"),
    (r"private-repo jobs run only", "stale: private repos may use GitHub-hosted minutes (house rules, Doing the work, 2026-11-03)"),
    (r"never on github-hosted", "stale: CI runs only on GitHub-hosted runners (house rules, Doing the work, 2026-11-03)"),
    (r"codex first, always eligible", "stale pre-2026-11-07 pacing; the pacer owns it (house rules, Models and harnesses, Pace every subscription)"),
    (r"85% stop", "stale pre-2026-11-07 reserve; the pacer owns it (house rules, Models and harnesses, Pace every subscription)"),
    (r"70% manager reserve", "stale pre-2026-11-07 reserve; the pacer owns it (house rules, Models and harnesses, Pace every subscription)"),
    (r"always eligible despite quota", "stale pre-2026-11-07 pacing; the pacer owns it (house rules, Models and harnesses, Pace every subscription)"),
    (r"ht-ci-runner", "retired CI runner pool; one shared runner pool (factory plan, 2026-11-08)"),
    (r"ht-hax-runner", "retired hax runner pool; fleet/runner (factory plan, 2026-11-08)"),
    (r"mb-pick", "retired picker; fleet/pick (factory plan, 2026-11-08)"),
    (r"mp-pick", "retired picker; fleet/pick (factory plan, 2026-11-08)"),
]
BANNED_RE = [(re.compile(p, re.I), why) for p, why in BANNED]

HOUSE_BANNED = [
    (r"ht-ci-runner", "retired CI runner pool; one shared runner pool (factory plan, 2026-11-08)"),
    (r"infra-runner-", "retired infra runner pool; one shared runner pool (factory plan, 2026-11-08)"),
    (r"ht-hax-runner", "retired hax runner pool; fleet/runner (factory plan, 2026-11-08)"),
    (r"mb-pick", "retired picker; fleet/pick (factory plan, 2026-11-08)"),
    (r"mp-pick", "retired picker; fleet/pick (factory plan, 2026-11-08)"),
    (r"runs its own\b.*\brunners?", "retired per-lane runner pools; one shared pool (factory plan, 2026-11-08)"),
    (r"CI Boss runners", "retired separate CI runner pool (factory plan, 2026-11-08)"),
    (r"infra-runner-1\.\.3", "retired infra-runner count line (factory plan, 2026-11-08)"),
    (r"infra-lead/bin/infra-pick", "retired infra picker; fleet/pick (factory plan, 2026-11-08)"),
    (r"ci-pick", "retired CI picker; fleet/pick (factory plan, 2026-11-08)"),
    (r"infra-pick", "retired infra picker; fleet/pick (factory plan, 2026-11-08)"),
]
HOUSE_BANNED_RE = [(re.compile(p, re.I), why) for p, why in HOUSE_BANNED]

BEGIN = "<!-- house-rules:begin"
END = "<!-- house-rules:end -->"


def house_rules_path():
    env = os.environ.get("HOUSE_RULES_MD")
    if env and os.path.isfile(env):
        return os.path.realpath(env)
    here = os.path.dirname(os.path.abspath(__file__))
    in_repo = os.path.realpath(os.path.join(here, "..", "house-rules.md"))
    if os.path.isfile(in_repo):
        return in_repo
    return os.path.realpath(os.path.join(HOME, ".local/share/house-rules/house-rules.md"))


def sources():
    """Real files to scan. Dedupe by realpath so symlinked skills and worktrees count once."""
    paths = []
    paths += [os.path.join(HOME, ".claude/CLAUDE.md")]
    paths += sorted(glob.glob(os.path.join(HOME, ".claude/reference/*.md")))
    paths += sorted(glob.glob(os.path.join(HOME, ".claude/rules/*.md")))
    paths += [os.path.join(HOME, ".codex/AGENTS.md"), os.path.join(HOME, ".config/hax/AGENTS.md")]
    for name in ("CLAUDE.md", "AGENTS.md"):
        paths += sorted(glob.glob(os.path.join(HOME, "projects", "*", name)))
    for d in (os.path.join(HOME, ".claude/skills"), os.path.join(HOME, ".local/share/house-rules/skills")):
        paths += sorted(glob.glob(os.path.join(d, "*", "SKILL.md")))
    seen, out = set(), []
    for p in paths:
        if not os.path.isfile(p):
            continue
        rp = os.path.realpath(p)
        if rp in seen or rp == os.path.realpath(os.path.join(HOME, ".local/share/house-rules/house-rules.md")):
            continue
        seen.add(rp)
        out.append(p)
    return out


def hook_texts():
    """Texts the token-ladder hooks print into prompts. Returns [(label, text)]."""
    tl = os.path.join(HOME, "projects/token-ladder/bin/token-ladder")
    out = []
    if not os.path.isfile(tl):
        return out
    for sub in ("hook-prompt",):  # session-start refreshes reserve.json; bash and agent print only on a denial
        try:
            r = subprocess.run([sys.executable, tl, sub], input="{}", capture_output=True, text=True, timeout=20)
            out.append(("token-ladder " + sub, (r.stdout or "") + (r.stderr or "")))
        except Exception:
            pass
    return out


def scan_text(label, text, hits, skip_block=False):
    inblock = False
    for n, line in enumerate(text.splitlines(), 1):
        if skip_block:
            if line.startswith(BEGIN):
                inblock = True
                continue
            if inblock:
                if line == END:
                    inblock = False
                continue
        if ALLOW in line:
            continue
        for rx, why in BANNED_RE:
            m = rx.search(line)
            if m:
                hits.append((label, n, m.group(0), why, line.strip()[:160]))


def scan(files, hooks):
    hits = []
    for p in files:
        try:
            with open(p, encoding="utf-8", errors="replace") as f:
                scan_text(p, f.read(), hits, skip_block=p.endswith("AGENTS.md"))
        except OSError:
            pass
    for label, text in hooks:
        scan_text(label, text, hits)
    return hits


def scan_house_rules(path, hits=None):
    out = hits if hits is not None else []
    label = path
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            text = f.read()
    except OSError:
        return out
    for n, line in enumerate(text.splitlines(), 1):
        if ALLOW in line:
            continue
        for rx, why in HOUSE_BANNED_RE:
            m = rx.search(line)
            if m:
                out.append((label, n, m.group(0), why, line.strip()[:160]))
    return out


def log(lines):
    os.makedirs(os.path.dirname(LOG), exist_ok=True)
    stamp = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    with open(LOG, "a") as f:
        for ln in lines:
            f.write(f"{stamp} {ln}\n")


def self_check():
    ok = True
    with tempfile.TemporaryDirectory() as d:
        bad = os.path.join(d, "bad.md")
        with open(bad, "w") as f:
            f.write("fine line\n")
            for p, _ in BANNED:
                sample = re.sub(r"\\b", "", re.sub(r"\\", "", p.replace("?", "")))
                f.write(sample.strip() + " here\n")
            f.write("self-hosted runners allowed rules-drift:ok\n")
        hits = scan([bad], [])
        want = len(BANNED)
        if len(hits) != want:
            print(f"FAIL: expected {want} hits, got {len(hits)}: {hits}")
            ok = False
        if any(h[1] == 1 or h[1] == want + 2 for h in hits):
            print("FAIL: clean line or allow-marked line was flagged")
            ok = False
        agents = os.path.join(d, "AGENTS.md")
        with open(agents, "w") as f:
            f.write(BEGIN + " test -->\nself-hosted runners inside the synced block\n" + END + "\nclean after\n")
        if scan([agents], []):
            print("FAIL: the synced house-rules block was scanned")
            ok = False
        agents2 = os.path.join(d, "x", "AGENTS.md")
        os.makedirs(os.path.dirname(agents2))
        with open(agents2, "w") as f:
            f.write(BEGIN + " test -->\nclean\n" + END + "\nself-hosted runners outside the block\n")
        if len(scan([agents2], [])) != 1:
            print("FAIL: a hit outside the synced block was missed")
            ok = False
        hr_bad = os.path.join(d, "house-rules.md")
        with open(hr_bad, "w") as f:
            f.write("One shared runner pool.\nCI Boss runners ht-ci-runner-1..5\n")
        if len(scan_house_rules(hr_bad)) < 2:
            print("FAIL: house-rules retired pool phrases were not flagged")
            ok = False
        with open(hr_bad, "w") as f:
            f.write("One shared runner pool. Pool runners use fleet/pick.\n")
        if scan_house_rules(hr_bad):
            print("FAIL: clean house-rules.md was flagged")
            ok = False
    print("self-check " + ("PASS" if ok else "FAIL"))
    return 0 if ok else 1


def report_hits(hits, clean_label):
    for label, n, phrase, why, text in hits:
        print(f"{label}:{n}: \"{phrase}\" banned: {why}. Line: {text}")
    if hits:
        log([f"HIT {h[0]}:{h[1]} \"{h[2]}\"" for h in hits])
        print(f"rules-drift: {len(hits)} hit(s) in {clean_label}")
        return 1
    log([f"clean ({clean_label})"])
    print(f"rules-drift: clean ({clean_label})")
    return 0


def main():
    args = sys.argv[1:]
    if "--self-check" in args:
        return self_check()
    if "--house-rules" in args:
        path = house_rules_path()
        return report_hits(scan_house_rules(path), path)
    files = sources()
    hits = scan(files, hook_texts())
    hr = house_rules_path()
    if os.path.isfile(hr):
        scan_house_rules(hr, hits)
    return report_hits(hits, f"{len(files)} sources + house-rules")


if __name__ == "__main__":
    sys.exit(main())
